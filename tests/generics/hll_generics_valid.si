# HLL generics: parses, type-checks, and lowers to MIR end-to-end.
#
# HM inference pins the type args from context or payload:
#   - Constructor `Box { inner: 42 }` in a fn returning `Box<i64>`
#     unifies `T := i64` via the field type.
#   - Constructor `Option::Some(42)` in a fn returning `Option<i64>`
#     unifies `T := i64` via the payload.
# Field access on `b: Box<i64>` substitutes T at the access site so
# `b.inner` has type `i64`, not `T`.
# Match binding on `Option<i64>::Some(x)` gives `x: i64` via the same
# substitution.
#
# Each fn covers one cell of the (decl kind × use pattern) matrix.
#
#   fn                    decl kind  use pattern
#   make_box              struct     constructor + field access
#   box_extract           struct     field access on generic param
#   make_some             enum       constructor with payload
#   option_extract_match  enum       match with destructuring
#   nested_container      struct     nested generic (Box<Option<i64>>)
#   call_generic_fn       generic fn HM infers T := i64 from arg
#   call_generic_fn_via_ret generic fn HM infers T := i64 from return context

struct<T: Copy + Drop> Box: Copy + Drop { inner: T }

enum<T: Copy + Drop> Option: Copy + Drop { None: unit, Some: T }

# ---------- Struct: constructor + return the wrapped value ----------

# `Box { inner: 42 }` unifies `T := i64` against the return type.
fn make_box() -> Box<i64> {
  Box { inner: 42 }
}

# `b.inner` substitutes T := i64 at the field access, so the return
# type i64 matches without a mismatch diagnostic.
fn box_extract(b: Box<i64>) -> i64 {
  b.inner
}

# ---------- Enum: constructor with generic payload ----------

# `Option::Some(42)` infers `T := i64` from the payload against the
# return type `Option<i64>`.
fn make_some() -> Option<i64> {
  Option::Some(42)
}

# Match on `Option<i64>` gives payload `x: i64` — the substitution
# happens at the arm's pattern binding. `Option` is Copy+Drop, so the
# arm binding uses `copy o as V`; the scrutinee `o` stays Init and is
# dropped at the merge.
fn option_extract_match(o: Option<i64>) -> i64 {
  o match {
    None(_) => 0,
    Some(x) => x,
  }
}

# Move-only enum match: owned scrutinee dispatches to `move ml as V`
# so enum-atomicity marks `ml` Moved after the extract. Without that
# the scrutinee would stay Init at the merge and (since Move-only is
# not Drop) trip INIT-ReturnValueLeak.
enum MoveList: Move { EmptyM: unit, ConsM: i64 }
fn move_only_owned_match(ml: MoveList) -> i64 {
  ml match {
    EmptyM(u) => u_to_zero(u),
    ConsM(x) => x,
  }
}
fn u_to_zero(u: unit) -> i64 { 0 }

# Move-only enum through a shared borrow: dispatch falls back to
# `copy ml.* as V` because moving out through a shared ref would
# violate the borrow. The scrutinee stays live via the borrow.
fn move_only_borrowed_match(ml: &MoveList) -> i64 {
  ml.* match {
    EmptyM(_) => 0,
    ConsM(x) => x,
  }
}

# ---------- Nested generic ----------

# `Box<Option<i64>>` — the outer decl's arg is itself a generic
# instantiation. Extract the inner Option into a local before matching
# (variant flow only tracks root Vars, not projections).
fn nested_container(b: Box<Option<i64>>) -> i64 {
  let inner = b.inner;
  inner match {
    None(_) => 0,
    Some(x) => x,
  }
}

# Nested constructor in tail position: the inner `Box { inner: x }`
# and `Option::Some(...)` must lower into sret slots without a temp.
# Regression guard for an init-state pass that used to see fields of a
# generic struct without substituting T — deep projections (`.inner.inner`)
# then failed to fold Partial back to Init at the outer `$return`.
fn make_box_of_box(x: i64) -> Box<Box<i64>> {
  Box { inner: Box { inner: x } }
}

fn make_box_of_option(x: i64) -> Box<Option<i64>> {
  Box { inner: Option::Some(x) }
}

fn make_option_of_box(x: i64) -> Option<Box<i64>> {
  Option::Some(Box { inner: x })
}

# Nested-field READ through two levels of generic projection: `b.inner.inner`
# must type as `i64` at each hop. Regression guard for the same
# init_state / type_of_place field-substitution issue in the opposite
# direction (reads instead of writes).
fn read_nested_field(b: Box<Box<i64>>) -> i64 {
  b.inner.inner
}

# Write into pointee via a two-level generic projection: `r.*.inner.inner`.
# Exercises the `apply_pointee_write` path where each `Field` step must
# substitute the outer args to find the sub-field's concrete type.
fn write_nested_pointee(r: &out Box<Box<i64>>, x: i64) {
  r.*.inner.inner = x;
}

# Partial-move of a generic struct where the still-Init field's type
# is a substituted `Param(T)`. Drop-elab must plan `drop p.b` at
# return: `T := DropCell` is Drop, but the raw field type is `T` and
# without substitution `class_of(Param(T))` sees empty markers under
# an empty scope and silently skips the drop. This then trips
# `INIT-ReturnValueLeak`.
struct DropCell: Drop + Move { v: i64 }
struct<T: Drop + Move> DropPair: Drop + Move { a: T, b: T }

fn partial_move_generic_drop() -> DropCell {
  let p = DropPair { a: DropCell { v: 1 }, b: DropCell { v: 2 } };
  p.a
}

# ---------- Generic fn call: T inferred from argument ----------

# Each call site to `identity` freshens `T` into a new inference var,
# then unifies with the argument type. Two calls with different
# concrete args each pick their own T without interference.
fn<T: Copy + Drop> identity(x: T) -> T {
  x
}

fn call_generic_fn() -> i64 {
  identity(42.2f64);
  identity(42)
}

# ---------- Generic fn call: T inferred from return context ----------

# Here the argument is another polymorphic call whose T floats until
# the return-type annotation pins the outer call to `i64`.
fn call_generic_fn_via_ret() -> i64 {
  identity(identity(7))
}

# ---------- Explicit generic-fn call syntax `foo<T>(x)` ----------

# The user supplies the type argument directly instead of relying on
# HM inference. Parses via tree-sitter's LR/GLR machinery — sibling
# rules `call_expr`, `instantiation_expr`, and the reduce path into
# `_expr_prefix` overlap on the `<` after an identifier, and the
# tree-sitter-typescript-style conflict declaration forces the parser
# to try all three and pick the one that fully consumes the input.
fn call_generic_explicit() -> i64 {
  identity<i64>(42)
}

# Nested explicit generic calls — each `<i64>` disambiguates cleanly
# without ambiguity against a comparison chain.
fn call_generic_explicit_nested() -> i64 {
  identity<i64>(identity<i64>(7))
}

# Explicit args and inference coexist in the same body — mixing does
# not confuse the parser.
fn call_generic_explicit_mixed() -> i64 {
  identity(identity<i64>(3))
}

# Explicit args are checked rather than merely copied into MIR.
# covers: direct generic call with an explicit concrete type argument
fn call_generic_explicit_float() -> f64 {
  identity<f64>(42.0f64)
}

# covers: explicit nested custom type argument
fn call_generic_explicit_nested_type(x: Box<i64>) -> Box<i64> {
  identity<Box<i64>>(x)
}

# A type parameter may be inferred solely from the expected return type.
extern fn<T: Copy + Drop> make_default() -> T;
# covers: direct generic call inferred solely from return context
fn infer_generic_from_return_only() -> i64 {
  make_default()
}

# A generic function used as a first-class value is instantiated from the
# receiving function type, independently of direct-call resolution.
fn call_i64(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
# covers: generic function value instantiated by a higher-order parameter
fn generic_function_value() -> i64 {
  call_i64(identity, 9)
}

# covers: generic function value inferred after storage in a local
fn delayed_generic_function_value(x: i64) -> i64 {
  let f = identity;
  f(x)
}

# Bounds are checked both after inference and against a caller's own bounds.
fn<T: Copy + Drop> requires_copy(x: T) -> T { x }
# covers: inferred concrete type argument satisfies marker bounds
fn inferred_concrete_bound() -> i64 { requires_copy(5) }
# covers: inferred caller type parameter satisfies bounds through its scope
fn<T: Copy + Drop> inferred_param_bound(x: T) -> T { requires_copy(x) }

# covers: free generic call inherits an impl header's type-parameter bounds
impl<T: Copy + Drop> Box<T> {
  fn identity_from_impl(recv: &Self, x: T) -> T { identity(x) }
}

# Explicit lifetime arguments survive HLL lowering into the MIR function
# constant instead of being discarded.
fn<'a> borrow_identity(x: &'a i64) -> &'a i64 { x }
# covers: explicit lifetime argument on a direct call
fn<'a> call_explicit_lifetime(x: &'a i64) -> &'a i64 {
  borrow_identity<'a>(x)
}

fn<'a, T: Copy + Drop> borrow_generic_identity(x: &'a T) -> &'a T { x }
# covers: explicit lifetime argument combined with inferred type argument
fn<'a> call_explicit_lifetime_inferred_type(x: &'a i64) -> &'a i64 {
  borrow_generic_identity<'a>(x)
}
# covers: inferred lifetime argument combined with explicit type argument
fn<'a> call_inferred_lifetime_explicit_type(x: &'a i64) -> &'a i64 {
  borrow_generic_identity<i64>(x)
}

struct<'view> BorrowedI64: Copy + Drop { value: &'view i64 }
fn<'callee> make_borrowed_i64(value: &'callee i64) -> BorrowedI64<'callee> {
  BorrowedI64 { value: value }
}
# covers: lifetime substitution inside a nominal result is independent of binder spelling
fn<'caller> forward_borrowed_i64(value: &'caller i64) -> BorrowedI64<'caller> {
  make_borrowed_i64<'caller>(value)
}
# covers: an omitted call lifetime is inferred through a nominal argument and result
fn<'caller> infer_borrowed_i64(value: &'caller i64) -> BorrowedI64<'caller> {
  make_borrowed_i64(value)
}
# covers: an omitted call lifetime can be inferred solely from a nominal result
extern fn<'callee> make_borrowed_i64_default() -> BorrowedI64<'callee>;
fn<'caller> infer_borrowed_i64_from_result() -> BorrowedI64<'caller> {
  make_borrowed_i64_default()
}
# covers: free-function receiver syntax preserves an inferred nominal result lifetime
fn<'caller> infer_borrowed_i64_receiver(value: &'caller i64) -> BorrowedI64<'caller> {
  value.make_borrowed_i64()
}

# Explicit arguments also resolve a parameter absent from the signature.
fn<T: Copy + Drop> generic_side_effect() { unit }
# covers: explicit type argument absent from all parameter and return types
fn explicit_unmentioned_type_param() { generic_side_effect<i64>(); }

# covers: explicit generic call lowered from a deferred expression
fn deferred_generic_call() {
  defer generic_side_effect<i64>();
}

fn<'a> lifetime_side_effect() { unit }
# covers: reserved static lifetime explicitly instantiates an unmentioned parameter
fn explicit_static_lifetime() { lifetime_side_effect<'static>(); }

unsafe fn<T: Copy + Drop> unsafe_identity(x: T) -> T { x }
# covers: generic unsafe call inside an unsafe block
fn call_generic_unsafe() -> i64 { unsafe { unsafe_identity<i64>(11) } }

# ---------- Unsafe block and raw pointer dereference ----------
fn test_unsafe_deref(ptr: *i64) -> i64 {
  unsafe { ptr.* }
}

# covers: zero-sized phantom struct carrying a lifetime and type parameter
struct<'a, T> PhantomData: Copy + Drop {}
struct<'a, T> SpanView: Copy + Drop { ptr: *T, len: u64, marker: PhantomData<'a, T> }

fn<'a, T> make_empty_span(p: *T) -> SpanView<'a, T> {
  SpanView { ptr: p, len: 0u64, marker: PhantomData {} }
}

fn<'a> use_empty_span(x: &'a i64) -> SpanView<'a, i64> {
  make_empty_span<'a, i64>(x as *i64)
}
