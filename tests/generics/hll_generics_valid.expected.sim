      $return.*.ptr = copy self.*.ptr;
      $return.*.len = copy self.*.len;
      unborrow $return;
      require_uninit $return;
      drop self;
      require_uninit self;
      return
  }
  fn pair_with<'s0, 's1, U: Copy + Drop>(self: &'s0 Buffer<T>, other: U, $return: &'s1 out Pair<T, U>) {
    entry:
