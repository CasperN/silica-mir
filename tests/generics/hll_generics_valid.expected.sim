}

fn<'s0> option_extract_match(o: Option<i64>, $return: &out 's0 i64) {
  _: unit;
  x: i64;
  entry:
    switchEnum(o) [None: switch_None_0, Some: switch_Some_1]
  switch_None_0:
    _ = copy o as None;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_Some_1:
    x = copy o as Some;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    drop o;
    require_uninit o;
    return
}

enum MoveList: Move {
  EmptyM: unit
  ConsM: i64
}

fn<'s0> move_only_owned_match(ml: MoveList, $return: &out 's0 i64) {
  u: unit;
  $tmp_0: &out i64;
  x: i64;
  entry:
    switchEnum(ml) [EmptyM: switch_EmptyM_0, ConsM: switch_ConsM_1]
  switch_EmptyM_0:
    u = move ml as EmptyM;
    $tmp_0 = &out $return.*;
    call u_to_zero(move u, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit u;
    goto switch_merge_2
  switch_ConsM_1:
    x = move ml as ConsM;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    require_uninit ml;
    return
}

fn<'s0> u_to_zero(u: unit, $return: &out 's0 i64) {
  entry:
    $return.* = 0;
    unborrow $return;
    require_uninit $return;
    drop u;
    require_uninit u;
    return
}

fn<'s0, 's1> move_only_borrowed_match(ml: &'s0 MoveList, $return: &out 's1 i64) {
  _: unit;
  x: i64;
  entry:
    switchEnum(ml.*) [EmptyM: switch_EmptyM_0, ConsM: switch_ConsM_1]
  switch_EmptyM_0:
    _ = copy ml.* as EmptyM;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_ConsM_1:
    x = copy ml.* as ConsM;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    drop ml;
    require_uninit ml;
    return
}

fn<'s0> nested_container(b: Box<Option<i64>>, $return: &out 's0 i64) {
  inner: Option<i64>;
  _: unit;
  x: i64;
  entry:
    inner = move b.inner;
    switchEnum(inner) [None: switch_None_0, Some: switch_Some_1]
  switch_None_0:
    _ = copy inner as None;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_Some_1:
    x = copy inner as Some;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    drop inner;
    require_uninit inner;
    require_uninit $return;
    require_uninit b;
    return
}

