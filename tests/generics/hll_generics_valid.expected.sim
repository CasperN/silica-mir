struct Box<T: Copy + Drop>: Copy + Drop {
  inner: T
}

enum Option<T: Copy + Drop>: Copy + Drop {
  None: unit
  Some: T
}

fn make_box<'s0>($return: &'s0 out Box<i64>) {
  entry:
    $return.*.inner = 42;
    unborrow $return;
    require_uninit $return;
    return
}

fn box_extract<'s0>(b: Box<i64>, $return: &'s0 out i64) {
  entry:
    $return.* = move b.inner;
    unborrow $return;
    require_uninit $return;
    require_uninit b;
    return
}

fn make_some<'s0>($return: &'s0 out Option<i64>) {
  entry:
    $return.* = Option<i64>::Some(42);
    unborrow $return;
    require_uninit $return;
    return
}

fn option_extract_match<'s0>(o: Option<i64>, $return: &'s0 out i64) {
  _: unit;
  x: i64;
  entry:
    switchEnum(o) [None: switch_None_0, Some: switch_Some_1]
  switch_None_0:
    _ = copy o as None;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_Some_1:
    x = copy o as Some;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    drop o;
    require_uninit o;
    return
}

enum MoveList: Move {
  EmptyM: unit
  ConsM: i64
}

fn move_only_owned_match<'s0>(ml: MoveList, $return: &'s0 out i64) {
  u: unit;
  $tmp_0: &out i64;
  x: i64;
  entry:
    switchEnum(ml) [EmptyM: switch_EmptyM_0, ConsM: switch_ConsM_1]
  switch_EmptyM_0:
    u = move ml as EmptyM;
    $tmp_0 = &out $return.*;
    call u_to_zero(move u, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit u;
    goto switch_merge_2
  switch_ConsM_1:
    x = move ml as ConsM;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    require_uninit ml;
    return
}

fn u_to_zero<'s0>(u: unit, $return: &'s0 out i64) {
  entry:
    $return.* = 0;
    unborrow $return;
    require_uninit $return;
    drop u;
    require_uninit u;
    return
}

fn move_only_borrowed_match<'s0, 's1>(ml: &'s0 MoveList, $return: &'s1 out i64) {
  _: unit;
  x: i64;
  entry:
    switchEnum(ml.*) [EmptyM: switch_EmptyM_0, ConsM: switch_ConsM_1]
  switch_EmptyM_0:
    _ = copy ml.* as EmptyM;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_ConsM_1:
    x = copy ml.* as ConsM;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    drop ml;
    require_uninit ml;
    return
}

fn nested_container<'s0>(b: Box<Option<i64>>, $return: &'s0 out i64) {
  inner: Option<i64>;
  _: unit;
  x: i64;
  entry:
    inner = move b.inner;
    switchEnum(inner) [None: switch_None_0, Some: switch_Some_1]
  switch_None_0:
    _ = copy inner as None;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_2
  switch_Some_1:
    x = copy inner as Some;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_2
  switch_merge_2:
    drop inner;
    require_uninit inner;
    require_uninit $return;
    require_uninit b;
    return
}

