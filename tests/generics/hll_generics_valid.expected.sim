struct Counter<T: Copy + Drop>: Copy + Drop {
  count: T
}

impl<T: Copy + Drop> Counter<T> {
  fn get_val<'s0, 's1>(self: &'s0 Counter<T>, $return: &'s1 out T) {
    entry:
      $return.* = copy self.*.count;
      unborrow $return;
