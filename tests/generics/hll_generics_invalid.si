# HLL generics: type-annotation and use-site validation errors.
#
# Every fn below places an ill-formed type in an annotation position
# (param, return, `let` binding) or an ill-formed use of a generic
# decl. The HLL type checker rejects each at its source span rather
# than letting it surface later in lowering or the MIR pipeline. All
# errors accumulate — one .si file surfaces every cell's diagnostic.
#
#   fn                          diagnostic                     trigger
#   undeclared_type_param       HTC-UndeclaredType             `T` used with no `T` in scope
#   undeclared_custom_type      HTC-UndeclaredType             reference to an unknown decl
#   arity_too_many_args         HTC-TypeArgArityMismatch       `Box<i64, i64>` on 1-param decl
#   arity_too_few_args          HTC-TypeArgArityMismatch       `Box` on generic decl (needs arg)
#   bound_not_satisfied_copy    HTC-BoundNotSatisfied          `Box<Linear>` where T: Copy
#   bound_not_satisfied_drop    HTC-BoundNotSatisfied          `Sink<Linear>` where T: Drop
#   nested_bound_violation      HTC-BoundNotSatisfied          `Box<Box<Linear>>` inner fails
#   return_type_bad_arity       HTC-TypeArgArityMismatch       return type has wrong arity
#   let_annotation_bad_arity    HTC-TypeArgArityMismatch       `let x: Box<i64, i64> = ...`
#   call_*                      call-site generic validation failures

struct Box<T: Copy + Drop>: Copy + Drop { inner: T }

struct Sink<T: Drop>: Drop { inner: T }

# Linear: not Copy, not Drop.
struct Linear { r: &out i64 }
struct DropOnly: Drop { value: i64 }

# ---------- Undeclared type-param reference ----------

fn undeclared_type_param(x: T) -> i64 {
  0
}

# ---------- Undeclared custom type ----------

fn undeclared_custom_type(x: Nope) -> i64 {
  0
}

# ---------- Arity: too many type args ----------

fn arity_too_many_args(x: Box<i64, i64>) -> i64 {
  0
}

# ---------- Arity: too few (missing args on generic decl) ----------

fn arity_too_few_args(x: Box) -> i64 {
  0
}

# ---------- Bound not satisfied: T requires Copy ----------

fn bound_not_satisfied_copy(x: Box<Linear>) -> i64 {
  0
}

# ---------- Bound not satisfied: T requires Drop ----------

fn bound_not_satisfied_drop(x: Sink<Linear>) -> i64 {
  0
}

# ---------- Nested: outer OK but inner arg fails its bound ----------

fn nested_bound_violation(x: Box<Box<Linear>>) -> i64 {
  0
}

# ---------- Return type: arity mismatch ----------

fn return_type_bad_arity() -> Box<i64, i64> {
  Box { inner: 0 }
}

# ---------- Let annotation: arity mismatch ----------

fn let_annotation_bad_arity() {
  let x: Box<i64, i64> = Box { inner: 0 };
}

# ---------- Generic function calls ----------

fn requires_copy<T: Copy + Drop>(x: T) -> T { x }
fn first<T, U>(x: T, y: U) -> T { x }
fn identity<T>(x: T) -> T { x }
fn generic_side_effect<T>() { unit }
fn borrow_identity<'a>(x: &'a i64) -> &'a i64 { x }
fn choose_first<'a, 'b>(x: &'a i64, y: &'b i64) -> &'a i64 { x }

# covers: too few explicit type arguments on a direct call
fn call_type_args_too_few() -> i64 { first<i64>(1, true) }
# covers: too many explicit type arguments on a direct call
fn call_type_args_too_many() -> i64 { identity<i64, bool>(1) }
# covers: explicit type argument conflicts with value and return context
fn call_explicit_type_mismatch() -> i64 { identity<bool>(1) }

# covers: inferred type argument fails a marker bound
fn call_inferred_bound_failure(x: DropOnly) -> DropOnly { requires_copy(x) }
# covers: explicit type argument fails a marker bound
fn call_explicit_bound_failure(x: DropOnly) -> DropOnly { requires_copy<DropOnly>(x) }

# covers: inferred type parameter absent from the function signature
fn call_unresolved_type_argument() { generic_side_effect(); }

# covers: explicit generic arguments applied to a function-valued parameter
fn call_generic_args_on_value(f: fn(i64) -> i64) -> i64 { f<i64>(1) }
# covers: local function value shadows a global generic function name
fn call_generic_args_on_shadow(identity: fn(i64) -> i64) -> i64 { identity<i64>(1) }

# covers: too few explicit lifetime arguments on a direct call
fn call_lifetime_args_too_few<'a>(x: &'a i64) -> &'a i64 {
  choose_first<'a>(x, x)
}
# covers: too many explicit lifetime arguments on a direct call
fn call_lifetime_args_too_many<'a>(x: &'a i64) -> &'a i64 {
  borrow_identity<'a, 'a>(x)
}
# covers: explicit call lifetime is not in the caller's generic scope
fn call_undeclared_lifetime<'a>(x: &'a i64) -> &'a i64 {
  borrow_identity<'missing>(x)
}

struct RefWrap<'a>: Copy + Drop { p: &'a i64 }

# covers: a bare nominal reference omits a required lifetime argument
fn nominal_lifetime_args_too_few(r: RefWrap) -> unit { unit }
# covers: a nominal reference supplies too many lifetime arguments
fn nominal_lifetime_args_too_many<'a>(r: RefWrap<'a, 'a>) -> unit { unit }

# covers: inferred generic call inside an impl uses impl-header bounds
impl DropOnly {
  fn call_inferred_bound_failure_from_impl(recv: &Self, x: DropOnly) -> DropOnly {
    requires_copy(x)
  }
}

unsafe fn unsafe_identity<T>(x: T) -> T { x }
# covers: generic unsafe call still requires an unsafe context
fn call_generic_unsafe_without_block() -> i64 { unsafe_identity<i64>(1) }

# covers: method-level generic type parameter bound violation
struct MethodBuffer<T: Copy + Drop>: Copy + Drop { ptr: *T }
impl<T: Copy + Drop> MethodBuffer<T> {
  fn take_copy<U: Copy + Drop>(self: &Self, item: U) -> unit { unit }
}

fn call_method_bound_not_satisfied(buf: &MethodBuffer<i64>, lin: Linear) -> unit {
  buf.take_copy(lin)
}

# covers: self receiver sugar in free function declaration
fn free_fn_with_self_sugar(&self) -> unit { unit }
fn free_fn_with_out_self(&out self) -> unit { unit }
fn free_fn_with_drop_self(&drop self) -> unit { unit }
fn free_fn_with_named_drop_self<'a>(&'a drop self) -> unit { unit }



