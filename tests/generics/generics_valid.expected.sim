struct<T: Copy + Drop> Box: Copy + Drop {
  inner: T
}

struct<T: Copy + Drop, U: Move> Pair {
  first: T
  second: U
}

enum<T: Copy + Drop> Option: Copy + Drop {
  None: unit
  Some: T
}

struct<T: Copy + Drop> Nest: Copy + Drop {
  outer: Box<Box<T>>
}

struct<T: Copy + Drop> LL: Copy + Drop {
  head: T
  tail: *LL<T>
}

struct Container: Copy + Drop {
  b: Box<i32>
}

struct<T: Copy + Drop> Arr3: Copy + Drop {
  xs: [T; 3]
}

struct<T: Move> Bag: Move {
  inner: T
}

struct<T: Move, U: Move> MovePair: Move {
  first: T
  second: U
}

struct<T: Copy + Drop, U: Copy + Drop> CopyPair: Copy + Drop {
  first: T
  second: U
}

struct<T: Copy> BoxC: Copy {
  inner: T
}

struct<T: Drop> BoxD: Drop {
  inner: T
}

struct<T: Move> BoxM: Move {
  inner: T
}

struct<T: Copy + Drop> BoxCD: Copy + Drop {
  inner: T
}

struct<T: Copy + Drop> BoxCD_Move: Move {
  inner: T
}

struct MatC: Copy {
  x: i64
}

struct MatD: Drop {
  x: i64
}

struct MatM: Move {
  x: i64
}

struct MatCD: Copy + Drop {
  x: i64
}

struct MatCM: Copy + Move {
  x: i64
}

struct MatDM: Drop + Move {
  x: i64
}

struct UseBoxC_MatC {
  b: BoxC<MatC>
}

struct UseBoxC_MatCD {
  b: BoxC<MatCD>
}

struct UseBoxC_MatCM {
  b: BoxC<MatCM>
}

struct UseBoxD_MatD {
  b: BoxD<MatD>
}

struct UseBoxD_MatCD {
  b: BoxD<MatCD>
}

struct UseBoxD_MatDM {
  b: BoxD<MatDM>
}

struct UseBoxM_MatM {
  b: BoxM<MatM>
}

struct UseBoxM_MatCM {
  b: BoxM<MatCM>
}

struct UseBoxM_MatDM {
  b: BoxM<MatDM>
}

struct UseBoxM_MatCD {
  b: BoxM<MatCD>
}

struct UseBoxM_BoxCD_i64 {
  b: BoxM<BoxCD<i64>>
}

struct<T: Copy + Drop> OuterBox: Copy + Drop {
  inner: BoxCD<T>
}

struct TripleBox: Copy + Drop {
  inner: OuterBox<BoxCD<i64>>
}

struct UseOuter_i64 {
  b: OuterBox<i64>
}

fn<'s0> copy_boxcd(src: BoxCD<i64>, dest: &out 's0 BoxCD<i64>) {
  entry:
    dest.* = copy src;
    unborrow dest;
    drop src;
    return
}

fn<'s0> copy_field_boxcd(b: BoxCD<i64>, dest: &out 's0 i64) {
  entry:
    dest.* = copy b.inner;
    unborrow dest;
    drop b;
    return
}

fn<'s0> move_boxcd_move(src: BoxCD_Move<i64>, dest: &out 's0 BoxCD_Move<i64>) {
  entry:
    dest.* = move src;
    unborrow dest;
    return
}

fn<'s0> move_boxm_i64(src: BoxM<i64>, dest: &out 's0 BoxM<i64>) {
  entry:
    dest.* = move src;
    unborrow dest;
    return
}

struct NestedBoxCD: Copy + Drop {
  inner: BoxCD<BoxCD<i64>>
}

fn<'s0, T> take_ref(r: &'s0 T) {
  entry:
    drop r;
    return
}

fn<T> touch() {
  entry:
    return
}

fn caller() {
  b: Box<i32>;
  entry:
    call touch<i32>();
    return
}

fn<T: Copy + Drop> take_by_value(x: T) {
  entry:
    drop x;
    return
}

fn<T: Copy + Drop> access_field(b: Box<T>) {
  x: T;
  entry:
    x = copy b.inner;
    drop x;
    drop b;
    return
}

fn<T: Copy + Drop> switch_on_generic_enum(o: Option<T>) {
  y: T;
  entry:
    switchEnum(o) [None: none_arm, Some: some_arm]
  none_arm:
    drop o;
    return
  some_arm:
    y = copy o as Some;
    drop y;
    drop o;
    return
}

fn<'s0, T: Copy + Drop> read_through_shared_ref(r: &'s0 T) {
  x: T;
  entry:
    x = copy r.*;
    drop x;
    drop r;
    return
}

fn<'s0, T: Copy + Drop> mut_ref_param(m: &mut 's0 T) {
  entry:
    drop m;
    return
}

fn<'s0, T: Copy + Drop> out_ref_param(src: T, dest: &out 's0 T) {
  entry:
    dest.* = copy src;
    unborrow dest;
    drop src;
    return
}

fn<'s0, T: Copy + Drop> uninit_ref_param(u: &uninit 's0 T) {
  entry:
    drop u;
    return
}

fn<T: Copy + Drop> fn_type_with_param(f: fn(T)) {
  entry:
    drop f;
    return
}

fn<T: Copy + Drop> option_of_box(x: Option<Box<T>>) {
  entry:
    drop x;
    return
}

fn<'s0, 's1, T: Move> ref_to_bag_of_mut_ref(b: &'s0 Bag<&mut 's1 T>) {
  entry:
    drop b;
    return
}

fn<'s0: 's1 + 's2, 's1, 's2, T: Move, U: Move> mut_ref_to_pair_of_refs(p: &mut 's0 MovePair<&drop 's1 T, &out 's2 U>) {
  entry:
    drop p;
    return
}

fn<'s0, T: Copy + Drop> unwrap_or(o: Option<T>, default: T, dest: &out 's0 T) {
  entry:
    switchEnum(o) [None: use_default, Some: use_some]
  use_default:
    drop o;
    dest.* = move default;
    unborrow dest;
    return
  use_some:
    dest.* = copy o as Some;
    unborrow dest;
    drop o;
    drop default;
    return
}

fn<'s0, 's1, T: Move> swap(a: &mut 's0 T, b: &mut 's1 T) {
  tmp: T;
  entry:
    tmp = move a.*;
    a.* = move b.*;
    b.* = move tmp;
    drop b;
    drop a;
    return
}

fn<'s0, 's1, T: Copy + Drop> replicate(x: T, out_a: &out 's0 T, out_b: &out 's1 T) {
  entry:
    out_a.* = copy x;
    unborrow out_a;
    out_b.* = copy x;
    unborrow out_b;
    drop x;
    return
}

fn<'s0, 's1, 's2, T: Copy + Drop, U: Copy + Drop> pair_copy_out(p: &'s0 CopyPair<T, U>, out_first: &out 's1 T, out_second: &out 's2 U) {
  entry:
    out_first.* = copy p.*.first;
    unborrow out_first;
    out_second.* = copy p.*.second;
    unborrow out_second;
    drop p;
    return
}

fn<'s0, T: Copy + Drop> pick_by_flag(flag: bool, a: T, b: T, dest: &out 's0 T) {
  entry:
    branch(copy flag) [true: pick_a, false: pick_b]
  pick_a:
    dest.* = copy a;
    unborrow dest;
    drop a;
    drop b;
    drop flag;
    return
  pick_b:
    dest.* = copy b;
    unborrow dest;
    drop a;
    drop b;
    drop flag;
    return
}

fn<'s0, T: Copy + Drop> unbox(b: Box<T>, dest: &out 's0 T) {
  entry:
    dest.* = copy b.inner;
    unborrow dest;
    drop b;
    return
}

fn<'a, T: Copy + Drop> observe_generic(x: &'a T) {
  entry:
    drop x;
    return
}

fn<'a> call_observe_generic(x: &'a i64) {
  entry:
    call observe_generic<'a, i64>(copy x);
    drop x;
    return
}
