struct Box<T: Copy + Drop>: Copy + Drop {
  inner: T
}

struct Pair<T: Copy + Drop, U: Move> {
  first: T
  second: U
}

enum Option<T: Copy + Drop>: Copy + Drop {
  None: $Tuple0
  Some: T
}

struct Nest<T: Copy + Drop>: Copy + Drop {
  outer: Box<Box<T>>
}

struct LL<T: Copy + Drop>: Copy + Drop {
  head: T
  tail: *LL<T>
}

struct Container: Copy + Drop {
  b: Box<i32>
}

struct Arr3<T: Copy + Drop>: Copy + Drop {
  xs: [T; 3]
}

struct Bag<T: Move>: Move {
  inner: T
}

struct MovePair<T: Move, U: Move>: Move {
  first: T
  second: U
}

struct CopyPair<T: Copy + Drop, U: Copy + Drop>: Copy + Drop {
  first: T
  second: U
}

struct BoxC<T: Copy>: Copy {
  inner: T
}

struct BoxD<T: Drop>: Drop {
  inner: T
}

struct BoxM<T: Move>: Move {
  inner: T
}

struct BoxCD<T: Copy + Drop>: Copy + Drop {
  inner: T
}

struct BoxCD_Move<T: Copy + Drop>: Move {
  inner: T
}

struct MatC: Copy {
  x: i64
}

struct MatD: Drop {
  x: i64
}

struct MatM: Move {
  x: i64
}

struct MatCD: Copy + Drop {
  x: i64
}

struct MatCM: Copy + Move {
  x: i64
}

struct MatDM: Drop + Move {
  x: i64
}

struct UseBoxC_MatC {
  b: BoxC<MatC>
}

struct UseBoxC_MatCD {
  b: BoxC<MatCD>
}

struct UseBoxC_MatCM {
  b: BoxC<MatCM>
}

struct UseBoxD_MatD {
  b: BoxD<MatD>
}

struct UseBoxD_MatCD {
  b: BoxD<MatCD>
}

struct UseBoxD_MatDM {
  b: BoxD<MatDM>
}

struct UseBoxM_MatM {
  b: BoxM<MatM>
}

struct UseBoxM_MatCM {
  b: BoxM<MatCM>
}

struct UseBoxM_MatDM {
  b: BoxM<MatDM>
}

struct UseBoxM_MatCD {
  b: BoxM<MatCD>
}

struct UseBoxM_BoxCD_i64 {
  b: BoxM<BoxCD<i64>>
}

struct OuterBox<T: Copy + Drop>: Copy + Drop {
  inner: BoxCD<T>
}

struct TripleBox: Copy + Drop {
  inner: OuterBox<BoxCD<i64>>
}

struct UseOuter_i64 {
  b: OuterBox<i64>
}

fn copy_boxcd<'s0>(src: BoxCD<i64>, dest: &'s0 out BoxCD<i64>) {
  entry:
    dest.* = copy src;
    unborrow dest;
    drop src;
    return
}

fn copy_field_boxcd<'s0>(b: BoxCD<i64>, dest: &'s0 out i64) {
  entry:
    dest.* = copy b.inner;
    unborrow dest;
    drop b;
    return
}

fn move_boxcd_move<'s0>(src: BoxCD_Move<i64>, dest: &'s0 out BoxCD_Move<i64>) {
  entry:
    dest.* = move src;
    unborrow dest;
    return
}

fn move_boxm_i64<'s0>(src: BoxM<i64>, dest: &'s0 out BoxM<i64>) {
  entry:
    dest.* = move src;
    unborrow dest;
    return
}

struct NestedBoxCD: Copy + Drop {
  inner: BoxCD<BoxCD<i64>>
}

fn take_ref<'s0, T>(r: &'s0 T) {
  entry:
    drop r;
    return
}

fn touch<T>() {
  entry:
    return
}

fn caller() {
  b: Box<i32>;
  entry:
    call touch<i32>();
    return
}

fn take_by_value<T: Copy + Drop>(x: T) {
  entry:
    drop x;
    return
}

fn access_field<T: Copy + Drop>(b: Box<T>) {
  x: T;
  entry:
    x = copy b.inner;
    drop x;
    drop b;
    return
}

fn switch_on_generic_enum<T: Copy + Drop>(o: Option<T>) {
  y: T;
  entry:
    switchEnum(o) [None: none_arm, Some: some_arm]
  none_arm:
    drop o;
    return
  some_arm:
    y = copy o as Some;
    drop y;
    drop o;
    return
}

fn read_through_shared_ref<'s0, T: Copy + Drop>(r: &'s0 T) {
  x: T;
  entry:
    x = copy r.*;
    drop x;
    drop r;
    return
}

fn mut_ref_param<'s0, T: Copy + Drop>(m: &'s0 mut T) {
  entry:
    drop m;
    return
}

fn out_ref_param<'s0, T: Copy + Drop>(src: T, dest: &'s0 out T) {
  entry:
    dest.* = copy src;
    unborrow dest;
    drop src;
    return
}

fn uninit_ref_param<'s0, T: Copy + Drop>(u: &'s0 uninit T) {
  entry:
    drop u;
    return
}

fn fn_type_with_param<T: Copy + Drop>(f: fn(T)) {
  entry:
    drop f;
    return
}

fn option_of_box<T: Copy + Drop>(x: Option<Box<T>>) {
  entry:
    drop x;
    return
}

fn ref_to_bag_of_mut_ref<'s0, 's1, T: Move>(b: &'s0 Bag<&'s1 mut T>) {
  entry:
    drop b;
    return
}

fn mut_ref_to_pair_of_refs<'s0: 's1 + 's2, 's1, 's2, T: Move, U: Move>(p: &'s0 mut MovePair<&'s1 drop T, &'s2 out U>) {
  entry:
    drop p;
    return
}

fn unwrap_or<'s0, T: Copy + Drop>(o: Option<T>, default: T, dest: &'s0 out T) {
  entry:
    switchEnum(o) [None: use_default, Some: use_some]
  use_default:
    drop o;
    dest.* = move default;
    unborrow dest;
    return
  use_some:
    dest.* = copy o as Some;
    unborrow dest;
    drop o;
    drop default;
    return
}

fn swap<'s0, 's1, T: Move>(a: &'s0 mut T, b: &'s1 mut T) {
  tmp: T;
  entry:
    tmp = move a.*;
    a.* = move b.*;
    b.* = move tmp;
    drop b;
    drop a;
    return
}

fn replicate<'s0, 's1, T: Copy + Drop>(x: T, out_a: &'s0 out T, out_b: &'s1 out T) {
  entry:
    out_a.* = copy x;
    unborrow out_a;
    out_b.* = copy x;
    unborrow out_b;
    drop x;
    return
}

fn pair_copy_out<'s0, 's1, 's2, T: Copy + Drop, U: Copy + Drop>(p: &'s0 CopyPair<T, U>, out_first: &'s1 out T, out_second: &'s2 out U) {
  entry:
    out_first.* = copy p.*.first;
    unborrow out_first;
    out_second.* = copy p.*.second;
    unborrow out_second;
    drop p;
    return
}

fn pick_by_flag<'s0, T: Copy + Drop>(flag: bool, a: T, b: T, dest: &'s0 out T) {
  entry:
    branch(copy flag) [true: pick_a, false: pick_b]
  pick_a:
    dest.* = copy a;
    unborrow dest;
    drop a;
    drop b;
    drop flag;
    return
  pick_b:
    dest.* = copy b;
    unborrow dest;
    drop a;
    drop b;
    drop flag;
    return
}

fn unbox<'s0, T: Copy + Drop>(b: Box<T>, dest: &'s0 out T) {
  entry:
    dest.* = copy b.inner;
    unborrow dest;
    drop b;
    return
}

fn observe_generic<'a, T: Copy + Drop>(x: &'a T) {
  entry:
    drop x;
    return
}

fn call_observe_generic<'a>(x: &'a i64) {
  entry:
    call observe_generic<'a, i64>(copy x);
    drop x;
    return
}
