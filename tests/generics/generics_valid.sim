# Generic declarations and instantiations accepted by all pipeline passes.
#
# The composition checker, type checker, NLL, drop elaboration, and
# pretty-printer all walk `TypeKind::Param` nodes; a regression in any of
# them would turn this fixture into an Errors fixture. Each cell below
# isolates one aspect of generic handling so the failing cell identifies
# the regression.
#
#   item                        covers
#   Box struct                  single Copy+Drop param; decl-side composition
#   Pair struct                 two params with independent bounds
#   Option enum                 generic enum; decl-side composition
#   Nest struct                 nested type-arg reference Box<Box<T>>
#   LL struct                   recursive-through-raw-pointer; by-value cycle check
#   Container struct            concrete instantiation; use-site bound check (empty scope)
#   Arr3 struct                 array element of Param
#   Bag / MovePair structs      Move-only params; ref kinds nested in generics
#   take_ref / touch / caller   generic fn decl; explicit type-arg call syntax
#   take_by_value               drop elaboration inserts `drop x` for T: Copy+Drop param
#   access_field                field projection on owned generic struct; type_of_place
#   switch_on_generic_enum      switchEnum + downcast on generic enum
#   read_through_shared_ref     deref through &T yields T
#   mut_ref_param               &mut T trivial body (unborrow only)
#   out_ref_param               &out T obligation: body must initialise pointee
#   uninit_ref_param            &uninit T trivial body
#   fn_type_with_param          fn(T) as parameter type
#   option_of_box               two-level nesting: Option<Box<T>>
#   ref_to_bag_of_mut_ref       Move ref nested in generic instantiation, passed by &
#   mut_ref_to_pair_of_refs     &mut to multi-param generic with ref-typed args
#   unwrap_or                   switchEnum with per-arm resource accounting
#   swap                        three-step move choreography via two &mut refs
#   replicate                   broadcast Copy source into two &out sinks
#   pair_copy_out               shared-ref field projection into two &out sinks
#   pick_by_flag                branch on bool; symmetric Copy+Drop cleanup
#   unbox                       field copy from owned generic struct + whole-value drop

# ── Shared type declarations ─────────────────────────────────────────

struct Box<T: Copy + Drop>: Copy + Drop { inner: T }

struct Pair<T: Copy + Drop, U: Move> { first: T  second: U }

enum Option<T: Copy + Drop>: Copy + Drop { None: unit  Some: T }

struct Nest<T: Copy + Drop>: Copy + Drop { outer: Box<Box<T>> }

struct LL<T: Copy + Drop>: Copy + Drop { head: T  tail: *LL<T> }

struct Container: Copy + Drop { b: Box<i32> }

struct Arr3<T: Copy + Drop>: Copy + Drop { xs: [T; 3] }

struct Bag<T: Move>: Move { inner: T }

struct MovePair<T: Move, U: Move>: Move { first: T  second: U }

struct CopyPair<T: Copy + Drop, U: Copy + Drop>: Copy + Drop { first: T  second: U }

# ── Generic shells for marker × param coverage ───────────────────────
# covers: type_kind=struct class=Copy op=composition bound=T:Copy
struct BoxC<T: Copy>: Copy { inner: T }
# covers: type_kind=struct class=Drop op=composition bound=T:Drop
struct BoxD<T: Drop>: Drop { inner: T }
# covers: type_kind=struct class=Move op=composition bound=T:Move
struct BoxM<T: Move>: Move { inner: T }
# covers: type_kind=struct class=Copy+Drop op=composition bound=T:Copy+Drop
struct BoxCD<T: Copy + Drop>: Copy + Drop { inner: T }
# covers: type_kind=struct class=Move op=blanket_move bound=T:Copy+Drop
struct BoxCD_Move<T: Copy + Drop>: Move { inner: T }

# ── Material types for the use-site matrix ───────────────────────────
# covers: type_kind=struct class=Copy op=use_site_bound
struct MatC: Copy { x: i64 }
# covers: type_kind=struct class=Drop op=use_site_bound
struct MatD: Drop { x: i64 }
# covers: type_kind=struct class=Move op=use_site_bound
struct MatM: Move { x: i64 }
# covers: type_kind=struct class=Copy+Drop op=use_site_bound
struct MatCD: Copy + Drop { x: i64 }
# covers: type_kind=struct class=Copy+Move op=use_site_bound
struct MatCM: Copy + Move { x: i64 }
# covers: type_kind=struct class=Drop+Move op=use_site_bound
struct MatDM: Drop + Move { x: i64 }

# ── Use-site: BoxC<X> — X must be Copy ──────────────────────────────
# covers: type_kind=struct class=Copy op=use_site_bound bound=MatC:Copy
struct UseBoxC_MatC { b: BoxC<MatC> }
struct UseBoxC_MatCD { b: BoxC<MatCD> }
struct UseBoxC_MatCM { b: BoxC<MatCM> }

# ── Use-site: BoxD<X> — X must be Drop ──────────────────────────────
# covers: type_kind=struct class=Drop op=use_site_bound bound=MatD:Drop
struct UseBoxD_MatD { b: BoxD<MatD> }
struct UseBoxD_MatCD { b: BoxD<MatCD> }
struct UseBoxD_MatDM { b: BoxD<MatDM> }

# ── Use-site: BoxM<X> — X must be Move ──────────────────────────────
# covers: type_kind=struct class=Move op=use_site_bound bound=MatM:Move
struct UseBoxM_MatM { b: BoxM<MatM> }
struct UseBoxM_MatCM { b: BoxM<MatCM> }
struct UseBoxM_MatDM { b: BoxM<MatDM> }
# covers: blanket Copy+Drop->Move at use-site
struct UseBoxM_MatCD { b: BoxM<MatCD> }
# covers: Custom(BoxCD<i64>) is Copy+Drop therefore Move at use-site
struct UseBoxM_BoxCD_i64 { b: BoxM<BoxCD<i64>> }

# ── Nested Param substitution ────────────────────────────────────────
# covers: type_kind=struct op=nested_param_subst class=Copy+Drop
struct OuterBox<T: Copy + Drop>: Copy + Drop { inner: BoxCD<T> }
struct TripleBox: Copy + Drop { inner: OuterBox<BoxCD<i64>> }
struct UseOuter_i64 { b: OuterBox<i64> }

# ── Ops on generic structs ───────────────────────────────────────────
# covers: type_kind=struct op=copy class=Copy+Drop
fn copy_boxcd(src: BoxCD<i64>, dest: &out BoxCD<i64>) {
  entry:
    dest.* = copy src;
    drop src;
    return
}

# covers: type_kind=struct op=field_copy class=Copy+Drop
fn copy_field_boxcd(b: BoxCD<i64>, dest: &out i64) {
  entry:
    dest.* = copy b.inner;
    drop b;
    return
}

# covers: type_kind=struct op=move class=Move (blanket Copy+Drop->Move)
fn move_boxcd_move(src: BoxCD_Move<i64>, dest: &out BoxCD_Move<i64>) {
  entry:
    dest.* = move src;
    return
}

# covers: type_kind=struct op=move class=Move bound=T:Move
fn move_boxm_i64(src: BoxM<i64>, dest: &out BoxM<i64>) {
  entry:
    dest.* = move src;
    return
}

# ── Nested Custom in field (two-level class_of through Custom) ────────
# covers: type_kind=struct op=nested_custom class=Copy+Drop
struct NestedBoxCD: Copy + Drop { inner: BoxCD<BoxCD<i64>> }

# ── Generic function declarations ────────────────────────────────────

# Generic fn that accepts a shared ref; exercises Param in ref position.
fn take_ref<T>(r: &T) {
  entry:
    return
}

# Generic fn with no params in the signature; exercises type-arg call syntax.
fn touch<T>() {
  entry:
    return
}

# Concrete caller: `call touch<i32>()` exercises use-site type-arg syntax.
fn caller() {
  b: Box<i32>;
  entry:
    call touch<i32>();
    return
}

# ── Drop elaboration on a T-typed param ─────────────────────────────

# T: Copy + Drop implies Drop, so elaboration inserts `drop x` before
# return. Verifies that drop elaboration handles Param nodes correctly.
fn take_by_value<T: Copy + Drop>(x: T) {
  entry:
    return
}

# ── Field projection on generic struct ──────────────────────────────

# type_of_place through b.inner returns T. Confirms Param survives the
# field-projection path in type_of_place.
fn access_field<T: Copy + Drop>(b: Box<T>) {
  x: T;
  entry:
    x = copy b.inner;
    return
}

# ── switchEnum + downcast on generic enum ───────────────────────────

# switchEnum dispatches on a Param-typed enum; `o as Some` downcasts to
# the variant's declared payload type T. Exercises generic enum arms.
fn switch_on_generic_enum<T: Copy + Drop>(o: Option<T>) {
  y: T;
  entry:
    switchEnum(o) [None: none_arm, Some: some_arm]
  none_arm:
    return
  some_arm:
    y = copy o as Some;
    return
}

# ── Shared ref to Param ──────────────────────────────────────────────

# r.* has type T. Deref through &T must yield T, not an error.
fn read_through_shared_ref<T: Copy + Drop>(r: &T) {
  x: T;
  entry:
    x = copy r.*;
    return
}

# ── Non-shared ref kinds carrying Param inner ────────────────────────

# &mut T (Init, Init): trivial — no obligation change needed.
fn mut_ref_param<T: Copy + Drop>(m: &mut T) {
  entry:
    return
}

# &out T (Uninit, Init): body must initialise the pointee.
fn out_ref_param<T: Copy + Drop>(src: T, dest: &out T) {
  entry:
    dest.* = copy src;
    return
}

# &uninit T (Uninit, Uninit): trivial.
fn uninit_ref_param<T: Copy + Drop>(u: &uninit T) {
  entry:
    return
}

# ── fn(T) as parameter type ──────────────────────────────────────────

# Fn type carrying a Param inner: validated by type checker, never called.
fn fn_type_with_param<T: Copy + Drop>(f: fn(T)) {
  entry:
    return
}

# ── Two-level nesting ────────────────────────────────────────────────

# Option<Box<T>>: Box<T> satisfies Option's T: Copy+Drop bound because
# Box is Copy+Drop when T is Copy+Drop. Each layer's bound is discharged
# independently by the composition check.
fn option_of_box<T: Copy + Drop>(x: Option<Box<T>>) {
  entry:
    return
}

# ── Ref kinds nested in generic instantiation ────────────────────────

# Bag<&mut T>: &mut T is Move, satisfying Bag's T: Move bound. Passed
# by shared ref because Bag is itself Move (linear at the value level).
fn ref_to_bag_of_mut_ref<T: Move>(b: &Bag<&mut T>) {
  entry:
    return
}

# MovePair<&drop T, &out U>: both linear ref kinds are Move, satisfying
# each param's Move bound. Every layer's bounds hold under scope-aware
# validation.
fn mut_ref_to_pair_of_refs<T: Move, U: Move>(p: &mut MovePair<&drop T, &out U>) {
  entry:
    return
}

# ── Multi-block workflows ────────────────────────────────────────────

# switchEnum with per-arm accounting: None arm moves default into dest;
# Some arm copies payload then drops the remaining values.
fn unwrap_or<T: Copy + Drop>(o: Option<T>, default: T, dest: &out T) {
  entry:
    switchEnum(o) [None: use_default, Some: use_some]
  use_default:
    drop o;
    dest.* = move default;
    return
  use_some:
    dest.* = copy o as Some;
    drop o;
    drop default;
    return
}

# Three-step move choreography via two &mut refs. T: Move only — no Copy
# or Drop. Every intermediate state has one pointee Uninit and one Init;
# the sequence leaves both Init.
fn swap<T: Move>(a: &mut T, b: &mut T) {
  tmp: T;
  entry:
    tmp = move a.*;
    a.* = move b.*;
    b.* = move tmp;
    return
}

# Broadcast a Copy source into two &out sinks. Both sink obligations
# transition Uninit -> Init from the same operand read.
fn replicate<T: Copy + Drop>(x: T, out_a: &out T, out_b: &out T) {
  entry:
    out_a.* = copy x;
    out_b.* = copy x;
    return
}

# Pair projection through a shared ref: reads both fields via deref,
# copies them into distinct &out slots of matching type. p is never
# consumed; NLL inserts an `unborrow p` after the last field read.
fn pair_copy_out<T: Copy + Drop, U: Copy + Drop>(
  p: &CopyPair<T, U>,
  out_first: &out T,
  out_second: &out U,
) {
  entry:
    out_first.* = copy p.*.first;
    out_second.* = copy p.*.second;
    return
}

# Branch on a bool operand and choose between two Copy+Drop candidates.
# Each arm clears the unused candidate with `drop`, so the net effect is
# one write to dest plus symmetric cleanup on both branches.
fn pick_by_flag<T: Copy + Drop>(flag: bool, a: T, b: T, dest: &out T) {
  entry:
    branch (copy flag) [true: pick_a, false: pick_b]
  pick_a:
    dest.* = copy a;
    drop a;
    drop b;
    return
  pick_b:
    dest.* = copy b;
    drop a;
    drop b;
    return
}

# Copy field from an owned generic struct, then consume the struct.
# Exercises field projection on an owned generic value across a stmt
# boundary: the copy leaves b still Init; the explicit drop closes it out.
fn unbox<T: Copy + Drop>(b: Box<T>, dest: &out T) {
  entry:
    dest.* = copy b.inner;
    drop b;
    return
}

# Ordinary function constants preserve explicit lifetime and type arguments.
fn observe_generic<'a, T: Copy + Drop>(x: &'a T) {
  entry:
    return
}

# covers: MIR FnName preserves explicit lifetime and type arguments
fn call_observe_generic<'a>(x: &'a i64) {
  entry:
    call observe_generic<'a, i64>(copy x);
    return
}
