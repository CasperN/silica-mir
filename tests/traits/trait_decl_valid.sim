# Trait declarations parse, type-check, and round-trip through
# pretty-print. Each cell isolates one shape so a regression is
# localizable.
#
#   trait             covers
#   Simple            no generics; one method referencing Self
#   Iter              trait-level generic + Self; two methods
#   Foo               method-level generic on top of trait generic
#   RefMethods        method sig uses every &-kind (Shared/Mut/Out/Drop/Uninit)

trait Simple {
  fn ping(recv: & Self);
}

trait<T: Copy + Drop> Iter {
  fn next(recv: &mut Self, $return: &out T);
  fn peek(recv: & Self, $return: &out T);
}

trait<T> Foo {
  fn<U> map(recv: & Self, other: & U, $return: &out T);
}

trait RefMethods {
  fn shared(recv: & Self);
  fn mut_(recv: &mut Self);
  fn out_(recv: &out Self);
  fn drop_(recv: &drop Self);
  fn uninit(recv: &uninit Self);
}
