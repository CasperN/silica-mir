trait Sink {
  fn accept<'s0>(recv: &'s0 mut Self, v: i64);
}

trait Iter<T: Copy + Drop> {
  fn next<'s0, 's1>(recv: &'s0 mut Self, $return: &'s1 out T);
}

struct Foo: Copy + Drop {
  x: i64
}

struct List: Copy + Drop {
  xs: [i64; 4]
}

impl Sink for Foo {
  fn accept<'s0>(recv: &'s0 mut Foo, v: i64) {
    entry:
      drop recv.*.x;
      recv.*.x = move v;
      drop recv;
      return
  }
}

impl Iter<i64> for List {
  fn next<'s0, 's1>(recv: &'s0 mut List, $return: &'s1 out i64) {
    entry:
      $return.* = 0;
      unborrow $return;
      drop recv;
      return
  }
}

impl Iter<u8> for List {
  fn next<'s0, 's1>(recv: &'s0 mut List, $return: &'s1 out u8) {
    entry:
      $return.* = 0u8;
      unborrow $return;
      drop recv;
      return
  }
}

fn drive<'s0, 's1, 's2>(f: &'s0 mut Foo, l: &'s1 mut List, $return: &'s2 out i64) {
  out_ref: &out i64;
  entry:
    call <Foo as Sink>::accept(move f, 7);
    out_ref = &out $return.*;
    call <List as Iter<i64>>::next(move l, move out_ref);
    unborrow $return;
    return
}

fn drive_bytes<'s0, 's1>(l: &'s0 mut List, $return: &'s1 out u8) {
  out_ref: &out u8;
  entry:
    out_ref = &out $return.*;
    call <List as Iter<u8>>::next(move l, move out_ref);
    unborrow $return;
    return
}

fn drive_generic<'s0, T: Sink>(f: &'s0 mut T) {
  entry:
    call <T as Sink>::accept(move f, 7);
    return
}

trait SuperSink {
  fn accept_super<'s0>(recv: &'s0 mut Self, v: i64);
}

trait ChildSink: SuperSink {
}

trait OrderedSuper<'a, 'b: 'a> {
}

trait OrderedChild<'a, 'b: 'a>: OrderedSuper<'a, 'b> {
}

fn drive_super_generic<'s0, T: ChildSink>(f: &'s0 mut T) {
  entry:
    call <T as SuperSink>::accept_super(move f, 7);
    return
}
