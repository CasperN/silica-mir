trait Sink {
  fn<'s0> accept(recv: &mut 's0 Self, v: i64);
}

trait<T: Copy + Drop> Iter {
  fn<'s0, 's1> next(recv: &mut 's0 Self, $return: &out 's1 T);
}

struct Foo: Copy + Drop {
  x: i64
}

struct List: Copy + Drop {
  xs: [i64; 4]
}

impl Sink for Foo {
  fn<'s0> accept(recv: &mut 's0 Foo, v: i64) {
    entry:
      drop recv.*.x;
      recv.*.x = move v;
      drop recv;
      return
  }
}

impl Iter<i64> for List {
  fn<'s0, 's1> next(recv: &mut 's0 List, $return: &out 's1 i64) {
    entry:
      $return.* = 0;
      unborrow $return;
      drop recv;
      return
  }
}

impl Iter<u8> for List {
  fn<'s0, 's1> next(recv: &mut 's0 List, $return: &out 's1 u8) {
    entry:
      $return.* = 0u8;
      unborrow $return;
      drop recv;
      return
  }
}

fn<'s0, 's1, 's2> drive(f: &mut 's0 Foo, l: &mut 's1 List, $return: &out 's2 i64) {
  out_ref: &out i64;
  entry:
    call <Foo as Sink>::accept(move f, 7);
    out_ref = &out $return.*;
    call <List as Iter<i64>>::next(move l, move out_ref);
    unborrow $return;
    return
}

fn<'s0, 's1> drive_bytes(l: &mut 's0 List, $return: &out 's1 u8) {
  out_ref: &out u8;
  entry:
    out_ref = &out $return.*;
    call <List as Iter<u8>>::next(move l, move out_ref);
    unborrow $return;
    return
}

fn<'s0, T: Sink> drive_generic(f: &mut 's0 T) {
  entry:
    call <T as Sink>::accept(move f, 7);
    return
}

trait SuperSink {
  fn<'s0> accept_super(recv: &mut 's0 Self, v: i64);
}

trait ChildSink: SuperSink {
}

trait<'a, 'b: 'a> OrderedSuper {
}

trait<'a, 'b: 'a> OrderedChild: OrderedSuper<'a, 'b> {
}

fn<'s0, T: ChildSink> drive_super_generic(f: &mut 's0 T) {
  entry:
    call <T as SuperSink>::accept_super(move f, 7);
    return
}
