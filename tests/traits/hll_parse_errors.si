# HLL parse-time rejections of declaration shape errors. Fires before the
# pipeline reaches typecheck, so mixed with typecheck cases would hide them.
#
# covers: bare extern on trait/impl methods, unknown ABI on free fns and
# methods, duplicate method names, nested generic shadowing, reserved Self
# positions, and qualified-method-as-value

struct S: Copy + Drop { value: i64 }

struct Self: Copy + Drop { value: i64 }

enum Self { Value: unit }

trait ExternTrait {
  extern fn ext(recv: &Self);
}

trait UnknownAbiTrait {
  extern "system" unsafe fn u(recv: &Self);
}

impl UnknownAbiTrait for S {
  extern "fastcall" unsafe fn u(recv: &Self) { unit }
}

trait Duplicate {
  fn same(recv: &Self);
  fn same(recv: &Self);
}

trait Required {
  fn required(recv: &Self);
}

impl Required for S {
  extern fn required(recv: &Self) { unit }
}

impl Required for S {
  fn required(recv: &Self) { unit }
  fn required(recv: &Self) { unit }
}

impl<T> Required for S {
  fn required<T>(recv: &Self) { unit }
}

trait Self {
  fn reserved(recv: &Self);
}

impl Self for S {
  fn reserved(recv: &Self) { unit }
}

trait DuplicateBound {}

# covers: the same direct trait bound cannot be declared twice
fn duplicate_direct_bound<T: DuplicateBound + DuplicateBound>(value: &T) {
  value;
}

# covers: qualified methods are selectors, not standalone function values
fn bare_qualified_method() {
  <S>::missing;
}

# Unrecognized ABI names on free fns. `Silica` is a redundant spelling of
# the default ABI.
extern "system" fn win_api(x: i64);
extern "fastcall" fn stdcall_thing(y: i64);
extern "Silica" fn spelled_silica(x: i64);
