# HLL-specific trait and impl declaration shape errors.
#
# covers: trait bodies, bodyless impl methods, extern methods, duplicates,
# nested generic shadowing and reserved Self positions

struct S: Copy + Drop { value: i64 }

struct Self: Copy + Drop { value: i64 }

enum Self { Value: unit }

trait Body {
  fn body(recv: &Self) { unit }
}

trait ExternTrait {
  extern fn ext(recv: &Self);
}

trait AbiTrait {
  extern "C" fn abi(recv: &Self);
}

trait Duplicate {
  fn same(recv: &Self);
  fn same(recv: &Self);
}

trait Required {
  fn required(recv: &Self);
}

impl Required for S {
  fn required(recv: &Self);
}

impl Required for S {
  extern fn required(recv: &Self) { unit }
}

impl Required for S {
  extern "C" fn required(recv: &Self) { unit }
}

impl Required for S {
  fn required(recv: &Self) { unit }
  fn required(recv: &Self) { unit }
}

impl<T> Required for S {
  fn required<T>(recv: &Self) { unit }
}

trait Self {
  fn reserved(recv: &Self);
}

impl Self for S {
  fn reserved(recv: &Self) { unit }
}

trait DuplicateBound {}

# covers: the same direct trait bound cannot be declared twice
fn duplicate_direct_bound<T: DuplicateBound + DuplicateBound>(value: &T) {
  value;
}

# covers: qualified methods are selectors, not standalone function values
fn bare_qualified_method() {
  <S>::missing;
}
