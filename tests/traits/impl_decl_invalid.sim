# Impl block well-formedness errors that fire from the type checker.
# Parser-time errors (body-less method, extern method, duplicate method)
# live in sibling `impl_method_*_rejected.sim` fixtures.
#
#   impl                          error
#   Unknown for Foo               trait 'Unknown' isn't declared
#   Iter for Foo (no args)        wrong trait type-arg arity
#   Trait for Foo (extra fn)      impl has a method not on the trait
#   Trait for Foo (missing fn)    impl is missing a trait method
#   TraitS for Foo (bad sig)      impl method sig doesn't match the trait's
#   BadBody for Foo               method body assigns i64 to a bool local
#   MgTrait for Foo (no method    impl method drops the trait's method-level
#     generic)                    generic parameter
#   LtTrait for Foo (no lt arg)   impl omits the trait's lifetime argument

struct Foo: Copy + Drop { x: i64 }

trait Trait {
  fn a(recv: & Self);
  fn b(recv: & Self);
}

trait<T: Copy + Drop> Iter {
  fn next(recv: &mut Self, $return: &out T);
}

# Unknown trait name.
impl Unknown for Foo {
  fn zap(recv: & Foo) {
    entry:
      return
  }
}

# Wrong number of trait type args (Iter takes 1, got 0).
impl Iter for Foo {
  fn next(recv: &mut Foo, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

# Extra method + missing method (Trait wants `a` and `b`; impl gives
# `a` and `extra`).
impl Trait for Foo {
  fn a(recv: & Foo) {
    entry:
      return
  }
  fn extra(recv: & Foo) {
    entry:
      return
  }
}

# Signature mismatch: trait says `recv: & Self` (shared ref), impl says
# `recv: &mut Foo` (mut ref). After Self := Foo the expected shape is
# `& Foo`, not `&mut Foo`.
trait TraitS {
  fn touch(recv: & Self);
}

impl TraitS for Foo {
  fn touch(recv: &mut Foo) {
    entry:
      return
  }
}

# Method body has a type error: assigning i64 to a bool local. The
# type checker sees this because `typecheck_impl` runs each method
# through `typecheck_function` with an effective scope.
trait BadBody {
  fn go(recv: & Self);
}

impl BadBody for Foo {
  fn go(recv: & Foo) {
    flag: bool;
    entry:
      flag = 0i64;
      return
  }
}

# Method-generic mismatch: the trait's method takes a `<U>` parameter;
# the impl drops the method generic and specializes to i64.
trait MgTrait {
  fn<U> pick(recv: & Self, $return: &out U);
}

impl MgTrait for Foo {
  fn pick(recv: & Foo, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

# Trait has a lifetime parameter but the impl omits the lifetime arg.
# Impls skip elision, so an exact-arity match is required.
trait<'a> LtTrait {
  fn peek(recv: & Self);
}

impl LtTrait for Foo {
  fn peek(recv: & Foo) {
    entry:
      return
  }
}
