# Receiver-call resolution selects the highest-priority applicable callable and
# lowers the receiver as argument zero.

fn field_value(value: i64) -> i64 { value }

struct Dispatch: Copy + Drop {
  priority: fn(i64) -> i64,
  trait_over_field: fn(i64) -> i64,
  field_over_free: fn(i64) -> i64,
  free_over_noncallable: i64,
}

trait PriorityTrait {
  fn priority(recv: &Dispatch, value: i64) -> i64;
}

impl PriorityTrait for Dispatch {
  fn priority(recv: &Dispatch, value: i64) -> i64 { value }
}

trait FieldTrait {
  fn trait_over_field(recv: &Dispatch, value: i64) -> i64;
}

impl FieldTrait for Dispatch {
  fn trait_over_field(recv: &Dispatch, value: i64) -> i64 { value }
}

impl Dispatch {
  fn priority(recv: &Dispatch, value: i64) -> i64 { value }
}

fn priority(recv: Dispatch, value: i64) -> i64 { value }
fn trait_over_field(recv: Dispatch, value: i64) -> i64 { value }
fn field_over_free(recv: &Dispatch, value: i64) -> i64 { value }
fn free_over_noncallable(recv: &Dispatch, value: i64) -> i64 { value }
unsafe fn unsafe_free(recv: Dispatch) -> i64 { recv.free_over_noncallable }

# covers: inherent method outranks trait method, callable field, and free UFCS
fn select_inherent(value: Dispatch, argument: i64) -> i64 {
  value.priority(argument)
}

# covers: parentheses force the callable-field interpretation
fn force_field(value: Dispatch, argument: i64) -> i64 {
  (value.priority)(argument)
}

# covers: trait method outranks callable field and free UFCS
fn select_trait(value: Dispatch, argument: i64) -> i64 {
  value.trait_over_field(argument)
}

# covers: callable field outranks free UFCS
fn select_field(value: Dispatch, argument: i64) -> i64 {
  value.field_over_free(argument)
}

# covers: a non-callable field does not block free UFCS
fn select_free_behind_noncallable_field(value: Dispatch, argument: i64) -> i64 {
  value.free_over_noncallable(argument)
}

# covers: free UFCS preserves ordinary unsafe-call checking
fn select_unsafe_free(value: Dispatch) -> i64 {
  unsafe { value.unsafe_free() }
}

struct Box<T: Copy + Drop>: Copy + Drop { value: T }

impl<T: Copy + Drop> Box<T> {
  fn inherent_generic<U: Copy + Drop>(recv: &Box<T>, ignored: U) -> T {
    recv.*.value
  }
}

trait GenericTrait<T: Copy + Drop> {
  fn trait_generic<U: Copy + Drop>(recv: &Box<T>, ignored: U) -> T;
}

impl<T: Copy + Drop> GenericTrait<T> for Box<T> {
  fn trait_generic<U: Copy + Drop>(recv: &Box<T>, ignored: U) -> T {
    recv.*.value
  }
}

# covers: generic inherent impl and explicit method arguments are instantiated
fn call_generic_inherent(value: Box<i64>) -> i64 {
  value.inherent_generic<bool>(true)
}

# covers: generic trait path and inferred method arguments are instantiated
fn call_generic_trait(value: Box<i64>) -> i64 {
  value.trait_generic(false)
}

fn free_generic<T: Copy + Drop, U: Copy + Drop>(recv: Box<T>, ignored: U) -> T {
  recv.value
}

# covers: free UFCS infers generic arguments from receiver and explicit args
fn call_generic_free(value: Box<i64>) -> i64 {
  value.free_generic(false)
}

struct Shared: Copy + Drop { value: i64 }

impl Shared {
  fn exact_shared(recv: &Shared) -> i64 { recv.*.value }

  fn inferred_method_lifetime<'a>(recv: &'a Shared) -> i64 {
    recv.*.value
  }
}

# covers: an already-borrowed receiver matches a reference receiver exactly
fn call_exact_shared(value: &Shared) -> i64 {
  value.exact_shared()
}

# covers: omitted method lifetime arguments are inferred
fn call_inferred_method_lifetime<'a>(value: &'a Shared) -> i64 {
  value.inferred_method_lifetime()
}

# covers: qualified inherent calls infer omitted method lifetimes
fn call_qualified_inferred_method_lifetime<'a>(value: &'a Shared) -> i64 {
  <Shared>::inferred_method_lifetime(value)
}

trait LifetimeTrait<'a> {
  fn lifetime_method(recv: &'a Shared) -> i64;
}

impl<'a> LifetimeTrait<'a> for Shared {
  fn lifetime_method(recv: &'a Shared) -> i64 { recv.*.value }
}

# covers: receiver lifetime instantiates a trait path
fn call_lifetime_trait<'a>(value: &'a Shared) -> i64 {
  value.lifetime_method()
}

trait NumericTrait {
  fn infer_receiver(recv: i64) -> i64;
}

impl NumericTrait for i64 {
  fn infer_receiver(recv: i64) -> i64 { recv }
}

# covers: method selection constrains an otherwise-unsuffixed receiver type
fn infer_receiver_type() -> i64 {
  let value = 1;
  value.infer_receiver()
}

struct Ranked: Copy + Drop { value: i64 }

trait ExactRank {
  fn ranked(recv: Ranked);
}

trait BorrowedRank {
  fn ranked(recv: &Ranked);
}

impl ExactRank for Ranked {
  fn ranked(recv: Ranked) { unit }
}

impl BorrowedRank for Ranked {
  fn ranked(recv: &Ranked) { unit }
}

# covers: an exact receiver match outranks an auto-borrow in the same tier
fn exact_outranks_auto_borrow(value: Ranked) {
  value.ranked();
}

struct BorrowTarget: Copy + Drop { value: i64 }

impl BorrowTarget {
  fn inherent_auto_shared(recv: &BorrowTarget) -> i64 { recv.*.value }
  fn inherent_auto_mut(recv: &mut BorrowTarget) {
    let old = recv.*.value;
    recv.*.value = 4;
    old;
  }
  fn inherent_auto_out(recv: &out BorrowTarget) {
    recv.* = BorrowTarget { value: 5 };
  }
  fn inherent_auto_drop(recv: &drop BorrowTarget) { recv.*; }
  fn inherent_auto_uninit(recv: &uninit BorrowTarget) {}
}

trait AutoBorrowMethods {
  fn trait_auto_shared(recv: &BorrowTarget) -> i64;
  fn trait_auto_mut(recv: &mut BorrowTarget);
  fn trait_auto_out(recv: &out BorrowTarget);
  fn trait_auto_drop(recv: &drop BorrowTarget);
  fn trait_auto_uninit(recv: &uninit BorrowTarget);
}

impl AutoBorrowMethods for BorrowTarget {
  fn trait_auto_shared(recv: &BorrowTarget) -> i64 { recv.*.value }
  fn trait_auto_mut(recv: &mut BorrowTarget) {
    let old = recv.*.value;
    recv.*.value = 6;
    old;
  }
  fn trait_auto_out(recv: &out BorrowTarget) {
    recv.* = BorrowTarget { value: 7 };
  }
  fn trait_auto_drop(recv: &drop BorrowTarget) { recv.*; }
  fn trait_auto_uninit(recv: &uninit BorrowTarget) {}
}

fn auto_shared(recv: &BorrowTarget) -> i64 { recv.*.value }
fn auto_mut(recv: &mut BorrowTarget) {
  let old = recv.*.value;
  recv.*.value = 2;
  old;
}
fn auto_out(recv: &out BorrowTarget) { recv.* = BorrowTarget { value: 3 }; }
fn auto_drop(recv: &drop BorrowTarget) { recv.*; }
fn auto_uninit(recv: &uninit BorrowTarget) {}

# covers: free UFCS automatically creates a shared receiver borrow
fn call_auto_shared(value: BorrowTarget) -> i64 {
  value.auto_shared()
}

# covers: free UFCS automatically creates a mutable receiver borrow
fn call_auto_mut(value: BorrowTarget) -> BorrowTarget {
  let mut local = value;
  local.auto_mut();
  local
}

# covers: free UFCS automatically creates an output receiver borrow
fn call_auto_out() -> BorrowTarget {
  let mut value: BorrowTarget;
  value.auto_out();
  value
}

# covers: AutoDrop may satisfy an output receiver's uninitialized precondition
fn call_auto_out_replaces(value: BorrowTarget) -> BorrowTarget {
  let mut local = value;
  local.auto_out();
  local
}

# covers: free UFCS automatically creates a dropping receiver borrow
fn call_auto_drop(value: BorrowTarget) {
  let mut local = value;
  local.auto_drop();
}

# covers: free UFCS automatically creates an uninitialized receiver borrow
fn call_auto_uninit() {
  let mut value: BorrowTarget;
  value.auto_uninit();
}

# covers: AutoDrop may satisfy an uninitialized receiver's precondition
fn call_auto_uninit_after_drop(value: BorrowTarget) {
  let mut local = value;
  local.auto_uninit();
}

# covers: inherent methods support every receiver auto-borrow kind
fn call_inherent_auto_shared(value: BorrowTarget) -> i64 {
  value.inherent_auto_shared()
}

fn call_inherent_auto_mut(value: BorrowTarget) -> BorrowTarget {
  let mut local = value;
  local.inherent_auto_mut();
  local
}

fn call_inherent_auto_out() -> BorrowTarget {
  let mut value: BorrowTarget;
  value.inherent_auto_out();
  value
}

fn call_inherent_auto_drop(value: BorrowTarget) {
  let mut local = value;
  local.inherent_auto_drop();
}

fn call_inherent_auto_uninit() {
  let mut value: BorrowTarget;
  value.inherent_auto_uninit();
}

# covers: trait methods support every receiver auto-borrow kind
fn call_trait_auto_shared(value: BorrowTarget) -> i64 {
  value.trait_auto_shared()
}

fn call_trait_auto_mut(value: BorrowTarget) -> BorrowTarget {
  let mut local = value;
  local.trait_auto_mut();
  local
}

fn call_trait_auto_out() -> BorrowTarget {
  let mut value: BorrowTarget;
  value.trait_auto_out();
  value
}

fn call_trait_auto_drop(value: BorrowTarget) {
  let mut local = value;
  local.trait_auto_drop();
}

fn call_trait_auto_uninit() {
  let mut value: BorrowTarget;
  value.trait_auto_uninit();
}

struct UnsafeTarget: Copy + Drop { value: i64 }

trait UnsafeMethod {
  unsafe fn trait_dangerous(recv: &Self) -> i64;
}

impl UnsafeMethod for UnsafeTarget {
  unsafe fn trait_dangerous(recv: &Self) -> i64 { recv.*.value }
}

impl UnsafeTarget {
  unsafe fn inherent_dangerous(recv: &Self) -> i64 { recv.*.value }
}

# covers: an unsafe block permits an unsafe trait-method call
fn call_unsafe_trait_method(value: UnsafeTarget) -> i64 {
  unsafe { value.trait_dangerous() }
}

# covers: an unsafe block permits an unsafe inherent-method call
fn call_unsafe_inherent_method(value: UnsafeTarget) -> i64 {
  unsafe { value.inherent_dangerous() }
}

fn receiver_effect() {}
fn make_argument() -> i64 { 1 }

# covers: receiver evaluation precedes explicit argument evaluation
fn receiver_before_argument(value: Dispatch) -> i64 {
  ({ receiver_effect(); value }).priority(make_argument())
}

trait BoundArgument {}
impl BoundArgument for BorrowTarget {}

trait GenericReceiver<X: Copy + Drop> {
  fn bound_shared(recv: &Self);
  fn bound_mut(recv: &mut Self);
  fn bound_out(recv: &out Self);
  fn bound_drop(recv: &drop Self);
  fn bound_uninit(recv: &uninit Self);
  fn bound_consume(recv: Self);
  fn bound_parameter(recv: &Self, value: X);
  fn bound_generic<U: BoundArgument>(recv: &Self, value: &U);
}

# covers: an already-borrowed generic receiver matches its direct bound exactly
fn generic_bound_exact<T: GenericReceiver<i64>>(value: &T) {
  value.bound_shared();
}

# covers: direct-bound methods support shared receiver auto-borrowing
fn generic_bound_shared<T: GenericReceiver<i64> + Move>(value: T) {
  value.bound_shared();
  value.bound_consume();
}

# covers: direct-bound methods support mutable receiver auto-borrowing
fn generic_bound_mut<T: GenericReceiver<i64> + Move>(value: T) {
  let mut local = value;
  local.bound_mut();
  local.bound_consume();
}

# covers: direct-bound methods support output receiver auto-borrowing
fn generic_bound_out<T: GenericReceiver<i64> + Move>() {
  let mut value: T;
  value.bound_out();
  value.bound_consume();
}

# covers: direct-bound methods support dropping receiver auto-borrowing
fn generic_bound_drop<T: GenericReceiver<i64> + Move>(value: T) {
  let mut local = value;
  local.bound_drop();
}

# covers: direct-bound methods support uninitialized receiver auto-borrowing
fn generic_bound_uninit<T: GenericReceiver<i64>>() {
  let mut value: T;
  value.bound_uninit();
}

# covers: direct-bound methods support by-value receivers
fn generic_bound_consume<T: GenericReceiver<i64> + Move>(value: T) {
  value.bound_consume();
}

# covers: trait arguments substitute into a direct-bound method signature
fn generic_bound_parameter<T: GenericReceiver<i64>>(value: &T) {
  value.bound_parameter(1);
}

# covers: direct-bound method generic obligations are enforced and inferred
fn generic_bound_method_argument<T: GenericReceiver<i64>>(
  value: &T,
  argument: &BorrowTarget,
) {
  value.bound_generic(argument);
}

trait GenericLifetimeReceiver<'a> {
  fn bound_lifetime(recv: &'a Self);
}

# covers: trait lifetimes substitute into a direct-bound receiver signature
fn generic_bound_lifetime<'a, T: GenericLifetimeReceiver<'a>>(value: &'a T) {
  value.bound_lifetime();
}

trait BoundExact {
  fn bound_rank(recv: Self);
}

trait BoundBorrowed {
  fn bound_rank(recv: &Self);
}

# covers: an exact direct-bound receiver outranks an auto-borrow candidate
fn generic_bound_exact_rank<T: BoundExact + BoundBorrowed + Move>(value: T) {
  value.bound_rank();
}

# covers: AutoClone bounds support compiler-generated generic trait calls
fn generic_bound_auto_clone<T: AutoClone + Move>(value: T) -> [T; 2] {
  [value, value]
}

# covers: AutoDestroy bounds support compiler-generated generic trait calls
fn generic_bound_auto_destroy<T: AutoDestroy>(value: T) {}

trait SuperReceiver<X: Copy + Drop> {
  fn inherited(recv: &Self, value: X);
  fn inherited_generic<U: Copy + Drop>(recv: &Self, value: U);
  unsafe fn inherited_unsafe(recv: &Self);
}

trait ChildReceiver<X: Copy + Drop>: SuperReceiver<X> + Copy + Drop {
  fn child(recv: &Self);
}

trait GrandReceiver<X: Copy + Drop>: ChildReceiver<X> {}

trait LeftReceiver<X: Copy + Drop>: SuperReceiver<X> {}
trait RightReceiver<X: Copy + Drop>: SuperReceiver<X> {}
trait DiamondReceiver<X: Copy + Drop>: LeftReceiver<X> + RightReceiver<X> {}

struct SuperTarget: Copy + Drop { value: i64 }

impl SuperReceiver<i64> for SuperTarget {
  fn inherited(recv: &SuperTarget, value: i64) { recv; value; }
  fn inherited_generic<U: Copy + Drop>(recv: &SuperTarget, value: U) {
    recv;
    value;
  }
  unsafe fn inherited_unsafe(recv: &SuperTarget) { recv; }
}

impl ChildReceiver<i64> for SuperTarget {
  fn child(recv: &SuperTarget) { recv; }
}

impl GrandReceiver<i64> for SuperTarget {}

# covers: a generic receiver sees methods inherited through multiple supertrait levels
fn inherited_generic_method<T: GrandReceiver<i64>>(value: &T) {
  value.inherited(1);
  value.inherited_generic(true);
  unsafe { value.inherited_unsafe(); }
  value.child();
}

# covers: an inherited reference receiver auto-borrows an owned generic value
fn inherited_auto_borrow<T: GrandReceiver<i64> + Move>(value: T) {
  value.inherited(1);
}

# covers: duplicate diamond paths to the same instantiated method are one candidate
fn inherited_diamond_method<T: DiamondReceiver<i64>>(value: &T) {
  value.inherited(1);
}

# covers: a supertrait's marker bounds contribute to a generic receiver's class
fn inherited_markers<T: GrandReceiver<i64>>(value: T) -> [T; 2] {
  [value, value]
}

trait InheritedAutoClone: AutoClone {}
trait InheritedAutoDestroy: AutoDestroy {}

# covers: compiler-generated AutoClone calls use inherited trait evidence
fn inherited_auto_clone<T: InheritedAutoClone + Move>(value: T) -> [T; 2] {
  [value, value]
}

# covers: compiler-generated AutoDestroy calls use inherited trait evidence
fn inherited_auto_destroy<T: InheritedAutoDestroy>(value: T) {}

trait LifetimeSuperReceiver<'a, X: Copy + Drop> {
  fn inherited_lifetime(recv: &'a Self, value: X);
}

trait LifetimeChildReceiver<'a, X: Copy + Drop>: LifetimeSuperReceiver<'a, X> {}

# covers: inherited method lookup substitutes supertrait lifetime and type arguments
fn inherited_lifetime_method<'a, T: LifetimeChildReceiver<'a, i64>>(value: &'a T) {
  value.inherited_lifetime(1);
}

trait SelfArgumentSuper<X> {
  fn inherited_self_argument(recv: &Self, value: &X);
}

trait SelfArgumentChild: SelfArgumentSuper<Self> {}

struct SelfArgumentTarget: Copy + Drop { value: i64 }

impl SelfArgumentSuper<SelfArgumentTarget> for SelfArgumentTarget {
  fn inherited_self_argument(recv: &SelfArgumentTarget, value: &SelfArgumentTarget) {
    recv;
    value;
  }
}

impl SelfArgumentChild for SelfArgumentTarget {}

# covers: Self in a supertrait argument substitutes to the generic receiver
fn inherited_self_argument<T: SelfArgumentChild>(value: &T) {
  value.inherited_self_argument(value);
}

trait GenericImplParent<X> {}
trait GenericImplChild<X>: GenericImplParent<X> {}

# covers: a generic impl header may prove its instantiated supertrait obligation
impl<T: GenericImplParent<i64>> GenericImplChild<i64> for T {}

trait InheritedExactRank {
  fn inherited_rank(recv: Self);
}

trait InheritedBorrowedRank {
  fn inherited_rank(recv: &Self);
}

trait InheritedRank: InheritedExactRank + InheritedBorrowedRank {}

# covers: exact receiver matching outranks auto-borrow across inherited methods
fn inherited_receiver_rank<T: InheritedRank + Move>(value: T) {
  value.inherited_rank();
}

trait QualifiedFirst {
  fn qualified_collision(recv: &Self) -> i64;
}

trait QualifiedSecond {
  fn qualified_collision(recv: &Self) -> i64;
}

struct QualifiedTarget: Copy + Drop { value: i64 }

impl QualifiedFirst for QualifiedTarget {
  fn qualified_collision(recv: &Self) -> i64 { recv.*.value }
}

impl QualifiedSecond for QualifiedTarget {
  fn qualified_collision(recv: &Self) -> i64 { recv.*.value }
}

impl QualifiedTarget {
  fn qualified_inherent<U: Copy + Drop>(recv: &Self, ignored: U) -> i64 {
    ignored;
    recv.*.value
  }

  unsafe fn qualified_unsafe(recv: &Self) -> i64 { recv.*.value }
}

# covers: trait qualification selects one otherwise ambiguous method
fn qualified_trait_call(value: &QualifiedTarget) -> i64 {
  <QualifiedTarget as QualifiedFirst>::qualified_collision(value)
}

# covers: inherent qualification and explicit method arguments lower directly
fn qualified_inherent_call(value: &QualifiedTarget) -> i64 {
  <QualifiedTarget>::qualified_inherent<bool>(value, true)
}

# covers: qualification matches generic inherent and trait impl headers
fn qualified_generic_impl_calls(value: &Box<i64>) -> i64 {
  <Box<i64>>::inherent_generic<bool>(value, true);
  <Box<i64> as GenericTrait<i64>>::trait_generic<bool>(value, true)
}

# covers: qualified unsafe methods retain ordinary unsafe checking
fn qualified_unsafe_call(value: &QualifiedTarget) -> i64 {
  unsafe { <QualifiedTarget>::qualified_unsafe(value) }
}

# covers: qualification may select a supertrait proven by a generic bound
fn qualified_supertrait_call<T: GrandReceiver<i64>>(value: &T) {
  <T as SuperReceiver<i64>>::inherited(value, 1);
}

# covers: qualified trait and method lifetime arguments remain explicit
fn qualified_lifetime_call<'a, T: LifetimeChildReceiver<'a, i64>>(value: &'a T) {
  <T as LifetimeSuperReceiver<'a, i64>>::inherited_lifetime(value, 1);
}

struct StaticContainer: Copy + Drop {
  val: i64,
  flag: bool,
}

impl StaticContainer {
  fn zero_arg() -> StaticContainer {
    StaticContainer { val: 0, flag: false }
  }

  fn one_arg(val: i64) -> StaticContainer {
    StaticContainer { val: val, flag: true }
  }

  fn multi_arg(val: i64, flag: bool) -> StaticContainer {
    StaticContainer { val: val, flag: flag }
  }
}

enum ShapeKind: Copy + Drop {
  None: unit,
  Point: i64,
}

struct Shape: Copy + Drop {
  kind: ShapeKind,
}

impl Shape {
  fn Point(val: i64) -> Shape {
    Shape { kind: ShapeKind::Point(val) }
  }
}

# covers: 0-arg, 1-arg, and multi-arg static inherent methods
fn test_static_methods() -> StaticContainer {
  let a = StaticContainer::zero_arg();
  let b = StaticContainer::one_arg(42);
  let c = StaticContainer::multi_arg(10, true);
  b
}

# covers: enum constructor via path and coexistence with same-named static method
fn test_enum_path_and_coexistence() -> Shape {
  let k = ShapeKind::Point(5);
  let u = ShapeKind::None(unit);
  let s = Shape::Point(5);
  s
}

enum Status: Copy + Drop {
  Active: i64,
  Inactive: unit,
}

impl Status {
  fn default_active() -> Status {
    Status::Active(1)
  }

  fn custom_active(val: i64) -> Status {
    Status::Active(val)
  }
}

impl StaticContainer {
  fn duplicate_with_self() -> StaticContainer {
    Self::zero_arg()
  }

  fn with_generic_payload<U: Copy + Drop>(val: i64, extra: U) -> StaticContainer {
    extra;
    StaticContainer { val: val, flag: true }
  }
}

struct ReceiverTarget: Copy + Drop {
  value: i64,
}

impl ReceiverTarget {
  fn get_val(&self) -> i64 {
    self.*.value
  }
}

# covers: inherent static methods on enums
fn test_enum_inherent_static_methods() -> Status {
  let s1 = Status::default_active();
  let s2 = Status::custom_active(100);
  s2
}

# covers: Self::method from within an impl block
fn test_self_scoped_call() -> StaticContainer {
  StaticContainer::duplicate_with_self()
}

# covers: static method with generic type parameter on the method itself
fn test_static_method_generic_param() -> StaticContainer {
  let s1 = StaticContainer::with_generic_payload<bool>(42, true);
  let s2 = StaticContainer::with_generic_payload(10, 20);
  s1
}

# covers: calling receiver method through static path syntax with explicit receiver
fn test_call_receiver_method_via_path(target: &ReceiverTarget) -> i64 {
  ReceiverTarget::get_val(target)
}

# covers: local variable shadowing struct name does not shadow static path call
fn test_shadowing_does_not_break_static_path() -> StaticContainer {
  let StaticContainer = 999;
  StaticContainer;
  StaticContainer::zero_arg()
}



