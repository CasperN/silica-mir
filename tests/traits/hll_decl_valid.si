# HLL trait and impl declarations lower into the existing MIR representation.
#
# covers: trait generics, method generics, Self, non-() method returns,
# generic impl headers, lifetime-parameterized traits, reference kinds,
# Self-qualified struct/enum constructors, HLL impl bodies, and generic and
# concrete inherent impls split across multiple blocks

struct Box<T: Copy + Drop>: Copy + Drop { value: T }

enum Choice: Copy + Drop { Empty: () }

trait RefKinds {
  fn shared(recv: &Self);
  fn mutable(recv: &mut Self);
  fn output(recv: &out Self);
  fn dropping(recv: &drop Self);
  fn uninitialized(recv: &uninit Self);
}

trait Convert<T: Copy + Drop> {
  fn convert<U: Copy + Drop>(recv: &Self, ignored: U) -> T;
}

impl<T: Copy + Drop> Convert<T> for Box<T> {
  fn convert<U: Copy + Drop>(recv: &Self, ignored: U) -> T {
    recv.*.value
  }
}

trait Observe<'a> {
  fn observe(recv: &'a Self);
}

impl<'a, T: Copy + Drop> Observe<'a> for Box<T> {
  fn observe(recv: &'a Self) {
    let local: Self = Self { value: recv.*.value };
    ()
  }
}

trait Make {
  fn make() -> Self;
}

impl Make for Choice {
  fn make() -> Self {
    Self::Empty(())
  }
}

# Inherent impls share the impl-header and method generic scopes used by
# trait impls. Multiple blocks for one target are permitted.
impl<T: Copy + Drop> Box<T> {
  fn make(value: T) -> Self {
    Self { value: value }
  }
}

impl<T: Copy + Drop> Box<T> {
  fn get(recv: &Self) -> T {
    recv.*.value
  }
}

impl Choice {
  fn empty() -> Self {
    Self::Empty(())
  }
}
