}

fn<'s0, 's1> inspect_lifetime_argument_good(recv: &'s0 Good, value: &'s1 Good) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call <Good>::inspect_lifetime_argument<'static, Good>(move recv, move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
