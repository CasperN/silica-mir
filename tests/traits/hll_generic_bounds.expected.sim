struct Good: Copy + Drop {
  value: i64
}

struct Other: Copy + Drop {
  value: i64
}

trait Label {
}

impl Label for Good {
}

trait RequiresLabel<T: Label> {
}

impl RequiresLabel<Good> for Good {
}

trait Related<T> {
}

impl Related<i64> for Good {
}

trait LifetimeLabel<'a> {
}

impl LifetimeLabel<'static> for Good {
}

struct Holder<T: Label> {
  value: T
}

enum Maybe<T: Label> {
  None: unit
  Some: T
}

struct Wrapper<T> {
  value: T
}

struct LifetimeHolder<'held, T: LifetimeLabel<'held>> {
  value: &'held T
}

extern fn accept<'s0, T: Label>(value: &'s0 T);

extern fn accept_auto_clone<'s0, T: AutoClone>(value: &'s0 T);

extern fn accept_auto_destroy<'s0, T: AutoDestroy>(value: &'s0 T);

extern fn accept_lifetime_bound<'bound, 's0, T: LifetimeLabel<'bound>>(value: &'s0 T);

extern fn accept_inferred_lifetime_bound<'bound, T: LifetimeLabel<'bound>>(value: &'bound T);

fn accept_concrete<'s0>(value: &'s0 Good) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call accept<Good>(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn accept_generic<'s0, T: Label>(value: &'s0 T) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call accept<T>(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn accept_auto_bounds<'s0, T: AutoClone + AutoDestroy>(value: &'s0 T) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: unit;
  entry:
    call accept_auto_clone<T>(copy value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    call accept_auto_destroy<T>(move value);
    $tmp_2 = unit;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn accept_static_lifetime_bound<'s0>(value: &'s0 Good) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call accept_lifetime_bound<'static, Good>(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn forward_inferred_lifetime_bound<'bound, T: LifetimeLabel<'bound>>(value: &'bound T) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call accept_inferred_lifetime_bound<'bound, T>(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn use_bounded_types<'s0, 's1, T: Label>(holder: &'s0 Holder<T>, maybe: &'s1 Maybe<T>) {
  $tmp_0: unit;
  $tmp_1: &Holder<T>;
  $tmp_2: &Maybe<T>;
  entry:
    $tmp_1 = move holder;
    unborrow $tmp_1;
    require_uninit $tmp_1;
    $tmp_2 = move maybe;
    unborrow $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit maybe;
    require_uninit holder;
    return
}

fn use_bounded_trait_argument<'s0, T: RequiresLabel<Good>>(value: &'s0 T) {
  $tmp_0: unit;
  $tmp_1: &T;
  entry:
    $tmp_1 = move value;
    unborrow $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn use_parameterized_bound<'s0, T: Related<i64>>(value: &'s0 T) {
  $tmp_0: unit;
  $tmp_1: &T;
  entry:
    $tmp_1 = move value;
    unborrow $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn use_later_bound_parameter<'s0, 's1, T: Related<U>, U>(value: &'s0 T, other: &'s1 U) {
  $tmp_0: unit;
  $tmp_1: &T;
  $tmp_2: &U;
  entry:
    $tmp_1 = move value;
    unborrow $tmp_1;
    require_uninit $tmp_1;
    $tmp_2 = move other;
    unborrow $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit other;
    require_uninit value;
    return
}

fn use_static_lifetime_holder<'s0>(value: &'s0 LifetimeHolder<'static, Good>) {
  $tmp_0: unit;
  $tmp_1: &LifetimeHolder<'static, Good>;
  entry:
    $tmp_1 = move value;
    unborrow $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

impl<T: Label> Wrapper<T> {
  fn inspect<'s0>(recv: &'s0 Wrapper<T>) {
    $tmp_0: unit;
    $tmp_1: &Wrapper<T>;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit recv;
      return
  }
}

fn inspect_good<'s0>(value: &'s0 Wrapper<Good>) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call <Wrapper<Good>>::inspect(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

trait Inspect {
  fn inspect_trait<'s0>(recv: &'s0 Self);
  fn inspect_trait_argument<'s0, 's1, U: Label>(recv: &'s0 Self, value: &'s1 U);
}

impl<T: Label> Inspect for Wrapper<T> {
  fn inspect_trait<'s0>(recv: &'s0 Wrapper<T>) {
    $tmp_0: unit;
    $tmp_1: &Wrapper<T>;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit recv;
      return
  }
  fn inspect_trait_argument<'s0, 's1, U: Label>(recv: &'s0 Wrapper<T>, value: &'s1 U) {
    $tmp_0: unit;
    $tmp_1: &Wrapper<T>;
    $tmp_2: &U;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_2 = move value;
      unborrow $tmp_2;
      require_uninit $tmp_2;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit value;
      require_uninit recv;
      return
  }
}

fn inspect_trait_good<'s0>(value: &'s0 Wrapper<Good>) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call <Wrapper<Good> as Inspect>::inspect_trait(move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit value;
    return
}

fn inspect_trait_argument_good<'s0, 's1>(value: &'s0 Wrapper<Good>, argument: &'s1 Good) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call <Wrapper<Good> as Inspect>::inspect_trait_argument<Good>(move value, move argument);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit argument;
    require_uninit value;
    return
}

impl Good {
  fn inspect_argument<'s0, 's1, U: Label>(recv: &'s0 Good, value: &'s1 U) {
    $tmp_0: unit;
    $tmp_1: &Good;
    $tmp_2: &U;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_2 = move value;
      unborrow $tmp_2;
      require_uninit $tmp_2;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit value;
      require_uninit recv;
      return
  }
  fn inspect_inferred_lifetime_argument<'bound, 's0, U: LifetimeLabel<'bound>>(recv: &'s0 Good, value: &'bound U) {
    $tmp_0: unit;
    $tmp_1: &Good;
    $tmp_2: &'bound U;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_2 = move value;
      unborrow $tmp_2;
      require_uninit $tmp_2;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit value;
      require_uninit recv;
      return
  }
  fn inspect_lifetime_argument<'bound, 's0, 's1, U: LifetimeLabel<'bound>>(recv: &'s0 Good, value: &'s1 U) {
    $tmp_0: unit;
    $tmp_1: &Good;
    $tmp_2: &U;
    entry:
      $tmp_1 = move recv;
      unborrow $tmp_1;
      require_uninit $tmp_1;
      $tmp_2 = move value;
      unborrow $tmp_2;
      require_uninit $tmp_2;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit value;
      require_uninit recv;
      return
  }
}

fn inspect_argument_good<'s0, 's1>(recv: &'s0 Good, value: &'s1 Good) {
  $tmp_0: unit;
  $tmp_1: unit;
  entry:
    call <Good>::inspect_argument<Good>(move recv, move value);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
