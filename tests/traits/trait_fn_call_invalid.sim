# Trait-method call resolution errors. Each `call` below exercises one
# failure mode; type-check errors don't short-circuit so all fire.
#
#   call site                                error
#   <Foo as Unknown>::any(...)               unknown trait
#   <Bar as Iter<i64>>::next(...)            no impl for that (trait, target)
#   <List as Iter<bool>>::next(...)          right target, wrong trait args
#                                            (List has Iter<i64>, not Iter<bool>)
#   <List as Iter<i64>>::missing(...)        impl exists but has no such method
#   <T as Iter<i64>>::next(...)              generic-param receiver, deferred
#   <Pair<i64, bool> as Same<i64>>::same(...) repeated generic impl binding
#                                               must agree across target args
#   <Pair<i64, i64> as Amb<i64>>::amb(...)     overlapping impl patterns
#   <Wrapper<Linear> as Bounded>::run(...)      inferred impl arg violates bound
#   <LifetimeBox<'a> as LifetimeTrait<'b>>      one impl lifetime must match in
#                                                the trait path and target

trait<T: Copy + Drop> Iter {
  fn next(recv: &mut Self, $return: &out T);
}

struct Foo: Copy + Drop { x: i64 }
struct Bar: Copy + Drop { y: i64 }
struct List: Copy + Drop { xs: [i64; 4] }

impl Iter<i64> for List {
  fn next(recv: &mut List, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

fn unknown_trait(f: &mut Foo, $return: &out i64) {
  out_ref: &out i64;
  entry:
    out_ref = &out $return.*;
    call <Foo as Unknown>::any(move f, move out_ref);
    return
}

fn no_impl(b: &mut Bar, $return: &out i64) {
  out_ref: &out i64;
  entry:
    out_ref = &out $return.*;
    call <Bar as Iter<i64>>::next(move b, move out_ref);
    return
}

fn wrong_trait_args(l: &mut List, $return: &out bool) {
  out_ref: &out bool;
  entry:
    out_ref = &out $return.*;
    call <List as Iter<bool>>::next(move l, move out_ref);
    return
}

fn no_method(l: &mut List, $return: &out i64) {
  out_ref: &out i64;
  entry:
    out_ref = &out $return.*;
    call <List as Iter<i64>>::missing(move l, move out_ref);
    return
}

fn<T> param_receiver(t: &mut T, $return: &out i64) {
  out_ref: &out i64;
  entry:
    out_ref = &out $return.*;
    call <T as Iter<i64>>::next(move t, move out_ref);
    return
}

trait<T: Copy + Drop> Same {
  fn same(recv: & Self);
}

struct<T: Copy + Drop, U: Copy + Drop> Pair: Copy + Drop {
  first: T,
  second: U,
}

impl<T: Copy + Drop> Same<T> for Pair<T, T> {
  fn same(recv: & Pair<T, T>) {
    entry:
      return
  }
}

fn inconsistent_impl_binding(pair: & Pair<i64, bool>) {
  entry:
    call <Pair<i64, bool> as Same<i64>>::same(move pair);
    return
}

trait<T: Copy + Drop> Amb {
  fn amb(recv: & Self);
}

impl<T: Copy + Drop> Amb<T> for Pair<T, i64> {
  fn amb(recv: & Pair<T, i64>) {
    entry:
      return
  }
}

impl<U: Copy + Drop> Amb<i64> for Pair<i64, U> {
  fn amb(recv: & Pair<i64, U>) {
    entry:
      return
  }
}

fn ambiguous_impl(pair: & Pair<i64, i64>) {
  entry:
    call <Pair<i64, i64> as Amb<i64>>::amb(move pair);
    return
}

trait Bounded {
  fn run(recv: & Self);
}

struct Linear {}
struct<T> Wrapper { value: T }

impl<T: Copy> Bounded for Wrapper<T> {
  fn run(recv: & Wrapper<T>) {
    entry:
      return
  }
}

fn impl_bound_mismatch(wrapper: & Wrapper<Linear>) {
  entry:
    call <Wrapper<Linear> as Bounded>::run(move wrapper);
    return
}

trait<'a> LifetimeTrait {
  fn inspect(recv: & Self);
}

struct<'a> LifetimeBox: Copy + Drop { value: & 'a i64 }

impl<'a> LifetimeTrait<'a> for LifetimeBox<'a> {
  fn inspect(recv: & LifetimeBox<'a>) {
    entry:
      return
  }
}

fn<'a, 'b> lifetime_impl_mismatch(value: & LifetimeBox<'a>) {
  entry:
    call <LifetimeBox<'a> as LifetimeTrait<'b>>::inspect(copy value);
    return
}
