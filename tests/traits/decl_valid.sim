# Trait and impl declarations parse, type-check, and round-trip through
# pretty-print. Each cell isolates one shape so a regression is
# localizable. Impls are the primary check; trait-only shapes without a
# matching impl exercise trait-declaration paths (uncommon receiver ref
# kinds, combined trait+method generics) that no impl demonstrates.
#
#   trait                            covers
#   Simple                           no generics; one method referencing Self
#   Iter<T>                          trait-level generic + Self
#   Combo<T>                         trait-level generic + method-level generic
#                                    on the same method
#   RefMethods                       method sig uses every &-kind
#                                    (Shared/Mut/Out/Drop/Uninit)
#   MgTrait                          method has its own type parameter
#   LifetimeContract                method outlives bounds survive positional
#                                    lifetime-parameter renaming in the impl
#   LtTrait<'a>                      trait has a lifetime parameter
#   SelfAlias, SelfLocal, SelfInBody Self desugars in receiver, local, and
#                                    body-operand positions
#
#   impl                             covers
#   Simple for Foo                   non-generic trait + concrete target
#   Iter<i64> for List               generic trait + concrete target
#   Iter<T> for Bag<T>               generic trait + generic target
#   MgTrait for Foo                  method type-param preserved through impl
#   LtTrait<'a> for LtHolder<'a>     lifetime-param supplied to trait ref
#   SelfAlias for Bag<T>             Self := target for each ref kind
#   SelfLocal for Foo                Self inside body local
#   SelfInBody for Foo               Self inside body operands
#   LtTrait<'s0> for LtHolder<'s0>   impl-header 'sN skiplist for elision
#   AutoClone/AutoDestroy for Foo    compiler-provided traits are in scope and
#                                    their method signatures use Self correctly
#   Bag<T> (two inherent blocks)     generic inherent impls, Self substitution,
#                                    body analyses, and split blocks

# Trait-only shapes with no accompanying impl.
trait<T> Combo {
  fn<U> map(recv: &Self, other: &U, $return: &out T);
}

trait RefMethods {
  fn shared(recv: &Self);
  fn mut_(recv: &mut Self);
  fn out_(recv: &out Self);
  fn drop_(recv: &drop Self);
  fn uninit(recv: &uninit Self);
}

trait Simple {
  fn ping(recv: &Self);
}

trait<T: Copy + Drop> Iter {
  fn next(recv: &mut Self, $return: &out T);
}

struct Foo: Copy + Drop { x: i64 }

struct List: Copy + Drop { xs: [i64; 4] }

struct<T: Copy + Drop> Bag: Copy + Drop { inner: T }

impl Simple for Foo {
  fn ping(recv: &Foo) {
    entry:
      return
  }
}

impl Iter<i64> for List {
  fn next(recv: &mut List, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

impl<T: Copy + Drop> Iter<T> for Bag<T> {
  fn next(recv: &mut Bag<T>, $return: &out T) {
    entry:
      $return.* = copy recv.*.inner;
      return
  }
}

# Trait method with its own type parameter: impl must preserve the
# generic (may rename it), not specialize it away.
trait MgTrait {
  fn<U: Copy + Drop> ignore(recv: &Self, other: &U);
}

impl MgTrait for Foo {
  fn<V: Copy + Drop> ignore(recv: &Self, other: &V) {
    entry:
      return
  }
}

trait<'a> LifetimeContract {
  fn<'b: 'a> relate(recv: &Self, earlier: &'a i64, later: &'b i64);
}

impl<'x> LifetimeContract<'x> for Foo {
  fn<'y: 'x> relate(recv: &Foo, earlier: &'x i64, later: &'y i64) {
    entry:
      return
  }
}

# Trait with a lifetime parameter: impl must supply exact-arity
# lifetime args in the trait ref.
struct<'a> LtHolder: Copy + Drop { p: &'a i64 }

trait<'a> LtTrait {
  fn peek(recv: &Self);
}

impl<'a> LtTrait<'a> for LtHolder<'a> {
  fn peek(recv: &Self) {
    entry:
      return
  }
}

# `Self` inside an impl method is a scoped alias for the target type;
# after desugar these are indistinguishable from spelling the target
# out. Covers the three ref kinds a method receiver commonly uses,
# against a generic target so the substitution has non-trivial content.
trait SelfAlias {
  fn s(recv: &Self);
  fn m(recv: &mut Self);
  fn d(recv: &drop Self);
}

impl<T: Copy + Drop> SelfAlias for Bag<T> {
  fn s(recv: &Self) {
    entry:
      return
  }
  fn m(recv: &mut Self) {
    entry:
      return
  }
  fn d(recv: &drop Self) {
    entry:
      drop recv.*;
      return
  }
}

# `Self` inside an impl-method body local also desugars to the target
# type. Covers the local-declaration position, which the parser routes
# through the same `type_scope` as parameter types.
trait SelfLocal {
  fn foo(recv: &Self);
}

impl SelfLocal for Foo {
  fn foo(recv: &Self) {
    p: &Self;
    entry:
      p = copy recv;
      return
  }
}

# `Self` inside body-position operand type slots — generic-fn callee
# type args and trait-fn callee `self_ty` — also desugars to the
# target. Uses `Simple` (declared above) as the trait dispatched
# through, and a small generic free fn as the FnName callee.
fn<T: Copy + Drop> visit_ref(r: &T) {
  entry:
    return
}

trait SelfInBody {
  fn dispatch(recv: &Self);
}

impl SelfInBody for Foo {
  fn dispatch(recv: &Self) {
    entry:
      call visit_ref<Self>(copy recv);
      call <Self as Simple>::ping(copy recv);
      return
  }
}

# Impl-header lifetime seed for elision: the method's unnamed ref
# elides to a fresh `'sN`. Without seeding the fresh-name skiplist
# with the impl-header's own lifetime param `'s0`, elision would
# regenerate `'s0` for the method and shadow the header.
impl<'s0> LtTrait<'s0> for LtHolder<'s0> {
  fn peek(recv: &Self) {
    entry:
      return
  }
}

# Drop elaboration visits impl methods and resolves method-generic bounds.
trait Discard {
  fn<T: Drop> discard(recv: &Self, value: T);
}

impl Discard for Foo {
  fn<T: Drop> discard(recv: &Foo, value: T) {
    entry:
      return
  }
}

impl AutoClone for Foo {
  fn clone(recv: &Foo, $return: &out Foo) {
    entry:
      $return.* = copy recv.*;
      return
  }
}

impl AutoDestroy for Foo {
  fn destroy(recv: &drop Foo) {
    entry:
      drop recv.*;
      return
  }
}

# Inherent impls use the same combined impl-header/method environment and
# participate in body checking and elaboration. Multiple blocks for one
# target are legal when their method names are distinct.
impl<T: Copy + Drop> Bag<T> {
  fn make(value: T, $return: &out Self) {
    entry:
      $return.*.inner = copy value;
      return
  }
}

impl<T: Copy + Drop> Bag<T> {
  fn get(recv: &Self, $return: &out T) {
    entry:
      $return.* = copy recv.*.inner;
      return
  }
}

# Direct trait bounds round-trip through MIR and discharge generic obligations.
trait DirectBound {}
trait<'a> LifetimeDirectBound {}
trait<'a, 'b: 'a> OrderedDirectBound {}

impl DirectBound for Foo {}

struct<T: DirectBound> DirectBox { value: T }

extern fn<T: DirectBound> accept_direct(value: &T);

# covers: an exact caller bound satisfies a direct callee obligation
fn<T: DirectBound> forward_direct(value: &T) {
  entry:
    call accept_direct<T>(copy value);
    return
}

# covers: declared lifetimes are available in direct trait bounds
extern fn<'a, T: LifetimeDirectBound<'a>> accept_lifetime_direct(value: &'a T);

# covers: direct bounds inherit the bounded trait's lifetime requirements
extern fn<'a, 'b: 'a, T: OrderedDirectBound<'a, 'b>> accept_ordered_direct(value: &'b T);
