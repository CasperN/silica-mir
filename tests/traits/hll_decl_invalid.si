# HLL declarations reach the MIR trait checker for cross-declaration rules.
#
# covers: unknown traits, trait-argument arity, missing and extra methods,
# signature and method-generic mismatch, impl-method lifetime shadowing,
# invalid inherent targets, duplicate inherent methods across blocks, and
# ABI-on-method rules (unknown ABI, unsafe requirement, trait/impl ABI parity)

struct S: Copy + Drop { value: i64 }

trait Required {
  fn required(recv: &Self);
}

impl Unknown for S {
  fn ignored(recv: &Self) { unit }
}

impl Required for S {
  fn extra(recv: &Self) { unit }
}

trait Result {
  fn result(recv: &Self) -> i64;
}

impl Result for S {
  fn result(recv: &Self) -> bool { false }
}

trait Lifetime<'a> {
  fn lifetime<'b>(recv: &'b Self);
}

impl<'a> Lifetime<'a> for S {
  fn lifetime<'a>(recv: &'a Self) { unit }
}

trait GenericTrait<T: Copy + Drop> {
  fn generic(recv: &Self, value: T);
}

impl GenericTrait for S {
  fn generic(recv: &Self, value: i64) { unit }
}

trait MethodGeneric {
  fn method_generic<T: Copy + Drop>(recv: &Self, value: T);
}

impl MethodGeneric for S {
  fn method_generic(recv: &Self, value: i64) { unit }
}

# Inherent impl targets must be nominal types.
impl i64 {
  fn invalid_target(recv: &Self) { unit }
}

# Multiple blocks are legal, but cannot redeclare a method for the same target.
impl S {
  fn duplicate(recv: &Self) { unit }
}

impl S {
  fn duplicate(recv: &Self) { unit }
}

# Trait declares a C-ABI method; impl provides a Silica-ABI body.
trait AbiParityCTrait {
  extern "C" unsafe fn c_method(recv: &Self);
}

impl AbiParityCTrait for S {
  unsafe fn c_method(recv: &Self) { unit }
}

# Trait declares a Silica-ABI method; impl provides a C-ABI body.
trait AbiParitySilicaTrait {
  unsafe fn silica_method(recv: &Self);
}

impl AbiParitySilicaTrait for S {
  extern "C" unsafe fn silica_method(recv: &Self) { unit }
}
