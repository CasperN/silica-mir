# Trait- and impl-declaration well-formedness errors that fire from
# the type checker or env-build (coherence). Parser-time errors
# (body-less/extern method, duplicate method names, `Self`
# reservation) live in the sibling `parse_errors.sim`.
#
#   context                          error
#   struct + trait share a name      DuplicateDeclaration
#   trait method sig refs Missing    InvalidDeclaredType (unknown type)
#   trait method lifetime shadowing  DuplicateLifetimeParam
#
#   impl Unknown for Foo             ImplForUnknownTrait
#   impl Iter for Foo                ImplTraitArgArity (0 vs 1 type arg)
#   impl Trait for Foo (extra fn)    ImplMethodNotInTrait
#   impl Trait for Foo (missing fn)  ImplMissingTraitMethod
#   impl TraitS for Foo (bad sig)    ImplMethodSignatureMismatch
#   impl BadBody for Foo             AssignmentTypeMismatch (body typecheck)
#   impl MgTrait for Foo             ImplMethodSignatureMismatch (dropped generic)
#   impl method lifetime bounds      ImplMethodSignatureMismatch when either
#                                    weaker or stronger than the trait method
#   impl LtTrait for Foo             ImplTraitArgArity (0 vs 1 lifetime arg)
#
#   two impls of Iter<i64> for       DuplicateDeclaration (coherence)
#     DupTarget
#
#   impl target unknown              InvalidDeclaredType — sole error,
#                                    conformance must be skipped so
#                                    the target failure doesn't fan out
#                                    into per-method SignatureMismatch
#   impl Iter<MissingArg>            InvalidDeclaredType on the trait
#                                    arg — same bail, sole diagnostic
#   inherent impls                   invalid scalar target, duplicate methods,
#                                    lifetime shadowing, and body analyses

# --- Trait declaration errors ------------------------------------------

struct Duplicated {
  x: i64
}

trait Duplicated {
  fn ping(recv: &Self);
}

trait IterMissingT {
  fn next(recv: &mut Self, out: &Missing);
}

trait TraitLifetimeShadow<'a> {
  fn borrow<'a>(recv: &'a Self);
}

# --- Impl declaration errors -------------------------------------------

struct Foo: Copy + Drop { x: i64 }

trait Trait {
  fn a(recv: &Self);
  fn b(recv: &Self);
}

trait Iter<T: Copy + Drop> {
  fn next(recv: &mut Self, $return: &out T);
}

# Unknown trait name.
impl Unknown for Foo {
  fn zap(recv: &Foo) {
    entry:
      return
  }
}

# Wrong number of trait type args (Iter takes 1, got 0).
impl Iter for Foo {
  fn next(recv: &mut Foo, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

# Extra method + missing method (Trait wants `a` and `b`; impl gives
# `a` and `extra`).
impl Trait for Foo {
  fn a(recv: &Foo) {
    entry:
      return
  }
  fn extra(recv: &Foo) {
    entry:
      return
  }
}

# Signature mismatch: trait says `recv: &Self` (shared ref), impl says
# `recv: &mut Foo` (mut ref). After Self := Foo the expected shape is
# `&Foo`, not `&mut Foo`.
trait TraitS {
  fn touch(recv: &Self);
}

impl TraitS for Foo {
  fn touch(recv: &mut Foo) {
    entry:
      return
  }
}

# Method body has a type error: assigning i64 to a bool local. The
# type checker sees this because `typecheck_impl` checks each method
# with its impl-header and method-level generics in scope.
trait BadBody {
  fn go(recv: &Self);
}

impl BadBody for Foo {
  fn go(recv: &Foo) {
    flag: bool;
    entry:
      flag = 0i64;
      return
  }
}

# Method-generic mismatch: the trait's method takes a `<U>` parameter;
# the impl drops the method generic and specializes to i64.
trait MgTrait {
  fn pick<U>(recv: &Self, $return: &out U);
}

impl MgTrait for Foo {
  fn pick(recv: &Foo, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

# Method lifetime bounds are part of the trait contract. An impl may rename
# lifetime parameters, but it may neither omit a required relationship nor
# impose an additional one.
trait BoundedMethod<'a> {
  fn relate<'b: 'a>(recv: &Self, earlier: &'a i64, later: &'b i64);
}

impl<'x> BoundedMethod<'x> for Foo {
  fn relate<'y>(recv: &Foo, earlier: &'x i64, later: &'y i64) {
    entry:
      return
  }
}

trait UnboundedMethod {
  fn accept<'a, 'b>(recv: &Self, first: &'a i64, second: &'b i64);
}

impl UnboundedMethod for Foo {
  fn accept<'x, 'y: 'x>(recv: &Foo, first: &'x i64, second: &'y i64) {
    entry:
      return
  }
}

# Trait has a lifetime parameter but the impl omits the lifetime arg.
# Impls skip elision, so an exact-arity match is required.
trait LtTrait<'a> {
  fn peek(recv: &Self);
}

impl LtTrait for Foo {
  fn peek(recv: &Foo) {
    entry:
      return
  }
}

# --- Coherence: duplicate impl ------------------------------------------

# Two impls of the same trait for the same target type are rejected
# at env-build time. Impl-table keying is structural
# `(trait_path, target)` equality; two `impl Iter<i64> for DupTarget`
# blocks collide even if their bodies differ.
struct DupTarget: Copy + Drop { x: i64 }

impl Iter<i64> for DupTarget {
  fn next(recv: &mut DupTarget, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

impl Iter<i64> for DupTarget {
  fn next(recv: &mut DupTarget, $return: &out i64) {
    entry:
      $return.* = 7;
      return
  }
}

# --- Impl signature-input validation ------------------------------------

# When the impl's target (or a trait-ref type arg) is well-formed
# syntactically but doesn't validate — e.g. it names an undeclared
# type — `typecheck_impl` must emit only that primary error and skip
# method-signature conformance. Otherwise every method downstream of
# `Self := <bad target>` fans out into a `SignatureMismatch` cascade.
impl Iter<i64> for MissingTarget {
  fn next(recv: &mut MissingTarget, $return: &out i64) {
    entry:
      $return.* = 0;
      return
  }
}

# Same bail, this time triggered by a bad trait-ref type argument
# (target is well-formed, the trait arg is not). The single
# `InvalidDeclaredType` on the trait arg is the only diagnostic;
# no per-method `SignatureMismatch` on the trait arg's substitution.
impl Iter<MissingArg> for Foo {
  fn next(recv: &mut Foo, $return: &out MissingArg) {
    entry:
      unreachable
  }
}

# --- Impl method body checking -----------------------------------------

# The substructural statement checker visits impl methods with their impl-header
# generic parameters in scope. Move does not imply Copy.
extern fn consume<T: Move>(value: T);

struct Box<T> { value: T }

trait BadSub<T: Move> {
  fn duplicate(recv: &Self, value: T);
}

impl<T: Move> BadSub<T> for Box<T> {
  fn duplicate(recv: &Box<T>, value: T) {
    duplicate: T;
    entry:
      duplicate = copy value;
      call consume<T>(move value);
      call consume<T>(move duplicate);
      return
  }
}

# The substructural checker also visits methods stored in inherent impl blocks.
impl<T: Move> Box<T> {
  fn inherent_duplicate(value: T) {
    duplicate: T;
    entry:
      duplicate = copy value;
      call consume<T>(move value);
      call consume<T>(move duplicate);
      return
  }
}

# An impl method cannot redeclare a lifetime from its impl header. Named
# lifetimes are shared across the combined LocalEnv and cannot shadow.
trait LifetimeShadow<'a> {
  fn borrow<'b>(recv: &'b Self);
}

impl<'a> LifetimeShadow<'a> for Foo {
  fn borrow<'a>(recv: &'a Foo) {
    entry:
      return
  }
}

impl<'a> Foo {
  fn inherent_borrow<'a>(recv: &'a Self) {
    entry:
      return
  }
}

# Inherent impl targets must be declared nominal types.
impl i64 {
  fn invalid_target(recv: &Self) {
    entry:
      return
  }
}

# Separate inherent blocks may add methods, but may not redeclare one for the
# same exact target.
impl Foo {
  fn duplicate(recv: &Self) {
    entry:
      return
  }
}

impl Foo {
  fn duplicate(recv: &Self) {
    entry:
      return
  }
}

# Inherent methods participate in ordinary MIR body type checking.
impl Foo {
  fn invalid_body(recv: &Self) {
    flag: bool;
    entry:
      flag = 0i64;
      return
  }
}

# --- Direct generic trait-bound errors ---------------------------------

trait DirectBound {}
trait GenericBound<T> {}
trait LifetimeDirectBound<'a> {}
trait OrderedDirectBound<'a, 'b: 'a> {}
struct Other: Copy + Drop { value: i64 }

# covers: MIR bounds must name a declared trait
extern fn unknown_direct_bound<T: MissingBound>(value: &T);

# covers: MIR bounds must supply the trait's declared generic arity
extern fn wrong_direct_bound_arity<T: GenericBound>(value: &T);

# covers: MIR trait bounds reject undeclared lifetime arguments
extern fn unknown_direct_bound_lifetime<T: LifetimeDirectBound<'missing>>(value: &T);

# covers: a direct bound's trait lifetime requirements must be declared by its owner
extern fn missing_direct_bound_outlives<'a, 'b, T: OrderedDirectBound<'a, 'b>>(value: &'b T);

extern fn accept_direct<T: DirectBound>(value: &T);

# covers: MIR call type arguments must satisfy direct trait bounds
fn reject_direct_bound(value: &Other) {
  entry:
    call accept_direct<Other>(copy value);
    return
}

# --- Trait self-bound errors --------------------------------------------

trait MirCycleFirst: MirCycleSecond {}
trait MirCycleSecond: MirCycleFirst {}

trait MirExpandingCycle<X>: MirExpandingCycle<[X; 1]> {}

trait MirUnrelated {
  fn unrelated(recv: &Self);
}

# covers: transitive MIR bound checking terminates on argument-expanding cycles
fn mir_expanding_cycle_lookup<T: MirExpandingCycle<i64>>(value: &T) {
  entry:
    call <T as MirUnrelated>::unrelated(copy value);
    return
}

trait MirOrderedSuper<'a, 'b: 'a> {}

# covers: supertrait lifetime requirements must follow from the child trait
trait MirMissingSuperOutlives<'a, 'b>: MirOrderedSuper<'a, 'b> {}

trait MirParent {}
trait MirChild: MirParent + Copy {}
struct MirLinear {}

# covers: MIR impls must satisfy marker and trait self-bounds
impl MirChild for MirLinear {}
