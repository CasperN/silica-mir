struct<T: Copy + Drop> Box: Copy + Drop {
  value: T
}

enum Choice: Copy + Drop {
  Empty: unit
}

trait RefKinds {
  fn<'s0> shared(recv: & 's0 Self);
  fn<'s0> mutable(recv: &mut 's0 Self);
  fn<'s0> output(recv: &out 's0 Self);
  fn<'s0> dropping(recv: &drop 's0 Self);
  fn<'s0> uninitialized(recv: &uninit 's0 Self);
}

trait<T: Copy + Drop> Convert {
  fn<'s0, 's1, U: Copy + Drop> convert(recv: & 's0 Self, ignored: U, $return: &out 's1 T);
}

impl<T: Copy + Drop> Convert<T> for Box<T> {
  fn<'s0, 's1, U: Copy + Drop> convert(recv: & 's0 Box<T>, ignored: U, $return: &out 's1 T) {
    entry:
      $return.* = copy recv.*.value;
      unborrow $return;
      unborrow recv;
      require_uninit $return;
      drop ignored;
      require_uninit ignored;
      require_uninit recv;
      return
  }
}

trait<'a> Observe {
  fn observe(recv: & 'a Self);
}

impl<'a, T: Copy + Drop> Observe<'a> for Box<T> {
  fn observe(recv: & 'a Box<T>) {
    $tmp_0: unit;
    local: Box<T>;
    entry:
      local.value = copy recv.*.value;
      unborrow recv;
      $tmp_0 = unit;
      drop local;
      require_uninit local;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit recv;
      return
  }
}

trait Make {
  fn<'s0> make($return: &out 's0 Self);
}

impl Make for Choice {
  fn<'s0> make($return: &out 's0 Choice) {
    entry:
      $return.* = Choice::Empty(unit);
      unborrow $return;
      require_uninit $return;
      return
  }
}
