struct Box<T: Copy + Drop>: Copy + Drop {
  value: T
}

enum Choice: Copy + Drop {
  Empty: $Tuple0
}

trait RefKinds {
  fn shared<'s0>(recv: &'s0 Self);
  fn mutable<'s0>(recv: &'s0 mut Self);
  fn output<'s0>(recv: &'s0 out Self);
  fn dropping<'s0>(recv: &'s0 drop Self);
  fn uninitialized<'s0>(recv: &'s0 uninit Self);
}

trait Convert<T: Copy + Drop> {
  fn convert<'s0, 's1, U: Copy + Drop>(recv: &'s0 Self, ignored: U, $return: &'s1 out T);
}

impl<T: Copy + Drop> Convert<T> for Box<T> {
  fn convert<'s0, 's1, U: Copy + Drop>(recv: &'s0 Box<T>, ignored: U, $return: &'s1 out T) {
    entry:
      $return.* = copy recv.*.value;
      unborrow $return;
      require_uninit $return;
      drop ignored;
      require_uninit ignored;
      drop recv;
      require_uninit recv;
      return
  }
}

trait Observe<'a> {
  fn observe(recv: &'a Self);
}

impl<'a, T: Copy + Drop> Observe<'a> for Box<T> {
  fn observe(recv: &'a Box<T>) {
    $tmp_0: $Tuple0;
    local: Box<T>;
    entry:
      local.value = copy recv.*.value;
      $tmp_0 = $Tuple0 {};
      drop local;
      require_uninit local;
      drop $tmp_0;
      require_uninit $tmp_0;
      drop recv;
      require_uninit recv;
      return
  }
}

trait Make {
  fn make<'s0>($return: &'s0 out Self);
}

impl Make for Choice {
  fn make<'s0>($return: &'s0 out Choice) {
    $tmp_0: $Tuple0;
    entry:
      $tmp_0 = $Tuple0 {};
      $return.* = Choice::Empty(move $tmp_0);
      unborrow $return;
      require_uninit $tmp_0;
      require_uninit $return;
      return
  }
}

impl<T: Copy + Drop> Box<T> {
  fn make<'s0>(value: T, $return: &'s0 out Box<T>) {
    entry:
      $return.*.value = move value;
      unborrow $return;
      require_uninit $return;
      require_uninit value;
      return
  }
}

impl<T: Copy + Drop> Box<T> {
  fn get<'s0, 's1>(recv: &'s0 Box<T>, $return: &'s1 out T) {
    entry:
      $return.* = copy recv.*.value;
      unborrow $return;
      require_uninit $return;
      drop recv;
      require_uninit recv;
      return
  }
}

impl Choice {
  fn empty<'s0>($return: &'s0 out Choice) {
    $tmp_0: $Tuple0;
    entry:
      $tmp_0 = $Tuple0 {};
      $return.* = Choice::Empty(move $tmp_0);
      unborrow $return;
      require_uninit $tmp_0;
      require_uninit $return;
      return
  }
}
