# Two impl methods with the same name are rejected at parse time.
# Parse errors short-circuit; see sibling fixtures for the other
# impl-method parse rejections.

struct S { x: i64 }

trait T {
  fn m(recv: & Self);
}

impl T for S {
  fn m(recv: & S) {
    entry:
      return
  }
  fn m(recv: & S) {
    entry:
      return
  }
}
