# Receiver-call diagnostics cover ambiguity and the absence of a callable
# interpretation.

struct AmbiguousTraitTarget: Copy + Drop { value: i64 }

trait First {
  fn collide(recv: AmbiguousTraitTarget);
}

trait Second {
  fn collide(recv: AmbiguousTraitTarget);
}

impl First for AmbiguousTraitTarget {
  fn collide(recv: AmbiguousTraitTarget) { unit }
}

impl Second for AmbiguousTraitTarget {
  fn collide(recv: AmbiguousTraitTarget) { unit }
}

# covers: multiple applicable trait methods in one tier are ambiguous
fn ambiguous_trait(value: AmbiguousTraitTarget) {
  value.collide();
}

struct Missing: Copy + Drop { value: i64 }

# covers: no method, callable field, or free function applies
fn unresolved(value: Missing) {
  value.unknown();
}

struct WrongArity: Copy + Drop { value: i64 }

impl WrongArity {
  fn takes_argument(recv: WrongArity, value: i64) { unit }
}

# covers: receiver is included in method-call arity checking
fn wrong_arity(value: WrongArity) {
  value.takes_argument();
}

struct<T: Copy + Drop> Overlap: Copy + Drop { value: T }

impl<T: Copy + Drop> Overlap<T> {
  fn duplicate(recv: Overlap<T>) { unit }
}

impl Overlap<i64> {
  fn duplicate(recv: Overlap<i64>) { unit }
}

# covers: multiple applicable inherent methods in one tier are ambiguous
fn ambiguous_inherent(value: Overlap<i64>) {
  value.duplicate();
}

struct Callable: Copy + Drop { generic: fn(i64) }

# covers: explicit generic arguments cannot apply to a callable field
fn generic_args_on_field(value: Callable) {
  value.generic<i64>(1);
}

unsafe fn unsafe_free(recv: Missing) {}

# covers: free UFCS preserves ordinary unsafe-call checking
fn unsafe_free_without_block(value: Missing) {
  value.unsafe_free();
}

struct Linear { value: i64 }
struct<T: Copy + Drop> Generic: Copy + Drop { value: T }

impl<T: Copy + Drop> Generic<T> {
  fn<U: Copy + Drop> bounded(recv: Generic<T>, value: U) { unit }
}

# covers: inferred receiver impl arguments do not bypass method bounds
fn method_bound_failure(value: Generic<i64>, linear: Linear) {
  value.bounded<Linear>(linear);
}

struct BorrowAmbiguous: Copy + Drop { value: i64 }

trait BorrowFirst {
  fn borrow_collision(recv: &BorrowAmbiguous);
}

trait BorrowSecond {
  fn borrow_collision(recv: &BorrowAmbiguous);
}

impl BorrowFirst for BorrowAmbiguous {
  fn borrow_collision(recv: &BorrowAmbiguous) { unit }
}

impl BorrowSecond for BorrowAmbiguous {
  fn borrow_collision(recv: &BorrowAmbiguous) { unit }
}

# covers: multiple auto-borrow candidates in one tier are ambiguous
fn ambiguous_auto_borrow(value: BorrowAmbiguous) {
  value.borrow_collision();
}

fn no_receiver() {}

# covers: free UFCS requires a receiver parameter
fn free_without_receiver(value: Missing) {
  value.no_receiver();
}

struct UnsafeMethodTarget: Copy + Drop { value: i64 }

trait UnsafeCall {
  unsafe fn trait_dangerous(recv: &Self);
}

impl UnsafeCall for UnsafeMethodTarget {
  unsafe fn trait_dangerous(recv: &Self) { unit }
}

impl UnsafeMethodTarget {
  unsafe fn inherent_dangerous(recv: &Self) { unit }
}

# covers: unsafe trait methods cannot be called from a safe context
fn unsafe_trait_call(value: UnsafeMethodTarget) {
  value.trait_dangerous();
}

# covers: unsafe inherent methods cannot be called from a safe context
fn unsafe_inherent_call(value: UnsafeMethodTarget) {
  value.inherent_dangerous();
}

trait SafeContract {
  fn safety_mismatch(recv: &Self);
}

impl SafeContract for UnsafeMethodTarget {
  unsafe fn safety_mismatch(recv: &Self) { unit }
}

trait UnsafeContract {
  unsafe fn other_safety_mismatch(recv: &Self);
}

impl UnsafeContract for UnsafeMethodTarget {
  fn other_safety_mismatch(recv: &Self) { unit }
}

trait BoundFirst {
  fn bound_collision(recv: &Self);
}

trait BoundSecond {
  fn bound_collision(recv: &Self);
}

# covers: multiple direct bounds with the same applicable method are ambiguous
fn<T: BoundFirst + BoundSecond> ambiguous_bound_method(value: &T) {
  value.bound_collision();
}

trait DirectCollision {
  fn mixed_collision(recv: &Self);
}

trait ReferenceCollision {
  fn mixed_collision(recv: Self);
}

impl<U> ReferenceCollision for &U {
  fn mixed_collision(recv: Self) { recv; }
}

# covers: bound and concrete-reference candidates share one ambiguity tier
fn<T: DirectCollision> ambiguous_bound_and_impl(value: &T) {
  value.mixed_collision();
}

trait BoundArgument {
  fn qualified_required(recv: &Self);
}
trait GenericBoundMethod {
  fn<U: BoundArgument> bound_generic(recv: &Self, value: &U);
  unsafe fn bound_unsafe(recv: &Self);
}

struct WrongBoundArgument: Copy + Drop { value: i64 }

# covers: generic arguments on direct-bound methods retain their obligations
fn<T: GenericBoundMethod> reject_bound_method_argument(
  value: &T,
  argument: &WrongBoundArgument,
) {
  value.bound_generic<WrongBoundArgument>(argument);
}

# covers: unsafe direct-bound methods still require an unsafe context
fn<T: GenericBoundMethod> reject_bound_unsafe(value: &T) {
  value.bound_unsafe();
}

# covers: a generic receiver without the declaring bound has no method candidate
fn<T> reject_unbounded_receiver(value: &T) {
  value.bound_generic<WrongBoundArgument>(value);
}

trait MissingSupertraitUse: MissingSupertrait {}

trait<X> GenericSupertrait {}
trait WrongSupertraitArity: GenericSupertrait {}

trait CycleFirst: CycleSecond {}
trait CycleSecond: CycleFirst {}

trait<X> ExpandingCycle: ExpandingCycle<[X; 1]> {}

# covers: a cycle that changes type arguments still terminates method lookup
fn<T: ExpandingCycle<i64>> expanding_cycle_lookup(value: &T) {
  value.missing_cycle_method();
}

trait RequiresCopySelf: Copy {}
struct LinearSupertraitTarget {}

# covers: implementing a trait requires its marker self-bounds
impl RequiresCopySelf for LinearSupertraitTarget {}

trait<X: Copy + Drop> RequiredParent {}
trait<X: Copy + Drop> RequiresParent: RequiredParent<X> {}

struct WrongSupertraitArgument: Copy + Drop { value: i64 }
impl RequiredParent<bool> for WrongSupertraitArgument {}

# covers: implementing a trait requires the correctly instantiated supertrait
impl RequiresParent<i64> for WrongSupertraitArgument {}

trait<X: Copy + Drop> InheritedCollision {
  fn inherited_collision(recv: &Self);
}

trait CollisionLeft: InheritedCollision<i64> {}
trait CollisionRight: InheritedCollision<bool> {}
trait CollisionDiamond: CollisionLeft + CollisionRight {}

# covers: differently instantiated inherited methods remain ambiguous
fn<T: CollisionDiamond> ambiguous_inherited_method(value: &T) {
  value.inherited_collision();
}

trait RedeclaredParent {
  fn redeclared(recv: &Self);
}

trait RedeclaredChild: RedeclaredParent {
  fn redeclared(recv: &Self);
}

# covers: a child declaration does not silently override a supertrait method
fn<T: RedeclaredChild> ambiguous_redeclared_method(value: &T) {
  value.redeclared();
}

trait InheritedRequirementsParent {
  fn<U: Copy + Drop> inherited_bounded(recv: &Self, value: U);
  unsafe fn inherited_dangerous(recv: &Self);
}

trait InheritedRequirementsChild: InheritedRequirementsParent {}

# covers: inherited methods retain their method-generic obligations
fn<T: InheritedRequirementsChild> reject_inherited_method_argument(
  value: &T,
  argument: LinearSupertraitTarget,
) {
  value.inherited_bounded<LinearSupertraitTarget>(argument);
}

# covers: inherited unsafe methods retain their safety requirement
fn<T: InheritedRequirementsChild> reject_inherited_unsafe(value: &T) {
  value.inherited_dangerous();
}

trait MissingGenericImplParent {}
trait MissingGenericImplChild: MissingGenericImplParent {}

# covers: a generic impl must declare evidence for its supertrait obligation
impl<T> MissingGenericImplChild for T {}

# covers: qualified trait calls require the selected implementation
fn qualified_missing_impl(value: &WrongBoundArgument) {
  <WrongBoundArgument as BoundArgument>::qualified_required(value);
}

trait QualifiedParent {
  fn parent_only(recv: &Self);
}

trait QualifiedChild: QualifiedParent {}

# covers: qualification names methods declared by the selected trait itself
fn<T: QualifiedChild> qualified_child_does_not_alias_parent(value: &T) {
  <T as QualifiedChild>::parent_only(value);
}

# covers: qualified inherent calls require an applicable named method
fn qualified_missing_inherent(value: &WrongBoundArgument) {
  <WrongBoundArgument>::missing(value);
}

# covers: qualified trait paths retain generic arity checking
fn<T: GenericSupertrait<i64>> qualified_wrong_trait_arity(value: &T) {
  <T as GenericSupertrait>::missing(value);
}

# covers: qualified unsafe trait calls require an unsafe context
fn qualified_unsafe_trait(value: &UnsafeMethodTarget) {
  <UnsafeMethodTarget as UnsafeCall>::trait_dangerous(value);
}

# covers: qualified unsafe inherent calls require an unsafe context
fn qualified_unsafe_inherent(value: &UnsafeMethodTarget) {
  <UnsafeMethodTarget>::inherent_dangerous(value);
}

trait QualifiedExplicitBorrow {
  fn needs_explicit_borrow(recv: &Self);
}

impl QualifiedExplicitBorrow for WrongBoundArgument {
  fn needs_explicit_borrow(recv: &Self) { recv; }
}

# covers: qualified calls do not apply receiver-syntax auto-borrowing
fn qualified_does_not_auto_borrow(value: WrongBoundArgument) {
  <WrongBoundArgument as QualifiedExplicitBorrow>::needs_explicit_borrow(value);
}

# covers: qualified trait calls reject undeclared traits
fn qualified_unknown_trait(value: &WrongBoundArgument) {
  <WrongBoundArgument as MissingQualifiedTrait>::missing(value);
}

trait<'a> QualifiedLifetime {}

# covers: qualified trait paths reject undeclared lifetime arguments
fn<T> qualified_unknown_lifetime(value: &T) {
  <T as QualifiedLifetime<'missing>>::missing(value);
}

trait<X: Copy + Drop> QualifiedBoundedArgument {}

# covers: qualified trait paths retain trait-argument bounds
fn qualified_bad_trait_argument(value: &WrongBoundArgument) {
  <WrongBoundArgument as QualifiedBoundedArgument<LinearSupertraitTarget>>::missing(value);
}

# covers: explicit inherent qualification does not hide overlapping impls
fn ambiguous_qualified_inherent(value: Overlap<i64>) {
  <Overlap<i64>>::duplicate(value);
}

# covers: qualified methods retain method-generic obligations
fn qualified_method_bound_failure(value: Generic<i64>, linear: Linear) {
  <Generic<i64>>::bounded<Linear>(value, linear);
}

struct StaticTarget: Copy + Drop {
  value: i64,
}

impl StaticTarget {
  fn create(value: i64) -> StaticTarget {
    StaticTarget { value: value }
  }
}

# covers: static call to nonexistent inherent method on known type
fn static_nonexistent_method() {
  StaticTarget::nonexistent();
}

# covers: static method call arity mismatch
fn static_arity_mismatch() {
  StaticTarget::create(1, 2);
}

# covers: static method call argument type mismatch
fn static_type_mismatch() {
  StaticTarget::create(true);
}

# covers: scoped path on undeclared type
fn static_undeclared_type() {
  UndeclaredType::new();
}

enum CollidingEnum: Copy + Drop {
  Duplicate: i64,
}

impl CollidingEnum {
  fn Duplicate(value: i64) -> CollidingEnum {
    CollidingEnum::Duplicate(value)
  }
}

# covers: collision between enum variant and inherent method on the same type
fn static_variant_method_collision() {
  CollidingEnum::Duplicate(42);
}

struct<T: Copy + Drop> OnlyCopyTarget: Copy + Drop {
  val: T,
}

impl<T: Copy + Drop> OnlyCopyTarget<T> {
  fn new(val: T) -> OnlyCopyTarget<T> {
    OnlyCopyTarget { val: val }
  }
}

# covers: static call bound not satisfied on inferred generic parameter
fn static_bound_not_satisfied(linear: Linear) {
  OnlyCopyTarget::new(linear);
}

struct ReceiverTarget: Copy + Drop {
  value: i64,
}

impl ReceiverTarget {
  fn get_val(&self) -> i64 {
    self.*.value
  }
}

# covers: calling receiver method statically without arguments
fn static_call_missing_receiver() {
  ReceiverTarget::get_val();
}

# covers: calling nonexistent variant on known enum
fn static_nonexistent_enum_variant() {
  CollidingEnum::Nonexistent(10);
}




