# Receiver-call diagnostics cover ambiguity and the absence of a callable
# interpretation.

struct AmbiguousTraitTarget: Copy + Drop { value: i64 }

trait First {
  fn collide(recv: AmbiguousTraitTarget);
}

trait Second {
  fn collide(recv: AmbiguousTraitTarget);
}

impl First for AmbiguousTraitTarget {
  fn collide(recv: AmbiguousTraitTarget) { unit }
}

impl Second for AmbiguousTraitTarget {
  fn collide(recv: AmbiguousTraitTarget) { unit }
}

# covers: multiple applicable trait methods in one tier are ambiguous
fn ambiguous_trait(value: AmbiguousTraitTarget) {
  value.collide();
}

struct Missing: Copy + Drop { value: i64 }

# covers: no method, callable field, or free function applies
fn unresolved(value: Missing) {
  value.unknown();
}

struct WrongArity: Copy + Drop { value: i64 }

impl WrongArity {
  fn takes_argument(recv: WrongArity, value: i64) { unit }
}

# covers: receiver is included in method-call arity checking
fn wrong_arity(value: WrongArity) {
  value.takes_argument();
}

struct<T: Copy + Drop> Overlap: Copy + Drop { value: T }

impl<T: Copy + Drop> Overlap<T> {
  fn duplicate(recv: Overlap<T>) { unit }
}

impl Overlap<i64> {
  fn duplicate(recv: Overlap<i64>) { unit }
}

# covers: multiple applicable inherent methods in one tier are ambiguous
fn ambiguous_inherent(value: Overlap<i64>) {
  value.duplicate();
}

struct Callable: Copy + Drop { generic: fn(i64) }

# covers: explicit generic arguments cannot apply to a callable field
fn generic_args_on_field(value: Callable) {
  value.generic<i64>(1);
}

unsafe fn unsafe_free(recv: Missing) {}

# covers: free UFCS preserves ordinary unsafe-call checking
fn unsafe_free_without_block(value: Missing) {
  value.unsafe_free();
}

struct Linear { value: i64 }
struct<T: Copy + Drop> Generic: Copy + Drop { value: T }

impl<T: Copy + Drop> Generic<T> {
  fn<U: Copy + Drop> bounded(recv: Generic<T>, value: U) { unit }
}

# covers: inferred receiver impl arguments do not bypass method bounds
fn method_bound_failure(value: Generic<i64>, linear: Linear) {
  value.bounded<Linear>(linear);
}

struct BorrowAmbiguous: Copy + Drop { value: i64 }

trait BorrowFirst {
  fn borrow_collision(recv: & BorrowAmbiguous);
}

trait BorrowSecond {
  fn borrow_collision(recv: & BorrowAmbiguous);
}

impl BorrowFirst for BorrowAmbiguous {
  fn borrow_collision(recv: & BorrowAmbiguous) { unit }
}

impl BorrowSecond for BorrowAmbiguous {
  fn borrow_collision(recv: & BorrowAmbiguous) { unit }
}

# covers: multiple auto-borrow candidates in one tier are ambiguous
fn ambiguous_auto_borrow(value: BorrowAmbiguous) {
  value.borrow_collision();
}

fn no_receiver() {}

# covers: free UFCS requires a receiver parameter
fn free_without_receiver(value: Missing) {
  value.no_receiver();
}

struct UnsafeMethodTarget: Copy + Drop { value: i64 }

trait UnsafeCall {
  unsafe fn trait_dangerous(recv: & Self);
}

impl UnsafeCall for UnsafeMethodTarget {
  unsafe fn trait_dangerous(recv: & Self) { unit }
}

impl UnsafeMethodTarget {
  unsafe fn inherent_dangerous(recv: & Self) { unit }
}

# covers: unsafe trait methods cannot be called from a safe context
fn unsafe_trait_call(value: UnsafeMethodTarget) {
  value.trait_dangerous();
}

# covers: unsafe inherent methods cannot be called from a safe context
fn unsafe_inherent_call(value: UnsafeMethodTarget) {
  value.inherent_dangerous();
}

trait SafeContract {
  fn safety_mismatch(recv: & Self);
}

impl SafeContract for UnsafeMethodTarget {
  unsafe fn safety_mismatch(recv: & Self) { unit }
}

trait UnsafeContract {
  unsafe fn other_safety_mismatch(recv: & Self);
}

impl UnsafeContract for UnsafeMethodTarget {
  fn other_safety_mismatch(recv: & Self) { unit }
}

trait BoundFirst {
  fn bound_collision(recv: & Self);
}

trait BoundSecond {
  fn bound_collision(recv: & Self);
}

# covers: multiple direct bounds with the same applicable method are ambiguous
fn<T: BoundFirst + BoundSecond> ambiguous_bound_method(value: & T) {
  value.bound_collision();
}

trait DirectCollision {
  fn mixed_collision(recv: & Self);
}

trait ReferenceCollision {
  fn mixed_collision(recv: Self);
}

impl<U> ReferenceCollision for & U {
  fn mixed_collision(recv: Self) { recv; }
}

# covers: bound and concrete-reference candidates share one ambiguity tier
fn<T: DirectCollision> ambiguous_bound_and_impl(value: & T) {
  value.mixed_collision();
}

trait BoundArgument {}
trait GenericBoundMethod {
  fn<U: BoundArgument> bound_generic(recv: & Self, value: & U);
  unsafe fn bound_unsafe(recv: & Self);
}

struct WrongBoundArgument: Copy + Drop { value: i64 }

# covers: generic arguments on direct-bound methods retain their obligations
fn<T: GenericBoundMethod> reject_bound_method_argument(
  value: & T,
  argument: & WrongBoundArgument,
) {
  value.bound_generic<WrongBoundArgument>(argument);
}

# covers: unsafe direct-bound methods still require an unsafe context
fn<T: GenericBoundMethod> reject_bound_unsafe(value: & T) {
  value.bound_unsafe();
}

# covers: a generic receiver without the declaring bound has no method candidate
fn<T> reject_unbounded_receiver(value: & T) {
  value.bound_generic<WrongBoundArgument>(value);
}
