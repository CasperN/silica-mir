# `Self` is reserved as the trait/impl-scoped alias for the receiver /
# target type. A user-declared `<Self>` generic param would silently
# overshadow that alias inside the impl body, so the parser rejects
# `Self` as a type-parameter name everywhere. Impl header is the most
# common context; the same rule applies to `trait<Self>`,
# `struct<Self>`, `enum<Self>`, and `fn<Self>`. Parser errors
# short-circuit; one representative case is enough.

trait T { fn m(recv: & Self); }

struct Foo: Copy + Drop { x: i64 }

impl<Self> T for Foo {
  fn m(recv: & Foo) {
    entry:
      return
  }
}
