trait Combo<T> {
  fn map<'s0, 's1, 's2, U>(recv: &'s0 Self, other: &'s1 U, $return: &'s2 out T);
}

trait RefMethods {
  fn shared<'s0>(recv: &'s0 Self);
  fn mut_<'s0>(recv: &'s0 mut Self);
  fn out_<'s0>(recv: &'s0 out Self);
  fn drop_<'s0>(recv: &'s0 drop Self);
  fn uninit<'s0>(recv: &'s0 uninit Self);
}

trait Simple {
  fn ping<'s0>(recv: &'s0 Self);
}

trait Iter<T: Copy + Drop> {
  fn next<'s0, 's1>(recv: &'s0 mut Self, $return: &'s1 out T);
}

struct Foo: Copy + Drop {
  x: i64
}

struct List: Copy + Drop {
  xs: [i64; 4]
}

struct Bag<T: Copy + Drop>: Copy + Drop {
  inner: T
}

impl Simple for Foo {
  fn ping<'s0>(recv: &'s0 Foo) {
    entry:
      drop recv;
      return
  }
}

impl Iter<i64> for List {
  fn next<'s0, 's1>(recv: &'s0 mut List, $return: &'s1 out i64) {
    entry:
      $return.* = 0;
      unborrow $return;
      drop recv;
      return
  }
}

impl<T: Copy + Drop> Iter<T> for Bag<T> {
  fn next<'s0, 's1>(recv: &'s0 mut Bag<T>, $return: &'s1 out T) {
    entry:
      $return.* = copy recv.*.inner;
      unborrow $return;
      drop recv;
      return
  }
}

trait MgTrait {
  fn ignore<'s0, 's1, U: Copy + Drop>(recv: &'s0 Self, other: &'s1 U);
}

impl MgTrait for Foo {
  fn ignore<'s0, 's1, V: Copy + Drop>(recv: &'s0 Foo, other: &'s1 V) {
    entry:
      drop other;
      drop recv;
      return
  }
}

trait LifetimeContract<'a> {
  fn relate<'b: 'a, 's0>(recv: &'s0 Self, earlier: &'a i64, later: &'b i64);
}

impl<'x> LifetimeContract<'x> for Foo {
  fn relate<'y: 'x, 's0>(recv: &'s0 Foo, earlier: &'x i64, later: &'y i64) {
    entry:
      drop later;
      drop earlier;
      drop recv;
      return
  }
}

struct LtHolder<'a>: Copy + Drop {
  p: &'a i64
}

trait LtTrait<'a> {
  fn peek<'s0>(recv: &'s0 Self);
}

impl<'a> LtTrait<'a> for LtHolder<'a> {
  fn peek<'s0>(recv: &'s0 LtHolder<'a>) {
    entry:
      drop recv;
      return
  }
}

trait SelfAlias {
  fn s<'s0>(recv: &'s0 Self);
  fn m<'s0>(recv: &'s0 mut Self);
  fn d<'s0>(recv: &'s0 drop Self);
}

impl<T: Copy + Drop> SelfAlias for Bag<T> {
  fn s<'s0>(recv: &'s0 Bag<T>) {
    entry:
      drop recv;
      return
  }
  fn m<'s0>(recv: &'s0 mut Bag<T>) {
    entry:
      drop recv;
      return
  }
  fn d<'s0>(recv: &'s0 drop Bag<T>) {
    entry:
      drop recv.*;
      unborrow recv;
      return
  }
}

trait SelfLocal {
  fn foo<'s0>(recv: &'s0 Self);
}

impl SelfLocal for Foo {
  fn foo<'s0>(recv: &'s0 Foo) {
    p: &Foo;
    entry:
      p = copy recv;
      unborrow p;
      drop recv;
      return
  }
}

fn visit_ref<'s0, T: Copy + Drop>(r: &'s0 T) {
  entry:
    drop r;
    return
}

trait SelfInBody {
  fn dispatch<'s0>(recv: &'s0 Self);
}

impl SelfInBody for Foo {
  fn dispatch<'s0>(recv: &'s0 Foo) {
    entry:
      call visit_ref<Foo>(copy recv);
      call <Foo as Simple>::ping(copy recv);
      drop recv;
      return
  }
}

impl<'s0> LtTrait<'s0> for LtHolder<'s0> {
  fn peek<'s1>(recv: &'s1 LtHolder<'s0>) {
    entry:
      drop recv;
      return
  }
}

trait Discard {
  fn discard<'s0, T: Drop>(recv: &'s0 Self, value: T);
}

impl Discard for Foo {
  fn discard<'s0, T: Drop>(recv: &'s0 Foo, value: T) {
    entry:
      drop value;
      drop recv;
      return
  }
}

impl AutoClone for Foo {
  fn clone<'s0, 's1>(recv: &'s0 Foo, $return: &'s1 out Foo) {
    entry:
      $return.* = copy recv.*;
      unborrow $return;
      drop recv;
      return
  }
}

impl AutoDestroy for Foo {
  fn destroy<'s0>(recv: &'s0 drop Foo) {
    entry:
      drop recv.*;
      unborrow recv;
      return
  }
}

impl<T: Copy + Drop> Bag<T> {
  fn make<'s0>(value: T, $return: &'s0 out Bag<T>) {
    entry:
      $return.*.inner = copy value;
      unborrow $return;
      drop value;
      return
  }
}

impl<T: Copy + Drop> Bag<T> {
  fn get<'s0, 's1>(recv: &'s0 Bag<T>, $return: &'s1 out T) {
    entry:
      $return.* = copy recv.*.inner;
      unborrow $return;
      drop recv;
      return
  }
}

trait DirectBound {
}

trait LifetimeDirectBound<'a> {
}

trait OrderedDirectBound<'a, 'b: 'a> {
}

impl DirectBound for Foo {
}

struct DirectBox<T: DirectBound> {
  value: T
}

extern fn accept_direct<'s0, T: DirectBound>(value: &'s0 T);

fn forward_direct<'s0, T: DirectBound>(value: &'s0 T) {
  entry:
    call accept_direct<T>(copy value);
    drop value;
    return
}

extern fn accept_lifetime_direct<'a, T: LifetimeDirectBound<'a>>(value: &'a T);

extern fn accept_ordered_direct<'a, 'b: 'a, T: OrderedDirectBound<'a, 'b>>(value: &'b T);
