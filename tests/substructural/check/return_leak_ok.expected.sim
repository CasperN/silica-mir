struct P {
  x: i64
  y: i64
}

struct MoveP: Move {
  x: i64
  y: i64
}

struct<'s0> L: Move {
  r: &out 's0 i64
}

struct S: Move {
  v: i64
}

extern fn take_num(a: i64);

extern fn take_move_p(p: MoveP);

extern fn<'s0> take_linear(x: L<'s0>);

extern fn<'s0> take_out(r: &out 's0 i64);

extern fn<'s0> init_s(r: &out 's0 S);

extern fn take_s(s: S);

fn scalar_param_untouched(x: i64) {
  entry:
    drop x;
    return
}

fn scalar_param_moved_out(x: i64) {
  entry:
    call take_num(move x);
    return
}

fn<'s0> linear_ref_param_moved_out(r: &out 's0 i64) {
  entry:
    call take_out(move r);
    return
}

fn linear_struct_moved_whole(p: MoveP) {
  entry:
    call take_move_p(move p);
    return
}

fn<'s0> linear_struct_moved_via_call(x: L<'s0>) {
  entry:
    call take_linear(move x);
    return
}

fn linear_struct_partial_init_dropped() {
  p: P;
  entry:
    p.x = 1;
    drop p.x;
    return
}

fn linear_struct_all_fields_dropped() {
  p: P;
  entry:
    p.x = 1;
    p.y = 2;
    drop p.x;
    drop p.y;
    return
}

fn linear_struct_one_field_init_drop() {
  p: P;
  entry:
    p.x = 1;
    drop p.x;
    return
}

fn partial_array_slot_consumed() {
  a: [S; 3];
  r: &out S;
  entry:
    r = &out a[1];
    call init_s(move r);
    call take_s(move a[1]);
    return
}

trait ImplDropElaborationOk {
  fn<'s0> finish(recv: &'s0 Self, x: i64);
}

impl ImplDropElaborationOk for P {
  fn<'s0> finish(recv: &'s0 P, x: i64) {
    entry:
      drop x;
      drop recv;
      return
  }
}
