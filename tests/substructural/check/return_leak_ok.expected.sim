struct P {
  x: i64
  y: i64
}

struct MoveP: Move {
  x: i64
  y: i64
}

struct L<'s0>: Move {
  r: &'s0 out i64
}

struct S: Move {
  v: i64
}

extern fn take_num(a: i64);

extern fn take_move_p(p: MoveP);

extern fn take_linear<'s0>(x: L<'s0>);

extern fn take_out<'s0>(r: &'s0 out i64);

extern fn init_s<'s0>(r: &'s0 out S);

extern fn take_s(s: S);

fn scalar_param_untouched(x: i64) {
  entry:
    drop x;
    return
}

fn scalar_param_moved_out(x: i64) {
  entry:
    call take_num(move x);
    return
}

fn linear_ref_param_moved_out<'s0>(r: &'s0 out i64) {
  entry:
    call take_out(move r);
    return
}

fn linear_struct_moved_whole(p: MoveP) {
  entry:
    call take_move_p(move p);
    return
}

fn linear_struct_moved_via_call<'s0>(x: L<'s0>) {
  entry:
    call take_linear(move x);
    return
}

fn linear_struct_partial_init_dropped() {
  p: P;
  entry:
    p.x = 1;
    drop p.x;
    return
}

fn linear_struct_all_fields_dropped() {
  p: P;
  entry:
    p.x = 1;
    p.y = 2;
    drop p.x;
    drop p.y;
    return
}

fn linear_struct_one_field_init_drop() {
  p: P;
  entry:
    p.x = 1;
    drop p.x;
    return
}

fn partial_array_slot_consumed() {
  a: [S; 3];
  r: &out S;
  entry:
    r = &out a[1];
    call init_s(move r);
    call take_s(move a[1]);
    return
}

trait ImplDropElaborationOk {
  fn finish<'s0>(recv: &'s0 Self, x: i64);
}

impl ImplDropElaborationOk for P {
  fn finish<'s0>(recv: &'s0 P, x: i64) {
    entry:
      drop x;
      drop recv;
      return
  }
}
