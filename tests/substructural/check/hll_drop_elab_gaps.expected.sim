enum Level: Copy + Drop {
  High: i64
  Low: i64
}

fn<'s0> chained_matches(s: State, $return: &out 's0 i64) {
  _temp_0: Level;
  a: i64;
  b: i64;
  h: i64;
  l: i64;
  entry:
    switchEnum(s) [On: switch_On_0, Off: switch_Off_1]
  switch_On_0:
    a = copy s as On;
    _temp_0 = Level::High(move a);
    require_uninit a;
    goto switch_merge_2
  switch_Off_1:
    b = copy s as Off;
    _temp_0 = Level::Low(move b);
    require_uninit b;
    goto switch_merge_2
  switch_merge_2:
    switchEnum(_temp_0) [High: switch_High_3, Low: switch_Low_4]
  switch_High_3:
    h = copy _temp_0 as High;
    $return.* = move h;
    unborrow $return;
    require_uninit h;
    goto switch_merge_5
  switch_Low_4:
    l = copy _temp_0 as Low;
    $return.* = move l;
    unborrow $return;
    require_uninit l;
    goto switch_merge_5
  switch_merge_5:
    drop _temp_0;
    require_uninit _temp_0;
    require_uninit $return;
    drop s;
    require_uninit s;
    return
}

fn loop_if_break() {
