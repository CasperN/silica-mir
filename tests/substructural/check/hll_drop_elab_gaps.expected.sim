enum State: Copy + Drop {
  On: i64
  Off: i64
}

enum Level: Copy + Drop {
  High: i64
  Low: i64
}

fn chained_matches<'s0>(s: State, $return: &'s0 out i64) {
  $tmp_0: Level;
  a: i64;
  b: i64;
  h: i64;
  l: i64;
  entry:
    switchEnum(s) [On: switch_On_0, Off: switch_Off_1]
  switch_On_0:
    a = copy s as On;
    $tmp_0 = Level::High(move a);
    require_uninit a;
    goto switch_merge_2
  switch_Off_1:
    b = copy s as Off;
    $tmp_0 = Level::Low(move b);
    require_uninit b;
    goto switch_merge_2
  switch_merge_2:
    switchEnum($tmp_0) [High: switch_High_3, Low: switch_Low_4]
  switch_High_3:
    h = copy $tmp_0 as High;
    $return.* = move h;
    unborrow $return;
    require_uninit h;
    goto switch_merge_5
  switch_Low_4:
    l = copy $tmp_0 as Low;
    $return.* = move l;
    unborrow $return;
    require_uninit l;
    goto switch_merge_5
  switch_merge_5:
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit $return;
    drop s;
    require_uninit s;
    return
}

fn loop_if_break() {
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  $tmp_2: $Tuple0;
  $tmp_3: $Tuple0;
  $tmp_4: $Tuple0;
  entry:
    goto loop_start_0
  loop_start_0:
    branch(true) [true: if_true_2, false: if_false_3]
  if_true_2:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    goto loop_end_1
  if_false_3:
    $tmp_3 = $Tuple0 {};
    goto if_merge_4
  if_merge_4:
    drop $tmp_3;
    require_uninit $tmp_3;
    $tmp_2 = $Tuple0 {};
    drop $tmp_2;
    require_uninit $tmp_2;
    goto loop_start_0
  loop_end_1:
    require_uninit $tmp_1;
    $tmp_0 = $Tuple0 {};
    drop $tmp_0;
    require_uninit $tmp_0;
    return
}

struct P: Copy + Drop {
  x: i64
  y: i64
  z: i64
}

fn struct_field_diverged<'s0>(c: bool, $return: &'s0 out i64) {
  p: P;
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  $tmp_2: $Tuple0;
  $tmp_3: $Tuple0;
  $tmp_4: $Tuple0;
  entry:
    branch(copy c) [true: if_true_0, false: if_false_1]
  if_true_0:
    p.x = 1;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    p.z = 3;
    $tmp_2 = $Tuple0 {};
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = $Tuple0 {};
    goto $edge0
  $edge0:
    drop p.z;
    goto if_merge_2
  if_false_1:
    p.x = 1;
    $tmp_3 = $Tuple0 {};
    drop $tmp_3;
    require_uninit $tmp_3;
    p.y = 2;
    $tmp_4 = $Tuple0 {};
    drop $tmp_4;
    require_uninit $tmp_4;
    $tmp_0 = $Tuple0 {};
    goto $edge1
  $edge1:
    drop p.y;
    goto if_merge_2
  if_merge_2:
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move p.x;
    unborrow $return;
    require_uninit p;
    require_uninit $return;
    drop c;
    require_uninit c;
    return
}

