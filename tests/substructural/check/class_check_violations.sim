# Per-statement class checks reject operands of the wrong class.
#
# `copy p` on a non-Copy operand fires SUB-CopyOfNonCopy; `move p` on
# a non-Move operand fires SUB-MoveOfNonMove; `drop p` on a non-Drop
# operand fires SUB-DropOfNonDrop. Each fn below exercises one cell
# of the (operation x rejecting-type x operand-position) matrix.
# Every failing operand carries the "try move / not Copy / not Drop"
# hint. A regression here pins the wrong DiagCode, the wrong span, or
# lets a bad class slip through.
#
# The `&drop` / `&out` drop cells fire an extra
# INIT-RefObligationUnfulfilled at return because dropping the local
# ends the reference before its obligation is discharged — that dual
# diagnostic is part of the pinned output.
#
#   fn                                  op    rejecting-type    position
#   copy_drop_only_struct               copy  D (Drop only)     rvalue
#   copy_linear_struct_as_rvalue        copy  Linear            rvalue
#   copy_mut_ref                        copy  &mut i64          rvalue
#   copy_out_ref                        copy  &out i64          rvalue
#   copy_uninit_ref                     copy  &uninit i64       rvalue
#   copy_linear_struct_as_call_arg      copy  Linear            call arg
#   copy_linear_struct_as_enum_payload  copy  Linear            enum payload
#   move_copy_only_struct               move  C (Copy only)     call arg
#   move_non_move_struct                move  Linear (no Move)  rvalue + call arg
#   drop_linear_struct                  drop  Linear            statement
#   drop_drop_ref                       drop  &drop i64         statement
#   drop_out_ref                        drop  &out i64          statement

struct D: Drop { x: i64 }

struct C: Copy { x: i64 }

struct Linear { r: &out i64 }

enum Wrap { W: Linear }

# ---------- Matrix shells (scalar field avoids ref-obligation noise) ----------
struct MatL { v: i64 }
struct MatC: Copy { v: i64 }
struct MatM: Move { v: i64 }
struct MatCM: Copy + Move { v: i64 }
struct MatDM: Drop + Move { v: i64 }

extern fn take_linear(x: Linear);
extern fn take_copy_only(c: C);
extern fn take_mat_l(x: MatL);
extern fn take_mat_d(x: D);
extern fn take_mat_m(x: MatM);
extern fn take_mat_c(x: C);
extern fn take_mat_cm(x: MatCM);

# ---------- copy: non-Copy rvalues ----------

fn copy_drop_only_struct(a: D) {
  b: D;
  entry:
    b = copy a;
    return
}

fn copy_linear_struct_as_rvalue(x: Linear) {
  y: Linear;
  entry:
    y = copy x;
    return
}

fn copy_mut_ref(r: &mut i64) {
  s: &mut i64;
  entry:
    s = copy r;
    return
}

fn copy_out_ref(r: &out i64) {
  s: &out i64;
  entry:
    s = copy r;
    return
}

fn copy_uninit_ref(r: &uninit i64) {
  s: &uninit i64;
  entry:
    s = copy r;
    return
}

# ---------- copy: non-Copy in call-arg position ----------

fn copy_linear_struct_as_call_arg(x: Linear) {
  entry:
    call take_linear(copy x);
    return
}

# ---------- copy: non-Copy in enum-payload position ----------

fn copy_linear_struct_as_enum_payload(x: Linear) {
  w: Wrap;
  entry:
    w = Wrap::W(copy x);
    return
}

# ---------- move: non-Move operands ----------

# Copy without Drop does not imply Move; moving a Copy-only value fires
# SUB-MoveOfNonMove.
fn move_copy_only_struct(c: C) {
  entry:
    call take_copy_only(move c);
    return
}

# A linear struct with no Move marker is not Move; both the rvalue move
# and the call-arg move fail independently at the same fn.
fn move_non_move_struct(x: Linear) {
  y: Linear;
  entry:
    y = move x;
    call take_linear(move y);
    return
}

# ---------- drop: non-Drop operands ----------

fn drop_linear_struct(x: Linear) {
  entry:
    drop x;
    return
}

fn drop_drop_ref(r: &drop i64) {
  entry:
    drop r;
    return
}

fn drop_out_ref(r: &out i64) {
  entry:
    drop r;
    return
}

# ============================================================
# Matrix: copy_op violations — rejected when type is not Copy
# ============================================================

# MatL (no markers): not Copy — fires SUB-CopyOfNonCopy.
fn copy_op_MatL(x: MatL) {
  y: MatL;
  entry:
    y = copy x;
    return
}

# D (Drop only): not Copy — fires SUB-CopyOfNonCopy.
fn copy_op_D(a: D) {
  b: D;
  entry:
    b = copy a;
    return
}

# MatM (Move only): not Copy — fires SUB-CopyOfNonCopy.
fn copy_op_MatM(x: MatM) {
  y: MatM;
  entry:
    y = copy x;
    return
}

# MatDM (Drop + Move): not Copy — fires SUB-CopyOfNonCopy.
fn copy_op_MatDM(x: MatDM) {
  y: MatDM;
  entry:
    y = copy x;
    return
}

# MatC (Copy only, no Drop, no Move): copy is accepted (no SUB-CopyOfNonCopy)
# but x cannot be consumed — fires INIT-ReturnValueLeak because MatC is not
# Drop and the param can only be duplicated, never discharged.
fn copy_op_MatC_leaks(x: MatC) {
  entry:
    return
}

# ============================================================
# Matrix: move_op violations — rejected when type is not Move
# (Copy alone does not imply Move; only Copy + Drop → Move)
# ============================================================

# MatL (no markers): not Move — fires SUB-MoveOfNonMove.
fn move_op_MatL(x: MatL) {
  y: MatL;
  entry:
    y = move x;
    return
}

# C (Copy only, no Drop): no blanket Move — fires SUB-MoveOfNonMove.
fn move_op_C(c: C) {
  entry:
    call take_mat_c(move c);
    return
}

# D (Drop only, no Copy, no explicit Move): not Move — fires SUB-MoveOfNonMove.
fn move_op_D(d: D) {
  e: D;
  entry:
    e = move d;
    return
}

# ============================================================
# Matrix: drop_op violations — rejected when type is not Drop
# ============================================================

# MatL (no markers): not Drop — fires SUB-DropOfNonDrop.
fn drop_op_MatL(x: MatL) {
  entry:
    drop x;
    return
}

# C (Copy only): not Drop — fires SUB-DropOfNonDrop.
fn drop_op_C(x: C) {
  entry:
    drop x;
    return
}

# MatM (Move only): not Drop — fires SUB-DropOfNonDrop.
fn drop_op_MatM(x: MatM) {
  entry:
    drop x;
    return
}

# MatCM (Copy + Move): not Drop — fires SUB-DropOfNonDrop.
fn drop_op_MatCM(x: MatCM) {
  entry:
    drop x;
    return
}

# ============================================================
# Matrix: untouched_param violations — non-Drop params leak
# at return because drop-elab cannot insert a drop.
# Each fires INIT-ReturnValueLeak.
# ============================================================

# MatL (no markers): not Drop — leaks at return.
fn untouched_param_MatL(x: MatL) {
  entry:
    return
}

# C (Copy only): not Drop — leaks at return.
fn untouched_param_C(x: C) {
  entry:
    return
}

# MatM (Move only): not Drop — leaks at return.
fn untouched_param_MatM(x: MatM) {
  entry:
    return
}

# MatCM (Copy + Move): not Drop — leaks at return.
fn untouched_param_MatCM(x: MatCM) {
  entry:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 1 violations (both arms move x)
# covers: class=L|C|D op=move cfg=if_both_move type_kind=struct
# Non-Move classes: SUB-MoveOfNonMove on each arm.
# ============================================================

fn if_both_move_MatL(x: MatL, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_l(move x);
    goto done
  f:
    call take_mat_l(move x);
    goto done
  done:
    return
}

fn if_both_move_C(x: C, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_c(move x);
    goto done
  f:
    call take_mat_c(move x);
    goto done
  done:
    return
}

fn if_both_move_D(x: D, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_d(move x);
    goto done
  f:
    call take_mat_d(move x);
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 2 violations (one arm moves, other Init)
# covers: class=L|M|C|CM op=move cfg=if_one_arm_move type_kind=struct
# Non-Drop classes: drop-elab cannot insert on not-moved arm → INIT-ReturnValueLeak.
# MatL/MatC also fire SUB-MoveOfNonMove on the moving arm.
# ============================================================
fn if_one_arm_move_MatM(x: MatM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_m(move x);
    goto done
  f:
    goto done
  done:
    return
}
fn if_one_arm_move_MatCM(x: MatCM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cm(move x);
    goto done
  f:
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 3 violations (one arm drops, non-Drop class)
# covers: class=L|M op=drop cfg=if_one_arm_drop type_kind=struct
# SUB-DropOfNonDrop on the drop arm; INIT-ReturnValueLeak at done.
# ============================================================
fn if_one_arm_drop_MatL(x: MatL, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}
fn if_one_arm_drop_MatM(x: MatM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 4 violations (both arms drop, non-Drop class)
# covers: class=L|M|C|CM op=drop cfg=if_both_drop type_kind=struct
# SUB-DropOfNonDrop on each arm.
# ============================================================

fn if_both_drop_MatL(x: MatL, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatM(x: MatM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatC(x: MatC, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatCM(x: MatCM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

trait ImplClassCheckViolation {
  fn check(recv: & Self, x: D);
}

impl ImplClassCheckViolation for D {
  # covers: substructural errors in impl method bodies
  fn check(recv: & D, x: D) {
    y: D;
    entry:
      y = copy x;
      return
  }
}
