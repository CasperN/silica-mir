struct P: Copy + Drop {
  x: i64
  y: i64
}

struct<'s0> L: Move {
  r: &out 's0 i64
}

struct D: Drop {
  x: i64
}

enum Wrap: Copy + Drop {
  W: i64
}

struct MatL {
  v: i64
}

struct MatC: Copy {
  v: i64
}

struct MatD: Drop {
  v: i64
}

struct MatM: Move {
  v: i64
}

struct MatCD: Copy + Drop {
  v: i64
}

struct MatCM: Copy + Move {
  v: i64
}

struct MatDM: Drop + Move {
  v: i64
}

struct MatCDM: Copy + Drop {
  v: i64
}

extern fn take_num(x: i64);

extern fn take_point(p: P);

extern fn take_mut(r: &mut 's0 i64);

extern fn take_out(r: &out 's0 i64);

extern fn take_mat_c(x: MatC);

extern fn take_mat_d(x: MatD);

extern fn take_mat_m(x: MatM);

extern fn take_mat_cd(x: MatCD);

extern fn take_mat_cm(x: MatCM);

extern fn take_mat_dm(x: MatDM);

extern fn take_mat_cdm(x: MatCDM);

fn copy_number_as_rvalue(x: i64) {
  y: i64;
  entry:
    y = copy x;
    drop y;
    drop x;
    return
}

fn copy_copy_struct_as_rvalue(p: P) {
  q: P;
  entry:
    q = copy p;
    drop q;
    drop p;
    return
}

fn<'s0> copy_shared_ref_as_rvalue(r: & 's0 i64) {
  s: & i64;
  entry:
    s = copy r;
    unborrow r;
    unborrow s;
    return
}

fn copy_number_as_call_arg(x: i64) {
  entry:
    call take_num(copy x);
    drop x;
    return
}

fn copy_number_as_enum_payload(x: i64) {
  w: Wrap;
  entry:
    w = Wrap::W(copy x);
    drop w;
    drop x;
    return
}

fn move_copy_drop_struct_via_call(p: P) {
  entry:
    call take_point(move p);
    return
}

fn move_move_marker_struct_rvalue(x: L) {
  y: L;
  entry:
    y = move x;
    call take_out(move y.r);
    return
}

fn<'s0> move_mut_ref_via_call(r: &mut 's0 i64) {
  entry:
    call take_mut(move r);
    return
}

fn<'s0> move_out_ref_via_call(r: &out 's0 i64) {
  entry:
    call take_out(move r);
    return
}

fn drop_drop_struct(d: D) {
  entry:
    drop d;
    return
}

fn<'s0> drop_mut_ref(r: &mut 's0 i64) {
  entry:
    drop r;
    return
}

fn<'s0> drop_shared_ref(r: & 's0 i64) {
  entry:
    drop r;
    return
}

fn copy_op_MatCD(x: MatCD) {
  y: MatCD;
  entry:
    y = copy x;
    drop y;
    drop x;
    return
}

fn copy_op_MatCM(x: MatCM) {
  y: MatCM;
  entry:
    y = copy x;
    call take_mat_cm(move x);
    call take_mat_cm(move y);
    return
}

fn copy_op_MatCDM(x: MatCDM) {
  y: MatCDM;
  entry:
    y = copy x;
    drop y;
    drop x;
    return
}

fn move_op_MatM(x: MatM) {
  entry:
    call take_mat_m(move x);
    return
}

fn move_op_MatCD(x: MatCD) {
  entry:
    call take_mat_cd(move x);
    return
}

fn move_op_MatCM(x: MatCM) {
  entry:
    call take_mat_cm(move x);
    return
}

fn move_op_MatDM(x: MatDM) {
  y: MatDM;
  entry:
    y = move x;
    drop y;
    return
}

fn move_op_MatCDM(x: MatCDM) {
  entry:
    call take_mat_cdm(move x);
    return
}

fn drop_op_MatD(x: MatD) {
  entry:
    drop x;
    return
}

fn drop_op_MatCD(x: MatCD) {
  entry:
    drop x;
    return
}

fn drop_op_MatDM(x: MatDM) {
  entry:
    drop x;
    return
}

fn drop_op_MatCDM(x: MatCDM) {
  entry:
    drop x;
    return
}

fn untouched_param_MatD(x: MatD) {
  entry:
    drop x;
    return
}

fn untouched_param_MatCD(x: MatCD) {
  entry:
    drop x;
    return
}

fn untouched_param_MatDM(x: MatDM) {
  entry:
    drop x;
    return
}

fn untouched_param_MatCDM(x: MatCDM) {
  entry:
    drop x;
    return
}
