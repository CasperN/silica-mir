# Per-statement class checks accept operands of the required class.
#
# `copy p` requires `p`'s type to be Copy; `move p` requires Move;
# `drop p` requires Drop. Each fn below exercises one cell of the
# (operation x satisfying-type x operand-position) matrix. The
# operation must run clean; a regression here means the class check
# rejects a legal operand or that operand-position wiring skips a
# case.
#
# `copy` participates in every operand position (rvalue / call arg
# / enum payload) so all three are covered. `move` and `drop` only
# have a proper subset — see the header of `class_check_violations`
# for the failure-side coverage.
#
#   fn                              op    class-required   type              position
#   copy_number_as_rvalue           copy  Copy             i64               rvalue
#   copy_copy_struct_as_rvalue      copy  Copy             P (Copy+Drop)     rvalue
#   copy_shared_ref_as_rvalue       copy  Copy             &i64              rvalue
#   copy_number_as_call_arg         copy  Copy             i64               call arg
#   copy_number_as_enum_payload     copy  Copy             i64               enum payload
#   move_copy_drop_struct_via_call  move  Move             P (Copy+Drop)     call arg
#   move_move_marker_struct_rvalue  move  Move             L (Move-linear)   rvalue
#   move_mut_ref_via_call           move  Move             &mut i64          call arg
#   move_out_ref_via_call           move  Move             &out i64          call arg
#   drop_drop_struct                drop  Drop             D (Drop)          statement
#   drop_mut_ref                    drop  Drop             &mut i64          statement
#   drop_shared_ref                 drop  Drop             &i64              statement

struct P: Copy + Drop { x: i64  y: i64 }

struct L: Move { r: &out i64 }

struct D: Drop { x: i64 }

enum Wrap: Copy + Drop { W: i64 }

# ---------- Matrix shells: 8 single-field structs covering all marker combos ----------
# MatL: linear (no markers)
struct MatL { v: i64 }
# MatC: Copy only
struct MatC: Copy { v: i64 }
# MatD: Drop only (alias for D above; kept separate for naming clarity)
struct MatD: Drop { v: i64 }
# MatM: Move only
struct MatM: Move { v: i64 }
# MatCD: Copy + Drop (blanket impl synthesises Move)
struct MatCD: Copy + Drop { v: i64 }
# MatCM: Copy + Move
struct MatCM: Copy + Move { v: i64 }
# MatDM: Drop + Move
struct MatDM: Drop + Move { v: i64 }
# MatCDM: Copy + Drop + Move (Move redundant, but legal)
struct MatCDM: Copy + Drop + Move { v: i64 }

extern fn take_num(x: i64);
extern fn take_point(p: P);
extern fn take_mut(r: &mut i64);
extern fn take_out(r: &out i64);
extern fn take_mat_c(x: MatC);
extern fn take_mat_d(x: MatD);
extern fn take_mat_m(x: MatM);
extern fn take_mat_cd(x: MatCD);
extern fn take_mat_cm(x: MatCM);
extern fn take_mat_dm(x: MatDM);
extern fn take_mat_cdm(x: MatCDM);

# ---------- copy: Copy operand in rvalue position ----------

fn copy_number_as_rvalue(x: i64) {
  y: i64;
  entry:
    y = copy x;
    return
}

fn copy_copy_struct_as_rvalue(p: P) {
  q: P;
  entry:
    q = copy p;
    return
}

fn copy_shared_ref_as_rvalue(r: &i64) {
  s: &i64;
  entry:
    s = copy r;
    return
}

# ---------- copy: Copy operand in call-arg position ----------

fn copy_number_as_call_arg(x: i64) {
  entry:
    call take_num(copy x);
    return
}

# ---------- copy: Copy operand in enum-payload position ----------

fn copy_number_as_enum_payload(x: i64) {
  w: Wrap;
  entry:
    w = Wrap::W(copy x);
    return
}

# ---------- move: Move operand in call-arg / rvalue position ----------

# Copy+Drop implies Move, so a Copy+Drop struct is a valid `move` operand.
fn move_copy_drop_struct_via_call(p: P) {
  entry:
    call take_point(move p);
    return
}

# The `Move` marker on a linear struct discharges the `move` requirement
# even though the type is neither Copy nor Drop.
fn move_move_marker_struct_rvalue(x: L) {
  y: L;
  entry:
    y = move x;
    call take_out(move y.r);
    return
}

fn move_mut_ref_via_call(r: &mut i64) {
  entry:
    call take_mut(move r);
    return
}

fn move_out_ref_via_call(r: &out i64) {
  entry:
    call take_out(move r);
    return
}

# ---------- drop: Drop operand ----------

fn drop_drop_struct(d: D) {
  entry:
    drop d;
    return
}

fn drop_mut_ref(r: &mut i64) {
  entry:
    drop r;
    return
}

fn drop_shared_ref(r: &i64) {
  entry:
    drop r;
    return
}

# ============================================================
# Matrix: copy_op — accepted when type is Copy
# ============================================================

# MatCD: Copy + Drop — copy succeeds; drop-elab inserts drops for both.
fn copy_op_MatCD(x: MatCD) {
  y: MatCD;
  entry:
    y = copy x;
    return
}

# MatCM: Copy + Move — copy succeeds; original and copy are moved to calls.
fn copy_op_MatCM(x: MatCM) {
  y: MatCM;
  entry:
    y = copy x;
    call take_mat_cm(move x);
    call take_mat_cm(move y);
    return
}

# MatCDM: Copy + Drop + Move — copy succeeds; drop-elab handles leftovers.
fn copy_op_MatCDM(x: MatCDM) {
  y: MatCDM;
  entry:
    y = copy x;
    return
}

# ============================================================
# Matrix: move_op — accepted when type is Move (explicitly or
# via the Copy + Drop → Move blanket implication)
# ============================================================

# MatM: explicit Move marker — move succeeds.  MatM is not Drop, so y
# is consumed via a call rather than relying on drop-elab.
fn move_op_MatM(x: MatM) {
  entry:
    call take_mat_m(move x);
    return
}

# MatCD: Copy + Drop implies Move — move succeeds even without
# an explicit Move marker.  This is the blanket-implication cell.
fn move_op_MatCD(x: MatCD) {
  entry:
    call take_mat_cd(move x);
    return
}

# MatCM: Copy + Move — move succeeds.  MatCM is not Drop, so consume via call.
fn move_op_MatCM(x: MatCM) {
  entry:
    call take_mat_cm(move x);
    return
}

# MatDM: Drop + Move — move succeeds.
fn move_op_MatDM(x: MatDM) {
  y: MatDM;
  entry:
    y = move x;
    return
}

# MatCDM: Copy + Drop + Move — move succeeds.
fn move_op_MatCDM(x: MatCDM) {
  entry:
    call take_mat_cdm(move x);
    return
}

# ============================================================
# Matrix: drop_op — accepted when type is Drop
# ============================================================

# MatD: Drop only — drop succeeds.
fn drop_op_MatD(x: MatD) {
  entry:
    drop x;
    return
}

# MatCD: Copy + Drop — drop succeeds.
fn drop_op_MatCD(x: MatCD) {
  entry:
    drop x;
    return
}

# MatDM: Drop + Move — drop succeeds.
fn drop_op_MatDM(x: MatDM) {
  entry:
    drop x;
    return
}

# MatCDM: Copy + Drop + Move — drop succeeds.
fn drop_op_MatCDM(x: MatCDM) {
  entry:
    drop x;
    return
}

# ============================================================
# Matrix: untouched_param — accepted when type is Drop
# (drop-elaboration inserts drop at return)
# ============================================================

# MatD: Drop only — drop-elab inserts drop; no leak.
fn untouched_param_MatD(x: MatD) {
  entry:
    return
}

# MatCD: Copy + Drop — drop-elab inserts drop; no leak.
fn untouched_param_MatCD(x: MatCD) {
  entry:
    return
}

# MatDM: Drop + Move — drop-elab inserts drop; no leak.
fn untouched_param_MatDM(x: MatDM) {
  entry:
    return
}

# MatCDM: Copy + Drop + Move — drop-elab inserts drop; no leak.
fn untouched_param_MatCDM(x: MatCDM) {
  entry:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 1 (both arms move x)
# covers: class=M|CD|DM|CM|CDM op=move cfg=if_both_move type_kind=struct
# All Move-capable classes: clean because both arms consume x.
# ============================================================

fn if_both_move_MatM(x: MatM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_m(move x);
    goto done
  f:
    call take_mat_m(move x);
    goto done
  done:
    return
}

fn if_both_move_MatCD(x: MatCD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cd(move x);
    goto done
  f:
    call take_mat_cd(move x);
    goto done
  done:
    return
}

fn if_both_move_MatDM(x: MatDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_dm(move x);
    goto done
  f:
    call take_mat_dm(move x);
    goto done
  done:
    return
}

fn if_both_move_MatCM(x: MatCM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cm(move x);
    goto done
  f:
    call take_mat_cm(move x);
    goto done
  done:
    return
}

fn if_both_move_MatCDM(x: MatCDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cdm(move x);
    goto done
  f:
    call take_mat_cdm(move x);
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 2 (one arm moves, other leaves Init)
# covers: class=CD|DM|CDM op=move cfg=if_one_arm_move type_kind=struct
# Drop classes: drop-elab inserts drop on the non-moving arm → clean.
# Non-Drop classes fire INIT-ReturnValueLeak (see violations file).
# ============================================================

fn if_one_arm_move_MatCD(x: MatCD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cd(move x);
    goto done
  f:
    goto done
  done:
    return
}

fn if_one_arm_move_MatDM(x: MatDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_dm(move x);
    goto done
  f:
    goto done
  done:
    return
}

fn if_one_arm_move_MatCDM(x: MatCDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    call take_mat_cdm(move x);
    goto done
  f:
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 3 (one arm drops, other doesn't touch)
# covers: class=D|CD|DM|CDM op=drop cfg=if_one_arm_drop type_kind=struct
# Drop classes: drop-elab handles the untouched arm → clean.
# Non-Drop classes fire SUB-DropOfNonDrop (see violations file).
# ============================================================

fn if_one_arm_drop_MatD(x: MatD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}

fn if_one_arm_drop_MatCD(x: MatCD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}

fn if_one_arm_drop_MatDM(x: MatDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}

fn if_one_arm_drop_MatCDM(x: MatCDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 4 (both arms drop x)
# covers: class=D|CD|DM|CDM op=drop cfg=if_both_drop type_kind=struct
# Drop classes: clean. Non-Drop fires SUB-DropOfNonDrop (see violations file).
# ============================================================

fn if_both_drop_MatD(x: MatD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatCD(x: MatCD, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatDM(x: MatDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

fn if_both_drop_MatCDM(x: MatCDM, cond: bool) {
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    drop x;
    goto done
  f:
    drop x;
    goto done
  done:
    return
}

# ============================================================
# Matrix: if-diamond x class — Shape 5 (both arms init x, consume after merge)
# covers: class=all op=init cfg=if_both_init type_kind=struct
# Both arms Init → Init at join; clean regardless of class.
# ============================================================

fn if_both_init_read_MatL(cond: bool) {
  x: MatL;
  n: i64;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    n = move x.v;
    drop n;
    return
}

fn if_both_init_read_MatC(cond: bool) {
  x: MatC;
  n: i64;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    n = move x.v;
    drop n;
    return
}

fn if_both_init_read_MatD(cond: bool) {
  x: MatD;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    drop x;
    return
}

fn if_both_init_read_MatM(cond: bool) {
  x: MatM;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    call take_mat_m(move x);
    return
}

fn if_both_init_read_MatCD(cond: bool) {
  x: MatCD;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    drop x;
    return
}

fn if_both_init_read_MatCM(cond: bool) {
  x: MatCM;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    call take_mat_cm(move x);
    return
}

fn if_both_init_read_MatDM(cond: bool) {
  x: MatDM;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    drop x;
    return
}

fn if_both_init_read_MatCDM(cond: bool) {
  x: MatCDM;
  entry:
    branch(copy cond) [true: t, false: f]
  t:
    x.v = 1;
    goto merge
  f:
    x.v = 2;
    goto merge
  merge:
    drop x;
    return
}

trait ImplClassCheckOk {
  fn check(recv: &Self, x: i64);
}

impl ImplClassCheckOk for MatCDM {
  # covers: substructural checking visits impl method bodies
  fn check(recv: &MatCDM, x: i64) {
    y: i64;
    entry:
      y = copy x;
      return
  }
}
