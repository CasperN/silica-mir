struct CopyDropScalars: Copy + Drop {
  x: i64
  y: bool
}

struct CopySharedRef<'s0>: Copy {
  r: &'s0 i64
  x: i64
}

struct MoveScalars: Move {
  x: i64
  y: bool
}

struct MoveAllRefKinds<'s0, 's1, 's2, 's3, 's4>: Move {
  a: &'s0 mut i64
  b: &'s1 out i64
  c: &'s2 drop i64
  d: &'s3 uninit i64
  e: &'s4 i64
}

struct DropMutRef<'s0>: Drop {
  r: &'s0 mut i64
}

struct DropUninitRef<'s0>: Drop {
  r: &'s0 uninit i64
}

struct NoMarkersLinearField<'s0> {
  r: &'s0 out i64
}

struct CopyInner: Copy {
  x: i64
}

struct CopyNested: Copy {
  a: CopyInner
  y: i64
}

enum RecursiveList<'s0>: Copy + Drop {
  Nil: $Tuple0
  Cons: &'s0 RecursiveList<'s0>
}

enum CopyDropScalarVariants: Copy + Drop {
  N: i64
  B: bool
  U: $Tuple0
}

struct CopyDropPoint: Copy + Drop {
  x: i64
  y: i64
}

struct MoveCopyDropField: Move {
  p: CopyDropPoint
}
