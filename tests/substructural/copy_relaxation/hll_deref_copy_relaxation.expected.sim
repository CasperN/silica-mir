struct Pair: Copy + Drop {
  left: i64
  right: i64
}

fn read_shared_field<'s0, 's1>(r: &'s0 Pair, $return: &'s1 out i64) {
  entry:
    $return.* = copy r.*.left;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn consume_and_replace<'s0>(r: &'s0 mut i64) {
  $tmp_0: $Tuple0;
  x: i64;
  $tmp_1: $Tuple0;
  entry:
    x = copy r.*;
    drop r.*;
    r.* = 42;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = $Tuple0 {};
    drop x;
    require_uninit x;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

fn repeated_pointee_reads_then_reinit<'s0>(r: &'s0 mut i64) {
  $tmp_0: $Tuple0;
  a: i64;
  b: i64;
  $tmp_1: $Tuple0;
  $tmp_2: i64;
  $tmp_3: &out i64;
  entry:
    a = copy r.*;
    b = copy r.*;
    $tmp_3 = &out $tmp_2;
    call $i64_add(move a, move b, move $tmp_3);
    drop r.*;
    r.* = move $tmp_2;
    $tmp_1 = $Tuple0 {};
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = $Tuple0 {};
    require_uninit b;
    require_uninit a;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

fn single_read_preserves_obligation<'s0, 's1>(r: &'s0 mut i64, $return: &'s1 out i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}
