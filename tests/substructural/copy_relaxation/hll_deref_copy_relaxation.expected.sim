struct Pair: Copy + Drop {
  left: i64
  right: i64
}

fn<'s0, 's1> read_shared_field(r: &'s0 Pair, $return: &out 's1 i64) {
  entry:
    $return.* = copy r.*.left;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn<'s0> consume_and_replace(r: &mut 's0 i64) {
  $tmp_0: unit;
  x: i64;
  $tmp_1: unit;
  entry:
    x = copy r.*;
    drop r.*;
    r.* = 42;
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop x;
    require_uninit x;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

fn<'s0> repeated_pointee_reads_then_reinit(r: &mut 's0 i64) {
  $tmp_0: unit;
  a: i64;
  b: i64;
  $tmp_1: unit;
  $tmp_2: i64;
  $tmp_3: &out i64;
  entry:
    a = copy r.*;
    b = copy r.*;
    $tmp_3 = &out $tmp_2;
    call $i64_add(move a, move b, move $tmp_3);
    drop r.*;
    r.* = move $tmp_2;
    $tmp_1 = unit;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    require_uninit b;
    require_uninit a;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

fn<'s0, 's1> single_read_preserves_obligation(r: &mut 's0 i64, $return: &out 's1 i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}
