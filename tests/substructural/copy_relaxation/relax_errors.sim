# Copy relaxation error cases. Each fn exercises one `take` resolution
# failure mode; the pass emits a dedicated `RELAX-*` diagnostic.

struct Owned: Drop + Move { value: i64 }

extern fn consume(x: Owned);

# ---------- RELAX-MandatoryPreservationUnavailable: shared-ref crossing ----------

# Moving through a shared reference is illegal, and `Owned` has neither Copy
# nor AutoClone, so no preserving resolution exists.
fn take_of_non_copy_through_shared_ref(r: &Owned) {
  x: Owned;
  entry:
    x = take r.*;
    call consume(move x);
    return
}

# ---------- RELAX-MandatoryPreservationUnavailable: dynamic-index projection ----------

# A dynamic index requires preservation, but the slot type supports neither
# Copy nor AutoClone.
fn take_of_non_copy_at_dynamic_index(a: [Owned; 2], i: i64) {
  x: Owned;
  entry:
    x = take a[copy i];
    call consume(move x);
    return
}

# ---------- RELAX-IndexOperandNotReading: `move` inside `Index` ----------

# Array indexing is a non-consuming read of its operand. A `move` here
# would silently escape place-state / NLL / lifetime tracking of the
# indexed temporary.
fn move_index_operand(a: [i64; 4], i: i64) {
  x: i64;
  entry:
    x = copy a[move i];
    drop x;
    return
}

trait ImplCopyRelaxationViolation {
  fn relax(recv: & Self, x: &Owned);
}

impl ImplCopyRelaxationViolation for Owned {
  # covers: copy relaxation errors in impl method bodies
  fn relax(recv: & Owned, x: &Owned) {
    y: Owned;
    entry:
      y = take x.*;
      call consume(move y);
      return
  }
}
