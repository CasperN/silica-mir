# Copy relaxation is a pre-NLL, CFG-aware MIR elaboration pass. It
# specializes each `take` operand to `move` (last use, no further demand)
# or `copy` (later reachable use / ref post-Init obligation demands the
# value). Hand-written `move` and `copy` are authoritative and never
# rewritten. This fixture uses `take` throughout to exercise the pass's
# specialization; unit tests cover branch, loop, projection, and `&out`
# transfer edges.

struct Token: Copy + Drop { value: i64 }
struct Pair: Move { left: i64 right: i64 }
struct CopyPair: Copy + Drop { left: i64 right: i64 }
enum DeepChoice: Copy + Drop { Variant: i64 Other: i64 }
enum RefChoice: Move { HasRef: &mut CopyPair Empty: unit }
struct ProjectionRoot: Move { field: &mut [&mut DeepChoice; 3] }
struct Link: Move { next: &mut &mut CopyPair }

extern fn take_num(x: i64);
extern fn take_token(x: Token);
extern fn observe(r: &i64);

# The first take preserves x for the second use; the last use stays a move.
fn repeated_scalar(x: i64) {
  entry:
    call take_num(take x);
    call take_num(take x);
    return
}

# Classification comes from the declared MIR class, not a lowering heuristic.
fn repeated_custom(x: Token) {
  entry:
    call take_token(take x);
    call take_token(take x);
    return
}

# Copying a shared borrower lets NLL retain its loan through the first call
# and close it after the final consuming move.
fn repeated_shared_ref(r: &i64) {
  entry:
    call observe(take r);
    call observe(take r);
    return
}

# Sibling projections are independent take paths. The use of p.right does not
# justify copying the earlier take of p.left.
fn sibling_fields(p: Pair) {
  entry:
    call take_num(take p.left);
    call take_num(take p.right);
    return
}

# Dereference demand is tracked separately from demand for the borrower.
# The first pointee take is relaxed, the last remains a move, and the write
# restores the &mut reference's Init-at-expiry obligation.
fn repeated_mut_pointee(r: &mut i64) {
  entry:
    call take_num(take r.*);
    call take_num(take r.*);
    r.* = 0;
    return
}

# Static fields and constant indexes above a dereference retain their precise
# move-path identity.
fn repeated_mut_field(r: &mut CopyPair) {
  entry:
    call take_num(take r.*.left);
    call take_num(take r.*.left);
    r.*.left = 0;
    return
}

fn repeated_mut_const_index(r: &mut [i64; 2]) {
  entry:
    call take_num(take r.*[0]);
    call take_num(take r.*[0]);
    r.*[0] = 0;
    return
}

# Arbitrary-depth static access paths use the same rule. Every reference
# boundary is exclusive, the first leaf take is relaxed, and the final write
# restores the innermost obligation.
fn repeated_nested_mut_pointee(r: &mut &mut &mut CopyPair) {
  entry:
    call take_num(take r.*.*.*.left);
    call take_num(take r.*.*.*.left);
    r.*.*.*.left = 0;
    return
}

# Projections may occur before, between, and after dereferences.
fn repeated_field_between_derefs(link: Link) {
  entry:
    call take_num(take link.next.*.*.right);
    call take_num(take link.next.*.*.right);
    link.next.*.*.right = 0;
    return
}

fn repeated_downcast_between_derefs(r: &mut RefChoice) {
  entry:
    call take_num(take r.* as HasRef.*.left);
    call take_num(take r.* as HasRef.*.left);
    r.* as HasRef.*.left = 0;
    return
}

# Complex static path: owned field, dereference, constant index, dereference,
# then enum downcast. The final whole-enum write restores the inner &mut
# obligation after the last payload move.
fn repeated_complex_projection(foo: ProjectionRoot) {
  entry:
    call take_num(take foo.field.*[2].* as Variant);
    call take_num(take foo.field.*[2].* as Variant);
    foo.field.*[2].* = DeepChoice::Variant(0);
    return
}

# Mixed exclusive kinds retain their own postconditions at nested depth.
fn repeated_nested_drop(r: &mut &drop i64) {
  entry:
    call take_num(take r.*.*);
    call take_num(take r.*.*);
    return
}

fn repeated_nested_out(r: &mut &out i64) {
  entry:
    r.*.* = 1;
    call take_num(take r.*.*);
    call take_num(take r.*.*);
    r.*.* = 0;
    return
}

# Every exclusive reference kind can participate when its pointee is in the
# state required by the take and its eventual obligation is fulfilled.
fn repeated_drop_pointee(r: &drop i64) {
  entry:
    call take_num(take r.*);
    call take_num(take r.*);
    return
}

fn repeated_out_pointee(r: &out i64) {
  entry:
    r.* = 1;
    call take_num(take r.*);
    call take_num(take r.*);
    r.* = 0;
    return
}

fn repeated_uninit_pointee(r: &uninit i64) {
  entry:
    r.* = 1;
    call take_num(take r.*);
    call take_num(take r.*);
    return
}

trait ImplCopyRelaxationOk {
  fn relax(recv: & Self, x: i64);
}

impl ImplCopyRelaxationOk for Token {
  # covers: copy relaxation visits impl method bodies
  fn relax(recv: & Token, x: i64) {
    entry:
      call take_num(take x);
      call take_num(take x);
      return
  }
}
