# Copy relaxation is a pre-NLL, CFG-aware MIR elaboration pass. It
# specializes each `take` operand to `move` (last use), `copy` (trivial
# preservation), or an AutoClone call (nontrivial preservation). Hand-written
# `move` and `copy` are authoritative and never rewritten. This fixture uses
# `take` throughout to exercise the pass's specialization; unit tests cover
# additional dataflow invariants.

struct Token: Copy + Drop { value: i64 }
struct Pair: Move { left: i64 right: i64 }
struct CopyPair: Copy + Drop { left: i64 right: i64 }
enum DeepChoice: Copy + Drop { Variant: i64 Other: i64 }
enum RefChoice: Move { HasRef: &mut CopyPair Empty: unit }
struct ProjectionRoot: Move { field: &mut [&mut DeepChoice; 3] }
struct Link: Move { next: &mut &mut CopyPair }
struct Cloneable: Move { value: i64 }
struct<T: Copy + Drop> GenericCloneable: Move { value: T }
struct CloneHolder: Move { item: Cloneable tail: i64 }
struct<'a> BorrowedCloneable: Move { value: &'a i64 }

extern fn take_num(x: i64);
extern fn take_token(x: Token);
extern fn observe(r: &i64);
extern fn take_cloneable(x: Cloneable);
extern fn take_two_cloneable(x: Cloneable, y: Cloneable);
extern fn take_generic_cloneable(x: GenericCloneable<i64>);
extern fn<'a> take_borrowed_cloneable(x: BorrowedCloneable<'a>);

# Copy remains the preferred trivial relaxation even if AutoClone is also
# implemented for the type.
impl AutoClone for Token {
  fn clone(recv: &Token, $return: &out Token) {
    entry:
      $return.* = copy recv.*;
      return
  }
}

impl AutoClone for Cloneable {
  fn clone(recv: &Cloneable, $return: &out Cloneable) {
    entry:
      $return.*.value = copy recv.*.value;
      return
  }
}

impl<T: Copy + Drop> AutoClone for GenericCloneable<T> {
  fn clone(recv: &GenericCloneable<T>, $return: &out GenericCloneable<T>) {
    entry:
      $return.*.value = copy recv.*.value;
      return
  }
}

impl<'a> AutoClone for BorrowedCloneable<'a> {
  fn clone(recv: &BorrowedCloneable<'a>, $return: &out BorrowedCloneable<'a>) {
    entry:
      $return.*.value = copy recv.*.value;
      return
  }
}

# The first use of an AutoClone-but-not-Copy value expands to a clone call;
# the final use still moves the original value.
# covers: implicit AutoClone followed by last-use move
fn repeated_autoclone(x: Cloneable) {
  entry:
    call take_cloneable(take x);
    call take_cloneable(take x);
    return
}

# Assignment rvalues receive the generated clone prefix just like call
# operands. The assigned clone and original value can then be consumed.
# covers: AutoClone expansion before an assignment rvalue
fn assign_autoclone(x: Cloneable) {
  y: Cloneable;
  entry:
    y = take x;
    call take_cloneable(move y);
    call take_cloneable(move x);
    return
}

# A shared-reference boundary forbids moving the pointee, but AutoClone can
# preserve it without requiring the pointee itself to be Copy.
# covers: AutoClone through a shared-reference boundary
fn autoclone_through_shared(r: &Cloneable) {
  entry:
    call take_cloneable(take r.*);
    return
}

# Dynamic indices have no stable move-path identity. Cloning through a shared
# array reference provides a non-consuming resolution.
# covers: AutoClone through a dynamic-index projection
fn autoclone_dynamic_index(r: &[Cloneable; 2], i: i64) {
  entry:
    call take_cloneable(take r.*[copy i]);
    return
}

# Generic impl headers participate in implicit AutoClone lookup.
# covers: generic AutoClone impl selection
fn repeated_generic_autoclone(x: GenericCloneable<i64>) {
  entry:
    call take_generic_cloneable(take x);
    call take_generic_cloneable(take x);
    return
}

# Ordinary projections use the projected type's AutoClone impl. The sibling
# field is consumed separately so the containing Move aggregate is exhausted.
# covers: AutoClone of an owned projected field
fn repeated_projected_autoclone(x: CloneHolder) {
  entry:
    call take_cloneable(take x.item);
    call take_cloneable(take x.item);
    call take_num(take x.tail);
    return
}

# Prefix expansions retain operand order even though demand is walked
# backwards. Both operands clone for the first call and move in the second.
# covers: multiple AutoClone expansions before one statement
fn multiple_autoclone_operands(x: Cloneable, y: Cloneable) {
  entry:
    call take_two_cloneable(take x, take y);
    call take_two_cloneable(take x, take y);
    return
}

# Generated value and reference temporaries preserve lifetime-bearing types.
# covers: AutoClone of a lifetime-parameterized value
fn<'a> repeated_lifetime_autoclone(x: BorrowedCloneable<'a>) {
  entry:
    call take_borrowed_cloneable(take x);
    call take_borrowed_cloneable(take x);
    return
}

# Loop-carried demand clones on each iteration while the exit path eventually
# moves the original value.
# covers: AutoClone for loop-carried demand
fn autoclone_loop(x: Cloneable, again: bool) {
  entry:
    goto loop
  loop:
    call take_cloneable(take x);
    branch(copy again) [true: loop, false: done]
  done:
    call take_cloneable(take x);
    return
}

# The first take preserves x for the second use; the last use stays a move.
fn repeated_scalar(x: i64) {
  entry:
    call take_num(take x);
    call take_num(take x);
    return
}

# Classification comes from the declared MIR class, not a lowering heuristic.
# covers: Copy takes precedence when AutoClone is also implemented
fn repeated_custom(x: Token) {
  entry:
    call take_token(take x);
    call take_token(take x);
    return
}

# Copying a shared borrower lets NLL retain its loan through the first call
# and close it after the final consuming move.
fn repeated_shared_ref(r: &i64) {
  entry:
    call observe(take r);
    call observe(take r);
    return
}

# Sibling projections are independent take paths. The use of p.right does not
# justify copying the earlier take of p.left.
fn sibling_fields(p: Pair) {
  entry:
    call take_num(take p.left);
    call take_num(take p.right);
    return
}

# Dereference demand is tracked separately from demand for the borrower.
# The first pointee take is relaxed, the last remains a move, and the write
# restores the &mut reference's Init-at-expiry obligation.
fn repeated_mut_pointee(r: &mut i64) {
  entry:
    call take_num(take r.*);
    call take_num(take r.*);
    r.* = 0;
    return
}

# Generated AutoClone receivers may reborrow a mutable-reference pointee
# shared. The final move and field write restore the pointee obligation.
# covers: AutoClone through a mutable-reference pointee
fn autoclone_through_mut(r: &mut Cloneable) {
  entry:
    call take_cloneable(take r.*);
    call take_cloneable(take r.*);
    r.*.value = 0;
    return
}

# Static fields and constant indexes above a dereference retain their precise
# move-path identity.
fn repeated_mut_field(r: &mut CopyPair) {
  entry:
    call take_num(take r.*.left);
    call take_num(take r.*.left);
    r.*.left = 0;
    return
}

fn repeated_mut_const_index(r: &mut [i64; 2]) {
  entry:
    call take_num(take r.*[0]);
    call take_num(take r.*[0]);
    r.*[0] = 0;
    return
}

# Arbitrary-depth static access paths use the same rule. Every reference
# boundary is exclusive, the first leaf take is relaxed, and the final write
# restores the innermost obligation.
fn repeated_nested_mut_pointee(r: &mut &mut &mut CopyPair) {
  entry:
    call take_num(take r.*.*.*.left);
    call take_num(take r.*.*.*.left);
    r.*.*.*.left = 0;
    return
}

# Projections may occur before, between, and after dereferences.
fn repeated_field_between_derefs(link: Link) {
  entry:
    call take_num(take link.next.*.*.right);
    call take_num(take link.next.*.*.right);
    link.next.*.*.right = 0;
    return
}

fn repeated_downcast_between_derefs(r: &mut RefChoice) {
  entry:
    call take_num(take r.* as HasRef.*.left);
    call take_num(take r.* as HasRef.*.left);
    r.* as HasRef.*.left = 0;
    return
}

# Complex static path: owned field, dereference, constant index, dereference,
# then enum downcast. The final whole-enum write restores the inner &mut
# obligation after the last payload move.
fn repeated_complex_projection(foo: ProjectionRoot) {
  entry:
    call take_num(take foo.field.*[2].* as Variant);
    call take_num(take foo.field.*[2].* as Variant);
    foo.field.*[2].* = DeepChoice::Variant(0);
    return
}

# Mixed exclusive kinds retain their own postconditions at nested depth.
fn repeated_nested_drop(r: &mut &drop i64) {
  entry:
    call take_num(take r.*.*);
    call take_num(take r.*.*);
    return
}

fn repeated_nested_out(r: &mut &out i64) {
  entry:
    r.*.* = 1;
    call take_num(take r.*.*);
    call take_num(take r.*.*);
    r.*.* = 0;
    return
}

# Every exclusive reference kind can participate when its pointee is in the
# state required by the take and its eventual obligation is fulfilled.
fn repeated_drop_pointee(r: &drop i64) {
  entry:
    call take_num(take r.*);
    call take_num(take r.*);
    return
}

fn repeated_out_pointee(r: &out i64) {
  entry:
    r.* = 1;
    call take_num(take r.*);
    call take_num(take r.*);
    r.* = 0;
    return
}

fn repeated_uninit_pointee(r: &uninit i64) {
  entry:
    r.* = 1;
    call take_num(take r.*);
    call take_num(take r.*);
    return
}

trait ImplCopyRelaxationOk {
  fn relax(recv: &Self, x: i64, y: Cloneable);
}

impl ImplCopyRelaxationOk for Token {
  # covers: copy relaxation visits impl method bodies
  fn relax(recv: &Token, x: i64, y: Cloneable) {
    entry:
      call take_num(take x);
      call take_num(take x);
      call take_cloneable(take y);
      call take_cloneable(take y);
      return
  }
}
