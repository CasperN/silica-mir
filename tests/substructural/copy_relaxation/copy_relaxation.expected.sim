struct Token: Copy + Drop {
  value: i64
}

struct Pair: Move {
  left: i64
  right: i64
}

struct CopyPair: Copy + Drop {
  left: i64
  right: i64
}

enum DeepChoice: Copy + Drop {
  Variant: i64
  Other: i64
}

enum<'s0> RefChoice: Move {
  HasRef: &mut 's0 CopyPair
  Empty: unit
}

struct<'s0, 's1> ProjectionRoot: Move {
  field: &mut 's0 [&mut 's1 DeepChoice; 3]
}

struct<'s0, 's1> Link: Move {
  next: &mut 's0 &mut 's1 CopyPair
}

struct Cloneable: Move {
  value: i64
}

struct<T: Copy + Drop> GenericCloneable: Move {
  value: T
}

struct CloneHolder: Move {
  item: Cloneable
  tail: i64
}

struct<'a> BorrowedCloneable: Move {
  value: &'a i64
}

extern fn take_num(x: i64);

extern fn take_token(x: Token);

extern fn<'s0> observe(r: &'s0 i64);

extern fn take_cloneable(x: Cloneable);

extern fn take_two_cloneable(x: Cloneable, y: Cloneable);

extern fn take_generic_cloneable(x: GenericCloneable<i64>);

extern fn<'a> take_borrowed_cloneable(x: BorrowedCloneable<'a>);

impl AutoClone for Token {
  fn<'s0, 's1> clone(recv: &'s0 Token, $return: &out 's1 Token) {
    entry:
      $return.* = copy recv.*;
      unborrow $return;
      drop recv;
      return
  }
}

impl AutoClone for Cloneable {
  fn<'s0, 's1> clone(recv: &'s0 Cloneable, $return: &out 's1 Cloneable) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

impl<T: Copy + Drop> AutoClone for GenericCloneable<T> {
  fn<'s0, 's1> clone(recv: &'s0 GenericCloneable<T>, $return: &out 's1 GenericCloneable<T>) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

impl<'a> AutoClone for BorrowedCloneable<'a> {
  fn<'s0, 's1> clone(recv: &'s0 BorrowedCloneable<'a>, $return: &out 's1 BorrowedCloneable<'a>) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

fn repeated_autoclone(x: Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    call take_cloneable(move x);
    return
}

fn assign_autoclone(x: Cloneable) {
  y: Cloneable;
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    y = move $clone_0;
    call take_cloneable(move y);
    call take_cloneable(move x);
    return
}

fn<'s0> autoclone_through_shared(r: &'s0 Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &r.*;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    drop r;
    return
}

fn<'s0> autoclone_dynamic_index(r: &'s0 [Cloneable; 2], i: i64) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &r.*[copy i];
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    drop i;
    drop r;
    return
}

fn repeated_generic_autoclone(x: GenericCloneable<i64>) {
  $clone_0: GenericCloneable<i64>;
  $clone_1: &GenericCloneable<i64>;
  $clone_2: &out GenericCloneable<i64>;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <GenericCloneable<i64> as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_generic_cloneable(move $clone_0);
    call take_generic_cloneable(move x);
    return
}

fn repeated_projected_autoclone(x: CloneHolder) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x.item;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    call take_cloneable(move x.item);
    call take_num(move x.tail);
    return
}

fn multiple_autoclone_operands(x: Cloneable, y: Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  $clone_3: Cloneable;
  $clone_4: &Cloneable;
  $clone_5: &out Cloneable;
  entry:
    $clone_4 = &x;
    $clone_5 = &out $clone_3;
    call <Cloneable as AutoClone>::clone(move $clone_4, move $clone_5);
    $clone_1 = &y;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_two_cloneable(move $clone_3, move $clone_0);
    call take_two_cloneable(move x, move y);
    return
}

fn<'a> repeated_lifetime_autoclone(x: BorrowedCloneable<'a>) {
  $clone_0: BorrowedCloneable<'a>;
  $clone_1: &BorrowedCloneable<'a>;
  $clone_2: &out BorrowedCloneable<'a>;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <BorrowedCloneable<'a> as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_borrowed_cloneable(move $clone_0);
    call take_borrowed_cloneable(move x);
    return
}

fn autoclone_loop(x: Cloneable, again: bool) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    goto loop
  loop:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    branch(copy again) [true: loop, false: done]
  done:
    call take_cloneable(move x);
    drop again;
    return
}

fn repeated_scalar(x: i64) {
  entry:
    call take_num(copy x);
    call take_num(move x);
    return
}

fn repeated_custom(x: Token) {
  entry:
    call take_token(copy x);
    call take_token(move x);
    return
}

fn<'s0> repeated_shared_ref(r: &'s0 i64) {
  entry:
    call observe(copy r);
    call observe(move r);
    return
}

fn sibling_fields(p: Pair) {
  entry:
    call take_num(move p.left);
    call take_num(move p.right);
    return
}

fn<'s0> repeated_mut_pointee(r: &mut 's0 i64) {
  entry:
    call take_num(copy r.*);
    call take_num(move r.*);
    r.* = 0;
    drop r;
    return
}

fn<'s0> autoclone_through_mut(r: &mut 's0 Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &r.*;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    call take_cloneable(move r.*);
    r.*.value = 0;
    drop r;
    return
}

fn<'s0> repeated_mut_field(r: &mut 's0 CopyPair) {
  entry:
    call take_num(copy r.*.left);
    call take_num(move r.*.left);
    r.*.left = 0;
    drop r;
    return
}

fn<'s0> repeated_mut_const_index(r: &mut 's0 [i64; 2]) {
  entry:
    call take_num(copy r.*[0]);
    call take_num(move r.*[0]);
    r.*[0] = 0;
    drop r;
    return
}

fn<'s0: 's1 + 's2, 's1, 's2> repeated_nested_mut_pointee(r: &mut 's0 &mut 's1 &mut 's2 CopyPair) {
  entry:
    call take_num(copy r.*.*.*.left);
    call take_num(move r.*.*.*.left);
    r.*.*.*.left = 0;
    drop r;
    return
}

fn<'s0, 's1> repeated_field_between_derefs(link: Link<'s0, 's1>) {
  entry:
    call take_num(copy link.next.*.*.right);
    call take_num(move link.next.*.*.right);
    link.next.*.*.right = 0;
    unborrow link.next;
    return
}

fn<'s0> repeated_downcast_between_derefs(r: &mut 's0 RefChoice<'s0>) {
  entry:
    call take_num(copy r.* as HasRef.*.left);
    call take_num(move r.* as HasRef.*.left);
    r.* as HasRef.*.left = 0;
    drop r;
    return
}

fn<'s0, 's1> repeated_complex_projection(foo: ProjectionRoot<'s0, 's1>) {
  entry:
    call take_num(copy foo.field.*[2].* as Variant);
    call take_num(move foo.field.*[2].* as Variant);
    foo.field.*[2].* = DeepChoice::Variant(0);
    unborrow foo.field;
    return
}

fn<'s0: 's1, 's1> repeated_nested_drop(r: &mut 's0 &drop 's1 i64) {
  entry:
    call take_num(copy r.*.*);
    call take_num(move r.*.*);
    drop r;
    return
}

fn<'s0: 's1, 's1> repeated_nested_out(r: &mut 's0 &out 's1 i64) {
  entry:
    r.*.* = 1;
    call take_num(copy r.*.*);
    call take_num(move r.*.*);
    r.*.* = 0;
    drop r;
    return
}

fn<'s0> repeated_drop_pointee(r: &drop 's0 i64) {
  entry:
    call take_num(copy r.*);
    call take_num(move r.*);
    unborrow r;
    return
}

fn<'s0> repeated_out_pointee(r: &out 's0 i64) {
  entry:
    r.* = 1;
    call take_num(copy r.*);
    call take_num(move r.*);
    r.* = 0;
    unborrow r;
    return
}

fn<'s0> repeated_uninit_pointee(r: &uninit 's0 i64) {
  entry:
    r.* = 1;
    call take_num(copy r.*);
    call take_num(move r.*);
    drop r;
    return
}

trait ImplCopyRelaxationOk {
  fn<'s0> relax(recv: &'s0 Self, x: i64, y: Cloneable);
}

impl ImplCopyRelaxationOk for Token {
  fn<'s0> relax(recv: &'s0 Token, x: i64, y: Cloneable) {
    $clone_0: Cloneable;
    $clone_1: &Cloneable;
    $clone_2: &out Cloneable;
    entry:
      call take_num(copy x);
      call take_num(move x);
      $clone_1 = &y;
      $clone_2 = &out $clone_0;
      call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
      call take_cloneable(move $clone_0);
      call take_cloneable(move y);
      drop recv;
      return
  }
}
