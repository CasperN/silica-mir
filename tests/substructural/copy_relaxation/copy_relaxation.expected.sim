struct Token: Copy + Drop {
  value: i64
}

struct Pair: Move {
  left: i64
  right: i64
}

struct CopyPair: Copy + Drop {
  left: i64
  right: i64
}

enum DeepChoice: Copy + Drop {
  Variant: i64
  Other: i64
}

enum RefChoice<'s0>: Move {
  HasRef: &'s0 mut CopyPair
  Empty: unit
}

struct ProjectionRoot<'s0, 's1>: Move {
  field: &'s0 mut [&'s1 mut DeepChoice; 3]
}

struct Link<'s0, 's1>: Move {
  next: &'s0 mut &'s1 mut CopyPair
}

struct Cloneable: Move {
  value: i64
}

struct GenericCloneable<T: Copy + Drop>: Move {
  value: T
}

struct CloneHolder: Move {
  item: Cloneable
  tail: i64
}

struct BorrowedCloneable<'a>: Move {
  value: &'a i64
}

extern fn take_num(x: i64);

extern fn take_token(x: Token);

extern fn observe<'s0>(r: &'s0 i64);

extern fn take_cloneable(x: Cloneable);

extern fn take_two_cloneable(x: Cloneable, y: Cloneable);

extern fn take_generic_cloneable(x: GenericCloneable<i64>);

extern fn take_borrowed_cloneable<'a>(x: BorrowedCloneable<'a>);

impl AutoClone for Token {
  fn clone<'s0, 's1>(recv: &'s0 Token, $return: &'s1 out Token) {
    entry:
      $return.* = copy recv.*;
      unborrow $return;
      drop recv;
      return
  }
}

impl AutoClone for Cloneable {
  fn clone<'s0, 's1>(recv: &'s0 Cloneable, $return: &'s1 out Cloneable) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

impl<T: Copy + Drop> AutoClone for GenericCloneable<T> {
  fn clone<'s0, 's1>(recv: &'s0 GenericCloneable<T>, $return: &'s1 out GenericCloneable<T>) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

impl<'a> AutoClone for BorrowedCloneable<'a> {
  fn clone<'s0, 's1>(recv: &'s0 BorrowedCloneable<'a>, $return: &'s1 out BorrowedCloneable<'a>) {
    entry:
      $return.*.value = copy recv.*.value;
      unborrow $return;
      drop recv;
      return
  }
}

fn repeated_autoclone(x: Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    call take_cloneable(move x);
    return
}

fn assign_autoclone(x: Cloneable) {
  y: Cloneable;
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    y = move $clone_0;
    call take_cloneable(move y);
    call take_cloneable(move x);
    return
}

fn autoclone_through_shared<'s0>(r: &'s0 Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &r.*;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    drop r;
    return
}

fn autoclone_dynamic_index<'s0>(r: &'s0 [Cloneable; 2], i: i64) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &r.*[copy i];
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    drop i;
    drop r;
    return
}

fn repeated_generic_autoclone(x: GenericCloneable<i64>) {
  $clone_0: GenericCloneable<i64>;
  $clone_1: &GenericCloneable<i64>;
  $clone_2: &out GenericCloneable<i64>;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <GenericCloneable<i64> as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_generic_cloneable(move $clone_0);
    call take_generic_cloneable(move x);
    return
}

fn repeated_projected_autoclone(x: CloneHolder) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    $clone_1 = &x.item;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    call take_cloneable(move x.item);
    call take_num(move x.tail);
    return
}

fn multiple_autoclone_operands(x: Cloneable, y: Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  $clone_3: Cloneable;
  $clone_4: &Cloneable;
  $clone_5: &out Cloneable;
  entry:
    $clone_4 = &x;
    $clone_5 = &out $clone_3;
    call <Cloneable as AutoClone>::clone(move $clone_4, move $clone_5);
    $clone_1 = &y;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_two_cloneable(move $clone_3, move $clone_0);
    call take_two_cloneable(move x, move y);
    return
}

fn repeated_lifetime_autoclone<'a>(x: BorrowedCloneable<'a>) {
  $clone_0: BorrowedCloneable<'a>;
  $clone_1: &BorrowedCloneable<'a>;
  $clone_2: &out BorrowedCloneable<'a>;
  entry:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <BorrowedCloneable<'a> as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_borrowed_cloneable(move $clone_0);
    call take_borrowed_cloneable(move x);
    return
}

fn autoclone_loop(x: Cloneable, again: bool) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  entry:
    goto loop
  loop:
    $clone_1 = &x;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    branch(copy again) [true: loop, false: done]
  done:
    call take_cloneable(move x);
    drop again;
    return
}

fn repeated_scalar(x: i64) {
  entry:
    call take_num(copy x);
    call take_num(move x);
    return
}

fn repeated_custom(x: Token) {
  entry:
    call take_token(copy x);
    call take_token(move x);
    return
}

fn repeated_shared_ref<'s0>(r: &'s0 i64) {
  entry:
    call observe(copy r);
    call observe(move r);
    return
}

fn sibling_fields(p: Pair) {
  entry:
    call take_num(move p.left);
    call take_num(move p.right);
    return
}

fn repeated_mut_pointee<'s0>(r: &'s0 mut i64) {
  entry:
    call take_num(copy r.*);
    call take_num(copy r.*);
    drop r.*;
    r.* = 0;
    drop r;
    return
}

fn autoclone_through_mut<'s0>(r: &'s0 mut Cloneable) {
  $clone_0: Cloneable;
  $clone_1: &Cloneable;
  $clone_2: &out Cloneable;
  $clone_3: Cloneable;
  $clone_4: &Cloneable;
  $clone_5: &out Cloneable;
  entry:
    $clone_4 = &r.*;
    $clone_5 = &out $clone_3;
    call <Cloneable as AutoClone>::clone(move $clone_4, move $clone_5);
    call take_cloneable(move $clone_3);
    $clone_1 = &r.*;
    $clone_2 = &out $clone_0;
    call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
    call take_cloneable(move $clone_0);
    drop r.*.value;
    r.*.value = 0;
    drop r;
    return
}

fn repeated_mut_field<'s0>(r: &'s0 mut CopyPair) {
  entry:
    call take_num(copy r.*.left);
    call take_num(copy r.*.left);
    drop r.*.left;
    r.*.left = 0;
    drop r;
    return
}

fn repeated_mut_const_index<'s0>(r: &'s0 mut [i64; 2]) {
  entry:
    call take_num(copy r.*[0]);
    call take_num(copy r.*[0]);
    drop r.*[0];
    r.*[0] = 0;
    drop r;
    return
}

fn repeated_nested_mut_pointee<'s0: 's1 + 's2, 's1, 's2>(r: &'s0 mut &'s1 mut &'s2 mut CopyPair) {
  entry:
    call take_num(copy r.*.*.*.left);
    call take_num(copy r.*.*.*.left);
    drop r.*.*.*.left;
    r.*.*.*.left = 0;
    drop r;
    return
}

fn repeated_field_between_derefs<'s0, 's1>(link: Link<'s0, 's1>) {
  entry:
    call take_num(copy link.next.*.*.right);
    call take_num(copy link.next.*.*.right);
    drop link.next.*.*.right;
    link.next.*.*.right = 0;
    unborrow link.next;
    return
}

fn repeated_downcast_between_derefs<'s0>(r: &'s0 mut RefChoice<'s0>) {
  entry:
    call take_num(copy r.* as HasRef.*.left);
    call take_num(copy r.* as HasRef.*.left);
    drop r.* as HasRef.*.left;
    r.* as HasRef.*.left = 0;
    drop r;
    return
}

fn repeated_complex_projection<'s0, 's1>(foo: ProjectionRoot<'s0, 's1>) {
  entry:
    call take_num(copy foo.field.*[2].* as Variant);
    call take_num(copy foo.field.*[2].* as Variant);
    drop foo.field.*[2].*;
    foo.field.*[2].* = DeepChoice::Variant(0);
    unborrow foo.field;
    return
}

fn repeated_nested_drop<'s0: 's1, 's1>(r: &'s0 mut &'s1 drop i64) {
  entry:
    call take_num(copy r.*.*);
    call take_num(move r.*.*);
    drop r;
    return
}

fn repeated_nested_out<'s0: 's1, 's1>(r: &'s0 mut &'s1 out i64) {
  entry:
    r.*.* = 1;
    call take_num(copy r.*.*);
    call take_num(move r.*.*);
    r.*.* = 0;
    drop r;
    return
}

fn repeated_drop_pointee<'s0>(r: &'s0 drop i64) {
  entry:
    call take_num(copy r.*);
    call take_num(move r.*);
    unborrow r;
    return
}

fn repeated_out_pointee<'s0>(r: &'s0 out i64) {
  entry:
    r.* = 1;
    call take_num(copy r.*);
    call take_num(move r.*);
    r.* = 0;
    unborrow r;
    return
}

fn repeated_uninit_pointee<'s0>(r: &'s0 uninit i64) {
  entry:
    r.* = 1;
    call take_num(copy r.*);
    call take_num(move r.*);
    drop r;
    return
}

trait ImplCopyRelaxationOk {
  fn relax<'s0>(recv: &'s0 Self, x: i64, y: Cloneable);
}

impl ImplCopyRelaxationOk for Token {
  fn relax<'s0>(recv: &'s0 Token, x: i64, y: Cloneable) {
    $clone_0: Cloneable;
    $clone_1: &Cloneable;
    $clone_2: &out Cloneable;
    entry:
      call take_num(copy x);
      call take_num(move x);
      $clone_1 = &y;
      $clone_2 = &out $clone_0;
      call <Cloneable as AutoClone>::clone(move $clone_1, move $clone_2);
      call take_cloneable(move $clone_0);
      call take_cloneable(move y);
      drop recv;
      return
  }
}
