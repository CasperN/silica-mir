# covers: 0-arg lambda with no captures
fn test_nullary() -> i64 {
  let f = || 42i64;
  f()
}

# covers: multi-arg lambda with explicit types
fn test_explicit_args(a: i64, b: i64) -> i64 {
  let add = |x: i64, y: i64| -> i64 x + y;
  add(a, b)
}

# covers: lambda capturing local variable by value
fn test_single_capture(x: i64) -> i64 {
  let factor = 3i64;
  let mul = |val: i64| val * factor;
  mul(x)
}

# covers: lambda capturing multiple variables by value
fn test_multi_capture(x: i64) -> i64 {
  let a = 10i64;
  let b = 20i64;
  let f = |n: i64| n + a + b;
  f(x)
}

# covers: immediate lambda invocation
fn test_immediate_call() -> i64 {
  (|x: i64| x * 2i64)(21i64)
}

# covers: lambda parameter and return type inference
fn test_inferred(x: i64) -> i64 {
  let inc = |n| n + 1i64;
  inc(x)
}

# covers: capturing a shared reference explicitly
fn test_capture_shared_ref(x: i64) -> i64 {
  let r = &x;
  let f = || r.*;
  f()
}

# covers: capturing a mutable reference explicitly
fn test_capture_mut_ref(x: i64) -> i64 {
  let mut x = x;
  {
    let r = &mut x;
    let mut f = || r.* = r.* + 1i64;
    f();
  }
  x
}

# covers: capturing an out reference explicitly
fn test_capture_out_ref() -> i64 {
  let mut x: i64;
  {
    let r = &out x;
    let f = || r.* = 42i64;
    f();
  }
  x
}

struct Handle: Move {
  id: i64,
}

impl AutoClone for Handle {
  fn clone(&self) -> Handle {
    Handle { id: self.*.id }
  }
}

impl AutoDestroy for Handle {
  fn destroy(&drop self) {
    self.*.id;
  }
}

# covers: closure capturing an AutoClone + AutoDestroy type derives AutoClone + AutoDestroy
fn test_capture_autoclone_and_autodestroy(h: Handle) -> i64 {
  let f = || h.id;
  let g = f;
  f() + g()
}

# covers: calling an immutable Fn closure multiple times
fn test_fn_multi_call(x: i64) -> i64 {
  let f = |n: i64| n + x;
  f(10i64) + f(20i64)
}

# covers: calling a mutable FnMut closure multiple times
fn test_fn_mut_multi_call() -> i64 {
  let mut counter = 0i64;
  {
    let r = &mut counter;
    let mut inc = || {
      r.* = r.* + 1i64;
      r.*
    };
    inc();
    inc();
    inc();
  }
  counter
}

struct LinearVal: Move {
  v: i64,
}

extern fn consume_linear(lv: LinearVal) -> i64;

# covers: calling a FnOnce closure that consumes a linear capture
fn test_fn_once_call(lv: LinearVal) -> i64 {
  let f = || consume_linear(lv);
  f()
}

# covers: nested closure capturing an outer captured variable
fn test_nested_closures(x: i64) -> i64 {
  let outer = |a: i64| {
    let inner = |b: i64| a + b + x;
    inner(1i64) + inner(2i64)
  };
  outer(10i64) + outer(20i64)
}

# covers: invoking an immutable Fn closure in a loop
fn test_closure_in_loop(limit: i64) -> i64 {
  let mut sum = 0i64;
  let mut i = 0i64;
  let add_const = |v: i64| v + 5i64;
  loop {
    if i >= limit {
      break;
    }
    sum = add_const(sum);
    i = i + 1i64;
  }
  sum
}

struct Pair: Copy + Drop {
  first: i64,
  second: i64,
}

# covers: closure capturing a struct and accessing multiple fields
fn test_capture_struct_fields(p: Pair) -> i64 {
  let f = || p.first + p.second;
  f() + f()
}

# covers: closure constructing and returning a struct
fn test_closure_return_struct(x: i64, y: i64) -> Pair {
  let make_pair = || Pair { first: x, second: y };
  make_pair()
}


