fn compose<'s0, A: Move, B: Move, C, F: Move + FnOnce<$Tuple1<A>, B>, G: Move + FnOnce<$Tuple1<B>, C>>(f: F, g: G, a: A, $return: &'s0 out C) {
  $tmp_0: $Tuple1<B>;
  $tmp_1: $Tuple1<A>;
  $tmp_2: &out B;
  $tmp_3: &out C;
  entry:
    $tmp_1._0 = move a;
    $tmp_2 = &out $tmp_0._0;
    call <F as FnOnce<$Tuple1<A>, B>>::call_once(move f, move $tmp_1, move $tmp_2);
    $tmp_3 = &out $return.*;
    call <G as FnOnce<$Tuple1<B>, C>>::call_once(move g, move $tmp_0, move $tmp_3);
    unborrow $return;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit a;
    require_uninit g;
    require_uninit f;
    return
}

