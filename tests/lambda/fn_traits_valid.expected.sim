struct Pair: Copy + Drop {
  first: i64
  second: i64
}

struct Resource: Drop + Move {
  id: i64
}

fn apply_once<'s0, T: Move, R, F: Move + FnOnce<$Tuple1<T>, R>>(f: F, x: T, $return: &'s0 out R) {
  $tmp_0: $Tuple1<T>;
  $tmp_1: &out R;
  entry:
    $tmp_0._0 = move x;
    $tmp_1 = &out $return.*;
    call <F as FnOnce<$Tuple1<T>, R>>::call_once(move f, move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    require_uninit f;
    return
}

fn apply_mut<'s0, T: Move, R, F: Drop + Move + FnMut<$Tuple1<T>, R>>(f: F, x: T, $return: &'s0 out R) {
  $f_0: F;
  $tmp_0: &mut F;
  $tmp_1: $Tuple1<T>;
  $tmp_2: &out R;
  entry:
    $f_0 = move f;
    $tmp_0 = &mut $f_0;
    $tmp_1._0 = move x;
    $tmp_2 = &out $return.*;
    call <F as FnMut<$Tuple1<T>, R>>::call_mut(move $tmp_0, move $tmp_1, move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    drop $f_0;
    require_uninit $f_0;
    require_uninit $return;
    require_uninit x;
    require_uninit f;
    return
}

fn apply_fn<'s0, T: Move, R, F: Drop + Move + Fn<$Tuple1<T>, R>>(f: F, x: T, $return: &'s0 out R) {
  $tmp_0: &F;
  $tmp_1: $Tuple1<T>;
  $tmp_2: &out R;
  entry:
    $tmp_0 = &f;
    $tmp_1._0 = move x;
    $tmp_2 = &out $return.*;
    call <F as Fn<$Tuple1<T>, R>>::call(move $tmp_0, move $tmp_1, move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    drop f;
    require_uninit f;
    return
}

fn apply_binary<'s0, A: Move, B: Move, R, F: Move + FnOnce<$Tuple2<A, B>, R>>(f: F, a: A, b: B, $return: &'s0 out R) {
  $tmp_0: $Tuple2<A, B>;
  $tmp_1: &out R;
  entry:
    $tmp_0._0 = move a;
    $tmp_0._1 = move b;
    $tmp_1 = &out $return.*;
    call <F as FnOnce<$Tuple2<A, B>, R>>::call_once(move f, move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit b;
    require_uninit a;
    require_uninit f;
    return
}

fn apply_nullary<'s0, R, F: Move + FnOnce<$Tuple0, R>>(f: F, $return: &'s0 out R) {
  $tmp_0: $Tuple0;
  $tmp_1: &out R;
  entry:
    $tmp_0 = $Tuple0 {};
    $tmp_1 = &out $return.*;
    call <F as FnOnce<$Tuple0, R>>::call_once(move f, move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit f;
    return
}

fn test_pass_fn_once<'s0>(x: i64, $return: &'s0 out i64) {
  double: $closure_0;
  $tmp_0: &out i64;
  entry:
    double.$call = $closure_0_call;
    $tmp_0 = &out $return.*;
    call apply_once<i64, i64, $closure_0>(move double, move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit double;
    require_uninit $return;
    require_uninit x;
    return
}

struct $closure_0: Copy + Drop {
  $call: fn(&$closure_0, i64, $return: &out i64)
}

fn $closure_0_call<'s0, 's1>(recv: &'s0 $closure_0, n: i64, $return: &'s1 out i64) {
  $tmp_0: &out i64;
  entry:
    $tmp_0 = &out $return.*;
    call $i64_mul(move n, 2, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit n;
    drop recv;
    require_uninit recv;
    return
}

impl FnOnce<$Tuple1<i64>, i64> for $closure_0 {
  fn call_once<'s0>(recv: $closure_0, args: $Tuple1<i64>, $return: &'s0 out i64) {
    $tmp_recv: &$closure_0;
    entry:
      $tmp_recv = &recv;
      call $closure_0_call(move $tmp_recv, move args._0, move $return);
      drop recv;
      require_uninit recv;
      require_uninit args;
      return
  }
}

impl FnMut<$Tuple1<i64>, i64> for $closure_0 {
  fn call_mut<'s0, 's1>(recv: &'s0 mut $closure_0, args: $Tuple1<i64>, $return: &'s1 out i64) {
    $tmp_recv: &$closure_0;
    entry:
      $tmp_recv = &recv.*;
      call $closure_0_call(move $tmp_recv, move args._0, move $return);
      require_uninit args;
      drop recv;
      return
  }
}

impl Fn<$Tuple1<i64>, i64> for $closure_0 {
  fn call<'s0, 's1>(recv: &'s0 $closure_0, args: $Tuple1<i64>, $return: &'s1 out i64) {
    entry:
      call $closure_0_call(move recv, move args._0, move $return);
      require_uninit args;
      return
  }
}

fn test_pass_fn_mut<'s0>(x: i64, $return: &'s0 out i64) {
  accumulator: i64;
  $tmp_0: $Tuple0;
  add_to_acc: $closure_1;
  $tmp_1: i64;
  $tmp_2: &out i64;
  entry:
    accumulator = 10;
    add_to_acc.$call = $closure_1_call;
    add_to_acc.$cap_accumulator = copy accumulator;
    $tmp_2 = &out $tmp_1;
    call apply_mut<i64, i64, $closure_1>(move add_to_acc, move x, move $tmp_2);
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = $Tuple0 {};
    require_uninit add_to_acc;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move accumulator;
    unborrow $return;
    require_uninit accumulator;
    require_uninit $return;
    require_uninit x;
    return
}

struct $closure_1: Copy + Drop {
  $call: fn(&mut $closure_1, i64, $return: &out i64)
  $cap_accumulator: i64
}

fn $closure_1_call<'s0, 's1>(recv: &'s0 mut $closure_1, n: i64, $return: &'s1 out i64) {
  $tmp_0: $Tuple0;
  $tmp_1: i64;
  $tmp_2: &out i64;
  entry:
    $tmp_2 = &out $tmp_1;
    call $i64_add(copy recv.*.$cap_accumulator, move n, move $tmp_2);
    drop recv.*.$cap_accumulator;
    recv.*.$cap_accumulator = move $tmp_1;
    $tmp_0 = $Tuple0 {};
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = copy recv.*.$cap_accumulator;
    unborrow $return;
    require_uninit $return;
    require_uninit n;
    drop recv;
    require_uninit recv;
    return
}

impl FnOnce<$Tuple1<i64>, i64> for $closure_1 {
  fn call_once<'s0>(recv: $closure_1, args: $Tuple1<i64>, $return: &'s0 out i64) {
    $tmp_recv: &mut $closure_1;
    entry:
      $tmp_recv = &mut recv;
      call $closure_1_call(move $tmp_recv, move args._0, move $return);
      drop recv;
      require_uninit recv;
      require_uninit args;
