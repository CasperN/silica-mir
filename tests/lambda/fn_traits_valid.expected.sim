fn test_explicit_method_calls<'s0>($return: &'s0 out i64) {
  f_once: $closure_6;
  r1: i64;
  $tmp_0: $Tuple1<i64>;
  $tmp_1: &out i64;
  acc: i64;
  f_mut: $closure_7;
  r2: i64;
  $tmp_2: &mut $closure_7;
  $tmp_3: $Tuple1<i64>;
  $tmp_4: &out i64;
  f_pure: $closure_8;
  r3: i64;
  $tmp_5: &$closure_8;
  $tmp_6: $Tuple2<i64, i64>;
  $tmp_7: &out i64;
  $tmp_8: i64;
  $tmp_9: &out i64;
  $tmp_10: &out i64;
  entry:
    f_once.$call = $closure_6_call;
    $tmp_0._0 = 10;
    $tmp_1 = &out r1;
    call <$closure_6 as FnOnce<$Tuple1<i64>, i64>>::call_once(move f_once, move $tmp_0, move $tmp_1);
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    acc = 0;
    f_mut.$call = $closure_7_call;
    f_mut.$cap_acc = move acc;
    $tmp_2 = &mut f_mut;
    $tmp_3._0 = 20;
    $tmp_4 = &out r2;
    call <$closure_7 as FnMut<$Tuple1<i64>, i64>>::call_mut(move $tmp_2, move $tmp_3, move $tmp_4);
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    f_pure.$call = $closure_8_call;
    $tmp_5 = &f_pure;
    $tmp_6._0 = 3;
    $tmp_6._1 = 4;
    $tmp_7 = &out r3;
    call <$closure_8 as Fn<$Tuple2<i64, i64>, i64>>::call(move $tmp_5, move $tmp_6, move $tmp_7);
    require_uninit $tmp_7;
    require_uninit $tmp_6;
    require_uninit $tmp_5;
    $tmp_9 = &out $tmp_8;
    call $i64_add(move r1, move r2, move $tmp_9);
    $tmp_10 = &out $return.*;
    call $i64_add(move $tmp_8, move r3, move $tmp_10);
    unborrow $return;
    require_uninit $tmp_10;
    require_uninit $tmp_9;
    require_uninit $tmp_8;
    require_uninit r3;
    drop f_pure;
    require_uninit f_pure;
    require_uninit r2;
    drop f_mut;
    require_uninit f_mut;
    require_uninit acc;
    require_uninit r1;
    require_uninit f_once;
    require_uninit $return;
    return
}

