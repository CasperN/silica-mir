fn test_fn_supertrait_upcast<'s0>(x: i64, $return: &'s0 out i64) {
  pure_fn: $closure_3;
  a: i64;
  $tmp_0: &out i64;
  b: i64;
  $tmp_1: &out i64;
  c: i64;
  $tmp_2: &out i64;
  $tmp_3: i64;
  $tmp_4: &out i64;
  $tmp_5: &out i64;
  entry:
    pure_fn.$call = $closure_3_call;
    $tmp_0 = &out a;
    call apply_once<i64, i64, $closure_3>(copy pure_fn, copy x, move $tmp_0);
    require_uninit $tmp_0;
    $tmp_1 = &out b;
    call apply_mut<i64, i64, $closure_3>(copy pure_fn, copy x, move $tmp_1);
    require_uninit $tmp_1;
    $tmp_2 = &out c;
    call apply_fn<i64, i64, $closure_3>(move pure_fn, move x, move $tmp_2);
    require_uninit $tmp_2;
    $tmp_4 = &out $tmp_3;
    call $i64_add(move a, move b, move $tmp_4);
    $tmp_5 = &out $return.*;
    call $i64_add(move $tmp_3, move c, move $tmp_5);
    unborrow $return;
    require_uninit $tmp_5;
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit c;
    require_uninit b;
    require_uninit a;
    require_uninit pure_fn;
    require_uninit $return;
    require_uninit x;
    return
}

