fn test_nullary<'s0>($return: &'s0 out i64) {
  f: $closure_0;
  $tmp_0: &out i64;
  entry:
    f.$call = $closure_0_call;
    $tmp_0 = &out $return.*;
    call copy f.$call(move f, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit f;
    require_uninit $return;
    return
}

struct $closure_0: Copy + Drop {
