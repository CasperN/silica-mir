fn test_capture_mut_ref<'s0>(x: i64, $return: &'s0 out i64) {
  $x_0: i64;
  $tmp_0: unit;
  r: &mut i64;
  f: $closure_7<'s0>;
  $tmp_1: unit;
  entry:
    $x_0 = move x;
    r = &mut $x_0;
    f.$call = $closure_7_call;
    f.$cap_r = move r;
    call copy f.$call(move f);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    require_uninit f;
    require_uninit r;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move $x_0;
    unborrow $return;
    require_uninit $x_0;
    require_uninit $return;
    require_uninit x;
    return
}

