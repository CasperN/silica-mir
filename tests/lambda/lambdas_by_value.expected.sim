struct Handle: Move {
  id: i64
}

impl AutoClone for Handle {
  fn clone<'s0, 's1>(self: &'s0 Handle, $return: &'s1 out Handle) {
    entry:
      $return.*.id = copy self.*.id;
      unborrow $return;
      require_uninit $return;
      drop self;
      require_uninit self;
      return
  }
}

impl AutoDestroy for Handle {
  fn destroy<'s0>(self: &'s0 drop Handle) {
    $tmp_0: unit;
    $tmp_1: i64;
    entry:
      $tmp_1 = move self.*.id;
      unborrow self;
      drop $tmp_1;
      require_uninit $tmp_1;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      require_uninit self;
      return
  }
}

fn test_capture_autoclone_and_autodestroy<'s0>(h: Handle, $return: &'s0 out i64) {
  f: $closure_9;
  g: $closure_9;
  $tmp_0: i64;
  $tmp_1: &out i64;
  $tmp_2: i64;
  $tmp_3: &out i64;
  $tmp_4: &out i64;
  $clone_0: $closure_9;
  $clone_1: &$closure_9;
  $clone_2: &out $closure_9;
  entry:
    f.$call = $closure_9_call;
    f.$cap_h = move h;
    $clone_1 = &f;
    $clone_2 = &out $clone_0;
    call <$closure_9 as AutoClone>::clone(move $clone_1, move $clone_2);
    g = move $clone_0;
    $tmp_1 = &out $tmp_0;
    call copy f.$call(move f, move $tmp_1);
    $tmp_3 = &out $tmp_2;
    call copy g.$call(move g, move $tmp_3);
    $tmp_4 = &out $return.*;
    call $i64_add(move $tmp_0, move $tmp_2, move $tmp_4);
    unborrow $return;
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit g;
    require_uninit f;
    require_uninit $return;
    require_uninit h;
    return
}

struct $closure_9: Move {
  $call: fn($closure_9, $return: &out i64)
  $cap_h: Handle
}

fn $closure_9_call<'s0>($self: $closure_9, $return: &'s0 out i64) {
  entry:
    $return.* = move $self.$cap_h.id;
    unborrow $return;
    require_uninit $return;
    drop $self.$call;
    require_uninit $self;
    return
}

impl AutoClone for $closure_9 {
  fn clone<'s0, 's1>(recv: &'s0 $closure_9, $return: &'s1 out $closure_9) {
    $tmp_recv_h: &Handle;
    $tmp_out_h: &out Handle;
    entry:
      $return.*.$call = copy recv.*.$call;
      $tmp_recv_h = &recv.*.$cap_h;
      $tmp_out_h = &out $return.*.$cap_h;
      call <Handle as AutoClone>::clone(move $tmp_recv_h, move $tmp_out_h);
      unborrow $return;
      drop recv;
      require_uninit recv;
      return
  }
}

impl AutoDestroy for $closure_9 {
  fn destroy<'s0>(recv: &'s0 drop $closure_9) {
    $tmp_drop_h: &drop Handle;
    entry:
      drop recv.*.$call;
      $tmp_drop_h = &drop recv.*.$cap_h;
      call <Handle as AutoDestroy>::destroy(move $tmp_drop_h);
      unborrow recv;
      return
  }
}
