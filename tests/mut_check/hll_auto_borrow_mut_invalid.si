# Automatic non-shared receiver borrows obey ordinary HLL binding mutability.

struct Target: Copy + Drop { value: i64 }

fn shared(recv: &Target) {}
fn mutable(recv: &mut Target) {}
fn output(recv: &out Target) { recv.* = Target { value: 1 }; }
fn dropping(recv: &drop Target) { recv.*; }
fn uninitialized(recv: &uninit Target) {}

# covers: shared auto-borrow does not require a mutable binding
fn shared_of_immutable(value: Target) {
  value.shared();
}

# covers: mutable auto-borrow rejects an immutable binding
fn mutable_of_immutable(value: Target) {
  value.mutable();
}

# covers: output auto-borrow rejects an immutable binding
fn output_of_immutable(value: Target) {
  value.output();
}

# covers: dropping auto-borrow rejects an immutable binding
fn dropping_of_immutable(value: Target) {
  value.dropping();
}

# covers: uninitialized auto-borrow rejects an immutable binding
fn uninitialized_of_immutable(value: Target) {
  value.uninitialized();
}

trait GenericMutable {
  fn generic_mutable(recv: &mut Self);
}

# covers: direct-bound mutable auto-borrow rejects an immutable binding
fn generic_mutable_of_immutable<T: GenericMutable + Drop>(value: T) {
  value.generic_mutable();
}

# covers: calling a FnMut closure rejects an immutable binding
fn fn_mut_closure_of_immutable(r: &mut i64) {
  let inc = || r.* = r.* + 1i64;
  inc();
}

# covers: calling a generic FnMut parameter rejects an immutable binding
fn generic_fn_mut_of_immutable<F: FnMut<(i64,), i64> + Drop>(f: F, x: i64) -> i64 {
  f(x)
}

