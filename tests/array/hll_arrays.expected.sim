struct Buffer: Copy + Drop {
  values: [i32; 3]
}

extern fn set_i64<'s0>(slot: &'s0 out i64, value: i64);

fn literal_and_constant_read<'s0>($return: &'s0 out i64) {
  a: [i64; 3];
  entry:
    a = [10, 20, 30];
    $return.* = move a[1];
    unborrow $return;
    drop a[2];
    drop a[0];
    require_uninit a;
    require_uninit $return;
    return
}

fn struct_field_and_nested_array<'s0>($return: &'s0 out i32) {
  b: Buffer;
  m: [[i32; 2]; 2];
  $tmp_0: [i32; 2];
  $tmp_1: [i32; 2];
  $tmp_2: &out i32;
  entry:
    b.values = [1i32, 2i32, 3i32];
    $tmp_0 = [1i32, 2i32];
    $tmp_1 = [3i32, 4i32];
    m = [move $tmp_0, move $tmp_1];
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    $tmp_2 = &out $return.*;
    call $i32_add(move b.values[2], move m[1][0], move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    drop m[1][1];
    drop m[0];
    require_uninit m;
    drop b.values[1];
    drop b.values[0];
    require_uninit b;
    require_uninit $return;
    return
}

fn constant_slot_initialization<'s0>($return: &'s0 out i64) {
  a: [i64; 3];
  $tmp_0: unit;
  $tmp_1: &out i64;
  $tmp_2: unit;
  $tmp_3: &out i64;
  $tmp_4: unit;
  $tmp_5: &out i64;
  entry:
    $tmp_1 = &out a[0];
    call set_i64(move $tmp_1, 10);
    $tmp_0 = unit;
    require_uninit $tmp_1;
    drop $tmp_0;
    require_uninit $tmp_0;
    $tmp_3 = &out a[1];
    call set_i64(move $tmp_3, 20);
    $tmp_2 = unit;
    require_uninit $tmp_3;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_5 = &out a[2];
    call set_i64(move $tmp_5, 30);
    $tmp_4 = unit;
    require_uninit $tmp_5;
    drop $tmp_4;
    require_uninit $tmp_4;
    $return.* = move a[1];
    unborrow $return;
    drop a[2];
    drop a[0];
    require_uninit a;
    require_uninit $return;
    return
}

fn constant_slot_isolation<'s0>($return: &'s0 out i64) {
  a: [i64; 3];
  r: &mut i64;
  other: i64;
  $tmp_0: &out i64;
  entry:
    a = [10, 20, 30];
    r = &mut a[0];
    other = move a[1];
    $tmp_0 = &out $return.*;
    call $i64_add(copy r.*, move other, move $tmp_0);
    unborrow $return;
    unborrow r;
    require_uninit $tmp_0;
    require_uninit other;
    require_uninit r;
    drop a[2];
    drop a[0];
    require_uninit a;
    require_uninit $return;
    return
}

fn dynamic_read<'s0>(a: [i64; 3], i: i64, $return: &'s0 out i64) {
  $tmp_0: i64;
  $tmp_1: bool;
  $tmp_2: &out bool;
  entry:
    $tmp_0 = move i;
    $tmp_2 = &out $tmp_1;
    call $i64_lt(copy $tmp_0, 3, move $tmp_2);
    branch(copy $tmp_1) [true: index_in_bounds_0, false: index_out_of_bounds_1]
  index_out_of_bounds_1:
    abort
  index_in_bounds_0:
    $return.* = copy a[copy $tmp_0];
    unborrow $return;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit i;
    drop a;
    require_uninit a;
    return
}

fn dynamic_mut_borrow<'s0>(i: i64, $return: &'s0 out i64) {
  a: [i64; 3];
  r: &mut i64;
  $tmp_0: i64;
  $tmp_1: bool;
  $tmp_2: &out bool;
  entry:
    a = [10, 20, 30];
    $tmp_0 = move i;
    $tmp_2 = &out $tmp_1;
    call $i64_lt(copy $tmp_0, 3, move $tmp_2);
    branch(copy $tmp_1) [true: index_in_bounds_0, false: index_out_of_bounds_1]
  index_out_of_bounds_1:
    abort
  index_in_bounds_0:
    r = &mut a[copy $tmp_0];
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = copy r.*;
    unborrow $return;
    unborrow r;
    require_uninit r;
    drop a;
    require_uninit a;
    require_uninit $return;
    require_uninit i;
    return
}
