fn ptr_to_ptr<'s0>(p: *i64, $return: &'s0 out *u8) {
  entry:
    $return.* = ptr_cast(copy p, *u8);
    unborrow $return;
    drop p;
    return
}

fn ref_to_ptr<'s0, 's1>(r: &'s0 i64, $return: &'s1 out *u8) {
  entry:
    $return.* = ptr_cast(copy r, *u8);
    unborrow $return;
    unborrow r;
    return
}

fn ptr_to_ref<'s0, 's1>(p: *i64, $return: &'s0 out &'s1 i64) {
  entry:
    $return.* = ptr_cast(copy p, &i64);
    unborrow $return;
    drop p;
    return
}

fn ref_to_ref<'s0, 's1>(r: &'s0 i64, $return: &'s1 out &'s0 u8) {
  entry:
    $return.* = ptr_cast(copy r, &u8);
    unborrow $return;
    unborrow r;
    return
}

fn mut_ref_to_mut_ptr<'s0, 's1>(r: &'s0 mut i64, $return: &'s1 out *u8) {
  _temp_0: *i64;
  entry:
    _temp_0 = &raw r.*;
    unborrow r;
    $return.* = ptr_cast(move _temp_0, *u8);
    unborrow $return;
    return
}

fn mut_ptr_to_mut_ref<'s0, 's1>(p: *i64, $return: &'s0 out &'s1 mut i64) {
  entry:
    $return.* = ptr_cast(copy p, &mut i64);
    unborrow $return;
    drop p;
    return
}

fn mut_ref_to_mut_ref<'s0, 's1>(r: &'s0 mut i64, $return: &'s1 out &'s0 mut u8) {
  _temp_0: *u8;
  _temp_1: *i64;
  entry:
    _temp_1 = &raw r.*;
    unborrow r;
    _temp_0 = ptr_cast(move _temp_1, *u8);
    $return.* = ptr_cast(move _temp_0, &mut u8);
    unborrow $return;
    return
}
