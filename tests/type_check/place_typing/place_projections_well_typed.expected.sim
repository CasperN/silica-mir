struct P: Copy + Drop {
  x: i64
  y: i64
}

struct Ptr<'s0>: Copy + Drop {
  r: &'s0 i64
}

enum Option: Copy + Drop {
  None: unit
  Some: i64
}

fn read_var_scalar(x: i64) {
  y: i64;
  entry:
    y = copy x;
    drop y;
    drop x;
    return
}

fn noop() {
  entry:
    return
}

fn read_var_fn_pointer() {
  g: fn();
  entry:
    g = noop;
    call copy g();
    drop g;
    return
}

fn field_on_struct(p: P) {
  a: i64;
  entry:
    a = copy p.x;
    drop a;
    drop p;
    return
}

fn downcast_on_enum(o: Option) {
  x: i64;
  entry:
    switchEnum(o) [None: n, Some: s]
  s:
    x = copy o as Some;
    drop x;
    drop o;
    return
  n:
    drop o;
    return
}

fn deref_of_ref<'s0>(r: &'s0 i64) {
  x: i64;
  entry:
    x = copy r.*;
    drop x;
    drop r;
    return
}

fn deref_of_nested_ref<'s0: 's1, 's1>(r: &'s0 mut &'s1 mut i64) {
  a: i64;
  entry:
    a = copy r.*.*;
    drop a;
    drop r;
    return
}

fn deref_through_field<'s0>(p: Ptr<'s0>) {
  a: i64;
  entry:
    a = copy p.r.*;
    drop a;
    drop p;
    return
}
