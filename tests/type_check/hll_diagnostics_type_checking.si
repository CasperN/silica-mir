fn test_ambiguous_type() {
  let x = [];
}

fn test_silenced_error() {
  # 1. First error: 'undeclared_var' is undeclared.
  # This infers 'x' as TypeKind::Error to poison the local variable.
  let x = undeclared_var;

  # Unification succeeds silently, and binary typecheck accepts TypeKind::Error
  # without pushing a secondary "non-numeric operand" error (silencing).
  let y = x + 1;
  let z = x + 42.0;
}

fn test_int_var_mismatch_with_float() {
  let x = 42;
  let y: f64 = x;
}

fn test_float_var_mismatch_with_int() {
  let x = 42.2;
  let y: i64 = x;
}

# ---------- HTC-UndeclaredVariable ----------

fn test_undeclared_variable() -> i64 {
  let x = y;
  x
}

# ---------- HTC-TypeMismatch: block value vs declared return type ----------

# The block's trailing expression is a `bool`; the declared return
# type is `i64`. Distinct from the let-annotation mismatch above —
# this is the fn-body unification path.
fn test_return_type_mismatch() -> i64 {
  true
}

# ---------- TC-AssignmentTypeMismatch: defer body has wrong type ----------

fn test_defer_type_mismatch() {
  defer 42;
}

# ---------- HTC-EmptySwitch: checked-against-context match ----------

enum One: Copy + Drop { Value: i64 }
# covers: empty match checked against an expected return type
fn test_empty_match(value: One) -> i64 {
  value match {}
}

# ---------- HTC-InvalidFnModifiers: linkage/ABI/safety mismatches ----------
#
# ABI-string parse errors (unknown ABI, redundant "Silica") live in
# `tests/declaration/hll_fn_modifier_errors.si` (free fns) and
# `tests/traits/hll_parse_errors.si` (methods). The rules pinned here
# fire at typecheck once the parse succeeds.

# `extern "C"` requires `unsafe` — the signature is user-asserted and
# calls carry FFI obligations. Positive coverage:
# `hll_hello_world_via_write.si` uses `extern "C" unsafe fn`.
extern "C" fn c_without_unsafe(x: i64);

# `extern` (Silica ABI) forbids `unsafe` — a cross-TU Silica symbol
# is safe by import contract.
extern unsafe fn silica_marked_unsafe(x: i64);

# `extern` (no body) or a body without `extern` is required — mixing is
# an error.
extern fn extern_with_body() { () }
fn missing_body(x: i64);

# Trait methods must not have a body; impl methods require one.
struct FnModifierHost: Copy + Drop { value: i64 }

trait TraitBodyDefault {
  fn with_body(recv: &Self) { () }
}

trait ImplBodyRequired { fn slot(recv: &Self); }

impl ImplBodyRequired for FnModifierHost {
  fn slot(recv: &Self);
}

# `extern "C"` requires `unsafe` — same rule as free fns.
trait MissingUnsafeTrait {
  extern "C" fn missing_unsafe(recv: &Self);
}

impl MissingUnsafeTrait for FnModifierHost {
  extern "C" fn missing_unsafe(recv: &Self) { () }
}

# ---------- HTC-TypeMismatch: fn-value ABI mismatches ----------

# ABI is part of fn-type identity; passing a C-ABI fn value where a
# Silica-ABI fn type is expected, or vice versa, is a type error.
# Positive coverage: `hll_hello_world_via_write.si` calls a C-ABI fn
# directly (no fn-value round-trip).
extern "C" unsafe fn c_valued(x: i64) -> i64;

fn accepts_silica(f: fn(i64) -> i64) -> i64 {
  f(42)
}

fn abi_mismatch_via_arg() -> i64 {
  accepts_silica(c_valued)
}

fn abi_mismatch_via_let() {
  let f: fn(i64) -> i64 = c_valued;
  f(1);
}

# ---------- HTC-UnaryOpInvalidOperand ----------

# Unary `-` requires a signed integer or float operand. u64 is rejected;
# same for bool. Positive coverage: `enum_matches.si` uses `-n` on i64
# in the `Neg` arm of `to_i64`.
fn test_unary_neg_on_unsigned(x: u64) -> u64 { -x }
fn test_unary_neg_on_bool(b: bool) -> bool { -b }

# ---------- HTC-ExpectedFunction: non-callable field candidate ----------

struct NonCallableField: Copy + Drop { invoke: i64 }

# covers: receiver syntax rejects a field whose value is not callable
fn test_non_callable_field(value: NonCallableField) {
  value.invoke(1);
}

# ---------- HTC-TypeMismatch: impl method body ----------

# Impl methods pass through the same HLL inference path as free functions.
struct TraitBodyTarget: Copy + Drop { value: i64 }

trait BadTraitBody {
  fn value(recv: &Self) -> i64;
}

impl BadTraitBody for TraitBodyTarget {
  fn value(recv: &Self) -> i64 {
    false
  }
}

# Inherent methods pass through that same inference path.
impl TraitBodyTarget {
  fn inherent_value(recv: &Self) -> i64 {
    false
  }

  # covers: deferred ambiguity diagnostics retain inherent-method identity
  fn ambiguous_local(recv: &Self) {
    let values = [];
  }
}

