fn<'s0> ptr_to_ptr(p: *i64, $return: &out 's0 *u8) {
  entry:
    $return.* = ptr_cast(move p, *u8);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn<'s0, 's1> ref_to_ptr(r: &'s0 i64, $return: &out 's1 *u8) {
  entry:
    $return.* = ptr_cast(move r, *u8);
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn<'s0: 's1, 's1> ptr_to_ref(p: *i64, $return: &out 's0 &'s1 i64) {
  entry:
    $return.* = ptr_cast(move p, &i64);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn<'s0: 's2, 's1: 's2, 's2> ref_to_ref(r: &'s0 i64, $return: &out 's1 &'s2 u8) {
  entry:
    $return.* = ptr_cast(move r, &u8);
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn<'s0, 's1> mut_ref_to_mut_ptr(r: &mut 's0 i64, $return: &out 's1 *u8) {
  $tmp_0: *i64;
  entry:
    $tmp_0 = &raw r.*;
    $return.* = ptr_cast(move $tmp_0, *u8);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn<'s0: 's1, 's1> mut_ptr_to_mut_ref(p: *i64, $return: &out 's0 &mut 's1 i64) {
  entry:
    $return.* = ptr_cast(move p, &mut i64);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn<'s0: 's2, 's1: 's2, 's2> mut_ref_to_mut_ref(r: &mut 's0 i64, $return: &out 's1 &mut 's2 u8) {
  $tmp_0: *u8;
  $tmp_1: *i64;
  entry:
    $tmp_1 = &raw r.*;
    $tmp_0 = ptr_cast(move $tmp_1, *u8);
    $return.* = ptr_cast(move $tmp_0, &mut u8);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}
