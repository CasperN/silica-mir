fn ptr_to_ptr<'s0>(p: *i64, $return: &'s0 out *u8) {
  entry:
    $return.* = ptr_cast(move p, *u8);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn ref_to_ptr<'s0, 's1>(r: &'s0 i64, $return: &'s1 out *u8) {
  entry:
    $return.* = ptr_cast(move r, *u8);
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn ptr_to_ref<'s0: 's1, 's1>(p: *i64, $return: &'s0 out &'s1 i64) {
  entry:
    $return.* = ptr_cast(move p, &i64);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn ref_to_ref<'s0: 's2, 's1: 's2, 's2>(r: &'s0 i64, $return: &'s1 out &'s2 u8) {
  entry:
    $return.* = ptr_cast(move r, &u8);
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn mut_ref_to_mut_ptr<'s0, 's1>(r: &'s0 mut i64, $return: &'s1 out *u8) {
  $tmp_0: *i64;
  entry:
    $tmp_0 = &raw r.*;
    $return.* = ptr_cast(move $tmp_0, *u8);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn mut_ptr_to_mut_ref<'s0: 's1, 's1>(p: *i64, $return: &'s0 out &'s1 mut i64) {
  entry:
    $return.* = ptr_cast(move p, &mut i64);
    unborrow $return;
    require_uninit $return;
    require_uninit p;
    return
}

fn mut_ref_to_mut_ref<'s0: 's2, 's1: 's2, 's2>(r: &'s0 mut i64, $return: &'s1 out &'s2 mut u8) {
  $tmp_0: *u8;
  $tmp_1: *i64;
  entry:
    $tmp_1 = &raw r.*;
    $tmp_0 = ptr_cast(move $tmp_1, *u8);
    $return.* = ptr_cast(move $tmp_0, &mut u8);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}
