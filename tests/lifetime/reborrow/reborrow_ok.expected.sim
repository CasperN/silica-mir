enum E: Move {
  V: i64
}

extern fn sink_mut<'s0>(r: &'s0 mut i64);

extern fn sink_shared<'s0>(r: &'s0 i64);

fn shared_from_shared_param<'s0>(r: &'s0 i64) {
  s: &i64;
  entry:
    s = &r.*;
    call sink_shared(move s);
    drop r;
    return
}

fn mut_from_mut_local(x: i64) {
  r: &mut i64;
  s: &mut i64;
  entry:
    r = &mut x;
    s = &mut r.*;
    call sink_mut(move s);
    unborrow r;
    drop x;
    return
}

fn shared_from_mut_local(x: i64) {
  r: &mut i64;
  s: &i64;
  entry:
    r = &mut x;
    s = &r.*;
    call sink_shared(move s);
    unborrow r;
    drop x;
    return
}

fn shared_from_mut_param<'s0>(r: &'s0 mut i64) {
  s: &i64;
  entry:
    s = &r.*;
    call sink_shared(move s);
    drop r;
    return
}

fn out_from_out_param<'s0>(r: &'s0 out i64) {
  s: &out i64;
  entry:
    s = &out r.*;
    s.* = 42;
    unborrow s;
    unborrow r;
    return
}

fn chained_mut_from_mut(x: i64) {
  r: &mut i64;
  s: &mut i64;
  t: &mut i64;
  entry:
    r = &mut x;
    s = &mut r.*;
    t = &mut s.*;
    call sink_mut(move t);
    unborrow s;
    unborrow r;
    drop x;
    return
}

fn mut_from_mut_via_downcast<'s0>(e: &'s0 mut E) {
  r: &mut i64;
  entry:
    switchEnum(e.*) [V: v_arm]
  v_arm:
    r = &mut e.* as V;
    call sink_mut(move r);
    drop e;
    return
}

fn mut_from_mut_in_loop(x: i64, b: bool) {
  r: &mut i64;
  s: &mut i64;
  entry:
    r = &mut x;
    goto head
  head:
    branch(copy b) [true: body, false: $edge0]
  $edge0:
    unborrow r;
    goto done
  body:
    s = &mut r.*;
    call sink_mut(move s);
    goto head
  done:
    drop b;
    drop x;
    return
}

fn mut_from_mut_conditional<'s0>(r: &'s0 mut i64, cond: bool) {
  s: &mut i64;
  entry:
    s = &mut r.*;
    branch(copy cond) [true: left, false: $edge0]
  $edge0:
    unborrow s;
    goto right
  left:
    call sink_mut(move s);
    drop r.*;
    r.* = 5;
    drop cond;
    drop r;
    return
  right:
    drop r.*;
    r.* = 10;
    drop cond;
    drop r;
    return
}

fn mut_from_mut_returned<'a, 's0>(r: &'a mut i64, $return: &'s0 out &'a mut i64) {
  entry:
    $return.* = &mut r.*;
    unborrow $return;
    unborrow r;
    return
}
