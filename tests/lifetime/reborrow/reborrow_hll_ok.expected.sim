fn<'s0> use_val(x: &mut 's0 i64) {
  $tmp_0: unit;
  entry:
    unborrow x;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit x;
    return
}

fn<'s0> reborrow_ok(r: &mut 's0 i64) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: &mut i64;
  $tmp_3: unit;
  $tmp_4: &mut i64;
  entry:
    $tmp_2 = &mut r.*;
    call use_val(move $tmp_2);
    $tmp_1 = unit;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_4 = &mut r.*;
    call use_val(move $tmp_4);
    unborrow r;
    $tmp_3 = unit;
    require_uninit $tmp_4;
    drop $tmp_3;
    require_uninit $tmp_3;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit r;
    return
}
