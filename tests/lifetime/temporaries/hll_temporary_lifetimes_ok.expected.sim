fn<'s0, 's1> read(r: &'s0 i64, $return: &out 's1 i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    unborrow r;
    require_uninit $return;
    require_uninit r;
    return
}

fn<'s0> named_value_borrow($return: &out 's0 i64) {
  value: i64;
  $tmp_0: &i64;
  $tmp_1: &out i64;
  entry:
    value = 41;
    $tmp_0 = &value;
    $tmp_1 = &out $return.*;
    call read(move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    drop value;
    require_uninit value;
    require_uninit $return;
    return
}

fn<'s0> continue_cleans_loop_body($return: &out 's0 i64) {
  i: i64;
  $tmp_0: unit;
  value: i64;
  $tmp_1: unit;
  $tmp_2: bool;
  $tmp_3: &out bool;
  $tmp_4: unit;
  $tmp_5: unit;
  $tmp_6: i64;
  $tmp_7: &out i64;
  $tmp_8: unit;
  $tmp_9: unit;
  $tmp_10: i64;
  $tmp_11: &out i64;
  $tmp_12: unit;
  $tmp_13: i64;
  $tmp_14: &out i64;
  entry:
    i = 0;
    goto loop_start_0
  loop_start_0:
    value = copy i;
    $tmp_3 = &out $tmp_2;
    call $i64_lt(copy i, 1, move $tmp_3);
    branch(move $tmp_2) [true: if_true_2, false: if_false_3]
  if_true_2:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    $tmp_7 = &out $tmp_6;
    call $i64_add(move i, 1, move $tmp_7);
    i = move $tmp_6;
    $tmp_5 = unit;
    require_uninit $tmp_7;
    require_uninit $tmp_6;
    drop $tmp_5;
    require_uninit $tmp_5;
    drop value;
    require_uninit value;
    goto loop_start_0
  if_false_3:
    $tmp_1 = unit;
    goto if_merge_4
  if_merge_4:
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move value;
    unborrow $return;
    require_uninit $tmp_8;
    require_uninit $tmp_0;
    $tmp_11 = &out $tmp_10;
    call $i64_add(move i, 1, move $tmp_11);
    i = move $tmp_10;
    $tmp_9 = unit;
    require_uninit $tmp_11;
    require_uninit $tmp_10;
    drop $tmp_9;
    require_uninit $tmp_9;
    require_uninit value;
    goto loop_end_1
  loop_end_1:
    drop i;
    require_uninit i;
    require_uninit $return;
    return
}

struct<'a, T> View: Copy + Drop {
  data: &'a *T
  len: u64
}

fn<'a, 's0, T> view_get(s: &'a View<'a, T>, $return: &out 's0 &'a T) {
  entry:
    $return.* = ptr_cast(copy s.*.data.*, &T);
    unborrow $return;
    unborrow s;
    require_uninit $return;
    require_uninit s;
    return
}
