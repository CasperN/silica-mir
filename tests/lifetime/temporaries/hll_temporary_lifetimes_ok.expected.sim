fn read<'s0, 's1>(r: &'s0 i64, $return: &'s1 out i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn named_value_borrow<'s0>($return: &'s0 out i64) {
  value: i64;
  $tmp_0: &i64;
  $tmp_1: &out i64;
  entry:
    value = 41;
    $tmp_0 = &value;
    $tmp_1 = &out $return.*;
    call read(move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    drop value;
    require_uninit value;
    require_uninit $return;
    return
}

fn continue_cleans_loop_body<'s0>($return: &'s0 out i64) {
  i: i64;
  $tmp_0: $Tuple0;
  value: i64;
  $tmp_1: $Tuple0;
  $tmp_2: bool;
  $tmp_3: &out bool;
  $tmp_4: $Tuple0;
  $tmp_5: $Tuple0;
  $tmp_6: i64;
  $tmp_7: &out i64;
  $tmp_8: $Tuple0;
  $tmp_9: $Tuple0;
  $tmp_10: i64;
  $tmp_11: &out i64;
  $tmp_12: $Tuple0;
  $tmp_13: i64;
  $tmp_14: &out i64;
  entry:
    i = 0;
    goto loop_start_0
  loop_start_0:
    value = copy i;
    $tmp_3 = &out $tmp_2;
    call $i64_lt(copy i, 1, move $tmp_3);
    branch(move $tmp_2) [true: if_true_2, false: if_false_3]
  if_true_2:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    $tmp_7 = &out $tmp_6;
    call $i64_add(move i, 1, move $tmp_7);
    i = move $tmp_6;
    $tmp_5 = $Tuple0 {};
    require_uninit $tmp_7;
    require_uninit $tmp_6;
    drop $tmp_5;
    require_uninit $tmp_5;
    drop value;
    require_uninit value;
    goto loop_start_0
  if_false_3:
    $tmp_1 = $Tuple0 {};
    goto if_merge_4
  if_merge_4:
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move value;
    unborrow $return;
    require_uninit $tmp_8;
    require_uninit $tmp_0;
    $tmp_11 = &out $tmp_10;
    call $i64_add(move i, 1, move $tmp_11);
    i = move $tmp_10;
    $tmp_9 = $Tuple0 {};
    require_uninit $tmp_11;
    require_uninit $tmp_10;
    drop $tmp_9;
    require_uninit $tmp_9;
    require_uninit value;
    goto loop_end_1
  loop_end_1:
    drop i;
    require_uninit i;
    require_uninit $return;
    return
}

struct View<'a, T>: Copy + Drop {
  data: &'a *T
  len: u64
}

fn view_get<'a, 's0, T>(s: &'a View<'a, T>, $return: &'s0 out &'a T) {
  entry:
    $return.* = ptr_cast(copy s.*.data.*, &T);
    unborrow $return;
    require_uninit $return;
    drop s;
    require_uninit s;
    return
}
