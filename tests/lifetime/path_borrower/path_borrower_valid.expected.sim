struct<'s0> RefBox: Move {
  p: &mut 's0 i64
}

struct<'s0, 's1> RefBox2: Move {
  q: &mut 's0 i64
  r: &mut 's1 i64
}

struct<'s0> Linear: Move {
  r: &out 's0 i64
}

extern fn<'s0> use_mut(r: &mut 's0 i64);

extern fn<'s0> sink(r: &mut 's0 i64);

extern fn<'s0> take_box(b: RefBox<'s0>);

extern fn<'s0> sink_linear(y: Linear<'s0>);

fn<'s0, 's1> split_fields_independent(x: i64, y: i64) {
  b: RefBox2<'s0, 's1>;
  entry:
    b.q = &mut x;
    b.r = &mut y;
    call use_mut(move b.q);
    call use_mut(move b.r);
    drop y;
    drop x;
    return
}

fn<'s0> reborrow_through_field(x: i64) {
  b: RefBox<'s0>;
  s: &mut i64;
  entry:
    b.p = &mut x;
    s = &mut b.p.*;
    call sink(move s);
    call take_box(move b);
    drop x;
    return
}

fn<'s0> move_ancestor_closes_loans(x: i64) {
  b: RefBox<'s0>;
  entry:
    b.p = &mut x;
    call take_box(move b);
    drop x;
    x = 1;
    drop x;
    return
}

fn<'s0> whole_struct_move_survives_loan(x: i64) {
  b: RefBox<'s0>;
  entry:
    b.p = &mut x;
    call take_box(move b);
    drop x;
    return
}

fn<'s0> struct_with_ref_typed_field(x: Linear<'s0>) {
  y: Linear<'s0>;
  entry:
    y = move x;
    call sink_linear(move y);
    return
}

fn<'s0> fulfilled_field_ref_before_move(x: i64, z: i64) {
  b: RefBox<'s0>;
  y: i64;
  entry:
    b.p = &mut x;
    y = move b.p.*;
    b.p.* = 7;
    call take_box(move b);
    drop y;
    drop z;
    drop x;
    return
}
