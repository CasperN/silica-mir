struct RefBox<'s0>: Move {
  p: &'s0 mut i64
}

struct RefBox2<'s0, 's1>: Move {
  q: &'s0 mut i64
  r: &'s1 mut i64
}

struct Linear<'s0>: Move {
  r: &'s0 out i64
}

extern fn use_mut<'s0>(r: &'s0 mut i64);

extern fn sink<'s0>(r: &'s0 mut i64);

extern fn take_box<'s0>(b: RefBox<'s0>);

extern fn sink_linear<'s0>(y: Linear<'s0>);

fn split_fields_independent<'s0, 's1>(x: i64, y: i64) {
  b: RefBox2<'s0, 's1>;
  entry:
    b.q = &mut x;
    b.r = &mut y;
    call use_mut(move b.q);
    call use_mut(move b.r);
    drop y;
    drop x;
    return
}

fn reborrow_through_field<'s0>(x: i64) {
  b: RefBox<'s0>;
  s: &mut i64;
  entry:
    b.p = &mut x;
    s = &mut b.p.*;
    call sink(move s);
    call take_box(move b);
    drop x;
    return
}

fn move_ancestor_closes_loans<'s0>(x: i64) {
  b: RefBox<'s0>;
  entry:
    b.p = &mut x;
    call take_box(move b);
    drop x;
    x = 1;
    drop x;
    return
}

fn whole_struct_move_survives_loan<'s0>(x: i64) {
  b: RefBox<'s0>;
  entry:
    b.p = &mut x;
    call take_box(move b);
    drop x;
    return
}

fn struct_with_ref_typed_field<'s0>(x: Linear<'s0>) {
  y: Linear<'s0>;
  entry:
    y = move x;
    call sink_linear(move y);
    return
}

fn fulfilled_field_ref_before_move<'s0>(x: i64, z: i64) {
  b: RefBox<'s0>;
  y: i64;
  entry:
    b.p = &mut x;
    y = move b.p.*;
    b.p.* = 7;
    call take_box(move b);
    drop y;
    drop z;
    drop x;
    return
}
