extern fn use_num(n: i64);

extern fn sink<'s0>(r: &'s0 mut i64);

struct P: Copy + Drop {
  a: i64
  b: i64
}

fn out_abort_suppresses_unborrow<'s0>(r: &'s0 out i64) {
  entry:
    abort
}

fn out_unreachable_suppresses_unborrow<'s0>(r: &'s0 out i64) {
  entry:
    unreachable
}

fn out_param_write_inserts_unborrow<'s0>(x: &'s0 out i64) {
  entry:
    x.* = 42;
    unborrow x;
    return
}

fn out_branch_one_arm_aborts<'s0>(r: &'s0 out i64, b: bool) {
  entry:
    branch(copy b) [true: init_arm, false: die_arm]
  init_arm:
    r.* = 42;
    unborrow r;
    drop b;
    return
  die_arm:
    abort
}

fn mut_move_out_then_abort<'s0>(r: &'s0 mut i64) {
  x: i64;
  entry:
    x = move r.*;
    abort
}

fn mut_param_read_last_use<'s0>(x: &'s0 mut i64) {
  y: i64;
  entry:
    y = copy x.*;
    drop y;
    drop x;
    return
}

fn mut_local_read_then_overwrite(x: i64) {
  r: &mut i64;
  y: i64;
  entry:
    r = &mut x;
    y = copy r.*;
    unborrow r;
    drop x;
    x = 42;
    drop y;
    drop x;
    return
}

fn out_local_write_last_use() {
  x: i64;
  r: &out i64;
  entry:
    r = &out x;
    r.* = 42;
    unborrow r;
    drop x;
    return
}

fn mut_field_borrow_last_use(p: P) {
  r: &mut i64;
  entry:
    r = &mut p.a;
    unborrow r;
    drop p.a;
    p.a = 42;
    drop p;
    return
}

fn mut_reborrow_same_place_twice(x: i64) {
  r: &mut i64;
  s: &mut i64;
  y: i64;
  entry:
    r = &mut x;
    y = copy r.*;
    unborrow r;
    s = &mut x;
    drop y;
    y = copy s.*;
    unborrow s;
    drop y;
    drop x;
    return
}

fn mut_branch_each_arm_unborrows(a: i64, b: i64, c: bool) {
  r: &mut i64;
  entry:
    branch(copy c) [true: t, false: fbr]
  t:
    r = &mut a;
    unborrow r;
    goto merge
  fbr:
    r = &mut b;
    unborrow r;
    goto merge
  merge:
    drop a;
    a = 1;
    drop b;
    b = 2;
    drop c;
    drop b;
    drop a;
    return
}

fn mut_cross_edge_one_arm_dies(x: i64, b: bool) {
  r: &mut i64;
  entry:
    r = &mut x;
    branch(copy b) [true: t, false: $edge0]
  $edge0:
    unborrow r;
    goto fbr
  t:
    call use_num(copy r.*);
    unborrow r;
    goto end
  fbr:
    goto end
  end:
    drop x;
    x = 42;
    drop b;
    drop x;
    return
}

fn mut_loop_unborrow_on_exit(x: i64, b: bool) {
  r: &mut i64;
  entry:
    r = &mut x;
    goto head
  head:
    branch(copy b) [true: body, false: $edge0]
  $edge0:
    unborrow r;
    goto done
  body:
    call use_num(copy r.*);
    goto head
  done:
    drop x;
    x = 42;
    drop b;
    drop x;
    return
}

fn mut_move_into_call_no_unborrow(x: i64) {
  r: &mut i64;
  entry:
    r = &mut x;
    call sink(move r);
    drop x;
    return
}

fn mut_drop_borrow_no_unborrow(x: i64) {
  r: &mut i64;
  entry:
    r = &mut x;
    drop r;
    drop x;
    return
}

fn out_reborrow_child_before_parent<'s0>(r: &'s0 out i64) {
  s: &out i64;
  entry:
    s = &out r.*;
    s.* = 42;
    unborrow s;
    unborrow r;
    return
}

fn mut_chained_reborrow_deepest_first(x: i64) {
  r: &mut i64;
  s: &mut i64;
  t: &mut i64;
  entry:
    r = &mut x;
    s = &mut r.*;
    t = &mut s.*;
    call sink(move t);
    unborrow s;
    unborrow r;
    drop x;
    return
}

trait ImplNllOk {
  fn close<'s0, 's1>(recv: &'s0 Self, x: &'s1 out i64);
}

impl ImplNllOk for P {
  fn close<'s0, 's1>(recv: &'s0 P, x: &'s1 out i64) {
    entry:
      x.* = 42;
      unborrow x;
      drop recv;
      return
  }
}

struct RefBag<'a>: Copy + Drop {
  r: &'a i64
  n: i64
}

fn read_scalar_through_borrow<'a>(bag: RefBag<'a>) {
  b: &RefBag<'a>;
  x: i64;
  entry:
    b = &bag;
    x = copy b.*.n;
    unborrow b;
    call use_num(move x);
    drop bag;
    return
}

fn read_ref_through_borrow<'a, 's0>(bag: RefBag<'a>, $return: &'s0 out &'a i64) {
  b: &RefBag<'a>;
  entry:
    b = &bag;
    $return.* = copy b.*.r;
    unborrow $return;
    unborrow b;
    drop bag;
    return
}

struct LinearRefBag<'a>: Move {
  r: &'a i64
}

fn linear_bag_needs_field_unborrow<'a>(bag: LinearRefBag<'a>) {
  x: i64;
  entry:
    x = copy bag.r.*;
    unborrow bag.r;
    call use_num(move x);
    return
}

fn shared_loan_closes_via_unborrow(x: i64) {
  s: &i64;
  y: i64;
  entry:
    s = &x;
    y = copy s.*;
    unborrow s;
    call use_num(move y);
    call use_num(move x);
    return
}
