struct Wrap<'a, 'b: 'a> {
  x: &'a i64
  y: &'b i64
}

fn mk_ok<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out Wrap<'a, 'b>) {
  entry:
    $return.*.x = move x;
    $return.*.y = move y;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn mk_same<'a, 's0>(x: &'a i64, $return: &'s0 out Wrap<'a, 'a>) {
  entry:
    $return.*.x = copy x;
    $return.*.y = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn first_ref<'a, 'b, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    drop y;
    require_uninit y;
    require_uninit x;
    return
}

fn explicit_first_ref<'a, 'b, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out &'a i64) {
  $tmp_0: &out &'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call first_ref<'a, 'b>(move x, move y, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn identity<'s0, T: Copy + Drop>(x: T, $return: &'s0 out T) {
  entry:
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn generic_ref_identity<'a, 's0>(x: &'a i64, $return: &'s0 out &'a i64) {
  $tmp_0: &out &'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call identity<&'a i64>(move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}

struct Ref<'x>: Copy + Drop {
  p: &'x i64
}

fn mk_ref_via_let<'a, 's0>(p: &'a i64, $return: &'s0 out Ref<'a>) {
  r: Ref<'a>;
  entry:
    r.p = move p;
    $return.* = move r;
    unborrow $return;
    require_uninit r;
    require_uninit $return;
    require_uninit p;
    return
}

fn project_ref<'a, 's0>(r: Ref<'a>, $return: &'s0 out &'a i64) {
  entry:
    $return.* = move r.p;
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn project_ref_through_borrow<'a, 's0, 's1>(r: &'s0 Ref<'a>, $return: &'s1 out &'a i64) {
  entry:
    $return.* = copy r.*.p;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

enum Held<'y, T>: Copy + Drop {
  One: &'y T
}

fn unwrap_held<'a, 's0, T>(h: Held<'a, T>, $return: &'s0 out &'a T) {
  inner: &'a T;
  entry:
    switchEnum(h) [One: switch_One_0]
  switch_One_0:
    inner = copy h as One;
    $return.* = move inner;
    unborrow $return;
    require_uninit inner;
    goto switch_merge_1
  switch_merge_1:
    require_uninit $return;
    drop h;
    require_uninit h;
    return
}

fn mk_held_via_let<'a, 's0, T: Copy + Drop>(p: &'a T, $return: &'s0 out Held<'a, T>) {
  h: Held<'a, T>;
  entry:
    h = Held<T>::One(move p);
    $return.* = move h;
    unborrow $return;
    require_uninit h;
    require_uninit $return;
    require_uninit p;
    return
}
