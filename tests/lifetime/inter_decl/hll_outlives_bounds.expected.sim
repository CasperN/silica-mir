struct<'a, 'b: 'a> Wrap {
  x: & 'a i64
  y: & 'b i64
}

fn<'a, 'b: 'a, 's0> mk_ok(x: & 'a i64, y: & 'b i64, $return: &out 's0 Wrap<'a, 'b>) {
  entry:
    $return.*.x = move x;
    $return.*.y = move y;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'a, 's0> mk_same(x: & 'a i64, $return: &out 's0 Wrap<'a, 'a>) {
  entry:
    $return.*.x = copy x;
    $return.*.y = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn<'a, 'b, 's0> first_ref(x: & 'a i64, y: & 'b i64, $return: &out 's0 & 'a i64) {
  entry:
    unborrow y;
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'a, 'b, 's0> explicit_first_ref(x: & 'a i64, y: & 'b i64, $return: &out 's0 & 'a i64) {
  $tmp_0: &out & 'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call first_ref<'a, 'b>(move x, move y, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'s0, T: Copy + Drop> identity(x: T, $return: &out 's0 T) {
  entry:
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn<'a, 's0> generic_ref_identity(x: & 'a i64, $return: &out 's0 & 'a i64) {
  $tmp_0: &out & 'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call identity<& 'a i64>(move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}
