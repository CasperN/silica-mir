struct<'a, 'b: 'a> Wrap {
  x: &'a i64
  y: &'b i64
}

fn<'a, 'b: 'a, 's0> mk_ok(x: &'a i64, y: &'b i64, $return: &out 's0 Wrap<'a, 'b>) {
  entry:
    $return.*.x = move x;
    $return.*.y = move y;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'a, 's0> mk_same(x: &'a i64, $return: &out 's0 Wrap<'a, 'a>) {
  entry:
    $return.*.x = copy x;
    $return.*.y = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn<'a, 'b, 's0> first_ref(x: &'a i64, y: &'b i64, $return: &out 's0 &'a i64) {
  entry:
    unborrow y;
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'a, 'b, 's0> explicit_first_ref(x: &'a i64, y: &'b i64, $return: &out 's0 &'a i64) {
  $tmp_0: &out &'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call first_ref<'a, 'b>(move x, move y, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit y;
    require_uninit x;
    return
}

fn<'s0, T: Copy + Drop> identity(x: T, $return: &out 's0 T) {
  entry:
    $return.* = move x;
    unborrow $return;
    require_uninit $return;
    require_uninit x;
    return
}

fn<'a, 's0> generic_ref_identity(x: &'a i64, $return: &out 's0 &'a i64) {
  $tmp_0: &out &'a i64;
  entry:
    $tmp_0 = &out $return.*;
    call identity<&'a i64>(move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}

struct<'x> Ref: Copy + Drop {
  p: &'x i64
}

fn<'a, 's0> mk_ref_via_let(p: &'a i64, $return: &out 's0 Ref<'a>) {
  r: Ref<'a>;
  entry:
    r.p = move p;
    $return.* = move r;
    unborrow $return;
    require_uninit r;
    require_uninit $return;
    require_uninit p;
    return
}

fn<'a, 's0> project_ref(r: Ref<'a>, $return: &out 's0 &'a i64) {
  entry:
    $return.* = move r.p;
    unborrow $return;
    require_uninit $return;
    require_uninit r;
    return
}

fn<'a, 's0, 's1> project_ref_through_borrow(r: &'s0 Ref<'a>, $return: &out 's1 &'a i64) {
  entry:
    $return.* = copy r.*.p;
    unborrow $return;
    unborrow r;
    require_uninit $return;
    require_uninit r;
    return
}

enum<'y, T> Held: Copy + Drop {
  One: &'y T
}

fn<'a, 's0, T> unwrap_held(h: Held<'a, T>, $return: &out 's0 &'a T) {
  inner: &'a T;
  entry:
    switchEnum(h) [One: switch_One_0]
  switch_One_0:
    inner = copy h as One;
    unborrow h as One;
    $return.* = move inner;
    unborrow $return;
    require_uninit inner;
    goto switch_merge_1
  switch_merge_1:
    require_uninit $return;
    require_uninit h;
    return
}

fn<'a, 's0, T: Copy + Drop> mk_held_via_let(p: &'a T, $return: &out 's0 Held<'a, T>) {
  h: Held<'a, T>;
  entry:
    h = Held<T>::One(move p);
    $return.* = move h;
    unborrow $return;
    require_uninit h;
    require_uninit $return;
    require_uninit p;
    return
}
