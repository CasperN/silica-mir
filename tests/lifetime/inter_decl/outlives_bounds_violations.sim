# Outlives-bound diagnostics fire when the axiom set doesn't justify
# a required region relation.
#
# Cells covered:
#   fn                                    issue                             diag
#   no_bound_flow_fails                   missing 'a: 'b axiom              LT-LifetimeMismatch
#   reversed_chain_fails                  'a: 'b, 'b: 'c but return 'a→'c   LT-LifetimeMismatch
#   undeclared_bound_lt                   bound references 'z               TC-UndeclaredLifetime
#   named_into_static                     Named region into 'static slot    LT-LifetimeMismatch
#   static_declared_as_param_fails        'static as a user param           TC-ReservedLifetimeName
#   duplicate_lifetime_param_fails        'a declared twice                 TC-DuplicateLifetimeParam

# ---------- missing bound: 'a into 'b slot with no 'a: 'b axiom ----------

# covers: type_kind=fn lifetime_bound=none op=deref_write
# The direct counterpart of `single_bound_flow` in the ok fixture,
# but without the `'b: 'a` bound. LT-LifetimeMismatch fires.
fn<'a, 'b> no_bound_flow_fails(x: &'a i64, y: &'b i64, $return: &out &'b i64) {
  entry:
    $return.* = copy x;
    drop y;
    return
}

# ---------- chain in wrong direction ----------

# covers: type_kind=fn lifetime_bound=chain_reversed op=deref_write
# `'b: 'a, 'c: 'b` gives 'c outlives 'b outlives 'a — so 'a is the
# SHORTEST. Returning 'a into a slot expecting 'c would require
# 'a: 'c, which isn't in the closure. LT-LifetimeMismatch.
fn<'a, 'b: 'a, 'c: 'b> reversed_chain_fails(
  x: &'a i64,
  y: &'b i64,
  z: &'c i64,
  $return: &out &'c i64
) {
  entry:
    $return.* = copy x;
    drop y;
    drop z;
    return
}

# ---------- undeclared bound-side lifetime ----------

# covers: type_kind=fn lifetime_bound=undeclared_bound
# TC-UndeclaredLifetime points at the invalid bound itself.
fn<'a: 'z> undeclared_bound_lt(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- Named region into 'static slot ----------

# covers: type_kind=fn lifetime_bound=named_into_static op=deref_write
# The return slot demands 'static; the input is 'a with no bound.
# LT-LifetimeMismatch fires because no 'a: 'static axiom is declared.
fn<'a> named_into_static(x: &'a i64, $return: &out &'static i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- deep chain in wrong direction ----------

# covers: type_kind=fn lifetime_bound=deep_chain_reversed
# 'e: 'd: 'c: 'b: 'a means 'a is shortest. Flowing 'a into 'e slot
# requires 'a: 'e which isn't in the closure. LT-LifetimeMismatch.
fn<'a, 'b: 'a, 'c: 'b, 'd: 'c, 'e: 'd> deep_chain_reversed(
  x: &'a i64,
  $return: &out &'e i64
) {
  entry:
    $return.* = copy x;
    return
}

# ---------- diamond: 'd into 'a slot ----------

# covers: type_kind=fn lifetime_bound=diamond_reversed
# 'a: 'b, 'a: 'c, 'b: 'd, 'c: 'd — 'a is the longest, 'd is shortest.
# Flowing 'd into 'a slot requires 'd: 'a; that's not in the closure.
fn<'a: 'b + 'c, 'b: 'd, 'c: 'd, 'd> diamond_d_into_a(
  x: &'d i64,
  $return: &out &'a i64
) {
  entry:
    $return.* = copy x;
    return
}

# ---------- missing bound at call site ----------

# covers: type_kind=fn lifetime_bound=call_site_no_axiom
# Callee requires 'a: 'b axiom; caller has two refs with unrelated
# Named regions and no declared bound between them. The instantiation
# variables are eliminated from the call constraint graph, exposing the
# caller requirement 'q: 'p. The caller's axiom set does not justify it, so
# LT-LifetimeMismatch fires rather than misclassifying the callee variable as
# an escaping body-local borrow.
fn<'a, 'b: 'a> callee_needs_bound(x: &'a i64, y: &'b i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    drop y;
    return
}

fn<'p, 'q> caller_missing_bound(x: &'p i64, y: &'q i64, $return: &out &'p i64) {
  ret_out: &out &'p i64;
  entry:
    ret_out = &out $return.*;
    call callee_needs_bound(copy x, copy y, move ret_out);
    return
}

# ---------- free region into 'static output slot ----------

# covers: type_kind=fn lifetime_bound=free_into_static
# Body-local ref (Free region) flowing into a $return slot typed
# &'static i64. The escape check sees Free→Named(static) where
# Named(static) maps to Region::Static. The (_, Region::Static)
# arm in check_constraints silently accepts it. Flag whether the
# checker catches or misses this.
fn free_into_static($return: &out &'static i64) {
  x: i64;
  r: &i64;
  entry:
    x = 42;
    r = &x;
    $return.* = copy r;
    return
}

# ---------- undeclared bound on struct ----------

# covers: type_kind=struct lifetime_bound=undeclared_bound
# 'z is not declared as a lifetime param; TC-UndeclaredLifetime fires.
struct<'a: 'z> BadStruct: Move { r: &'a i64 }

fn<'a> make_bad(_r: &'a i64) {
  entry:
    return
}

# ---------- Wrap2 mention in fn signature missing containing bound ----------

# covers: type_kind=struct lifetime_bound=fn_mention_missing_axiom
# `Wrap2<'a, 'b>` requires `'b: 'a`. Containing fn declares no such
# axiom. Signature well-formedness sweep emits `'b: 'a` into the fn's
# constraint set; check_constraints fires LT-LifetimeMismatch.
struct<'a, 'b: 'a> W2: Move { p: &'a i64, q: &'b i64 }

fn<'a, 'b> wrap2_missing_axiom(x: &'a i64, y: &'b i64, $return: &out W2<'a, 'b>) {
  entry:
    $return.*.p = copy x;
    $return.*.q = copy y;
    return
}

# ---------- Wrap2 mention on a local decl missing containing bound ----------

# covers: type_kind=struct lifetime_bound=local_mention_missing_axiom
# The type only appears in a local decl (not the signature) — still an
# in-scope mention, still emits the substituted bound.
fn<'a, 'b> wrap2_local_missing_axiom(x: &'a i64, y: &'b i64) {
  w: W2<'a, 'b>;
  entry:
    w.p = copy x;
    w.q = copy y;
    drop w.p;
    drop w.q;
    return
}

# ---------- Reversed lifetime args: Wrap2<'b, 'a> ----------

# covers: type_kind=struct lifetime_bound=reversed_args
# Fn declares 'b: 'a. Mentioning W2<'b, 'a> substitutes into the bound
# subject/target and demands 'a: 'b — the opposite direction, not in
# the closure. LT-LifetimeMismatch fires.
fn<'a, 'b: 'a> wrap2_reversed(x: &'b i64, y: &'a i64, $return: &out W2<'b, 'a>) {
  entry:
    $return.*.p = copy x;
    $return.*.q = copy y;
    return
}

# ---------- struct field mentions Wrap2, outer lacks bound ----------

# covers: type_kind=struct lifetime_bound=decl_field_missing_axiom
# Field type `W2<'a, 'b>` demands `'b: 'a` on the outer decl. `Outer`
# declares no such bound; decl well-formedness fires LT-LifetimeMismatch
# at the field type span.
struct<'a, 'b> OuterBad: Move { inner: W2<'a, 'b> }

fn<'a, 'b> use_outer_bad(_x: &'a i64, _y: &'b i64) {
  entry:
    return
}

# ---------- enum variant payload violating a bound ----------

# covers: type_kind=enum lifetime_bound=decl_variant_missing_axiom
# Same shape, but the mention is on an enum variant payload.
enum<'a, 'b> EitherBad: Move { L: W2<'a, 'b>, R: &'a i64 }

fn<'a, 'b> use_either_bad(_x: &'a i64, _y: &'b i64) {
  entry:
    return
}

# ---------- Custom nested in Ref, missing bound ----------

# covers: type_kind=shared_ref lifetime_bound=ref_nested_missing_axiom
# Wf recurses through `&'r W2<'a, 'b>` and emits the substituted bound.
# Fn declares no 'b:'a; LT-LifetimeMismatch fires.
fn<'a, 'b, 'r> ref_wrap2_missing(w: &'r W2<'a, 'b>, $return: &out &'a i64) {
  entry:
    $return.* = copy w.*.p;
    return
}

# ---------- Custom nested in Array, missing bound ----------

# covers: type_kind=array lifetime_bound=array_nested_missing_axiom
# Same via `[W2<'a, 'b>; N]`.
fn<'a, 'b> array_wrap2_missing(x: &'a i64, y: &'b i64, $return: &out [W2<'a, 'b>; 1]) {
  entry:
    $return.*[0].p = copy x;
    $return.*[0].q = copy y;
    return
}

# ---------- Extern fn signature mentions Wrap2 without bound ----------

# covers: type_kind=fn boundary=extern lifetime_bound=extern_signature_missing_axiom
# An extern fn declaration is a signature-only object, but its type
# mentions still need to be well-formed against the fn's declared
# outlives axioms. Missing 'b:'a fires LT-LifetimeMismatch at the
# param type span even though the fn has no body.
extern fn<'a, 'b> extern_wrap2_missing(w: W2<'a, 'b>);

# ---------- 'static substituted as bound target, no axiom ----------

# covers: type_kind=struct lifetime_bound=static_target_missing_axiom
# W2<'static, 'a>: substituted bound is 'a: 'static, which needs 'a to
# be at least 'static. The fn declares no such axiom, so the well-
# formedness sweep emits (Named('a), Static) and check_constraints
# fires LT-LifetimeMismatch via the closure lookup.
fn<'a> wrap2_static_target_missing(s: &'static i64, x: &'a i64, $return: &out W2<'static, 'a>) {
  entry:
    $return.*.p = copy s;
    $return.*.q = copy x;
    return
}

# ---------- decl-scope 'static target without axiom ----------

# covers: type_kind=struct lifetime_bound=decl_static_target_missing
# Field type W2<'static, 'a> in an outer struct that declares neither
# 'a: 'static nor 'a as static-bounded. Decl wf fires.
struct<'a> BadStaticContainer: Move { inner: W2<'static, 'a> }

fn<'a> use_bad_static_container(_x: &'a i64) {
  entry:
    return
}

# ---------- caller lacks 'static bound the callee needs ----------

# covers: type_kind=fn lifetime_bound=call_site_needs_static
# Callee axiom is `'a: 'static`. The caller instantiates callee's 'a
# with an inference region and passes a Named 'p ref. Eliminating the
# call-instantiation variable exposes the caller requirement 'p: 'static;
# check_constraints reports the missing bound rather than treating the
# inference variable as an escaping body-local region.
extern fn<'a: 'static> callee_needs_static(x: &'a i64);

fn<'p> caller_no_static_axiom(y: &'p i64) {
  entry:
    call callee_needs_static(copy y);
    return
}

# ---------- explicit wrong-arity lifetime args ----------

# covers: type_kind=struct lifetime_bound=wrong_lifetime_arity
# W2 declares 2 lifetime params. Writing `W2<'p>` supplies only one.
# TC-InvalidDeclaredType fires from the arity check. Zero-arg bare
# mentions like `W2` are still tolerated (pending elision backfill).
struct<'p> WrongArity: Move { w: W2<'p> }

fn<'p> use_wrong_arity(_x: &'p i64) {
  entry:
    return
}

# ---------- ptr_cast target carrying an unchecked bound ----------

# covers: type_kind=raw_ptr lifetime_bound=ptr_cast_target
# The cast target `*W2<'a, 'b>` mentions W2 without the enclosing fn
# declaring `'b: 'a`. Signature/local walks catch the mention at
# param positions; the statement-level walk provides defense in
# depth for expression-only mentions.
fn<'a, 'b> ptr_cast_missing_axiom(x: *W2<'a, 'b>, $return: &out *W2<'a, 'b>) {
  entry:
    $return.* = ptr_cast(copy x, *W2<'a, 'b>);
    return
}

# ---------- wrong-arity lifetime args in a ptr_cast target ----------

# covers: type_kind=raw_ptr lifetime_bound=ptr_cast_wrong_arity
# The cast target `*W2<'a>` gives one lifetime arg where W2 needs two.
# TC-InvalidDeclaredType fires from the rvalue-embedded type validation.
fn<'a, 'b: 'a> ptr_cast_wrong_arity(src: *W2<'a, 'b>, $return: &out *W2<'a, 'b>) {
  entry:
    $return.* = ptr_cast(copy src, *W2<'a>);
    return
}

# ---------- Pair positional match: callee 'static vs caller 'q ----------

# covers: type_kind=struct lifetime_bound=call_positional_match
# Callee needs Pair<'static, 'static>; caller has Pair<'static, 'q>.
# Both lifetime slots must be matched positionally; the second callee
# slot ('static) is compared against the caller's second slot ('q),
# and 'q outliving 'static requires an axiom the caller lacks.
struct<'a, 'b> Pair: Move { first: &'a i64, second: &'b i64 }

extern fn needs_static(p: Pair<'static, 'static>);

fn<'q> pair_positional_missing(p: Pair<'static, 'q>) {
  entry:
    call needs_static(move p);
    return
}

# ---------- FnName type_args in a Use-operand carry unchecked bounds ----------

# covers: type_kind=fn lifetime_bound=fn_value_type_args
# `sink<W2<'a, 'b>>` mentions W2<'a, 'b> in the FnName const's type args.
# The enclosing fn doesn't declare 'b: 'a; the well-formedness sweep
# now discharges FnName type_args at every operand position, so
# LT-LifetimeMismatch fires.
extern fn<T: Move> sink(x: T);

fn<'a, 'b> fn_value_missing_axiom() {
  g: fn(W2<'a, 'a>);
  entry:
    g = sink<W2<'a, 'b>>;
    abort
}

# ---------- Container mention transitively requires bound ----------

# covers: type_kind=nested_aggregate lifetime_bound=outer_bound_transitive
# Container is `struct<'a, 'b: 'a>`. A caller mentioning `Container<'a, 'b>`
# in a fn that itself doesn't declare 'b:'a picks up Container's own
# outlives axiom and fails.
struct<'a, 'b: 'a> Container2: Move { inner: W2<'a, 'b> }

fn<'a, 'b> use_container_missing_axiom(x: &'a i64, y: &'b i64, $return: &out Container2<'a, 'b>) {
  entry:
    $return.*.inner.p = copy x;
    $return.*.inner.q = copy y;
    return
}

# ---------- 'static declared as a lifetime parameter ----------

# covers: type_kind=fn lifetime_bound=static_as_param
# `'static` is a reserved name — the top of the outlives order and
# always in scope. Declaring it as a user parameter is rejected with
# TC-ReservedLifetimeName so the reserved name isn't accidentally
# re-bound.
fn<'static: 'a, 'a> static_declared_as_param_fails(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- duplicate lifetime parameter ----------

# covers: type_kind=fn lifetime_bound=duplicate_param
# Two `'a` declarations in the same parameter list — the second fires
# TC-DuplicateLifetimeParam. The bounds don't matter for the check.
fn<'a: 'b, 'a: 'b, 'b> duplicate_lifetime_param_fails(
  x: &'a i64,
  $return: &out &'b i64
) {
  entry:
    $return.* = copy x;
    return
}

# ---------- generated lifetime names are diagnostic-local and distinct ----------

# covers: type_kind=fn lifetime_bound=elided_distinct op=assignment
# Each elided input lifetime is a separate region. The diagnostic assigns
# source-facing names to both regions and must not collapse the requirement
# into the meaningless `'_ : '_`.
fn elided_bound_names_are_distinct(x: &i64, y: &i64) {
  entry:
    y = copy x;
    drop x;
    drop y;
    return
}
