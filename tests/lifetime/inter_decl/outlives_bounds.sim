# Signature outlives bounds: `fn<'a, 'b: 'a>` (subject outlives bound).
#
# The bound enters the checker as a signature axiom used by the
# transitive-closure step in check_constraints. A caller-facing ref
# with region 'a can flow into a slot expecting region 'b if the
# bound `'a: 'b` (or a chain concluding it) is in scope.
#
# `'static` is a reserved lifetime always in scope; `'a: 'static`
# means "any 'a" (`'static` outlives every 'a — the bound is
# vacuous but legal), and `'static: 'a` is trivially satisfiable.
#
# Cells covered:
#   fn                        bound shape             expected
#   plain_input_no_bound      no bound                clean (baseline)
#   single_bound_flow         'a: 'b, return 'a       clean via axiom
#   chain_bound_flow          'a: 'b, 'b: 'c, ret 'a  clean via transitive closure
#   static_source             'static input           clean
#   static_bound_reflexive    'a: 'static             clean; bound vacuous

# ---------- baseline: no outlives bound, single-input elision ----------

# covers: type_kind=fn lifetime_bound=unbounded
fn<'a> plain_input_no_bound(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- invariant call output unifies with the caller region ----------

# covers: type_kind=fn lifetime_bound=call_invariant_equality
# The exclusive output parameter makes its pointee lifetime invariant. The
# call therefore emits both directions between the instantiated callee region
# and caller region 'p. Normalize that equality before escape classification:
# the fresh callee variable is not a body-local borrow and must not fire
# LT-LifetimeEscape.
fn<'a> invariant_identity(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

fn<'p> invariant_forwarding(x: &'p i64, $return: &out &'p i64) {
  ret_out: &out &'p i64;
  entry:
    ret_out = &out $return.*;
    call invariant_identity(copy x, move ret_out);
    return
}

# ---------- qualified calls propagate satisfied method bounds ----------

struct<'r> CallReceiver: Copy + Drop { value: &'r i64 }

trait QualifiedNeedsBound {
  fn<'a, 'b: 'a> trait_needs(recv: & Self, x: &'a i64, y: &'b i64);
}

impl<'r> CallReceiver<'r> {
  fn<'a, 'b: 'a> inherent_needs(
    recv: & CallReceiver<'r>,
    x: &'a i64,
    y: &'b i64,
  ) {
    entry:
      return
  }
}

impl<'r> QualifiedNeedsBound for CallReceiver<'r> {
  fn<'a, 'b: 'a> trait_needs(
    recv: & CallReceiver<'r>,
    x: &'a i64,
    y: &'b i64,
  ) {
    entry:
      return
  }
}

# covers: inherent method outlives axiom is satisfied by the caller
fn<'p, 'q: 'p> inherent_caller_bound_ok(
  recv: & CallReceiver<'p>,
  x: &'p i64,
  y: &'q i64,
) {
  entry:
    call <CallReceiver<'p>>::inherent_needs<'p, 'q>(copy recv, copy x, copy y);
    return
}

# covers: trait method outlives axiom is satisfied by the caller
fn<'p, 'q: 'p> trait_caller_bound_ok(
  recv: & CallReceiver<'p>,
  x: &'p i64,
  y: &'q i64,
) {
  entry:
    call <CallReceiver<'p> as QualifiedNeedsBound>::trait_needs<'p, 'q>(
      copy recv,
      copy x,
      copy y,
    );
    return
}

trait<'a, 'b: 'a> QualifiedTraitHeaderBound {
  fn invoke(recv: & Self);
}

struct<'a, 'b> HeaderReceiver: Copy + Drop {
  first: &'a i64,
  second: &'b i64,
}

impl<'a, 'b: 'a> HeaderReceiver<'a, 'b> {
  fn inherent_header(recv: & HeaderReceiver<'a, 'b>) {
    entry:
      return
  }
}

# covers: an impl header satisfies its trait path's lifetime bounds
impl<'a, 'b: 'a> QualifiedTraitHeaderBound<'a, 'b> for HeaderReceiver<'a, 'b> {
  fn invoke(recv: & HeaderReceiver<'a, 'b>) {
    entry:
      return
  }
}

# covers: qualified trait declaration bound is satisfied by the caller
fn<'p, 'q: 'p> trait_header_caller_bound_ok(recv: & HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q> as QualifiedTraitHeaderBound<'p, 'q>>::invoke(copy recv);
    return
}

# covers: inherent impl-header bound is satisfied by the caller
fn<'p, 'q: 'p> impl_header_caller_bound_ok(recv: & HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q>>::inherent_header(copy recv);
    return
}

struct<T> ImplTypeReceiver { value: T }

impl<T> ImplTypeReceiver<T> {
  fn accept_impl_type(recv: & ImplTypeReceiver<T>, value: T) {
    entry:
      abort
  }
}

# covers: inherent method parameter types substitute impl-header type arguments
fn<'p, 'q: 'p> inherent_impl_type_bound_ok(
  recv: & ImplTypeReceiver<&'p i64>,
  value: &'q i64,
) {
  entry:
    call <ImplTypeReceiver<&'p i64>>::accept_impl_type(copy recv, copy value);
    return
}

struct MethodTypeReceiver: Copy + Drop {}

trait GenericMethod {
  fn<T> accept_method_type(recv: & Self, value: T);
}

impl GenericMethod for MethodTypeReceiver {
  fn<T> accept_method_type(recv: & MethodTypeReceiver, value: T) {
    entry:
      abort
  }
}

# covers: trait method parameter types substitute method type arguments
fn<'p, 'q: 'p> trait_method_type_bound_ok(
  recv: & MethodTypeReceiver,
  value: &'q i64,
) {
  entry:
    call <MethodTypeReceiver as GenericMethod>::accept_method_type<&'p i64>(
      copy recv,
      copy value,
    );
    return
}

# ---------- single outlives bound: 'a: 'b lets 'a flow into 'b slot ----------

# covers: type_kind=fn lifetime_bound=single_outlives op=deref_write
# Without the bound this fires LT-LifetimeMismatch — see the mirror
# fixture in outlives_bounds_violations.sim.
fn<'a, 'b: 'a> single_bound_flow(x: &'a i64, y: &'b i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    drop y;
    return
}

# ---------- chain: 'a: 'b, 'b: 'c ⇒ transitive 'a: 'c ----------

# covers: type_kind=fn lifetime_bound=chain
# Assign the 'c-region input into the 'c-region return slot — always
# clean. The transitive closure of the axiom set contains 'a: 'c even
# though the bound isn't written directly.
fn<'a, 'b: 'a, 'c: 'b> chain_bound_flow(
  x: &'a i64,
  y: &'b i64,
  z: &'c i64,
  $return: &out &'c i64
) {
  entry:
    $return.* = copy z;
    drop x;
    drop y;
    return
}

# ---------- 'static source flows into any Named slot ----------

# covers: type_kind=fn lifetime_bound=static_source op=deref_write
# 'static is the top of the outlives order; the closure trivially
# gives 'static outlives 'a for every named 'a. `copy s` (where
# `s: &'static i64`) into a `&'a i64` slot flows clean.
fn<'a> static_source(s: &'static i64, $return: &out &'a i64) {
  entry:
    $return.* = copy s;
    return
}

# ---------- 'a: 'static bound (vacuous, but legal) ----------

# covers: type_kind=fn lifetime_bound=static_reflexive
# `'a: 'static` demands 'a IS 'static (nothing else outlives 'static).
# A caller with an actual 'static input satisfies this; a Named-region
# input would fail at the call site (checked in the caller). The decl
# itself parses and type-checks clean.
fn<'a: 'static> requires_static(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- deep transitive chain: 'a: 'b: 'c: 'd: 'e ----------

# covers: type_kind=fn lifetime_bound=deep_chain
# 'e outlives 'a via the chain, so flowing 'e into 'a slot is clean.
fn<'a, 'b: 'a, 'c: 'b, 'd: 'c, 'e: 'd> deep_chain_forward(
  x: &'e i64,
  $return: &out &'a i64
) {
  entry:
    $return.* = copy x;
    return
}

# ---------- cyclic bounds: 'a ~ 'b ----------

# covers: type_kind=fn lifetime_bound=cyclic
# 'a: 'b and 'b: 'a — both directions should be clean and the closure
# must terminate (no infinite loop). Return 'a into 'b slot and vice versa.
fn<'a: 'b, 'b: 'a> cycle_a_into_b(x: &'a i64, $return: &out &'b i64) {
  entry:
    $return.* = copy x;
    return
}

fn<'a: 'b, 'b: 'a> cycle_b_into_a(x: &'b i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- diamond: 'a: 'b, 'a: 'c, 'b: 'd, 'c: 'd ----------

# covers: type_kind=fn lifetime_bound=diamond
# 'a outlives 'd via either path ('a→'b→'d or 'a→'c→'d).
fn<'a: 'b + 'c, 'b: 'd, 'c: 'd, 'd> diamond_a_into_d(
  x: &'a i64,
  $return: &out &'d i64
) {
  entry:
    $return.* = copy x;
    return
}

# ---------- multiple bounds via '+': 'a: 'b + 'c + 'static ----------

# covers: type_kind=fn lifetime_bound=multi_plus
# All three axioms enter the closure: 'a:'b, 'a:'c, 'a:'static.
fn<'a: 'b + 'c + 'static, 'b, 'c> multi_plus_b(x: &'a i64, $return: &out &'b i64) {
  entry:
    $return.* = copy x;
    return
}

fn<'a: 'b + 'c + 'static, 'b, 'c> multi_plus_c(x: &'a i64, $return: &out &'c i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- 'static on LHS via 'a: 'static + reciprocal bound in bound-only form ----------

# covers: type_kind=fn lifetime_bound=static_only_rhs
# The `'static` region is reserved — it can appear as a bound target
# but cannot be declared as a lifetime parameter (see
# `static_declared_as_param_fails` in the violations file).
fn<'a: 'static> static_only_rhs(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- reflexive bound: 'a: 'a ----------

# covers: type_kind=fn lifetime_bound=reflexive
# 'a outlives itself is trivial. Closure must not loop; result is clean.
fn<'a: 'a> reflexive_bound(x: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- struct-decl outlives bounds ----------

# covers: type_kind=struct lifetime_bound=single_outlives
# 'b: 'a on the struct decl. Every mention of Wrap2<'x, 'y> at any
# position (fn param, local, nested type arg, or struct/enum field)
# emits the substituted 'y: 'x obligation into the containing scope's
# constraint set. The containing scope must justify it via its own
# declared axioms; a match fires no diagnostic.
struct<'a, 'b: 'a> Wrap2: Move { outer: &'a i64, inner: &'b i64 }

fn<'a, 'b: 'a> make_wrap2(x: &'a i64, y: &'b i64, $return: &out Wrap2<'a, 'b>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy y;
    return
}

fn<'a, 'b: 'a> read_wrap2(w: Wrap2<'a, 'b>, $return: &out &'a i64) {
  entry:
    $return.* = copy w.outer;
    drop w.inner;
    return
}

# ---------- reflexive substitution: Wrap2<'a, 'a> ----------

# covers: type_kind=struct lifetime_bound=single_outlives_reflexive
# Substituting 'a for both params reduces the bound to 'a: 'a, which
# is reflexive and pruned by `emit`. Well-formed under any axiom set,
# including the empty one — the containing fn declares no bound.
fn<'a> wrap2_reflexive(x: &'a i64, $return: &out Wrap2<'a, 'a>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy x;
    return
}

# ---------- transitive chain propagation at a mention ----------

# covers: type_kind=struct lifetime_bound=chain_propagation
# Wrap2<'a, 'c> substitutes 'c into the bound RHS. The container fn
# has 'b: 'a and 'c: 'b, whose transitive closure contains 'c: 'a — so
# the substituted 'c: 'a is discharged.
fn<'a, 'b: 'a, 'c: 'b> wrap2_chain(x: &'a i64, y: &'c i64, $return: &out Wrap2<'a, 'c>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy y;
    return
}

# ---------- 'static substituted as bound subject ----------

# covers: type_kind=struct lifetime_bound=static_subject
# Wrap2<'a, 'static>: substituted bound is 'static: 'a. `emit` prunes
# outlives==Static — no constraint enters the check, clean under any
# axiom set.
fn<'a> wrap2_static_subject(x: &'a i64, s: &'static i64, $return: &out Wrap2<'a, 'static>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy s;
    return
}

# ---------- 'static substituted as bound target, axiom in scope ----------

# covers: type_kind=struct lifetime_bound=static_target_with_axiom
# Wrap2<'static, 'a>: substituted bound is 'a: 'static. The fn declares
# the axiom so the constraint is discharged via the transitive closure.
fn<'a: 'static> wrap2_static_target(s: &'static i64, x: &'a i64, $return: &out Wrap2<'static, 'a>) {
  entry:
    $return.*.outer = copy s;
    $return.*.inner = copy x;
    return
}

# ---------- nested Custom-in-Custom well-formedness ----------

# covers: type_kind=nested_aggregate lifetime_bound=nested_custom
# A struct whose field is itself a Wrap2 mention. Container declares
# 'b: 'a on itself so the field's substituted 'b: 'a is dischargeable
# at Container's decl wf. Container's mentions in fn signatures then
# emit its own 'b: 'a to the fn scope.
struct<'a, 'b: 'a> Container: Move { inner: Wrap2<'a, 'b> }

fn<'a, 'b: 'a> make_container(x: &'a i64, y: &'b i64, $return: &out Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    $return.*.inner.inner = copy y;
    return
}

# ---------- Custom nested in Ref ----------

# covers: type_kind=shared_ref lifetime_bound=nested_in_ref
# The Custom mention hides inside `&Wrap2<...>`. Wf recurses through
# Ref to find and discharge Wrap2's bound against the fn's axioms.
fn<'a, 'b: 'a, 'r> ref_to_wrap2(w: &'r Wrap2<'a, 'b>, $return: &out &'a i64) {
  entry:
    $return.* = copy w.*.outer;
    return
}

# ---------- Custom nested in Array ----------

# covers: type_kind=array lifetime_bound=nested_in_array
# Same idea, hidden inside `[Wrap2<...>; N]`.
fn<'a, 'b: 'a> array_of_wrap2(x: &'a i64, y: &'b i64, $return: &out [Wrap2<'a, 'b>; 2]) {
  entry:
    $return.*[0].outer = copy x;
    $return.*[0].inner = copy y;
    $return.*[1].outer = copy x;
    $return.*[1].inner = copy y;
    return
}

# ---------- Custom-of-Custom: bound in outer decl only ----------

# covers: type_kind=nested_aggregate lifetime_bound=outer_carries_bound
# Container declares 'b: 'a so its own field `Wrap2<'a, 'b>` is
# well-formed at Container's decl. A fn mentioning Container<'a, 'b>
# picks up Container's OWN declared 'b: 'a and requires the fn to
# match — not the inner Wrap2's bound, which is already discharged.
fn<'a, 'b: 'a> use_container(x: &'a i64, y: &'b i64, $return: &out Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    $return.*.inner.inner = copy y;
    return
}

# ---------- enum-decl outlives bounds ----------

# covers: type_kind=enum lifetime_bound=single_outlives
# 'b: 'a on the enum decl; well-formedness discharges at every mention.
enum<'a, 'b: 'a> Either2: Move { L: &'a i64, R: &'b i64 }

fn<'a, 'b: 'a> make_either2_l(x: &'a i64, $return: &out Either2<'a, 'b>) {
  entry:
    $return.* = Either2::L(copy x);
    return
}

fn<'a, 'b: 'a> make_either2_r(y: &'b i64, $return: &out Either2<'a, 'b>) {
  entry:
    $return.* = Either2::R(copy y);
    return
}

# ---------- 'static input into Named return with bound ----------

# covers: type_kind=fn lifetime_bound=static_source_with_bound
# 'static source flows into 'a slot; 'a: 'static in scope is consistent.
fn<'a: 'static> static_arg_required(x: &'static i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}
# Impl-method checking combines impl-header lifetime bounds with method scope.
struct ImplLifetimeHost: Copy + Drop { value: i64 }

trait<'a, 'b> ImplLifetimeFlow {
  fn flow(recv: & Self, x: &'a i64, $return: &out &'b i64);
}

impl<'a: 'b, 'b> ImplLifetimeFlow<'a, 'b> for ImplLifetimeHost {
  fn flow(recv: & ImplLifetimeHost, x: &'a i64, $return: &out &'b i64) {
    entry:
      $return.* = copy x;
      return
  }
}
