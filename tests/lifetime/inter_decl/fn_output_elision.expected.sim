fn identity<'s0: 's2, 's1: 's2, 's2>(r: &'s0 i64, $return: &'s1 out &'s2 i64) {
  entry:
    $return.* = copy r;
    unborrow $return;
    drop r;
    return
}

fn pick_first<'s0: 's3, 's1: 's3, 's2: 's3, 's3>(x: &'s0 i64, y: &'s1 i64, $return: &'s2 out &'s3 i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn pick_second<'s0: 's3, 's1: 's3, 's2: 's3, 's3>(x: &'s0 i64, y: &'s1 i64, $return: &'s2 out &'s3 i64) {
  entry:
    $return.* = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn mixed_elision<'a: 's2, 's0: 's2, 's1: 's2, 's2>(x: &'a i64, y: &'s0 i64, $return: &'s1 out &'s2 i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop y;
    drop x;
    return
}
