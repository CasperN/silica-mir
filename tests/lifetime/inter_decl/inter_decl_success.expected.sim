fn identity<'a, 's0>(r: &'a i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy r;
    unborrow $return;
    drop r;
    return
}

fn pick<'a, 's0>(x: &'a i64, y: &'a i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn first<'a, 'b, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn second<'a, 'b, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out &'b i64) {
  entry:
    $return.* = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn nested_identity<'outer, 'inner, 's0>(r: &'outer &'inner i64, $return: &'s0 out &'outer &'inner i64) {
  entry:
    $return.* = copy r;
    unborrow $return;
    drop r;
    return
}

struct Wrap<'a>: Move {
  r: &'a i64
}

fn wrap_it<'a, 's0>(x: &'a i64, $return: &'s0 out Wrap<'a>) {
  entry:
    $return.*.r = copy x;
    unborrow $return;
    drop x;
    return
}

struct Both<'a, 'b>: Move {
  l: &'a i64
  r: &'b i64
}

fn make_both<'a, 'b, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out Both<'a, 'b>) {
  entry:
    $return.*.l = copy x;
    $return.*.r = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

enum MaybeRef<'a>: Copy + Drop {
  None: $Tuple0
  Some: &'a i64
}

fn maybe_of<'a, 's0>(r: &'a i64, $return: &'s0 out MaybeRef<'a>) {
  entry:
    $return.* = MaybeRef::Some(copy r);
    unborrow $return;
    drop r;
    return
}

fn use_identity() {
  x: i64;
  r: &i64;
  ret_slot: &i64;
  ret_out: &out &i64;
  first_read: i64;
  second_read: i64;
  entry:
    x = 42;
    r = &x;
    ret_out = &out ret_slot;
    call identity(move r, move ret_out);
    first_read = copy ret_slot.*;
    second_read = copy ret_slot.*;
    drop second_read;
    drop first_read;
    drop ret_slot;
    drop x;
    return
}

extern fn use_wrap<'s0>(w: Wrap<'s0>);

fn local_wrap_consumed<'a>(x: &'a i64) {
  w: Wrap<'a>;
  entry:
    w.r = copy x;
    call use_wrap(move w);
    drop x;
    return
}

fn write_through_out<'a, 's0>(dst: &'s0 out &'a i64, src: &'a i64) {
  entry:
    dst.* = copy src;
    unborrow dst;
    drop src;
    return
}

fn wrap_ref_in_enum<'a, 's0>(r: &'a i64, $return: &'s0 out MaybeRef<'a>) {
  entry:
    $return.* = MaybeRef::Some(copy r);
    unborrow $return;
    drop r;
    return
}

fn bare_custom_reuses_fn_lifetime<'a>(w: Wrap<'a>, x: &'a i64) {
  entry:
    drop w.r;
    w.r = copy x;
    call use_wrap(move w);
    drop x;
    return
}

fn bare_custom_local_shares_param_region<'a>(x: Wrap<'a>) {
  y: Wrap<'a>;
  entry:
    y = move x;
    call use_wrap(move y);
    return
}

struct Trip<'a, 'b, 'c>: Move {
  p: &'a i64
  q: &'b i64
  r: &'c i64
}

struct Nest1<'s0, 's1, 's2>: Move {
  t: Trip<'s0, 's1, 's2>
}

struct Nest2<'s0, 's1, 's2>: Move {
  n: Nest1<'s0, 's1, 's2>
}

extern fn use_nest2<'s0, 's1, 's2>(x: Nest2<'s0, 's1, 's2>);

fn propagate_arity<'a, 'b, 'c>(p: &'a i64, q: &'b i64, r: &'c i64) {
  n: Nest2<'a, 'b, 'c>;
  entry:
    n.n.t.p = copy p;
    n.n.t.q = copy q;
    n.n.t.r = copy r;
    call use_nest2(move n);
    drop r;
    drop q;
    drop p;
    return
}
