# Fn elision axiom: every synthesized output-position lifetime is
# outlived by every input-position lifetime. Effect: a returned ref
# lives no longer than the intersection of all input refs. Axioms
# live on Function::signature_outlives.

# ---------- single-input ref, single output ref ----------

fn identity(r: &i64, $return: &out &i64) {
  entry:
    $return.* = copy r;
    return
}

# ---------- multi-input, output from either arg ----------

fn pick_first(x: &i64, y: &i64, $return: &out &i64) {
  entry:
    $return.* = copy x;
    return
}

fn pick_second(x: &i64, y: &i64, $return: &out &i64) {
  entry:
    $return.* = copy y;
    return
}

# ---------- one arg has a declared lifetime, one is elided ----------

# Rule: elided output constrained by every input, whether declared
# or synthesized. `'a outlives out` AND `'s0 outlives out`.
fn mixed_elision<'a>(x: &'a i64, y: &i64, $return: &out &i64) {
  entry:
    $return.* = copy x;
    return
}
