# Success cases for inter-decl (cross-fn / cross-struct) lifetimes.
# Every function here should type-check and lifetime-check cleanly.
# Once the loan checker honors declared lifetimes, these must still
# succeed — they pin every shape the analysis should accept.
#
# Axes covered:
#   - fn ref-return with one input       (elision applies)
#   - fn ref-return with multiple inputs (explicit lifetimes)
#   - struct with one ref field
#   - struct with two ref fields (independent lifetimes)
#   - enum with ref-carrying variant
#   - cross-fn ref-return threading
#   - nested shared refs preserve both declared lifetimes
#   - returned shared refs remain readable after the first read

# ---------- fn returning a ref from a single input (explicit) ----------

# Single-ref input, single-ref output. Explicit 'a ties input to
# output so the returned ref's region matches the input's. Silica
# elision synthesizes a distinct fresh lifetime per unannotated ref
# (no Rust-style rule-2 unification), so the caller must write 'a
# whenever they want two refs to share a region.
fn identity<'a>(r: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy r;
    return
}

# ---------- explicit single-lifetime: two inputs share 'a ----------

# Both inputs share 'a; result borrows from either. Classic Rust
# max-style shape.
fn pick<'a>(x: &'a i64, y: &'a i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# ---------- explicit multi-lifetime: distinct 'a and 'b ----------

# Two independent lifetimes; return tied to 'a only.
fn first<'a, 'b>(x: &'a i64, y: &'b i64, $return: &out &'a i64) {
  entry:
    $return.* = copy x;
    return
}

# Same shape, returning the 'b side.
fn second<'a, 'b>(x: &'a i64, y: &'b i64, $return: &out &'b i64) {
  entry:
    $return.* = copy y;
    return
}

# ---------- nested shared refs preserve both lifetimes ----------

# Both the outer reference lifetime and its pointee reference lifetime
# are semantically significant. Returning the same nested reference is
# valid when both are preserved.
# covers: nested shared-reference lifetime propagation
fn nested_identity<'outer, 'inner>(
  r: &'outer &'inner i64,
  $return: &out &'outer &'inner i64,
) {
  entry:
    $return.* = copy r;
    return
}

# ---------- struct with one ref field ----------

# 'a threads through the field. The struct is Move (linear over the
# ref); passing it forward is the only discharge.
struct Wrap<'a>: Move { r: &'a i64 }

fn wrap_it<'a>(x: &'a i64, $return: &out Wrap<'a>) {
  entry:
    $return.*.r = copy x;
    return
}

# ---------- struct with two independent ref lifetimes ----------

struct Both<'a, 'b>: Move { l: &'a i64, r: &'b i64 }

fn make_both<'a, 'b>(x: &'a i64, y: &'b i64, $return: &out Both<'a, 'b>) {
  entry:
    $return.*.l = copy x;
    $return.*.r = copy y;
    return
}

# ---------- enum with ref-carrying variant ----------

enum MaybeRef<'a>: Copy + Drop { None: unit, Some: &'a i64 }

fn maybe_of<'a>(r: &'a i64, $return: &out MaybeRef<'a>) {
  entry:
    $return.* = MaybeRef::Some(copy r);
    return
}

# ---------- caller wires ref through returned-ref chain ----------

# Caller borrows a local, passes through identity, and uses the
# result. The loan on x stays live from the borrow to the last
# access through the returned ref.
# covers: returned shared reference remains readable after repeated dereference
fn use_identity() {
  x: i64;
  r: &i64;
  ret_slot: &i64;
  ret_out: &out &i64;
  first_read: i64;
  second_read: i64;
  entry:
    x = 42;
    r = &x;
    ret_out = &out ret_slot;
    call identity(move r, move ret_out);
    first_read = copy ret_slot.*;
    second_read = copy ret_slot.*;
    return
}

# ---------- body-local Wrap not stored anywhere: no escape ----------

# Move the caller-provided ref into a locally-declared Wrap, then
# consume the Wrap via extern. Nothing escapes past return.
extern fn use_wrap(w: Wrap);

fn local_wrap_consumed<'a>(x: &'a i64) {
  w: Wrap<'a>;
  entry:
    w.r = copy x;
    call use_wrap(move w);
    return
}

# ---------- write through &out param, source is caller's ref ----------

# Writing a caller-provided ref through a caller-provided &out slot.
# Source region 'a matches destination region 'a; escape check
# permits it because the source is signature-visible.
fn write_through_out<'a>(dst: &out &'a i64, src: &'a i64) {
  entry:
    dst.* = copy src;
    return
}

# ---------- enum with ref variant, wrapped and returned ----------

fn wrap_ref_in_enum<'a>(r: &'a i64, $return: &out MaybeRef<'a>) {
  entry:
    $return.* = MaybeRef::Some(copy r);
    return
}

# ---------- bare Custom in signature reuses fn's lifetime ----------

# `w: Wrap` elides to `w: Wrap<'a>` — the reuse-first rule picks the
# fn's already-declared 'a rather than synthesizing a fresh lifetime.
# `x: &'a i64` therefore writes into `w.r: &'a i64` with matching
# region and no bound is required.
#
# Under the pre-elision silent-substitute era, this program also
# accepted, but by coincidence: substitute mismatched the empty
# lifetime_args against Wrap's declared `'b`, silently returned the
# raw field type `&'b i64`, and the checker happened to unify 'b
# against 'a whenever names collided. Renaming Wrap's parameter
# would have surfaced a confusing "declare bound 'a: 'b" diagnostic
# referring to a name not in the fn's scope. Reuse-first makes
# the acceptance intentional and name-agnostic.
fn bare_custom_reuses_fn_lifetime<'a>(w: Wrap, x: &'a i64) {
  entry:
    w.r = copy x;
    call use_wrap(move w);
    return
}

# ---------- bare Custom body-local shares fn param region ----------

# `y: Wrap` local reuses 'a positionally, matching `x: Wrap<'a>` in
# the signature. `y = move x` transfers the same region without
# needing an outlives bound. Guards against a regression where body-
# local Custom elision would synthesize a distinct region and force
# a spurious `'a: 's0` mismatch on the move.
fn bare_custom_local_shares_param_region<'a>(x: Wrap) {
  y: Wrap;
  entry:
    y = move x;
    call use_wrap(move y);
    return
}

# ---------- multi-step arity propagation via fixpoint iteration ----------

# `Trip` has 3 lifetime params. `Nest1` bare-uses Trip, so its own
# arity grows to 3 during the second struct/enum elision pass.
# `Nest2` bare-uses Nest1 — at the start of pass 2, arities['Nest1']
# is still 0 (from pass 1 where Nest1 had no bare Customs to
# process). Only after pass 2 lifts Nest1 to arity 3 does pass 3
# see the right arity for Nest2's bare Nest1 field. The fixpoint
# loop is what makes this converge — a single second pass would
# leave Nest2 at arity 0. Regression guard: removing the fixpoint
# loop breaks Nest2's elided form.
struct Trip<'a, 'b, 'c>: Move { p: &'a i64, q: &'b i64, r: &'c i64 }
struct Nest1: Move { t: Trip }
struct Nest2: Move { n: Nest1 }
extern fn use_nest2(x: Nest2);
fn propagate_arity<'a, 'b, 'c>(p: &'a i64, q: &'b i64, r: &'c i64) {
  n: Nest2;
  entry:
    n.n.t.p = copy p;
    n.n.t.q = copy q;
    n.n.t.r = copy r;
    call use_nest2(move n);
    return
}
