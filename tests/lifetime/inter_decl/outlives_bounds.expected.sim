fn<'a, 's0> plain_input_no_bound(x: &'a i64, $return: &out 's0 &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 's0> invariant_identity(x: &'a i64, $return: &out 's0 &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'p, 's0> invariant_forwarding(x: &'p i64, $return: &out 's0 &'p i64) {
  ret_out: &out &'p i64;
  entry:
    ret_out = &out $return.*;
    call invariant_identity(copy x, move ret_out);
    unborrow $return;
    unborrow x;
    return
}

struct<'r> CallReceiver: Copy + Drop {
  value: &'r i64
}

trait QualifiedNeedsBound {
  fn<'a, 'b: 'a, 's0> trait_needs(recv: &'s0 Self, x: &'a i64, y: &'b i64);
}

impl<'r> CallReceiver<'r> {
  fn<'a, 'b: 'a, 's0> inherent_needs(recv: &'s0 CallReceiver<'r>, x: &'a i64, y: &'b i64) {
    entry:
      unborrow recv;
      unborrow x;
      unborrow y;
      return
  }
}

impl<'r> QualifiedNeedsBound for CallReceiver<'r> {
  fn<'a, 'b: 'a, 's0> trait_needs(recv: &'s0 CallReceiver<'r>, x: &'a i64, y: &'b i64) {
    entry:
      unborrow recv;
      unborrow x;
      unborrow y;
      return
  }
}

fn<'p, 'q: 'p, 's0> inherent_caller_bound_ok(recv: &'s0 CallReceiver<'p>, x: &'p i64, y: &'q i64) {
  entry:
    call <CallReceiver<'p>>::inherent_needs<'p, 'q>(copy recv, copy x, copy y);
    unborrow recv;
    unborrow x;
    unborrow y;
    return
}

fn<'p, 'q: 'p, 's0> trait_caller_bound_ok(recv: &'s0 CallReceiver<'p>, x: &'p i64, y: &'q i64) {
  entry:
    call <CallReceiver<'p> as QualifiedNeedsBound>::trait_needs<'p, 'q>(copy recv, copy x, copy y);
    unborrow recv;
    unborrow x;
    unborrow y;
    return
}

trait<'a, 'b: 'a> QualifiedTraitHeaderBound {
  fn<'s0> invoke(recv: &'s0 Self);
}

struct<'a, 'b> HeaderReceiver: Copy + Drop {
  first: &'a i64
  second: &'b i64
}

impl<'a, 'b: 'a> HeaderReceiver<'a, 'b> {
  fn<'s0> inherent_header(recv: &'s0 HeaderReceiver<'a, 'b>) {
    entry:
      unborrow recv;
      return
  }
}

impl<'a, 'b: 'a> QualifiedTraitHeaderBound<'a, 'b> for HeaderReceiver<'a, 'b> {
  fn<'s0> invoke(recv: &'s0 HeaderReceiver<'a, 'b>) {
    entry:
      unborrow recv;
      return
  }
}

fn<'p, 'q: 'p, 's0> trait_header_caller_bound_ok(recv: &'s0 HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q> as QualifiedTraitHeaderBound<'p, 'q>>::invoke(copy recv);
    unborrow recv;
    return
}

fn<'p, 'q: 'p, 's0> impl_header_caller_bound_ok(recv: &'s0 HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q>>::inherent_header(copy recv);
    unborrow recv;
    return
}

struct<T> ImplTypeReceiver {
  value: T
}

impl<T> ImplTypeReceiver<T> {
  fn<'s0> accept_impl_type(recv: &'s0 ImplTypeReceiver<T>, value: T) {
    entry:
      abort
  }
}

fn<'p, 'q: 'p, 's0> inherent_impl_type_bound_ok(recv: &'s0 ImplTypeReceiver<&'p i64>, value: &'q i64) {
  entry:
    call <ImplTypeReceiver<&'p i64>>::accept_impl_type(copy recv, copy value);
    unborrow recv;
    unborrow value;
    return
}

struct MethodTypeReceiver: Copy + Drop {
}

trait GenericMethod {
  fn<'s0, T> accept_method_type(recv: &'s0 Self, value: T);
}

impl GenericMethod for MethodTypeReceiver {
  fn<'s0, T> accept_method_type(recv: &'s0 MethodTypeReceiver, value: T) {
    entry:
      abort
  }
}

fn<'p, 'q: 'p, 's0> trait_method_type_bound_ok(recv: &'s0 MethodTypeReceiver, value: &'q i64) {
  entry:
    call <MethodTypeReceiver as GenericMethod>::accept_method_type<&'p i64>(copy recv, copy value);
    unborrow recv;
    unborrow value;
    return
}

fn<'a, 'b: 'a, 's0> single_bound_flow(x: &'a i64, y: &'b i64, $return: &out 's0 &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    drop y;
    return
}

fn<'a, 'b: 'a, 'c: 'b, 's0> chain_bound_flow(x: &'a i64, y: &'b i64, z: &'c i64, $return: &out 's0 &'c i64) {
  entry:
    $return.* = copy z;
    unborrow $return;
    unborrow z;
    drop x;
    drop y;
    return
}

fn<'a, 's0> static_source(s: &'static i64, $return: &out 's0 &'a i64) {
  entry:
    $return.* = copy s;
    unborrow $return;
    unborrow s;
    return
}

fn<'a: 'static, 's0> requires_static(x: &'a i64, $return: &out 's0 &'a i64) {
