fn plain_input_no_bound<'a, 's0>(x: &'a i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop x;
    return
}

fn invariant_identity<'a, 's0>(x: &'a i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop x;
    return
}

fn invariant_forwarding<'p, 's0>(x: &'p i64, $return: &'s0 out &'p i64) {
  ret_out: &out &'p i64;
  entry:
    ret_out = &out $return.*;
    call invariant_identity(copy x, move ret_out);
    unborrow $return;
    drop x;
    return
}

struct CallReceiver<'r>: Copy + Drop {
  value: &'r i64
}

trait QualifiedNeedsBound {
  fn trait_needs<'a, 'b: 'a, 's0>(recv: &'s0 Self, x: &'a i64, y: &'b i64);
}

impl<'r> CallReceiver<'r> {
  fn inherent_needs<'a, 'b: 'a, 's0>(recv: &'s0 CallReceiver<'r>, x: &'a i64, y: &'b i64) {
    entry:
      drop y;
      drop x;
      drop recv;
      return
  }
}

impl<'r> QualifiedNeedsBound for CallReceiver<'r> {
  fn trait_needs<'a, 'b: 'a, 's0>(recv: &'s0 CallReceiver<'r>, x: &'a i64, y: &'b i64) {
    entry:
      drop y;
      drop x;
      drop recv;
      return
  }
}

fn inherent_caller_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 CallReceiver<'p>, x: &'p i64, y: &'q i64) {
  entry:
    call <CallReceiver<'p>>::inherent_needs<'p, 'q>(copy recv, copy x, copy y);
    drop y;
    drop x;
    drop recv;
    return
}

fn trait_caller_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 CallReceiver<'p>, x: &'p i64, y: &'q i64) {
  entry:
    call <CallReceiver<'p> as QualifiedNeedsBound>::trait_needs<'p, 'q>(copy recv, copy x, copy y);
    drop y;
    drop x;
    drop recv;
    return
}

trait QualifiedTraitHeaderBound<'a, 'b: 'a> {
  fn invoke<'s0>(recv: &'s0 Self);
}

struct HeaderReceiver<'a, 'b>: Copy + Drop {
  first: &'a i64
  second: &'b i64
}

impl<'a, 'b: 'a> HeaderReceiver<'a, 'b> {
  fn inherent_header<'s0>(recv: &'s0 HeaderReceiver<'a, 'b>) {
    entry:
      drop recv;
      return
  }
}

impl<'a, 'b: 'a> QualifiedTraitHeaderBound<'a, 'b> for HeaderReceiver<'a, 'b> {
  fn invoke<'s0>(recv: &'s0 HeaderReceiver<'a, 'b>) {
    entry:
      drop recv;
      return
  }
}

fn trait_header_caller_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q> as QualifiedTraitHeaderBound<'p, 'q>>::invoke(copy recv);
    drop recv;
    return
}

fn impl_header_caller_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 HeaderReceiver<'p, 'q>) {
  entry:
    call <HeaderReceiver<'p, 'q>>::inherent_header(copy recv);
    drop recv;
    return
}

struct ImplTypeReceiver<T> {
  value: T
}

impl<T> ImplTypeReceiver<T> {
  fn accept_impl_type<'s0>(recv: &'s0 ImplTypeReceiver<T>, value: T) {
    entry:
      abort
  }
}

fn inherent_impl_type_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 ImplTypeReceiver<&'p i64>, value: &'q i64) {
  entry:
    call <ImplTypeReceiver<&'p i64>>::accept_impl_type(copy recv, copy value);
    drop value;
    drop recv;
    return
}

struct MethodTypeReceiver: Copy + Drop {
}

trait GenericMethod {
  fn accept_method_type<'s0, T>(recv: &'s0 Self, value: T);
}

impl GenericMethod for MethodTypeReceiver {
  fn accept_method_type<'s0, T>(recv: &'s0 MethodTypeReceiver, value: T) {
    entry:
      abort
  }
}

fn trait_method_type_bound_ok<'p, 'q: 'p, 's0>(recv: &'s0 MethodTypeReceiver, value: &'q i64) {
  entry:
    call <MethodTypeReceiver as GenericMethod>::accept_method_type<&'p i64>(copy recv, copy value);
    drop value;
    drop recv;
    return
}

fn single_bound_flow<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn chain_bound_flow<'a, 'b: 'a, 'c: 'b, 's0>(x: &'a i64, y: &'b i64, z: &'c i64, $return: &'s0 out &'c i64) {
  entry:
    $return.* = copy z;
    unborrow $return;
    drop x;
    drop y;
    drop z;
    return
}

