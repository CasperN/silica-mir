fn<'a, 's0> plain_input_no_bound(x: & 'a i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 's0> invariant_identity(x: & 'a i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'p, 's0> invariant_forwarding(x: & 'p i64, $return: &out 's0 & 'p i64) {
  ret_out: &out & 'p i64;
  entry:
    ret_out = &out $return.*;
    call invariant_identity(copy x, move ret_out);
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 'b: 'a, 's0> single_bound_flow(x: & 'a i64, y: & 'b i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    drop y;
    return
}

fn<'a, 'b: 'a, 'c: 'b, 's0> chain_bound_flow(x: & 'a i64, y: & 'b i64, z: & 'c i64, $return: &out 's0 & 'c i64) {
  entry:
    $return.* = copy z;
    unborrow $return;
    unborrow z;
    drop x;
    drop y;
    return
}

fn<'a, 's0> static_source(s: & 'static i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy s;
    unborrow $return;
    unborrow s;
    return
}

fn<'a: 'static, 's0> requires_static(x: & 'a i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 'b: 'a, 'c: 'b, 'd: 'c, 'e: 'd, 's0> deep_chain_forward(x: & 'e i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'b, 'b: 'a, 's0> cycle_a_into_b(x: & 'a i64, $return: &out 's0 & 'b i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'b, 'b: 'a, 's0> cycle_b_into_a(x: & 'b i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'b + 'c, 'b: 'd, 'c: 'd, 'd, 's0> diamond_a_into_d(x: & 'a i64, $return: &out 's0 & 'd i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'b + 'c + 'static, 'b, 'c, 's0> multi_plus_b(x: & 'a i64, $return: &out 's0 & 'b i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'b + 'c + 'static, 'b, 'c, 's0> multi_plus_c(x: & 'a i64, $return: &out 's0 & 'c i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'static, 's0> static_only_rhs(x: & 'a i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a: 'a, 's0> reflexive_bound(x: & 'a i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

struct<'a, 'b: 'a> Wrap2: Move {
  outer: & 'a i64
  inner: & 'b i64
}

fn<'a, 'b: 'a, 's0> make_wrap2(x: & 'a i64, y: & 'b i64, $return: &out 's0 Wrap2<'a, 'b>) {
  entry:
    $return.*.outer = copy x;
    unborrow x;
    $return.*.inner = copy y;
    unborrow $return;
    unborrow y;
    return
}

fn<'a, 'b: 'a, 's0> read_wrap2(w: Wrap2<'a, 'b>, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy w.outer;
    unborrow $return;
    unborrow w.outer;
    drop w.inner;
    return
}

fn<'a, 's0> wrap2_reflexive(x: & 'a i64, $return: &out 's0 Wrap2<'a, 'a>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy x;
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 'b: 'a, 'c: 'b, 's0> wrap2_chain(x: & 'a i64, y: & 'c i64, $return: &out 's0 Wrap2<'a, 'c>) {
  entry:
    $return.*.outer = copy x;
    unborrow x;
    $return.*.inner = copy y;
    unborrow $return;
    unborrow y;
    return
}

fn<'a, 's0> wrap2_static_subject(x: & 'a i64, s: & 'static i64, $return: &out 's0 Wrap2<'a, 'static>) {
  entry:
    $return.*.outer = copy x;
    unborrow x;
    $return.*.inner = copy s;
    unborrow $return;
    unborrow s;
    return
}

fn<'a: 'static, 's0> wrap2_static_target(s: & 'static i64, x: & 'a i64, $return: &out 's0 Wrap2<'static, 'a>) {
  entry:
    $return.*.outer = copy s;
    unborrow s;
    $return.*.inner = copy x;
    unborrow $return;
    unborrow x;
    return
}

struct<'a, 'b: 'a> Container: Move {
  inner: Wrap2<'a, 'b>
}

fn<'a, 'b: 'a, 's0> make_container(x: & 'a i64, y: & 'b i64, $return: &out 's0 Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    unborrow x;
    $return.*.inner.inner = copy y;
    unborrow $return;
    unborrow y;
    return
}

fn<'a, 'b: 'a, 'r, 's0> ref_to_wrap2(w: & 'r Wrap2<'a, 'b>, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy w.*.outer;
    unborrow $return;
    unborrow w;
    return
}

fn<'a, 'b: 'a, 's0> array_of_wrap2(x: & 'a i64, y: & 'b i64, $return: &out 's0 [Wrap2<'a, 'b>; 2]) {
  entry:
    $return.*[0].outer = copy x;
    $return.*[0].inner = copy y;
    $return.*[1].outer = copy x;
    unborrow x;
    $return.*[1].inner = copy y;
    unborrow $return;
    unborrow y;
    return
}

fn<'a, 'b: 'a, 's0> use_container(x: & 'a i64, y: & 'b i64, $return: &out 's0 Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    unborrow x;
    $return.*.inner.inner = copy y;
    unborrow $return;
    unborrow y;
    return
}

enum<'a, 'b: 'a> Either2: Move {
  L: & 'a i64
  R: & 'b i64
}

fn<'a, 'b: 'a, 's0> make_either2_l(x: & 'a i64, $return: &out 's0 Either2<'a, 'b>) {
  entry:
    $return.* = Either2::L(copy x);
    unborrow $return;
    unborrow x;
    return
}

fn<'a, 'b: 'a, 's0> make_either2_r(y: & 'b i64, $return: &out 's0 Either2<'a, 'b>) {
  entry:
    $return.* = Either2::R(copy y);
    unborrow $return;
    unborrow y;
    return
}

fn<'a: 'static, 's0> static_arg_required(x: & 'static i64, $return: &out 's0 & 'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

struct ImplLifetimeHost: Copy + Drop {
  value: i64
}

trait<'a, 'b> ImplLifetimeFlow {
  fn<'s0, 's1> flow(recv: & 's0 Self, x: & 'a i64, $return: &out 's1 & 'b i64);
}

impl<'a: 'b, 'b> ImplLifetimeFlow<'a, 'b> for ImplLifetimeHost {
  fn<'s0, 's1> flow(recv: & 's0 ImplLifetimeHost, x: & 'a i64, $return: &out 's1 & 'b i64) {
    entry:
      unborrow recv;
      $return.* = copy x;
      unborrow $return;
      unborrow x;
      return
  }
}
