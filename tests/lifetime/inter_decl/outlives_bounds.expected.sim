}

struct Wrap2<'a, 'b: 'a>: Move {
  outer: &'a i64
  inner: &'b i64
}

fn make_wrap2<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out Wrap2<'a, 'b>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn read_wrap2<'a, 'b: 'a, 's0>(w: Wrap2<'a, 'b>, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy w.outer;
    unborrow $return;
    unborrow w.outer;
    drop w.inner;
    return
}

fn wrap2_reflexive<'a, 's0>(x: &'a i64, $return: &'s0 out Wrap2<'a, 'a>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy x;
    unborrow $return;
    drop x;
    return
}

fn wrap2_chain<'a, 'b: 'a, 'c: 'b, 's0>(x: &'a i64, y: &'c i64, $return: &'s0 out Wrap2<'a, 'c>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn wrap2_static_subject<'a, 's0>(x: &'a i64, s: &'static i64, $return: &'s0 out Wrap2<'a, 'static>) {
  entry:
    $return.*.outer = copy x;
    $return.*.inner = copy s;
    unborrow $return;
    drop s;
    drop x;
    return
}

fn wrap2_static_target<'a: 'static, 's0>(s: &'static i64, x: &'a i64, $return: &'s0 out Wrap2<'static, 'a>) {
  entry:
    $return.*.outer = copy s;
    $return.*.inner = copy x;
    unborrow $return;
    drop x;
    drop s;
    return
}

struct Container<'a, 'b: 'a>: Move {
  inner: Wrap2<'a, 'b>
}

fn make_container<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    $return.*.inner.inner = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn ref_to_wrap2<'a, 'b: 'a, 'r, 's0>(w: &'r Wrap2<'a, 'b>, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy w.*.outer;
    unborrow $return;
    drop w;
    return
}

fn array_of_wrap2<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out [Wrap2<'a, 'b>; 2]) {
  entry:
    $return.*[0].outer = copy x;
    $return.*[0].inner = copy y;
    $return.*[1].outer = copy x;
    $return.*[1].inner = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

fn use_container<'a, 'b: 'a, 's0>(x: &'a i64, y: &'b i64, $return: &'s0 out Container<'a, 'b>) {
  entry:
    $return.*.inner.outer = copy x;
    $return.*.inner.inner = copy y;
    unborrow $return;
    drop y;
    drop x;
    return
}

enum Either2<'a, 'b: 'a>: Move {
  L: &'a i64
  R: &'b i64
}

fn make_either2_l<'a, 'b: 'a, 's0>(x: &'a i64, $return: &'s0 out Either2<'a, 'b>) {
  entry:
    $return.* = Either2::L(copy x);
    unborrow $return;
    drop x;
    return
}

fn make_either2_r<'a, 'b: 'a, 's0>(y: &'b i64, $return: &'s0 out Either2<'a, 'b>) {
  entry:
    $return.* = Either2::R(copy y);
    unborrow $return;
    drop y;
    return
}

fn static_arg_required<'a: 'static, 's0>(x: &'static i64, $return: &'s0 out &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    drop x;
    return
}

struct ImplLifetimeHost: Copy + Drop {
  value: i64
}

trait ImplLifetimeFlow<'a, 'b> {
  fn flow<'s0, 's1>(recv: &'s0 Self, x: &'a i64, $return: &'s1 out &'b i64);
}

impl<'a: 'b, 'b> ImplLifetimeFlow<'a, 'b> for ImplLifetimeHost {
  fn flow<'s0, 's1>(recv: &'s0 ImplLifetimeHost, x: &'a i64, $return: &'s1 out &'b i64) {
    entry:
      $return.* = copy x;
      unborrow $return;
      drop x;
      drop recv;
      return
  }
}
