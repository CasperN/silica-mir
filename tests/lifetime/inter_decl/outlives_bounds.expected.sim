    unborrow $return;
    unborrow x;
    return
}

fn<'a, 'b: 'a, 'c: 'b, 'd: 'c, 'e: 'd, 's0> deep_chain_forward(x: &'e i64, $return: &out 's0 &'a i64) {
  entry:
    $return.* = copy x;
    unborrow $return;
    unborrow x;
    return
}

