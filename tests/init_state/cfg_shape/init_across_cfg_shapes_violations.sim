# Init-state join failures across CFG shapes.
#
# When predecessors of a join disagree on a local's state — one Init,
# one NeverInit or Moved — a subsequent access must not be accepted.
# The exact diagnostic reflects the access and state the init-state
# checker derives at that program point. The same rule catches a loop
# body that reads a local before writing it.
#
# Every function exercises one cell of the (CFG shape x disagreement
# cause) matrix. A regression pins the wrong shape or lets an invalid
# read through.
#
#   fn                                shape           disagreement cause
#   branch_join_disagreement          branch/merge    one arm inits, the other doesn't
#   move_one_branch_read_at_merge     branch/merge    one arm moves out, the other leaves Init
#   loop_body_reads_before_writing    natural loop    first-iter NeverInit vs backedge Init

struct M: Drop + Move { value: i64 }

extern fn take(y: M);
extern fn use_num(n: M);

# ---------- branch/merge: only one arm inits x ----------

# The true arm writes `x`; the false arm doesn't. The read at `merge`
# must not be accepted.
fn branch_join_disagreement(b: bool) {
  x: i64;
  y: i64;
  entry:
    branch(copy b) [true: t, false: fbr]
  t:
    x = 1;
    goto merge
  fbr:
    goto merge
  merge:
    y = copy x;
    return
}

# ---------- branch/merge: move-out on one arm, read on the merge ----------

# The true arm moves `x` out; the false arm leaves it Init. The consuming
# move at `merge` must still fail with UseAfterMove.
fn move_one_branch_read_at_merge(x: M, b: bool) {
  entry:
    branch(copy b) [true: t, false: fbr]
  t:
    call take(move x);
    goto merge
  fbr:
    goto merge
  merge:
    call use_num(move x);
    return
}

# ---------- natural loop: body reads x before writing on the first iteration ----------

# On the first entry to `body`, `x` is NeverInit; the read at
# `y = copy x` fails before the later backedge can establish a value.
fn loop_body_reads_before_writing(b: bool) {
  x: i64;
  y: i64;
  entry:
    branch(copy b) [true: body, false: done]
  body:
    y = copy x;
    x = 1;
    branch(copy b) [true: body, false: done]
  done:
    return
}
