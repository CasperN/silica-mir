enum Inner: Copy + Drop {
  X: i64
  Y: i64
}

enum Outer: Copy + Drop {
  A: Inner
  B: i64
}

fn<'s0> nested_downcast(o: Outer, $return: &out 's0 i64) {
  inner: Inner;
  x: i64;
  y: i64;
  b: i64;
  entry:
    switchEnum(o) [A: switch_A_0, B: switch_B_1]
  switch_A_0:
    inner = copy o as A;
    switchEnum(inner) [X: switch_X_3, Y: switch_Y_4]
  switch_X_3:
    x = copy inner as X;
    $return.* = move x;
    unborrow $return;
    require_uninit x;
    goto switch_merge_5
  switch_Y_4:
    y = copy inner as Y;
    $return.* = move y;
    unborrow $return;
    require_uninit y;
    goto switch_merge_5
  switch_merge_5:
    drop inner;
    require_uninit inner;
    goto switch_merge_2
  switch_B_1:
    b = copy o as B;
    $return.* = move b;
    unborrow $return;
    require_uninit b;
    goto switch_merge_2
  switch_merge_2:
    require_uninit $return;
    drop o;
    require_uninit o;
    return
}

enum Tag: Copy + Drop {
  Zero: unit
  Pos: i64
  Neg: i64
}

fn<'s0> to_i64(t: Tag, $return: &out 's0 i64) {
  _: unit;
  p: i64;
  n: i64;
  $tmp_0: &out i64;
  entry:
    switchEnum(t) [Zero: switch_Zero_0, Pos: switch_Pos_1, Neg: switch_Neg_2]
  switch_Zero_0:
    _ = copy t as Zero;
    $return.* = 0;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_3
  switch_Pos_1:
    p = copy t as Pos;
    $return.* = move p;
    unborrow $return;
    require_uninit p;
    goto switch_merge_3
  switch_Neg_2:
    n = copy t as Neg;
    $tmp_0 = &out $return.*;
    call $i64_neg(move n, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit n;
    goto switch_merge_3
  switch_merge_3:
    require_uninit $return;
    drop t;
    require_uninit t;
    return
}

fn<'s0> sum_two_tags(a: [Tag; 2], $return: &out 's0 i64) {
  $tmp_0: i64;
  $tmp_1: &out i64;
  $tmp_2: i64;
  $tmp_3: &out i64;
  $tmp_4: &out i64;
  entry:
    $tmp_1 = &out $tmp_0;
    call to_i64(move a[0], move $tmp_1);
    $tmp_3 = &out $tmp_2;
    call to_i64(move a[1], move $tmp_3);
    $tmp_4 = &out $return.*;
    call $i64_add(move $tmp_0, move $tmp_2, move $tmp_4);
    unborrow $return;
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit a;
    return
}

fn<'s0> sum_two_tags_direct(a: [Tag; 2], $return: &out 's0 i64) {
  first: i64;
  _: unit;
  p: i64;
  n: i64;
  $tmp_0: &out i64;
  second: i64;
  $__0: unit;
  $p_0: i64;
  $n_0: i64;
  $tmp_1: &out i64;
  $tmp_2: &out i64;
  entry:
    switchEnum(a[0]) [Zero: switch_Zero_0, Pos: switch_Pos_1, Neg: switch_Neg_2]
  switch_Zero_0:
    _ = copy a[0] as Zero;
    first = 0;
    drop _;
    require_uninit _;
    goto switch_merge_3
  switch_Pos_1:
    p = copy a[0] as Pos;
    first = move p;
    require_uninit p;
    goto switch_merge_3
  switch_Neg_2:
    n = copy a[0] as Neg;
    $tmp_0 = &out first;
    call $i64_neg(move n, move $tmp_0);
    require_uninit $tmp_0;
    require_uninit n;
    goto switch_merge_3
  switch_merge_3:
    switchEnum(a[1]) [Zero: switch_Zero_4, Pos: switch_Pos_5, Neg: switch_Neg_6]
  switch_Zero_4:
    $__0 = copy a[1] as Zero;
    second = 0;
    drop $__0;
    require_uninit $__0;
    goto switch_merge_7
  switch_Pos_5:
    $p_0 = copy a[1] as Pos;
    second = move $p_0;
    require_uninit $p_0;
    goto switch_merge_7
  switch_Neg_6:
    $n_0 = copy a[1] as Neg;
    $tmp_1 = &out second;
    call $i64_neg(move $n_0, move $tmp_1);
    require_uninit $tmp_1;
    require_uninit $n_0;
    goto switch_merge_7
  switch_merge_7:
    $tmp_2 = &out $return.*;
    call $i64_add(move first, move second, move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    require_uninit second;
    require_uninit first;
    require_uninit $return;
    drop a;
    require_uninit a;
    return
}

struct Tagged: Copy + Drop {
  tag: Tag
  extra: i64
}

fn<'s0> decode_field(t: Tagged, $return: &out 's0 i64) {
  _: unit;
  p: i64;
  $tmp_0: &out i64;
  n: i64;
  $tmp_1: &out i64;
  entry:
    switchEnum(t.tag) [Zero: switch_Zero_0, Pos: switch_Pos_1, Neg: switch_Neg_2]
  switch_Zero_0:
    _ = copy t.tag as Zero;
    $return.* = move t.extra;
    unborrow $return;
    drop _;
    require_uninit _;
    goto switch_merge_3
  switch_Pos_1:
    p = copy t.tag as Pos;
    $tmp_0 = &out $return.*;
    call $i64_add(move p, move t.extra, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit p;
    goto switch_merge_3
  switch_Neg_2:
    n = copy t.tag as Neg;
    $tmp_1 = &out $return.*;
    call $i64_sub(move t.extra, move n, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit n;
    goto switch_merge_3
  switch_merge_3:
    require_uninit $return;
    drop t.tag;
    require_uninit t;
    return
}

enum Which: Copy + Drop {
  A: unit
  B: unit
}

fn<'s0> asymmetric_ref_use(r: &mut 's0 i64, w: Which) {
  $tmp_0: unit;
  a: unit;
  observed: i64;
  b: unit;
  entry:
    switchEnum(w) [A: switch_A_0, B: $edge0]
  $edge0:
    unborrow r;
    goto switch_B_1
  switch_A_0:
    a = copy w as A;
    observed = copy r.*;
    unborrow r;
    $tmp_0 = unit;
    drop observed;
    require_uninit observed;
    drop a;
    require_uninit a;
    goto switch_merge_2
  switch_B_1:
    b = copy w as B;
    $tmp_0 = unit;
    drop b;
    require_uninit b;
    goto switch_merge_2
  switch_merge_2:
    drop $tmp_0;
    require_uninit $tmp_0;
    drop w;
    require_uninit w;
    require_uninit r;
    return
}
