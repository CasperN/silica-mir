    base = ptr_cast(move span.data, *T);
    $tmp_0 = &out item;
    call ptr_offset<T>(move base, move index, move $tmp_0);
    require_uninit $tmp_0;
    $return.* = ptr_cast(move item, &'a T);
    unborrow $return;
    require_uninit item;
    require_uninit base;
    require_uninit $return;
    require_uninit index;
    drop span.len;
    require_uninit span;
    return
}

struct<T> Vec: Move {
