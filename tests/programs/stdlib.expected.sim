extern fn<'s0> malloc_bytes(size: u64, $return: &out 's0 *u8);

extern fn free_bytes(p: *u8);

struct<T> Box: Move {
  p: *T
}

fn<'s0, T: Move> box_new(value: T, $return: &out 's0 Box<T>) {
  bytes: *u8;
  $tmp_0: u64;
  $tmp_1: &out u64;
  $tmp_2: &out *u8;
  typed: *T;
  $tmp_3: unit;
  $tmp_4: unit;
  entry:
    $tmp_1 = &out $tmp_0;
    call size_of<T>(move $tmp_1);
    $tmp_2 = &out bytes;
    call malloc_bytes(move $tmp_0, move $tmp_2);
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    typed = ptr_cast(move bytes, *T);
    typed.* = move value;
    $tmp_4 = unit;
    drop $tmp_4;
    require_uninit $tmp_4;
    $tmp_3 = unit;
    drop $tmp_3;
    require_uninit $tmp_3;
    $return.*.p = move typed;
    unborrow $return;
    require_uninit typed;
    require_uninit bytes;
    require_uninit $return;
    require_uninit value;
    return
}

fn<'s0, T: Move> box_into_inner(b: Box<T>, $return: &out 's0 T) {
  inner: T;
  bytes: *u8;
  $tmp_0: unit;
  entry:
    inner = move b.p.*;
    bytes = ptr_cast(move b.p, *u8);
    call free_bytes(move bytes);
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move inner;
    unborrow $return;
    require_uninit bytes;
    require_uninit inner;
    require_uninit $return;
    require_uninit b;
    return
}

fn<'s0: 's2, 's1: 's2, 's2, T> box_borrow(b: &'s0 Box<T>, $return: &out 's1 &'s2 T) {
  entry:
    $return.* = ptr_cast(copy b.*.p, &T);
    unborrow $return;
    unborrow b;
    require_uninit $return;
    require_uninit b;
    return
}

fn<'s0: 's2, 's1: 's2, 's2, T> box_borrow_mut(b: &mut 's0 Box<T>, $return: &out 's1 &mut 's2 T) {
  entry:
    $return.* = ptr_cast(copy b.*.p, &mut T);
    unborrow $return;
    unborrow b;
    require_uninit $return;
    require_uninit b;
    return
}

fn<'s0> main(exit: &out 's0 i32) {
  $tmp_0: unit;
  b: Box<i64>;
  $tmp_1: &out Box<i64>;
  peek: i64;
  $tmp_2: &i64;
  $tmp_3: &Box<i64>;
  $tmp_4: &out &i64;
  owned: i64;
  $tmp_5: &out i64;
  $tmp_6: unit;
  $tmp_7: i32;
  $tmp_8: i64;
  $tmp_9: i64;
  $tmp_10: &out i64;
  $tmp_11: &out i64;
  $tmp_12: &out i32;
  entry:
    $tmp_1 = &out b;
    call box_new<i64>(42, move $tmp_1);
    require_uninit $tmp_1;
    $tmp_3 = &b;
    $tmp_4 = &out $tmp_2;
    call box_borrow<i64>(move $tmp_3, move $tmp_4);
    peek = copy $tmp_2.*;
    unborrow $tmp_2;
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    $tmp_5 = &out owned;
    call box_into_inner<i64>(move b, move $tmp_5);
    require_uninit $tmp_5;
    $tmp_10 = &out $tmp_9;
    call $i64_add(copy peek, move owned, move $tmp_10);
    $tmp_11 = &out $tmp_8;
    call $i64_sub(move $tmp_9, move peek, move $tmp_11);
    $tmp_12 = &out $tmp_7;
    call $i64_to_i32(move $tmp_8, move $tmp_12);
    exit.* = move $tmp_7;
    unborrow exit;
    $tmp_6 = unit;
    require_uninit $tmp_12;
    require_uninit $tmp_11;
    require_uninit $tmp_10;
    require_uninit $tmp_9;
    require_uninit $tmp_8;
    require_uninit $tmp_7;
    drop $tmp_6;
    require_uninit $tmp_6;
    $tmp_0 = unit;
    require_uninit owned;
    require_uninit peek;
    require_uninit b;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit exit;
    return
}
