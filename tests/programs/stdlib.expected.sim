  fn<'s0: 's2, 's1: 's2, 's2> get_mut(recv: &mut 's0 Box<T>, $return: &out 's1 &mut 's2 T) {
    entry:
      $return.* = ptr_cast(copy recv.*.data, &mut T);
      unborrow $return;
      unborrow recv;
      require_uninit $return;
      require_uninit recv;
      return
  }
}

impl<T: Move> Box<T> {
  fn<'s0> into_inner(recv: Box<T>, $return: &out 's0 T) {
    value: T;
    $tmp_0: unit;
    $tmp_1: *u8;
    entry:
      value = move recv.data.*;
      $tmp_1 = ptr_cast(move recv.data, *u8);
      call free_bytes(move $tmp_1);
      $tmp_0 = unit;
      require_uninit $tmp_1;
      drop $tmp_0;
      require_uninit $tmp_0;
      $return.* = move value;
      unborrow $return;
      require_uninit value;
      require_uninit $return;
      require_uninit recv;
      return
  }
}

struct<'a, T> Span: Copy + Drop {
  data: &'a T
  len: u64
}

fn<'a, 's0, T> span_from_raw_parts(data: *T, len: u64, $return: &out 's0 Span<'a, T>) {
  entry:
    $return.*.data = ptr_cast(move data, &'a T);
    $return.*.len = move len;
    unborrow $return;
    require_uninit $return;
    require_uninit len;
    require_uninit data;
    return
}

fn<'a, 's0, T> span_len(span: Span<'a, T>, $return: &out 's0 u64) {
  entry:
    $return.* = move span.len;
    unborrow $return;
    require_uninit $return;
    drop span.data;
    require_uninit span;
    return
}

fn<'a, 's0, T> span_get_unchecked(span: Span<'a, T>, index: u64, $return: &out 's0 &'a T) {
