extern fn<'s0> malloc_bytes(size: u64, $return: &out 's0 *u8);

extern fn free_bytes(p: *u8);

struct<T> Box: Move {
  data: *T
}

fn<'s0, T: Move> box_new(value: T, $return: &out 's0 Box<T>) {
  bytes: *u8;
  $tmp_0: u64;
  $tmp_1: &out u64;
  $tmp_2: &out *u8;
  data: *T;
  $tmp_3: unit;
  $tmp_4: unit;
  entry:
    $tmp_1 = &out $tmp_0;
    call size_of<T>(move $tmp_1);
    $tmp_2 = &out bytes;
    call malloc_bytes(move $tmp_0, move $tmp_2);
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    data = ptr_cast(move bytes, *T);
    data.* = move value;
    $tmp_4 = unit;
    drop $tmp_4;
    require_uninit $tmp_4;
    $tmp_3 = unit;
    drop $tmp_3;
    require_uninit $tmp_3;
    $return.*.data = move data;
    unborrow $return;
    require_uninit data;
    require_uninit bytes;
    require_uninit $return;
    require_uninit value;
    return
}

impl<T> Box<T> {
  fn<'s0: 's2, 's1: 's2, 's2> get(recv: &'s0 Box<T>, $return: &out 's1 &'s2 T) {
    entry:
      $return.* = ptr_cast(copy recv.*.data, &T);
      unborrow $return;
      unborrow recv;
      require_uninit $return;
      require_uninit recv;
      return
