# Generic single-value heap box, hand-rolled to exercise the
# generics + raw-pointer + linear-drop pipeline end-to-end.
#
# `Box<T>` owns a heap allocation containing exactly one `T`. It is
# unconditionally `Move` (the handle is a raw pointer, which is
# bitwise-relocatable regardless of `T`'s markers) but deliberately
# NOT `Drop` — leaking a `Box` without consuming it via
# `box_into_inner` is a linearity error, caught by the init-state
# checker at return.
#
# Only operations that literally bitwise-move a `T` in or out of the
# heap slot (`box_new`, `box_into_inner`) require `T: Move`. A
# `box_new_in(ctor: fn(&out T))` that constructs `T` in place would
# work for `!Move` types too — that's how you box an immovable value
# — but requires lambdas, which are deferred.
#
# `box_new` uses the compiler-provided `size_of<T>()` prelude wrapper
# to compute the byte count; no explicit size parameter needed.

extern fn malloc_bytes(size: u64) -> *u8;
extern fn free_bytes(p: *u8);

struct<T> Box: Move { p: *T }

# Allocate a fresh box holding `value`. Takes ownership of `value`.
fn<T: Move> box_new(value: T) -> Box<T> {
  let bytes: *u8 = malloc_bytes(size_of<T>());
  let typed: *T = bytes as *T;
  unsafe { typed.* = value; }
  Box { p: typed }
}

# Consume the box, returning the inner value and freeing the buffer.
fn<T: Move> box_into_inner(b: Box<T>) -> T {
  let inner: T = unsafe { b.p.* };
  let bytes: *u8 = b.p as *u8;
  free_bytes(bytes);
  inner
}

# Borrow the boxed value. Works for any `T`.
fn<T> box_borrow(b: &Box<T>) -> &T {
  unsafe { b.*.p as &T }
}
fn<T> box_borrow_mut(b: &mut Box<T>) -> &mut T {
  unsafe { b.*.p as &mut T }
}

# Exit code is 42: borrow-read the value once, then consume the box.
fn main(exit: &out i32) {
  let b: Box<i64> = box_new(42i64);
  let peek: i64 = box_borrow(&b).*;
  let owned: i64 = box_into_inner(b);
  exit.* = (peek + owned - peek) as i32;
}
