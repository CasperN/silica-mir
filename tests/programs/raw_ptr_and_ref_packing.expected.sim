struct Point: Copy + Drop {
  x: i64
  y: i64
}

fn read_field_via_raw_ptr<'s0>(pt: Point, $return: &'s0 out i64) {
  p: *Point;
  entry:
    p = &raw pt;
    $return.* = move p.*.x;
    unborrow $return;
    drop p;
    require_uninit p;
    require_uninit $return;
    drop pt;
    require_uninit pt;
    return
}

struct Pair<'s0, 's1>: Move {
  a: &'s0 mut i64
  b: &'s1 mut i64
}

extern fn use_pair<'s0, 's1>(p: Pair<'s0, 's1>);

fn pack_and_pass<'s0, 's1>(x: i64, y: i64) {
  $tmp_0: $Tuple0;
  xm: i64;
  ym: i64;
  p: Pair<'s0, 's1>;
  $tmp_1: $Tuple0;
  entry:
    xm = move x;
    ym = move y;
    p.a = &mut xm;
    p.b = &mut ym;
    call use_pair(move p);
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = $Tuple0 {};
    require_uninit p;
    drop ym;
    require_uninit ym;
    drop xm;
    require_uninit xm;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit y;
    require_uninit x;
    return
}
