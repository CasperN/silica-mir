struct Point: Copy + Drop {
  x: i64
  y: i64
}

fn<'s0> read_field_via_raw_ptr(pt: Point, $return: &out 's0 i64) {
  p: *Point;
  entry:
    p = &raw pt;
    $return.* = move p.*.x;
    unborrow $return;
    drop p;
    require_uninit p;
    require_uninit $return;
    drop pt;
    require_uninit pt;
    return
}

struct<'s0, 's1> Pair: Move {
  a: &mut 's0 i64
  b: &mut 's1 i64
}

extern fn<'s0, 's1> use_pair(p: Pair<'s0, 's1>);

fn<'s0, 's1> pack_and_pass(x: i64, y: i64) {
  $tmp_0: unit;
  xm: i64;
  ym: i64;
  p: Pair<'s0, 's1>;
  $tmp_1: unit;
  entry:
    xm = move x;
    ym = move y;
    p.a = &mut xm;
    p.b = &mut ym;
    call use_pair(move p);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    require_uninit p;
    drop ym;
    require_uninit ym;
    drop xm;
    require_uninit xm;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit y;
    require_uninit x;
    return
}
