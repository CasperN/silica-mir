fn bool_to_i32<'s0>(x: i64, $return: &'s0 out i32) {
  $tmp_0: bool;
  $tmp_1: &out bool;
  $tmp_2: &out i32;
  entry:
    $tmp_1 = &out $tmp_0;
    call $i64_lt(move x, 0, move $tmp_1);
    $tmp_2 = &out $return.*;
    call $bool_to_i32(move $tmp_0, move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}

fn i32_round_trip<'s0>(x: i32, $return: &'s0 out i32) {
  $tmp_0: i64;
  $tmp_1: &out i64;
  $tmp_2: &out i32;
  entry:
    $tmp_1 = &out $tmp_0;
    call $i32_to_i64(move x, move $tmp_1);
    $tmp_2 = &out $return.*;
    call $i64_to_i32(move $tmp_0, move $tmp_2);
    unborrow $return;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}

fn fact<'s0>(n: i64, $return: &'s0 out i64) {
  $tmp_0: bool;
  $tmp_1: &out bool;
  $tmp_2: i64;
  $tmp_3: i64;
  $tmp_4: &out i64;
  $tmp_5: &out i64;
  $tmp_6: &out i64;
  entry:
    $tmp_1 = &out $tmp_0;
    call $i64_le(copy n, 1, move $tmp_1);
    branch(move $tmp_0) [true: if_true_0, false: if_false_1]
  if_true_0:
    $return.* = 1;
    unborrow $return;
    goto $edge0
  $edge0:
    drop n;
    goto if_merge_2
  if_false_1:
    $tmp_4 = &out $tmp_3;
    call $i64_sub(copy n, 1, move $tmp_4);
    $tmp_5 = &out $tmp_2;
    call fact(move $tmp_3, move $tmp_5);
    $tmp_6 = &out $return.*;
    call $i64_mul(move n, move $tmp_2, move $tmp_6);
    unborrow $return;
    require_uninit $tmp_6;
    require_uninit $tmp_5;
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    goto if_merge_2
  if_merge_2:
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit n;
    return
}

fn straight_line_reassign<'s0>(a: i64, b: i64, c: i64, $return: &'s0 out i64) {
  r: i64;
  $tmp_0: &out i64;
  $tmp_1: unit;
  $tmp_2: i64;
  $tmp_3: &out i64;
  entry:
    $tmp_0 = &out r;
    call $i64_add(copy a, move b, move $tmp_0);
    require_uninit $tmp_0;
    $tmp_3 = &out $tmp_2;
    call $i64_mul(move a, move c, move $tmp_3);
    drop r;
    r = move $tmp_2;
    $tmp_1 = unit;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move r;
    unborrow $return;
    require_uninit r;
    require_uninit $return;
    require_uninit c;
    require_uninit b;
    require_uninit a;
    return
}

fn double<'s0>(x: i64, $return: &'s0 out i64) {
  $tmp_0: &out i64;
  entry:
    $tmp_0 = &out $return.*;
    call $i64_add(copy x, move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}

fn call_it<'s0, 's1>(f: fn(i64, &'s0 out i64), x: i64, $return: &'s1 out i64) {
  $tmp_0: &out i64;
  entry:
    $tmp_0 = &out $return.*;
    call move f(move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    require_uninit f;
    return
}

fn double_via_call_it<'s0>(x: i64, $return: &'s0 out i64) {
  $tmp_0: &out i64;
  entry:
    $tmp_0 = &out $return.*;
    call call_it(double, move x, move $tmp_0);
    unborrow $return;
    require_uninit $tmp_0;
    require_uninit $return;
    require_uninit x;
    return
}
