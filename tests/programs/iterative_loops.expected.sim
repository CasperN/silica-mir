fn<'s0> sum_to_n(n: i64, $return: &out 's0 i64) {
  acc: i64;
  i: i64;
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: unit;
  $tmp_3: bool;
  $tmp_4: &out bool;
  $tmp_5: unit;
  $tmp_6: i64;
  $tmp_7: &out i64;
  $tmp_8: unit;
  $tmp_9: i64;
  $tmp_10: &out i64;
  entry:
    acc = 0;
    i = 1;
    goto loop_start_0
  loop_start_0:
    $tmp_4 = &out $tmp_3;
    call $i64_gt(copy i, copy n, move $tmp_4);
    branch(move $tmp_3) [true: if_true_2, false: if_false_3]
  if_true_2:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    goto loop_end_1
  if_false_3:
    $tmp_2 = unit;
    goto if_merge_4
  if_merge_4:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_7 = &out $tmp_6;
    call $i64_add(move acc, copy i, move $tmp_7);
    acc = move $tmp_6;
    $tmp_5 = unit;
    require_uninit $tmp_7;
    require_uninit $tmp_6;
    drop $tmp_5;
    require_uninit $tmp_5;
    $tmp_10 = &out $tmp_9;
    call $i64_add(move i, 1, move $tmp_10);
    i = move $tmp_9;
    $tmp_8 = unit;
    require_uninit $tmp_10;
    require_uninit $tmp_9;
    drop $tmp_8;
    require_uninit $tmp_8;
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    goto loop_start_0
  loop_end_1:
    require_uninit $tmp_0;
    $return.* = move acc;
    unborrow $return;
    drop i;
    require_uninit i;
    require_uninit acc;
    require_uninit $return;
    drop n;
    require_uninit n;
    return
}

fn<'s0> fib(n: i64, $return: &out 's0 i64) {
  a: i64;
  b: i64;
  i: i64;
  next: i64;
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: unit;
  $tmp_3: bool;
  $tmp_4: &out bool;
  $tmp_5: unit;
  $tmp_6: i64;
  $tmp_7: &out i64;
  $tmp_8: unit;
  $tmp_9: unit;
  $tmp_10: unit;
  $tmp_11: i64;
  $tmp_12: &out i64;
  entry:
    a = 0;
    b = 1;
    i = 0;
    next = 0;
    goto $edge0
  $edge0:
    drop next;
    goto loop_start_0
  loop_start_0:
    $tmp_4 = &out $tmp_3;
    call $i64_ge(copy i, copy n, move $tmp_4);
    branch(move $tmp_3) [true: if_true_2, false: if_false_3]
  if_true_2:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    require_uninit $tmp_1;
    goto loop_end_1
  if_false_3:
    $tmp_2 = unit;
    goto if_merge_4
  if_merge_4:
    require_uninit $tmp_4;
    require_uninit $tmp_3;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_7 = &out $tmp_6;
    call $i64_add(move a, copy b, move $tmp_7);
    next = move $tmp_6;
    $tmp_5 = unit;
    require_uninit $tmp_7;
    require_uninit $tmp_6;
    drop $tmp_5;
    require_uninit $tmp_5;
    a = move b;
    $tmp_8 = unit;
    drop $tmp_8;
    require_uninit $tmp_8;
    b = move next;
    $tmp_9 = unit;
    drop $tmp_9;
    require_uninit $tmp_9;
    $tmp_12 = &out $tmp_11;
    call $i64_add(move i, 1, move $tmp_12);
    i = move $tmp_11;
    $tmp_10 = unit;
    require_uninit $tmp_12;
    require_uninit $tmp_11;
    drop $tmp_10;
    require_uninit $tmp_10;
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    goto loop_start_0
  loop_end_1:
    require_uninit $tmp_0;
    $return.* = move a;
    unborrow $return;
    require_uninit next;
    drop i;
    require_uninit i;
    drop b;
    require_uninit b;
    require_uninit a;
    require_uninit $return;
    drop n;
    require_uninit n;
    return
}
