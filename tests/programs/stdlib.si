# A single-file sketch of core library types. Modules will eventually put
# these under `std`; today the fixture exercises the same APIs as global names.

extern fn malloc_bytes(size: u64) -> *u8;
extern fn free_bytes(p: *u8);


# Box<T>

struct<T> Box: Move { data: *T }

fn<T: Move> box_new(value: T) -> Box<T> {
  let bytes = malloc_bytes(size_of<T>());
  let data = bytes as *T;
  unsafe { data.* = value; }
  Box { data: data }
}

impl<T> Box<T> {
  fn get(recv: &Self) -> &T {
    unsafe { recv.*.data as &T }
  }

  fn get_mut(recv: &mut Self) -> &mut T {
    unsafe { recv.*.data as &mut T }
  }
}

impl<T: Move> Box<T> {
  fn into_inner(recv: Self) -> T {
    let value = unsafe { recv.data.* };
    free_bytes(recv.data as *u8);
    value
  }
}


# Span<'a, T>
#
# The first-element reference carries the lifetime. Constructing a span from
# raw parts and indexing it are unsafe. This representation cannot describe an
# empty span without a lifetime-only/phantom field.

struct<'a, T> Span: Copy + Drop { data: &'a T, len: u64 }

unsafe fn<'a, T> span_from_raw_parts(data: *T, len: u64) -> Span<'a, T> {
  Span { data: data as &'a T, len: len }
}

# Taking the Copy span by value avoids a false loan conflict when copying its
# reference field through a shared borrow of the aggregate.
fn<'a, T> span_len(span: Span<'a, T>) -> u64 { span.len }

unsafe fn<'a, T> span_get_unchecked(span: Span<'a, T>, index: u64) -> &'a T {
  let base = span.data as *T;
  let item = ptr_offset<T>(base, index);
  item as &'a T
}


# Vec<T>
#
# A vector owns an allocated but partly uninitialized buffer. Capacity must be
# nonzero because raw pointers are non-null. Allocation failure, capacity
# overflow, and checked indexing need a standard failure effect.

struct<T> Vec: Move { data: *T, len: u64, cap: u64 }

unsafe fn<T> vec_with_capacity(cap: u64) -> Vec<T> {
  let data = malloc_bytes(size_of<T>() * cap) as *T;
  Vec { data: data, len: 0u64, cap: cap }
}

impl<T> Vec<T> {
  fn len(recv: &Self) -> u64 { recv.*.len }
}

impl<T: Move> Vec<T> {
  # Consuming mutation avoids both the missing temporary `&mut` reborrow and a
  # false Partial state after pointer-based mutation through `&mut Vec<T>`.
  unsafe fn push_unchecked(recv: Self, value: T) -> Self {
    let slot = ptr_offset<T>(recv.data, recv.len);
    slot.* = value;
    Vec { data: recv.data, len: recv.len + 1u64, cap: recv.cap }
  }

  unsafe fn push(recv: Self, value: T) -> Self {
    if recv.len >= recv.cap {
      let old_data = recv.data;
      let new_cap = recv.cap + recv.cap;
      let new_data = malloc_bytes(size_of<T>() * new_cap) as *T;
      let mut index = 0u64;
      loop {
        if index >= recv.len { break }
        let source = ptr_offset<T>(old_data, index);
        let target = ptr_offset<T>(new_data, index);
        unsafe { target.* = source.*; }
        index = index + 1u64;
      }
      free_bytes(old_data as *u8);
      let grown = Vec { data: new_data, len: recv.len, cap: new_cap };
      grown.push_unchecked(value)
    } else {
      recv.push_unchecked(value)
    }
  }
}

unsafe fn<'a, T> vec_get_unchecked(vec: &'a Vec<T>, index: u64) -> &'a T {
  ptr_offset<T>(vec.*.data, index) as &'a T
}

unsafe fn<'a, T> vec_as_span(vec: &'a Vec<T>) -> Span<'a, T> {
  span_from_raw_parts<'a, T>(vec.*.data, vec.*.len)
}

# This concrete wrapper constructs Span directly because instantiating the
# generic `vec_as_span` result currently leaks its declared `'a` into the
# caller's lowered locals instead of substituting the inferred lifetime.
fn inspect_vec(vec: &Vec<i64>) -> i64 {
  let span = unsafe {
    Span { data: vec.*.data as &i64, len: vec.*.len }
  };
  let item = unsafe { ptr_offset<i64>(span.data as *i64, 1u64) as &i64 };
  item.* + span.len as i64
}

# Explicit cleanup is required until collection AutoDestroy implementations
# can invoke element destruction and release their allocation.
fn<T: Drop + Move> vec_free(vec: Vec<T>) {
  let mut index = 0u64;
  loop {
    if index >= vec.len { break }
    let item = ptr_offset<T>(vec.data, index);
    let value = unsafe { item.* };
    value;
    index = index + 1u64;
  }
  free_bytes(vec.data as *u8);
}


# covers: Box ownership and borrowing; Vec growth and element destruction;
# Span lifetime storage and indexing; inherent receiver auto-borrowing.
fn main() -> i32 {
  let mut boxed = box_new(40i64);
  let box_place = boxed.get_mut();
  # Assignment initializes, so replacement explicitly consumes the old value.
  let old_box_value = box_place.*;
  box_place.* = 42i64;
  old_box_value;
  let from_box = boxed.get().*;
  let owned = boxed.into_inner();

  let mut values = unsafe { vec_with_capacity<i64>(1u64) };
  values = unsafe { values.push(1i64) };
  values = unsafe { values.push(2i64) };
  let observed = inspect_vec(&values);
  vec_free(values);

  (owned + from_box + observed - from_box - 4i64) as i32
}
