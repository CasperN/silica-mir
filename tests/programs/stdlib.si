# A single-file sketch of core library types. Modules will eventually put
# these under `std`; today the fixture exercises the same APIs as global names.

extern fn malloc_bytes(size: u64) -> *u8;
extern fn free_bytes(p: *u8);


# Box<T>

struct<T> Box: Move { data: *T }

impl<T: Move> Box<T> {
  fn new(value: T) -> Box<T> {
    let bytes = malloc_bytes(size_of<T>());
    let data = bytes as *T;
    unsafe { data.* = value; }
    Box { data: data }
  }

  fn into_inner(self) -> T {
    let value = unsafe { self.data.* };
    free_bytes(self.data as *u8);
    value
  }
}

impl<T> Box<T> {
  fn get(&self) -> &T {
    unsafe { self.*.data as &T }
  }

  fn get_mut(&mut self) -> &mut T {
    unsafe { self.*.data as &mut T }
  }
}

impl<T: AutoDestroy> AutoDestroy for Box<T> {
  fn destroy(&drop self) {
    unsafe { self.*.data.*.destroy() };
    free_bytes(self.*.data as *u8);
  }
}


# PhantomData<'a, T>
#
# A zero-sized phantom marker representing lifetime and type ownership.

struct<'a, T> PhantomData: Copy + Drop {}


# Span<'a, T>
#
# A borrowed view of a contiguous slice of elements. Constructing a span from
# raw parts and indexing it are unsafe.

struct<'a, T> Span: Copy + Drop { data: *T, len: u64, _marker: PhantomData<'a, T> }

impl<'a, T> Span<'a, T> {
  unsafe fn from_raw_parts(data: *T, len: u64) -> Span<'a, T> {
    Span { data: data, len: len, _marker: PhantomData {} }
  }

  fn len(&self) -> u64 { self.*.len }

  unsafe fn get_unchecked(&self, index: u64) -> &'a T {
    let item = ptr_offset(self.*.data, index);
    item as &'a T
  }
}


# Vec<T>
#
# A vector owns an allocated but partly uninitialized buffer. Capacity must be
# nonzero because raw pointers are non-null. Allocation failure, capacity
# overflow, and checked indexing need a standard failure effect.

struct<T> Vec: Move { data: *T, len: u64, cap: u64 }

impl<T> Vec<T> {
  unsafe fn with_capacity(cap: u64) -> Vec<T> {
    let data = malloc_bytes(size_of<T>() * cap) as *T;
    Vec { data: data, len: 0u64, cap: cap }
  }

  fn len(&self) -> u64 { self.*.len }

  fn<'a> as_span(&'a self) -> Span<'a, T> {
    unsafe {
      Span::from_raw_parts(self.*.data, self.*.len)
    }
  }
}

impl<T: AutoDestroy> AutoDestroy for Vec<T> {
  fn destroy(&drop self) {
    let mut index = 0;
    loop {
      if index >= self.*.len {
        break;
      }
      let element = unsafe {
        ptr_offset(self.*.data, index) as &drop T
      };
      element.*.destroy();
      index = index + 1;
    }
    free_bytes(self.*.data as *u8);
    # Consume remaining fields to fulfill the &drop deinitialization obligation.
    # TODO: Destructure self.
    self.*.len;
    self.*.cap;
  }
}

impl<T: Move> Vec<T> {
  unsafe fn push_unchecked(&mut self, value: T) {
    let slot = ptr_offset(self.*.data, self.*.len);
    slot.* = value;
    self.*.len = self.*.len + 1u64;
  }

  unsafe fn push(&mut self, value: T) {
    if self.*.len >= self.*.cap {
      let old_data = self.*.data;
      let new_cap = self.*.cap + self.*.cap;
      let new_data = malloc_bytes(size_of<T>() * new_cap) as *T;
      let mut index = 0u64;
      loop {
        if index >= self.*.len { break }
        let source = ptr_offset(old_data, index);
        let target = ptr_offset(new_data, index);
        unsafe { target.* = source.*; }
        index = index + 1u64;
      }
      free_bytes(old_data as *u8);
      self.*.data = new_data;
      self.*.cap = new_cap;
    }
    self.push_unchecked(value);
  }
}

unsafe fn<'a, T> vec_get_unchecked(vec: &'a Vec<T>, index: u64) -> &'a T {
  ptr_offset(vec.*.data, index) as &'a T
}

fn<'inspect> inspect_vec(vec: &'inspect Vec<i64>) -> i64 {
  let span = vec.as_span();
  let borrow = &span;
  let length = borrow.len();
  let item = unsafe { borrow.get_unchecked(1u64) };
  item.* + length as i64
}

# covers: Box ownership and borrowing; Vec growth and element destruction;
# Span lifetime storage and indexing; inherent receiver auto-borrowing.
fn main() -> i32 {
  let mut boxed = Box::new(40i64);
  let box_place = boxed.get_mut();
  # Assignment initializes, so replacement explicitly consumes the old value.
  let old_box_value = box_place.*;
  box_place.* = 42i64;
  old_box_value;
  let from_box = boxed.get().*;
  let owned = boxed.into_inner();

  let mut values = unsafe { Vec::with_capacity(1u64) };
  unsafe { values.push(1i64); }
  unsafe { values.push(2i64); }
  let observed = inspect_vec(&values);

  (owned + from_box + observed - from_box - 4i64) as i32
}
