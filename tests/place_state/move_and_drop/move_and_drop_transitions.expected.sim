struct Unit0: Copy + Drop {
}

struct<'s0> Linear: Move {
  r: &out 's0 i64
}

enum Option: Copy + Drop {
  None: unit
  Some: i64
}

extern fn take_two(a: i64, b: i64);

extern fn consume(a: i64);

extern fn<'s0> sink_linear(x: Linear<'s0>);

fn param_starts_init(x: i64) {
  y: i64;
  entry:
    y = copy x;
    drop y;
    drop x;
    return
}

fn write_then_read() {
  x: i64;
  y: i64;
  entry:
    x = 42;
    y = copy x;
    drop y;
    drop x;
    return
}

fn empty_struct_local_starts_init() {
  u: Unit0;
  v: Unit0;
  entry:
    drop v;
    v = copy u;
    drop v;
    drop u;
    return
}

fn reassign_after_move(x: i64) {
  y: i64;
  z: i64;
  entry:
    y = move x;
    x = 42;
    z = copy x;
    drop z;
    drop y;
    drop x;
    return
}

fn call_args_copy_then_move(x: i64) {
  entry:
    call take_two(copy x, move x);
    return
}

fn single_param_drop(x: i64) {
  entry:
    drop x;
    return
}

fn reverse_decl_order_drops(a: i64, b: i64, c: i64) {
  x: i64;
  y: i64;
  entry:
    x = 1;
    y = 2;
    drop y;
    drop x;
    drop c;
    drop b;
    drop a;
    return
}

fn<'s0> linear_param_not_dropped(x: Linear<'s0>) {
  entry:
    call sink_linear(move x);
    return
}

fn moved_param_not_dropped(x: i64) {
  entry:
    call consume(move x);
    return
}

fn never_init_local_not_dropped() {
  x: i64;
  entry:
    return
}

fn enum_param_drop(o: Option) {
  entry:
    drop o;
    return
}

fn respects_explicit_user_drop(x: i64) {
  entry:
    drop x;
    return
}

extern fn extern_untouched(x: i64);

trait ImplPlaceStateOk {
  fn<'s0> check(recv: &'s0 Self, x: i64);
}

impl ImplPlaceStateOk for Unit0 {
  fn<'s0> check(recv: &'s0 Unit0, x: i64) {
    y: i64;
    entry:
      unborrow recv;
      y = copy x;
      drop y;
      drop x;
      return
  }
}
