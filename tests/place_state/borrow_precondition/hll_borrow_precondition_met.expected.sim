struct P: Copy + Drop {
  x: i64
  y: i64
}

struct Box: Drop + Move {
  val: i64
}

fn use_shared<'s0, 's1>(r: &'s0 i64, $return: &'s1 out i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn use_mut<'s0, 's1>(r: &'s0 mut i64, $return: &'s1 out i64) {
  entry:
    $return.* = copy r.*;
    unborrow $return;
    require_uninit $return;
    drop r;
    require_uninit r;
    return
}

fn take_scalar<'s0>(y: i64, $return: &'s0 out i64) {
  entry:
    $return.* = move y;
    unborrow $return;
    require_uninit $return;
    require_uninit y;
    return
}

fn shared_of_init<'s0>(x: i64, $return: &'s0 out i64) {
  $tmp_0: &i64;
  $tmp_1: &out i64;
  entry:
    $tmp_0 = &x;
    $tmp_1 = &out $return.*;
    call use_shared(move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    require_uninit $return;
    drop x;
    require_uninit x;
    return
}

fn mut_of_init<'s0>(x: i64, $return: &'s0 out i64) {
  y: i64;
  $tmp_0: &mut i64;
  $tmp_1: &out i64;
  entry:
    y = move x;
    $tmp_0 = &mut y;
    $tmp_1 = &out $return.*;
    call use_mut(move $tmp_0, move $tmp_1);
    unborrow $return;
    require_uninit $tmp_1;
    require_uninit $tmp_0;
    drop y;
    require_uninit y;
    require_uninit $return;
    require_uninit x;
    return
}

fn mut_of_init_field_of_partial<'s0>($return: &'s0 out i64) {
  p: P;
  $tmp_0: unit;
  r: &mut i64;
  v: i64;
  $tmp_1: unit;
  entry:
    p.x = 1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    r = &mut p.x;
    v = copy r.*;
    unborrow r;
    p.y = 2;
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move v;
    unborrow $return;
    require_uninit v;
    require_uninit r;
    drop p;
    require_uninit p;
    require_uninit $return;
    return
}

fn out_of_never_init<'s0>($return: &'s0 out i64) {
  x: i64;
  r: &out i64;
  $tmp_0: unit;
  entry:
    r = &out x;
    r.* = 42;
    unborrow r;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move x;
    unborrow $return;
    require_uninit r;
    require_uninit x;
    require_uninit $return;
    return
}

fn out_of_init_drop_type<'s0>(x: i64, $return: &'s0 out i64) {
  y: i64;
  r: &out i64;
  $tmp_0: unit;
  entry:
    y = move x;
    drop y;
    r = &out y;
    r.* = 2;
    unborrow r;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    $return.* = move y;
    unborrow $return;
    require_uninit r;
    require_uninit y;
    require_uninit $return;
    require_uninit x;
    return
}

fn deinit_of_init<'s0>(b: Box, $return: &'s0 out Box) {
  owned: Box;
  r: &drop Box;
  taken: Box;
  entry:
    owned = move b;
    r = &drop owned;
    taken = move r.*;
    unborrow r;
    $return.* = move taken;
    unborrow $return;
    require_uninit taken;
    require_uninit r;
    require_uninit owned;
    require_uninit $return;
    require_uninit b;
    return
}

fn uninit_of_never_init() {
  $tmp_0: unit;
  x: i64;
  r: &uninit i64;
  entry:
    r = &uninit x;
    unborrow r;
    $tmp_0 = unit;
    require_uninit r;
    require_uninit x;
    drop $tmp_0;
    require_uninit $tmp_0;
    return
}

struct Cell: Move {
  val: i64
}

fn cell_bump<'s0>(r: &'s0 mut Cell) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: i64;
  $tmp_3: &out i64;
  entry:
    $tmp_3 = &out $tmp_2;
    call $i64_add(copy r.*.val, 1, move $tmp_3);
    drop r.*.val;
    r.*.val = move $tmp_2;
    $tmp_1 = unit;
    require_uninit $tmp_3;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

fn reborrow_mut_twice<'s0>(r: &'s0 mut Cell) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: unit;
  $clone_0: &'s0 mut Cell;
  $clone_1: &'s0 mut Cell;
  entry:
    $clone_1 = &mut r.*;
    call cell_bump(move $clone_1);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $clone_0 = &mut r.*;
    call cell_bump(move $clone_0);
    $tmp_2 = unit;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}

struct Pair: Move {
  first: Cell
  second: Cell
}

fn reborrow_field<'s0>(p: &'s0 mut Pair) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: &mut Cell;
  $tmp_3: unit;
  $tmp_4: &mut Cell;
  $tmp_5: unit;
  $tmp_6: &mut Cell;
  entry:
    $tmp_2 = &mut p.*.first;
    call cell_bump(move $tmp_2);
    $tmp_1 = unit;
    require_uninit $tmp_2;
    drop $tmp_1;
    require_uninit $tmp_1;
    $tmp_4 = &mut p.*.second;
    call cell_bump(move $tmp_4);
    $tmp_3 = unit;
    require_uninit $tmp_4;
    drop $tmp_3;
    require_uninit $tmp_3;
    $tmp_6 = &mut p.*.first;
    call cell_bump(move $tmp_6);
    $tmp_5 = unit;
    require_uninit $tmp_6;
    drop $tmp_5;
    require_uninit $tmp_5;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop p;
    require_uninit p;
    return
}

impl Cell {
  fn bump<'s0>(recv: &'s0 mut Cell) {
    $tmp_0: unit;
    $tmp_1: unit;
    $tmp_2: i64;
    $tmp_3: &out i64;
    entry:
      $tmp_3 = &out $tmp_2;
      call $i64_add(copy recv.*.val, 1, move $tmp_3);
      drop recv.*.val;
      recv.*.val = move $tmp_2;
      $tmp_1 = unit;
      require_uninit $tmp_3;
      require_uninit $tmp_2;
      drop $tmp_1;
      require_uninit $tmp_1;
      $tmp_0 = unit;
      drop $tmp_0;
      require_uninit $tmp_0;
      drop recv;
      require_uninit recv;
      return
  }
}

fn reborrow_method_receiver<'s0>(r: &'s0 mut Cell) {
  $tmp_0: unit;
  $tmp_1: unit;
  $tmp_2: unit;
  $clone_0: &'s0 mut Cell;
  $clone_1: &'s0 mut Cell;
  entry:
    $clone_1 = &mut r.*;
    call <Cell>::bump(move $clone_1);
    $tmp_1 = unit;
    drop $tmp_1;
    require_uninit $tmp_1;
    $clone_0 = &mut r.*;
    call <Cell>::bump(move $clone_0);
    $tmp_2 = unit;
    drop $tmp_2;
    require_uninit $tmp_2;
    $tmp_0 = unit;
    drop $tmp_0;
    require_uninit $tmp_0;
    drop r;
    require_uninit r;
    return
}
