enum Option: Copy + Drop {
  None: unit
  Some: i64
}

struct Wrap: Copy + Drop {
  inner: Option
}

extern fn use_shared(r: & 's0 i64);

fn<'s0> deref_read_of_ref_param(r: & 's0 i64) {
  a: i64;
  entry:
    a = copy r.*;
    unborrow r;
    drop a;
    return
}

fn downcast_write_after_switch(o: Option) {
  entry:
    switchEnum(o) [None: n, Some: s]
  s:
    drop o as Some;
    o = Option::Some(7);
    drop o;
    return
  n:
    drop o;
    return
}

fn<'s0> deref_write_through_out_ref(r: &out 's0 i64) {
  entry:
    r.* = 42;
    unborrow r;
    return
}

fn array_slot_read_after_write() {
  a: [i64; 3];
  b: i64;
  entry:
    a[0] = 1;
    b = copy a[0];
    drop a[0];
    drop b;
    return
}

fn downcast_read_on_struct_field_arm(w: Wrap) {
  x: i64;
  entry:
    switchEnum(w.inner) [None: n, Some: s]
  s:
    x = copy w.inner as Some;
    drop x;
    drop w;
    return
  n:
    drop w;
    return
}

fn downcast_read_on_array_slot_arm() {
  a: [Option; 2];
  x: i64;
  entry:
    a[0] = Option::Some(7);
    a[1] = Option::None(unit);
    switchEnum(a[0]) [None: n, Some: s]
  s:
    x = copy a[0] as Some;
    drop x;
    drop a[0];
    drop a[1];
    return
  n:
    drop a[0];
    drop a[1];
    return
}
