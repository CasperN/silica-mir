extern fn sink_mut<'s0>(r: &'s0 mut i64);

extern fn sink_drop<'s0>(r: &'s0 drop i64);

fn drop_mut_ref_untouched<'s0>(r: &'s0 mut i64) {
  entry:
    drop r;
    return
}

fn move_drop_ref_to_call(x: i64) {
  r: &drop i64;
  entry:
    r = &drop x;
    call sink_drop(move r);
    return
}

fn move_mut_ref_to_call(x: i64) {
  r: &mut i64;
  entry:
    r = &mut x;
    call sink_mut(move r);
    drop x;
    return
}

fn overwrite_ref_previous_fulfilled(x: i64, y: i64) {
  r: &mut i64;
  entry:
    r = &mut x;
    unborrow r;
    r = &mut y;
    call sink_mut(move r);
    drop y;
    drop x;
    return
}

fn shared_ref_left_bound<'s0>(r: &'s0 i64) {
  entry:
    drop r;
    return
}

fn shared_ref_read<'s0>(r: &'s0 i64) {
  x: i64;
  entry:
    x = copy r.*;
    drop x;
    drop r;
    return
}

fn uninit_write_then_move<'s0>(r: &'s0 uninit i64) {
  x: i64;
  entry:
    r.* = 42;
    x = move r.*;
    drop x;
    drop r;
    return
}
