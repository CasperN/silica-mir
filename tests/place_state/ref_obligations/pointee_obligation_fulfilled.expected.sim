struct P: Copy + Drop {
  x: i64
  y: i64
}

enum E: Copy + Drop {
  A: i64
  B: $Tuple0
}

struct Box<T: Copy + Drop>: Copy + Drop {
  inner: T
}

enum Option<T: Copy + Drop>: Copy + Drop {
  None: $Tuple0
  Some: T
}

fn out_scalar<'s0>(r: &'s0 out i64) {
  entry:
    r.* = 42;
    unborrow r;
    return
}

fn out_struct<'s0>(src: P, r: &'s0 out P) {
  entry:
    r.* = move src;
    unborrow r;
    return
}

fn out_enum<'s0>(r: &'s0 out E) {
  entry:
    r.* = E::A(42);
    unborrow r;
    return
}

fn out_array<'s0>(r: &'s0 out [i64; 3]) {
  entry:
    r.* = [1, 2, 3];
    unborrow r;
    return
}

fn out_param<'s0, T: Copy + Drop>(src: T, r: &'s0 out T) {
  entry:
    r.* = move src;
    unborrow r;
    return
}

fn out_generic_struct<'s0, T: Copy + Drop>(src: Box<T>, r: &'s0 out Box<T>) {
  entry:
    r.* = move src;
    unborrow r;
    return
}

fn out_generic_enum<'s0, T: Copy + Drop>(src: Option<T>, r: &'s0 out Option<T>) {
  entry:
    r.* = move src;
    unborrow r;
    return
}

fn out_struct_field_by_field<'s0>(r: &'s0 out P) {
  entry:
    r.*.x = 1;
    r.*.y = 2;
    unborrow r;
    return
}

fn out_array_slot_by_slot<'s0>(r: &'s0 out [i64; 3]) {
  entry:
    r.*[0] = 1;
    r.*[1] = 2;
    r.*[2] = 3;
    unborrow r;
    return
}

fn drop_struct_field_by_field<'s0>(r: &'s0 drop P) {
  x: i64;
  y: i64;
  entry:
    x = move r.*.x;
    y = move r.*.y;
    unborrow r;
    drop x;
    drop y;
    return
}

fn drop_scalar<'s0>(r: &'s0 drop i64) {
  x: i64;
  entry:
    x = move r.*;
    unborrow r;
    drop x;
    return
}

fn drop_struct<'s0>(r: &'s0 drop P) {
  p: P;
  entry:
    p = move r.*;
    unborrow r;
    drop p;
    return
}

fn drop_enum<'s0>(r: &'s0 drop E) {
  e: E;
  entry:
    e = move r.*;
    unborrow r;
    drop e;
    return
}

fn drop_array<'s0>(r: &'s0 drop [i64; 3]) {
  a: [i64; 3];
  entry:
    a = move r.*;
    unborrow r;
    drop a;
    return
}

fn drop_param<'s0, T: Copy + Drop>(r: &'s0 drop T) {
  x: T;
  entry:
    x = move r.*;
    unborrow r;
    drop x;
    return
}

fn drop_generic_struct<'s0, T: Copy + Drop>(r: &'s0 drop Box<T>) {
  b: Box<T>;
  entry:
    b = move r.*;
    unborrow r;
    drop b;
    return
}

fn mut_scalar<'s0>(r: &'s0 mut i64) {
  entry:
    drop r;
    return
}

fn mut_struct<'s0>(r: &'s0 mut P) {
  entry:
    drop r;
    return
}

fn mut_array<'s0>(r: &'s0 mut [i64; 3]) {
  entry:
    drop r;
    return
}

fn mut_param<'s0, T: Copy + Drop>(r: &'s0 mut T) {
  entry:
    drop r;
    return
}

fn mut_generic_struct<'s0, T: Copy + Drop>(r: &'s0 mut Box<T>) {
  entry:
    drop r;
    return
}

fn uninit_scalar<'s0>(r: &'s0 uninit i64) {
  entry:
    drop r;
    return
}

fn uninit_struct<'s0>(r: &'s0 uninit P) {
  entry:
    drop r;
    return
}

fn uninit_array<'s0>(r: &'s0 uninit [i64; 3]) {
  entry:
    drop r;
    return
}

fn uninit_param<'s0, T: Copy + Drop>(r: &'s0 uninit T) {
  entry:
    drop r;
    return
}
