struct P: Copy + Drop {
  x: i64
  y: i64
}

struct Inner: Copy + Drop {
  a: i64
  b: i64
}

struct Outer: Copy + Drop {
  i: Inner
  c: i64
}

struct Box: Drop + Move {
  val: i64
}

struct Pair: Drop + Move {
  b: Box
  c: Box
}

struct BigOuter: Drop + Move {
  p: Pair
  tag: i64
}

fn struct_field_by_field<'s0>($return: &'s0 out i64) {
  p: P;
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  entry:
    p.x = 1;
    $tmp_0 = $Tuple0 {};
    drop $tmp_0;
    require_uninit $tmp_0;
    p.y = 2;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move p.x;
    unborrow $return;
    drop p.y;
    require_uninit p;
    require_uninit $return;
    return
}

fn nested_struct_leaf_by_leaf<'s0>($return: &'s0 out i64) {
  o: Outer;
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  $tmp_2: $Tuple0;
  entry:
    o.i.a = 1;
    $tmp_0 = $Tuple0 {};
    drop $tmp_0;
    require_uninit $tmp_0;
    o.i.b = 2;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    o.c = 3;
    $tmp_2 = $Tuple0 {};
    drop $tmp_2;
    require_uninit $tmp_2;
    $return.* = move o.i.a;
    unborrow $return;
    drop o.c;
    drop o.i.b;
    require_uninit o;
    require_uninit $return;
    return
}

fn array_slot_by_slot<'s0>($return: &'s0 out i64) {
  a: [i64; 3];
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  $tmp_2: $Tuple0;
  entry:
    a[0] = 1;
    $tmp_0 = $Tuple0 {};
    drop $tmp_0;
    require_uninit $tmp_0;
    a[1] = 2;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    a[2] = 3;
    $tmp_2 = $Tuple0 {};
    drop $tmp_2;
    require_uninit $tmp_2;
    $return.* = move a[1];
    unborrow $return;
    drop a[2];
    drop a[0];
    require_uninit a;
    require_uninit $return;
    return
}

fn whole_struct_overwrite_from_partial<'s0>(src: P, $return: &'s0 out i64) {
  p: P;
  $tmp_0: $Tuple0;
  $tmp_1: $Tuple0;
  entry:
    p.x = 1;
    $tmp_0 = $Tuple0 {};
    drop $tmp_0;
    require_uninit $tmp_0;
    p = move src;
    $tmp_1 = $Tuple0 {};
    drop $tmp_1;
    require_uninit $tmp_1;
    $return.* = move p.y;
    unborrow $return;
    drop p.x;
    require_uninit p;
    require_uninit $return;
    require_uninit src;
    return
}

fn move_one_field_leaves_other_init(p: Pair) {
  $tmp_0: $Tuple0;
  taken: Box;
  remaining: Box;
  entry:
    taken = move p.b;
    remaining = move p.c;
    $tmp_0 = $Tuple0 {};
    drop remaining;
    require_uninit remaining;
    drop taken;
    require_uninit taken;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit p;
    return
}

fn nested_move_inner_leaf(o: BigOuter) {
  $tmp_0: $Tuple0;
  inner_taken: Box;
  inner_kept: Box;
  tag: i64;
  entry:
    inner_taken = move o.p.b;
    inner_kept = move o.p.c;
    tag = move o.tag;
    $tmp_0 = $Tuple0 {};
    drop tag;
    require_uninit tag;
    drop inner_kept;
    require_uninit inner_kept;
    drop inner_taken;
    require_uninit inner_taken;
    drop $tmp_0;
    require_uninit $tmp_0;
    require_uninit o;
    return
}
